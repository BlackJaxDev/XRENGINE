<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <RootNamespace>RollingBall.DesktopVR</RootNamespace>
    <AssemblyName>RollingBall.DesktopVR</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU</Platforms>
    <XREngineGameProjectReference Condition="'$(XREngineGameProjectReference)' == ''">../RollingBall/RollingBall.csproj</XREngineGameProjectReference>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(XREngineGameProjectReference)" />
  </ItemGroup>
</Project>
