<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\**;$(MSBuildProjectDirectory)\bin\**</DefaultItemExcludes>
    <XREngineRendererBackends Condition="'$(XREngineRendererBackends)' == ''">All</XREngineRendererBackends>
    <XREngineIncludeOpenGlBackend Condition="'$(XREngineIncludeOpenGlBackend)' == '' and ('$(XREngineRendererBackends)' == 'All' or '$(XREngineRendererBackends)' == 'OpenGL')">true</XREngineIncludeOpenGlBackend>
    <XREngineIncludeOpenGlBackend Condition="'$(XREngineIncludeOpenGlBackend)' == ''">false</XREngineIncludeOpenGlBackend>
    <XREngineIncludeVulkanBackend Condition="'$(XREngineIncludeVulkanBackend)' == '' and ('$(XREngineRendererBackends)' == 'All' or '$(XREngineRendererBackends)' == 'Vulkan')">true</XREngineIncludeVulkanBackend>
    <XREngineIncludeVulkanBackend Condition="'$(XREngineIncludeVulkanBackend)' == ''">false</XREngineIncludeVulkanBackend>
    <DefineConstants Condition="'$(XREngineIncludeOpenGlBackend)' == 'true'">$(DefineConstants);XRENGINE_STATIC_OPENGL</DefineConstants>
    <DefineConstants Condition="'$(XREngineIncludeVulkanBackend)' == 'true'">$(DefineConstants);XRENGINE_STATIC_VULKAN</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <AotFactoryRegistrationGenerator>$(MSBuildProjectDirectory)\..\Tools\Generate-AotFactoryRegistrations.ps1</AotFactoryRegistrationGenerator>
    <GeneratedAotFactoryRegistrations>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\Generated\AotFactoryRegistrations.g.cs</GeneratedAotFactoryRegistrations>
    <AotFactoryRegistrationStamp>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\Generated\AotFactoryRegistrations.stamp</AotFactoryRegistrationStamp>
  </PropertyGroup>

  <ItemGroup Condition="'$(DesignTimeBuild)' != 'true'">
    <Compile Include="$(GeneratedAotFactoryRegistrations)" />
    <AotFactoryRegistrationInput Include="$(MSBuildProjectDirectory)\**\*.cs;$(MSBuildProjectDirectory)\..\XREngine.Data\**\*.cs;$(MSBuildProjectDirectory)\..\XREngine.Animation\**\*.cs;$(MSBuildProjectDirectory)\..\XREngine.Runtime.Core\**\*.cs;$(MSBuildProjectDirectory)\..\XREngine.Runtime.Rendering\**\*.cs;$(MSBuildProjectDirectory)\..\XREngine.Runtime.AnimationIntegration\**\*.cs;$(MSBuildProjectDirectory)\..\XREngine.Runtime.AudioIntegration\**\*.cs;$(MSBuildProjectDirectory)\..\XREngine.Runtime.InputIntegration\**\*.cs;$(MSBuildProjectDirectory)\..\XREngine.Runtime.ModelAssetPipeline\**\*.cs;$(MSBuildProjectDirectory)\..\XREngine.Runtime.ModelingIntegration\**\*.cs;$(MSBuildProjectDirectory)\..\XREngine.Runtime.UI.Skia\**\*.cs;$(MSBuildProjectDirectory)\..\XREngine.Runtime.UI.Rive\**\*.cs;$(MSBuildProjectDirectory)\..\XREngine.Audio.Audio2Face\**\*.cs;$(MSBuildProjectDirectory)\..\XREngine.Audio.SteamAudio\**\*.cs;$(MSBuildProjectDirectory)\..\XREngine.Runtime.Physics.PhysX\**\*.cs;$(MSBuildProjectDirectory)\..\XREngine.Runtime.Net.Osc\**\*.cs;$(MSBuildProjectDirectory)\..\XREngine.Runtime.Net.Sockets\**\*.cs" Exclude="**\bin\**;**\obj\**;**\*.g.cs" />
  </ItemGroup>

  <Target Name="InvalidateMissingAotFactoryRegistrationOutput" BeforeTargets="GenerateAotFactoryRegistrations" Condition="'$(DesignTimeBuild)' != 'true' and !Exists('$(GeneratedAotFactoryRegistrations)') and Exists('$(AotFactoryRegistrationStamp)')">
    <Delete Files="$(AotFactoryRegistrationStamp)" />
  </Target>

  <Target Name="GenerateAotFactoryRegistrations" BeforeTargets="CoreCompile" Inputs="$(AotFactoryRegistrationGenerator);$(MSBuildProjectFullPath);@(AotFactoryRegistrationInput)" Outputs="$(AotFactoryRegistrationStamp)" Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(AotFactoryRegistrationGenerator)')">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(GeneratedAotFactoryRegistrations)'))" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(AotFactoryRegistrationGenerator)&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot; -OutputFile &quot;$(GeneratedAotFactoryRegistrations)&quot;" />
    <Touch Files="$(AotFactoryRegistrationStamp)" AlwaysCreate="true" ForceTouch="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\XREngine.Audio.OpenAL\XREngine.Audio.OpenAL.csproj" />
    <ProjectReference Include="..\XREngine.Audio.OVRLipSync\XREngine.Audio.OVRLipSync.csproj" />
    <ProjectReference Include="..\XREngine.Audio.Audio2Face\XREngine.Audio.Audio2Face.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.UI.Ultralight\XREngine.Runtime.UI.Ultralight.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.UI.Rive\XREngine.Runtime.UI.Rive.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.Imaging.Magick\XREngine.Runtime.Imaging.Magick.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.Text.FreeType\XREngine.Runtime.Text.FreeType.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.Platform.Desktop\XREngine.Runtime.Platform.Desktop.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.Net.Sockets\XREngine.Runtime.Net.Sockets.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.Net.Osc\XREngine.Runtime.Net.Osc.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.MeshProcessing.Meshoptimizer\XREngine.Runtime.MeshProcessing.Meshoptimizer.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.XR.OpenVR\XREngine.Runtime.XR.OpenVR.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.XR.OpenXR\XREngine.Runtime.XR.OpenXR.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.Media.FFmpeg\XREngine.Runtime.Media.FFmpeg.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.UI.Skia\XREngine.Runtime.UI.Skia.csproj" />
    <InternalsVisibleTo Include="XREngine.UnitTests" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XREngine.Animation\XREngine.Animation.csproj" />
    <ProjectReference Include="..\XREngine.Audio\XREngine.Audio.csproj" />
    <ProjectReference Include="..\XREngine.Audio.NAudio\XREngine.Audio.NAudio.csproj" />
    <ProjectReference Include="..\XREngine.Audio.SteamAudio\XREngine.Audio.SteamAudio.csproj" />
    <ProjectReference Include="..\XREngine.Input.XInput\XREngine.Input.XInput.csproj" />
    <ProjectReference Include="..\XREngine.Data\XREngine.Data.csproj" />
    <ProjectReference Include="..\XREngine.Extensions\XREngine.Extensions.csproj" />
    <ProjectReference Include="..\XREngine.Input\XREngine.Input.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.AnimationIntegration\XREngine.Runtime.AnimationIntegration.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.AudioIntegration\XREngine.Runtime.AudioIntegration.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.Core\XREngine.Runtime.Core.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.IO.DirectStorage\XREngine.Runtime.IO.DirectStorage.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.Diagnostics.Desktop\XREngine.Runtime.Diagnostics.Desktop.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.Physics.Jolt\XREngine.Runtime.Physics.Jolt.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.Physics.PhysX\XREngine.Runtime.Physics.PhysX.csproj" />
    <ProjectReference Include="..\XREngine.ControlPlane\XREngine.ControlPlane.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.InputIntegration\XREngine.Runtime.InputIntegration.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.Rendering.OpenGL\XREngine.Runtime.Rendering.OpenGL.csproj" Condition="'$(XREngineIncludeOpenGlBackend)' == 'true'" />
    <ProjectReference Include="..\XREngine.Runtime.Rendering\XREngine.Runtime.Rendering.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.Rendering.Vulkan\XREngine.Runtime.Rendering.Vulkan.csproj" Condition="'$(XREngineIncludeVulkanBackend)' == 'true'" />
  </ItemGroup>

  <Target Name="ValidateRendererBackendSelection" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(XREngineRendererBackends)' != 'All' and '$(XREngineRendererBackends)' != 'OpenGL' and '$(XREngineRendererBackends)' != 'Vulkan' and '$(XREngineRendererBackends)' != 'None'" Text="XREngineRendererBackends must be All, OpenGL, Vulkan, or None." />
    <Error Condition="'$(XREngineRendererBackends)' != 'None' and '$(XREngineIncludeOpenGlBackend)' != 'true' and '$(XREngineIncludeVulkanBackend)' != 'true'" Text="XREngine.Runtime.Bootstrap requires at least one statically packaged renderer backend unless XREngineRendererBackends=None is selected for a headless host." />
  </Target>

  <ItemGroup>
  </ItemGroup>

</Project>
