<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(VulkanPerformanceToolOnly)' == 'true'">
    <DefineConstants>$(DefineConstants);VULKAN_PERFORMANCE_TOOL_ONLY</DefineConstants>
    <BaseOutputPath>..\Build\_AgentValidation\00000000-000000-shared\tools\VulkanPerformance\bin\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(VulkanPerformanceToolOnly)' == 'true'">
    <Compile Remove="**\*.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="VulkanPerformance\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(VulkanPerformanceToolOnly)' != 'true'">
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(VulkanPerformanceToolOnly)' != 'true'">
    <ProjectReference Include="..\XREngine.Fbx\XREngine.Fbx.csproj" />
    <ProjectReference Include="..\XREngine.Gltf\XREngine.Gltf.csproj" />
    <ProjectReference Include="..\XREngine.Data\XREngine.Data.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.Core\XREngine.Runtime.Core.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.AnimationIntegration\XREngine.Runtime.AnimationIntegration.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.Rendering\XREngine.Runtime.Rendering.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.Rendering.OpenGL\XREngine.Runtime.Rendering.OpenGL.csproj" />
    <!-- ModelImporter remains facade-owned; retain this edge until its job/settings/profiling host calls move to Runtime.ModelingBridge. -->
    <ProjectReference Include="..\XRENGINE\XREngine.csproj" />
  </ItemGroup>

</Project>
