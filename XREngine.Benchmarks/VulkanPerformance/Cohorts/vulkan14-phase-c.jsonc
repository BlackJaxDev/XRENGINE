{
  "$schema": "../../../.vscode/schemas/unit-testing-world-settings.schema.json",
  "WorldKind": "Default",
  "EditorType": "None",
  "Rendering": {
    "RenderBackend": "Vulkan",
    "BackendFallbackPolicy": "RequireRequested",
    "RenderPipeline": "DefaultRenderPipeline",
    "OpenGL": { "AllowProgramPipelines": true },
    "Vulkan": { "RenderTargetMode": "DynamicRendering" }
  },
  "GPURenderDispatch": true,
  "StartInPlayModeWithoutTransitions": true,
  "VR": { "Mode": "Desktop" },
  "Locomotion": false,
  "AddPhysics": false,
  "PhysicsChain": false,
  "ModelsToImport": [],
  "CreateUnitBox": true,
  "UnitBoxCount": 256,
  "UnitBoxMaterialCount": 16,
  "UnitBoxDeferredMaterial": true,
  "UnitBoxDoubleSided": false,
  "Skybox": false,
  "ProceduralSky": false,
  "GridFloor": false,
  "Mirror": false,
  "DirLight": true,
  "DirLightCastsShadows": true,
  "SpotLight": false,
  "DirLight2": false,
  "PointLight": false,
  "LightProbe": "Off",
  "SoundNode": false,
  "Microphone": false,
  "LipSync": false,
  "AnimationClipVMD": false,
  "AnimationClipAnim": false,
  "CameraAntiAliasingModeOverride": "Fxaa",
  "RenderPhysicsDebug": false,
  "RenderMeshBounds": false,
  "EditorCameraRenderOnDemand": false,
  "RenderTransformDebugInfo": false,
  "RenderTransformPoints": false,
  "RenderTransformCapsules": false,
  "RenderTransformLines": false,
  "VSyncOverride": "Off",
  "RenderFPS": 0.0,
  "UpdateFPS": 60.0,
  "FixedFPS": 30.0
}
