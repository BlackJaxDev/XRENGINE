      "camera": "Static",
      "lights": "CanonicalDirectional",
      "viewport": "1920x1080",
      "renderScale": "1.0",
      "strategy": "GpuIndirectZeroReadback",
      "zeroReadbackMaterialDrawPath": "BindlessMaterialTable",
      "vrMode": "Desktop",
      "foveationMode": "Off",
      "requireFoveation": false,
      "budgetMetric": "render_dispatch_ms",
      "budgetMilliseconds": 5.0,
