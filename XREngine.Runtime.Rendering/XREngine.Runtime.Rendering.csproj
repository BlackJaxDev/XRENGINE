<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
    <RenderCommandRegistrationGenerator>$(MSBuildProjectDirectory)\..\Tools\Generate-AotFactoryRegistrations.ps1</RenderCommandRegistrationGenerator>
    <GeneratedRenderCommandRegistrations>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\Generated\RenderCommandRegistrations.g.cs</GeneratedRenderCommandRegistrations>
    <RenderCommandRegistrationStamp>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\Generated\RenderCommandRegistrations.stamp</RenderCommandRegistrationStamp>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="MIConvexHull" Version="1.1.19.1019" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(GeneratedRenderCommandRegistrations)" />
    <RenderCommandRegistrationInput Include="$(MSBuildProjectDirectory)\**\*.cs" Exclude="**\bin\**;**\obj\**;**\*.g.cs" />
  </ItemGroup>

  <Target Name="InvalidateMissingRenderCommandRegistrations" BeforeTargets="GenerateRenderCommandRegistrations" Condition="'$(DesignTimeBuild)' != 'true' and !Exists('$(GeneratedRenderCommandRegistrations)') and Exists('$(RenderCommandRegistrationStamp)')">
    <Delete Files="$(RenderCommandRegistrationStamp)" />
  </Target>

  <Target Name="GenerateRenderCommandRegistrations" BeforeTargets="ValidateXREnginePortableProject;CoreCompile" Inputs="$(RenderCommandRegistrationGenerator);$(MSBuildProjectFullPath);@(RenderCommandRegistrationInput)" Outputs="$(RenderCommandRegistrationStamp)" Condition="'$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(GeneratedRenderCommandRegistrations)'))" />
    <Exec Command="pwsh -NoProfile -File &quot;$(RenderCommandRegistrationGenerator)&quot; -CommandsOnly -ProjectDir &quot;$(MSBuildProjectDirectory)&quot; -OutputFile &quot;$(GeneratedRenderCommandRegistrations)&quot;" />
    <Touch Files="$(RenderCommandRegistrationStamp)" AlwaysCreate="true" ForceTouch="true" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\XREngine.Data\XREngine.Data.csproj" />
    <ProjectReference Include="..\XREngine.Extensions\XREngine.Extensions.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.Core\XREngine.Runtime.Core.csproj" />
  </ItemGroup>
</Project>
