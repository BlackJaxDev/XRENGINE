    vec4 FoveationB;
};

struct GpuMeshletTaskRecord
{
    uint MeshletIndex;
    uint DrawID;
    uint TransformID;
    uint MaterialID;
};

struct MaterialStateGpu
{
    uint StateClassID;
    uint MaterialID;
    uint PipelineKey;
    uint OptionsBits;
    uint TransparencyMode;
    uint DescriptorStart;
    uint DescriptorCount;
