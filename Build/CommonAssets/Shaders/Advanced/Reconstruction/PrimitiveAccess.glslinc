#ifndef XR_ADVANCED_PRIMITIVE_ACCESS_GLSLINC
#define XR_ADVANCED_PRIMITIVE_ACCESS_GLSLINC

#include "Advanced/Visibility/VisibilityInterface.glslinc"

#ifndef XR_ADV_BINDING_RECONSTRUCTION_INDICES
#define XR_ADV_BINDING_RECONSTRUCTION_INDICES 47
#endif

#define XRAdvancedPackedVertex XRAdvancedVisibilityPackedVertex
#define XR_ADV_StaticVertices XR_ADV_VisibilityStaticVertices
#define XR_ADV_PreSkinnedCurrentVertices XR_ADV_VisibilityCurrentVertices
#define XR_ADV_PreSkinnedPreviousVertices XR_ADV_VisibilityPreviousVertices
#if !defined(XR_ADV_INDEXED_ONLY)
#define XRAdvancedReconstructionMeshlet XRAdvancedVisibilityMeshletDescriptor
#define XR_ADV_ReconstructionMeshlets XR_ADV_VisibilityMeshlets
#define XR_ADV_ReconstructionMeshletVertices XR_ADV_VisibilityMeshletVertexIndices
#define XR_ADV_ReconstructionMeshletTriangles XR_ADV_VisibilityMeshletTriangleWords
#endif

XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_RECONSTRUCTION_INDICES)
readonly buffer XRAdvancedReconstructionIndexTable
{
    uint indices[];
} XR_ADV_ReconstructionIndices;

#if !defined(XR_ADV_INDEXED_ONLY)
uint XR_ADV_ReconstructionTriangleByte(uint byteIndex)
{
    uint word = XR_ADV_ReconstructionMeshletTriangles.records[byteIndex >> 2u];
    return (word >> ((byteIndex & 3u) * 8u)) & 0xFFu;
}
#endif

bool XR_ADV_TryPrimitiveVertices(
    XRAdvancedGeometryRecord geometry,
    uint producer,
    uint encodedPrimitive,
    out uvec3 vertices)
{
    vertices = uvec3(0u);
    bool meshlet =
        producer == XR_ADV_VIS_PRODUCER_STATIC_MESHLET ||
        producer == XR_ADV_VIS_PRODUCER_SKINNED_MESHLET;
    if (!meshlet)
    {
        if (encodedPrimitive > 0xffffffffu / 3u)
            return false;
        uint firstIndex = encodedPrimitive * 3u;
        uint geometryEnd = geometry.indexData.elementOffset + geometry.indexData.elementCount;
        if (geometryEnd < geometry.indexData.elementOffset ||
            firstIndex < geometry.indexData.elementOffset ||
            firstIndex > geometryEnd ||
            geometryEnd - firstIndex < 3u ||
            firstIndex + 2u >= uint(XR_ADV_ReconstructionIndices.indices.length()))
            return false;
        vertices = uvec3(
            XR_ADV_ReconstructionIndices.indices[firstIndex],
            XR_ADV_ReconstructionIndices.indices[firstIndex + 1u],
            XR_ADV_ReconstructionIndices.indices[firstIndex + 2u]);
        return true;
    }

#if defined(XR_ADV_INDEXED_ONLY)
    return false;
#else
    uint meshletIndex = encodedPrimitive >> 8u;
    uint localPrimitive = encodedPrimitive & 0xFFu;
    if (meshletIndex < geometry.meshletFirst ||
        meshletIndex - geometry.meshletFirst >= geometry.meshletCount ||
        meshletIndex >= uint(XR_ADV_ReconstructionMeshlets.records.length()))
        return false;
    XRAdvancedReconstructionMeshlet descriptor =
        XR_ADV_ReconstructionMeshlets.records[meshletIndex];
    if (localPrimitive >= descriptor.triangleCount)
        return false;
    if (descriptor.triangleByteOffset > 0xfffffffdu ||
        localPrimitive > (0xfffffffdu - descriptor.triangleByteOffset) / 3u)
        return false;
    uint triangleByte = descriptor.triangleByteOffset + localPrimitive * 3u;
    if ((triangleByte + 2u) >> 2u >=
        uint(XR_ADV_ReconstructionMeshletTriangles.records.length()))
        return false;
    uvec3 localVertices = uvec3(
        XR_ADV_ReconstructionTriangleByte(triangleByte),
        XR_ADV_ReconstructionTriangleByte(triangleByte + 1u),
        XR_ADV_ReconstructionTriangleByte(triangleByte + 2u));
    if (any(greaterThanEqual(localVertices, uvec3(descriptor.vertexCount))))
        return false;
    if (any(greaterThan(localVertices,
            uvec3(0xffffffffu - descriptor.vertexOffset))))
        return false;
    uvec3 remapIndices = uvec3(descriptor.vertexOffset) + localVertices;
    uint remapCount = uint(XR_ADV_ReconstructionMeshletVertices.records.length());
    if (any(greaterThanEqual(remapIndices, uvec3(remapCount))))
        return false;
    vertices = uvec3(
        XR_ADV_ReconstructionMeshletVertices.records[remapIndices.x],
        XR_ADV_ReconstructionMeshletVertices.records[remapIndices.y],
        XR_ADV_ReconstructionMeshletVertices.records[remapIndices.z]);
    return true;
#endif
}

bool XR_ADV_TryLoadVertex(
    bool deformed,
    bool previous,
    uint index,
    out XRAdvancedPackedVertex vertex)
{
    vertex = XRAdvancedPackedVertex(
        vec3(0.0), 0u, 0u, 0u, 0u, 0u, 0u, 0u,
        0u, 0u, 0u, 0u, 0u, 0u);
    if (!deformed)
    {
        if (index >= uint(XR_ADV_StaticVertices.records.length()))
            return false;
        vertex = XR_ADV_StaticVertices.records[index];
        return true;
    }
    if (previous)
    {
        if (index >= uint(XR_ADV_PreSkinnedPreviousVertices.records.length()))
            return false;
        vertex = XR_ADV_PreSkinnedPreviousVertices.records[index];
        return true;
    }
    if (index >= uint(XR_ADV_PreSkinnedCurrentVertices.records.length()))
        return false;
    vertex = XR_ADV_PreSkinnedCurrentVertices.records[index];
    return true;
}

#endif
