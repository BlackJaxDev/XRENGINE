#ifndef XR_RVC_SHADELET_CACHE_INTERFACE_GLSLINC
#define XR_RVC_SHADELET_CACHE_INTERFACE_GLSLINC

#include "Advanced/Shading/AdvancedShadingInterface.glslinc"

#if !defined(XR_ADV_BACKEND_VULKAN)
#error "The RVC shadelet cache kernels are Vulkan only."
#endif

// Packed pixel-to-shadelet entry layout in RvcPixelToShadelet (R32UI image2DArray).
const uint RVC_SHADELET_INVALID = 0xFFFFFFFFu;
const uint RVC_SHADELET_STEREO_REUSE_BIT = 0x80000000u;
const uint RVC_SHADELET_DIRECT_PIXEL_BIT = 0x40000000u;
const uint RVC_SHADELET_INDEX_MASK = 0x3FFFFFFFu;

// Flags packed into RvcShadeletRecordGpu.representativePixelAndView.y (bits 16..31).
const uint RVC_SHADELET_RECORD_UBER_FLAG = 1u << 16u;
const uint RVC_SHADELET_RECORD_VIEW_DEPENDENT_FLAG = 1u << 17u;

// Mode flags packed into u_Push.kernelIndex for RVC control and resolve dispatches.
const uint RVC_DISPATCH_FLAG_STEREO_REUSE_ACTIVE = 1u << 0u;
const uint RVC_DISPATCH_FLAG_FORCE_FULL_RES_NEAR = 1u << 1u;
const uint RVC_DISPATCH_FLAG_BUILD_ARGS_PHASE = 1u << 2u;
const uint RVC_DISPATCH_FLAG_OVERFLOW_REPAIR = 1u << 3u;
const uint RVC_DISPATCH_DEBUG_MODE_SHIFT = 8u;
const uint RVC_DISPATCH_DEBUG_MODE_MASK = 0xFFu;

// Matches ERvcDebugViewMode enum values for on-GPU diagnostic overlays.
const uint RVC_DEBUG_VIEW_SHADELET_DENSITY = 12u;
const uint RVC_DEBUG_VIEW_REUSE_HEATMAP = 16u;

// Stereo validation tolerance (1% of camera distance) and near-field 1x1 clamp.
const float RVC_SHADELET_STEREO_DISTANCE_TOLERANCE = 0.01;
const float RVC_SHADELET_FORCE_FULL_RES_NEAR_METERS = 1.5;

// 32-byte shadelet record written by RvcPixelToShadeletMap.comp.
struct RvcShadeletRecordGpu
{
    // .x = pixel.x | (pixel.y << 16)
    // .y = (viewIndex & 0xFF) | ((blockSize & 0xFF) << 8) | flags
    uvec2 representativePixelAndView;
    uvec2 identity;
    uint metadata;
    uint surfaceCellHash;
    uint materialDense;
    uint kernelDense;
};

// 32-byte packed shaded output written by RvcMaterialShadeletShading.comp.
struct RvcShadeletShadedOutputGpu
{
    // .x = packHalf2x16(radiance.rg)
    // .y = packHalf2x16(vec2(radiance.b, opacity))
    // .z = packHalf2x16(velocity)
    // .w = (diagnostics & 0x00FFFFFFu) | (uint(clamp(reactive, 0.0, 1.0) * 255.0 + 0.5) << 24u)
    uvec4 primaryPacked;
    // .x = packHalf2x16(emittedRadiance.rg)
    // .y = packHalf2x16(vec2(emittedRadiance.b, float(hasMaterialSurface)))
    // .z = packUnorm4x8(clamp(albedoOpacity, 0.0, 1.0))
    // .w = packUnorm4x8(vec4(octNormal * 0.5 + 0.5, clamp(roughness, 0.0, 1.0), clamp(metallic, 0.0, 1.0)))
    uvec4 surfacePacked;
};

layout(r32ui, set = XR_ADV_VISIBILITY_SET, binding = 77) uniform uimage2DArray RvcPixelToShadelet;

layout(std430, set = XR_ADV_VISIBILITY_SET, binding = 78) buffer RvcShadeletRecordsBuffer
{
    RvcShadeletRecordGpu records[];
} RvcShadeletRecords;

// Standard shadelet indices grow upward from 0; Uber shadelet indices grow downward from capacity - 1.
layout(std430, set = XR_ADV_VISIBILITY_SET, binding = 79) buffer RvcShadeletBinIndicesBuffer
{
    uint indices[];
} RvcShadeletBinIndices;

layout(std430, set = XR_ADV_VISIBILITY_SET, binding = 80) buffer RvcShadeletShadedOutputBuffer
{
    RvcShadeletShadedOutputGpu outputs[];
} RvcShadeletShadedOutputs;

// 128-byte indirect dispatch and counter state (32 uints).
// Byte offset 0:  Standard shadelet indirect dispatch (VkDispatchIndirectCommand: .xyz; .w = sliceBase).
// Byte offset 16: Uber shadelet indirect dispatch (VkDispatchIndirectCommand: .xyz; .w = sliceBase).
// Byte offset 32: Overflow direct repair indirect dispatch (VkDispatchIndirectCommand: .xyz; .w = prevOverflowCount).
layout(std430, set = XR_ADV_VISIBILITY_SET, binding = 81) buffer RvcShadeletDispatchCountersBuffer
{
    uvec4 standardDispatch;
    uvec4 uberDispatch;
    uvec4 overflowDispatch;
    uint standardSliceCount;
    uint uberSliceCount;
    uint totalAllocated;
    uint totalStandard;
    uint totalUber;
    uint totalCoveredPixels;
    uint intraViewReusedPixels;
    uint stereoReusedPixels;
    uint directFallbackPixels;
    uint overflowCount;
    uint stereoCandidates;
    uint stereoRejected;
    uint reserved[8];
} RvcShadeletState;

bool RvcIsValidVisibilityIdentity(uvec2 identity)
{
    return identity.x != 0u &&
        identity.x != XR_ADV_VIS_INVALID &&
        identity.y != XR_ADV_VIS_INVALID;
}

bool RvcIsFarDepthValue(float depth, XRAdvancedViewRecord view)
{
    bool reversed = (view.flags & (1u << 1u)) != 0u || view.depthParams.w != 0.0;
    return isnan(depth) || isinf(depth) || (reversed ? depth <= 0.0 : depth >= 1.0);
}

vec3 RvcReconstructWorldPosition(vec2 pixelCenter, float depth, XRAdvancedViewRecord view)
{
    vec2 ndc = XR_ADV_FramebufferUvToClipNdc(view, pixelCenter * view.renderSizeAndInverse.zw);
    float clipDepth = (view.flags & XR_ADV_VIEW_DEPTH_ZERO_TO_ONE) != 0u ? depth : depth * 2.0 - 1.0;
    vec4 world = XR_ADV_TransformRowVector(vec4(ndc, clipDepth, 1.0), view.inverseViewProjectionJittered);
    return world.xyz / world.w;
}

uint RvcMixHash(uint value)
{
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return value;
}

// Quantizes worldPosition into a power-of-two cell sized to N pixel footprints at the
// point's distance from headCenter so both eyes compute matching keys for the same surface.
uint RvcComputeSurfaceCellHash(vec3 worldPosition, vec3 headCenter, float pixelAngle, float pixels)
{
    float edge = max(distance(worldPosition, headCenter) * pixelAngle * pixels, 1.0e-5);
    float level = ceil(log2(edge));
    vec3 cell = floor(worldPosition / exp2(level));
    ivec3 c = ivec3(clamp(cell, vec3(-1.0e9), vec3(1.0e9)));
    uint h = RvcMixHash(uint(c.x) ^ RvcMixHash(uint(c.y) ^ RvcMixHash(uint(c.z) ^ RvcMixHash(uint(int(level) + 128)))));
    return h == RVC_SHADELET_INVALID ? 0u : h;
}

float RvcResolveViewVerticalPixelAngle(XRAdvancedViewRecord view)
{
    float projY = abs(view.projectionUnjittered[1][1]);
    float height = max(view.renderSizeAndInverse.y, 1.0);
    return projY > 1.0e-5 ? (2.0 / (projY * height)) : (1.0 / height);
}

uint RvcResolveShadeletCapacity()
{
    uint recordCap = uint(RvcShadeletRecords.records.length());
    uint binCap = uint(RvcShadeletBinIndices.indices.length());
    uint outCap = uint(RvcShadeletShadedOutputs.outputs.length());
    uint cap = min(recordCap, min(binCap, outCap));
    if (u_Push.maxKernelTiles > 0u)
        cap = min(cap, u_Push.maxKernelTiles);
    return cap;
}

#endif
