#version 450
#include "ClusteredLightingInterface.glslinc"
layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

void getTileNdcBounds(XRAdvancedViewRecord view, uvec2 tile, out vec2 ndcMin, out vec2 ndcMax)
{
    // Froxel indices address physical framebuffer tiles. Convert both corners
    // before ordering the bounds because the view convention can reverse Y.
    vec2 uvMin = vec2(tile * 16u) / vec2(u_Push.screenExtent);
    vec2 uvMax = vec2(min((tile + 1u) * 16u, u_Push.screenExtent)) / vec2(u_Push.screenExtent);
    vec2 first = XR_ADV_FramebufferUvToClipNdc(view, uvMin);
    vec2 second = XR_ADV_FramebufferUvToClipNdc(view, uvMax);
    ndcMin = min(first, second);
    ndcMax = max(first, second);
}
bool intersectsTile(XRAdvancedLightRecord light, XRAdvancedViewRecord view, uvec3 tile,
    float sliceMin, float sliceMax)
{
    if ((light.type != 1u && light.type != 2u) || !XR_ADV_LightAffectsView(light, u_Push.viewIndex)) return false;
    float radius = light.positionAndRadius.w;
    if (!(radius > 0.0) || isinf(radius) || isnan(radius)) return false;
    vec4 world = vec4(light.positionAndRadius.xyz, 1.0);
    vec3 viewPosition = XR_ADV_TransformRowVector(world, view.view).xyz;
    float depth = -viewPosition.z;
    if (depth + radius < sliceMin || depth - radius > sliceMax) return false;
    vec2 ndcMin, ndcMax;
    getTileNdcBounds(view, tile.xy, ndcMin, ndcMax);
    // Homogeneous side planes avoid unstable projected radii near the camera.
    // Matrix columns form world-space planes for the engine's row-vector ABI.
    mat4 m = view.viewProjectionJittered;
    vec4 planes[4] = vec4[4](m[0] - ndcMin.x * m[3], ndcMax.x * m[3] - m[0],
        m[1] - ndcMin.y * m[3], ndcMax.y * m[3] - m[1]);
    for (uint p = 0u; p < 4u; ++p)
        if (dot(world, planes[p]) < -radius * length(planes[p].xyz)) return false;
    return true;
}

uint reserveLightIndicesForWorkgroup(uint count, uint capacity)
{
    if (count == 0u) return 0u;

    uint observed = atomicAdd(XR_ADV_LightingCounters.nextLightIndex, 0u);
    for (uint attempt = 0u; attempt < 64u; ++attempt)
    {
        if (observed > capacity || count > capacity - observed) return XR_ADV_FROXEL_OVERFLOW;
        uint prior = atomicCompSwap(XR_ADV_LightingCounters.nextLightIndex, observed, observed + count);
        if (prior == observed) return observed;
        observed = prior;
    }

    return XR_ADV_FROXEL_OVERFLOW;
}
bool intersectsDecalTile(XRAdvancedDecalRecord decal, XRAdvancedViewRecord view, uvec3 tile,
    float sliceMin, float sliceMax)
{
    if ((decal.flags & 1u) == 0u) return false;
    bool affectsView = (decal.viewMaskLo | decal.viewMaskHi) == 0u ||
        (u_Push.viewIndex < 32u ? (decal.viewMaskLo & (1u << u_Push.viewIndex)) != 0u :
            (u_Push.viewIndex < 64u && (decal.viewMaskHi & (1u << (u_Push.viewIndex - 32u))) != 0u));
    if (!affectsView) return false;

    mat4 decalToWorld = inverse(decal.worldToDecal);
    vec4 center = XR_ADV_TransformRowVector(vec4(0.0, 0.0, 0.0, 1.0), decalToWorld);
    if (abs(center.w) < 0.00001) return false;
    center /= center.w;
    vec3 extents = max(decal.halfExtentsAndFade.xyz, vec3(0.0));
    // A transformed OBB is conservatively culled as the sphere enclosing its
    // transformed axis extents. The material pass still performs the exact OBB test.
    float radius = length(XR_ADV_TransformRowVector(vec4(extents.x, 0.0, 0.0, 0.0), decalToWorld).xyz) +
        length(XR_ADV_TransformRowVector(vec4(0.0, extents.y, 0.0, 0.0), decalToWorld).xyz) +
        length(XR_ADV_TransformRowVector(vec4(0.0, 0.0, extents.z, 0.0), decalToWorld).xyz);
    if (isinf(radius) || isnan(radius)) return false;
    vec3 viewPosition = XR_ADV_TransformRowVector(center, view.view).xyz;
    float depth = -viewPosition.z;
    if (depth + radius < sliceMin || depth - radius > sliceMax) return false;
    vec2 ndcMin, ndcMax;
    getTileNdcBounds(view, tile.xy, ndcMin, ndcMax);
    mat4 m = view.viewProjectionJittered;
    vec4 planes[4] = vec4[4](m[0] - ndcMin.x * m[3], ndcMax.x * m[3] - m[0],
        m[1] - ndcMin.y * m[3], ndcMax.y * m[3] - m[1]);
    for (uint p = 0u; p < 4u; ++p)
        if (dot(center, planes[p]) < -radius * length(planes[p].xyz)) return false;
    return true;
}

uint reserveDecalIndicesForWorkgroup(uint count, uint capacity)
{
    if (count == 0u) return 0u;

    uint observed = atomicAdd(XR_ADV_LightingCounters.nextDecalIndex, 0u);
    for (uint attempt = 0u; attempt < 64u; ++attempt)
    {
        if (observed > capacity || count > capacity - observed) return XR_ADV_FROXEL_OVERFLOW;
        uint prior = atomicCompSwap(XR_ADV_LightingCounters.nextDecalIndex, observed, observed + count);
        if (prior == observed) return observed;
        observed = prior;
    }

    return XR_ADV_FROXEL_OVERFLOW;
}

shared uint s_lightGroupCount;
shared uint s_lightGroupBase;
shared uint s_lightOverflowCellCount;
shared uint s_decalGroupCount;
shared uint s_decalGroupBase;
shared uint s_decalOverflowCellCount;

void main()
{
    uvec3 tile = gl_GlobalInvocationID;
    uint lane = gl_LocalInvocationIndex;
    bool tileInBounds = !any(greaterThanEqual(tile, uvec3(u_Push.tilesCount, u_Push.depthSlices)));
    bool viewValid = u_Push.viewIndex < uint(XR_ADV_Views.records.length());
    bool eligible = tileInBounds && viewValid;
    bool gridIndexOutOfRange = false;
    uint index = 0u;
    if (eligible)
    {
        index = XR_ADV_GetFroxelIndex(tile.xy, tile.z, u_Push.viewIndex,
            u_Push.tilesCount, u_Push.depthSlices);
        gridIndexOutOfRange = index >= uint(XR_ADV_FroxelGrid.records.length()) ||
            index >= uint(XR_ADV_FroxelDecalGrid.records.length());
        eligible = !gridIndexOutOfRange;
    }

    XRAdvancedViewRecord view;
    float sliceMin = 0.0;
    float sliceMax = 0.0;
    if (eligible)
    {
        view = XR_ADV_LoadView(u_Push.viewIndex);
        float nearPlane = max(view.cameraPositionAndNear.w, 0.0001);
        float farPlane = max(view.cameraForwardAndFar.w, nearPlane + 0.0001);
        sliceMin = nearPlane * pow(farPlane / nearPlane, float(tile.z) / float(u_Push.depthSlices));
        sliceMax = nearPlane * pow(farPlane / nearPlane, float(tile.z + 1u) / float(u_Push.depthSlices));
    }

    uint lightCount = 0u;
    uint points = 0u;
    uint spots = 0u;
    if (eligible)
    {
        lightCount = min(u_Push.lightCount, uint(XR_ADV_Lights.records.length()));
        for (uint i = 0u; i < lightCount; ++i)
        {
            XRAdvancedLightRecord light = XR_ADV_LoadLight(i);
            if (!intersectsTile(light, view, tile, sliceMin, sliceMax)) continue;
            if (light.type == 1u) ++points; else ++spots;
        }
    }

    uint lightCellCount = points + spots;
    uint lightCapacity = min(u_Push.maxLightIndices, uint(XR_ADV_LightIndexList.indices.length()));
    uint maxLightContribution = min(lightCapacity, 0xffffffffu / (gl_WorkGroupSize.x * gl_WorkGroupSize.y * gl_WorkGroupSize.z));
    bool lightNeedsRepair = eligible && lightCellCount > maxLightContribution;
    uint lightContribution = lightNeedsRepair ? 0u : lightCellCount;

    if (lane == 0u)
    {
        s_lightGroupCount = 0u;
        s_lightGroupBase = 0u;
        s_lightOverflowCellCount = 0u;
    }
    barrier();

    // Preserve the capacity guard's diagnostic while keeping every lane in the
    // workgroup barrier sequence. Padding and invalid views do not contribute.
    if (gridIndexOutOfRange)
        atomicAdd(s_lightOverflowCellCount, 1u);

    uint lightLocalOffset = 0u;
    if (lightContribution != 0u)
        lightLocalOffset = atomicAdd(s_lightGroupCount, lightContribution);
    barrier();

    if (lane == 0u)
        s_lightGroupBase = reserveLightIndicesForWorkgroup(s_lightGroupCount, lightCapacity);
    barrier();

    bool lightReservationFailed = lightContribution != 0u && s_lightGroupBase == XR_ADV_FROXEL_OVERFLOW;
    if (eligible)
    {
        if (lightNeedsRepair || lightReservationFailed)
        {
            // Exact GPU repair in shading evaluates all local lights for this
            // froxel. It neither drops lighting nor requests a current-frame readback.
            XR_ADV_FroxelGrid.records[index] = uvec4(0u, XR_ADV_FROXEL_OVERFLOW, 0u, 0u);
            atomicAdd(s_lightOverflowCellCount, 1u);
        }
        else if (lightCellCount == 0u)
        {
            XR_ADV_FroxelGrid.records[index] = uvec4(0u);
        }
        else
        {
            uint base = s_lightGroupBase + lightLocalOffset;
            uint pointWrite = base;
            uint spotWrite = base + points;
            for (uint i = 0u; i < lightCount; ++i)
            {
                XRAdvancedLightRecord light = XR_ADV_LoadLight(i);
                if (!intersectsTile(light, view, tile, sliceMin, sliceMax)) continue;
                if (light.type == 1u) XR_ADV_LightIndexList.indices[pointWrite++] = i;
                else XR_ADV_LightIndexList.indices[spotWrite++] = i;
            }
            XR_ADV_FroxelGrid.records[index] = uvec4(base, points, base + points, spots);
        }
    }
    barrier();

    // All lanes finish reading the group reservation before lane zero publishes
    // aggregate repair state and the workgroup advances to decal allocation.
    if (lane == 0u && s_lightOverflowCellCount != 0u)
        atomicAdd(XR_ADV_LightingCounters.overflowCount, s_lightOverflowCellCount);
    barrier();

    uint decalRecordCount = 0u;
    uint decalCellCount = 0u;
    if (eligible)
    {
        decalRecordCount = uint(XR_ADV_Decals.records.length());
        for (uint i = 0u; i < decalRecordCount; ++i)
        {
            XRAdvancedDecalRecord decal = XR_ADV_Decals.records[i];
            if (intersectsDecalTile(decal, view, tile, sliceMin, sliceMax)) ++decalCellCount;
        }
    }

    uint decalCapacity = min(uint(XR_ADV_DecalIndexList.indices.length()), 65536u);
    uint maxDecalContribution = min(decalCapacity, 0xffffffffu / (gl_WorkGroupSize.x * gl_WorkGroupSize.y * gl_WorkGroupSize.z));
    bool decalNeedsRepair = eligible && (decalCellCount > 65535u || decalCellCount > maxDecalContribution);
    uint decalContribution = decalNeedsRepair ? 0u : decalCellCount;

    if (lane == 0u)
    {
        s_decalGroupCount = 0u;
        s_decalGroupBase = 0u;
        s_decalOverflowCellCount = 0u;
    }
    barrier();

    uint decalLocalOffset = 0u;
    if (decalContribution != 0u)
        decalLocalOffset = atomicAdd(s_decalGroupCount, decalContribution);
    barrier();

    if (lane == 0u)
        s_decalGroupBase = reserveDecalIndicesForWorkgroup(s_decalGroupCount, decalCapacity);
    barrier();

    bool decalReservationFailed = decalContribution != 0u && s_decalGroupBase == XR_ADV_FROXEL_OVERFLOW;
    if (eligible)
    {
        if (decalNeedsRepair || decalReservationFailed)
        {
            XR_ADV_FroxelDecalGrid.records[index] = uvec2(0u, XR_ADV_DECAL_FROXEL_OVERFLOW);
            atomicAdd(s_decalOverflowCellCount, 1u);
        }
        else if (decalCellCount == 0u)
        {
            XR_ADV_FroxelDecalGrid.records[index] = uvec2(0u);
        }
        else
        {
            uint base = s_decalGroupBase + decalLocalOffset;
            uint decalWrite = base;
            for (uint i = 0u; i < decalRecordCount; ++i)
            {
                XRAdvancedDecalRecord decal = XR_ADV_Decals.records[i];
                if (intersectsDecalTile(decal, view, tile, sliceMin, sliceMax))
                    XR_ADV_DecalIndexList.indices[decalWrite++] = i;
            }
            XR_ADV_FroxelDecalGrid.records[index] = uvec2(base | (decalCellCount << 16u), 0u);
        }
    }
    barrier();

    if (lane == 0u && s_decalOverflowCellCount != 0u)
        atomicAdd(XR_ADV_LightingCounters.decalOverflowCount, s_decalOverflowCellCount);
    barrier();
}