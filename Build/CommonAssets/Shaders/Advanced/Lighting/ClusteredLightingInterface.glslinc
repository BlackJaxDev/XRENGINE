#ifndef XR_ADVANCED_CLUSTERED_LIGHTING_INTERFACE_GLSLINC
#define XR_ADVANCED_CLUSTERED_LIGHTING_INTERFACE_GLSLINC

#include "Advanced/Shading/AdvancedShadingInterface.glslinc"

#ifndef XR_ADV_CLUSTERED_SET
#define XR_ADV_CLUSTERED_SET 1
#endif

#if defined(XR_ADV_BACKEND_VULKAN)
#define XR_ADV_CLUSTERED_PASS_LAYOUT(bindingIndex) layout(set = XR_ADV_CLUSTERED_SET, binding = bindingIndex)
#elif defined(XR_ADV_BACKEND_OPENGL)
#define XR_ADV_CLUSTERED_PASS_LAYOUT(bindingIndex) layout(binding = 75 + bindingIndex)
#else
#define XR_ADV_CLUSTERED_PASS_LAYOUT(bindingIndex) layout(binding = bindingIndex)
#endif

struct XRAdvancedFroxelRecord
{
    uint pointLightOffset;
    uint pointLightCount;
    uint spotLightOffset;
    uint spotLightCount;
};

XR_ADV_CLUSTERED_PASS_LAYOUT(10) buffer XRAdvancedFroxelGridBuffer
{
    XRAdvancedFroxelRecord records[];
} XR_ADV_FroxelGrid;

XR_ADV_CLUSTERED_PASS_LAYOUT(11) buffer XRAdvancedLightIndexListBuffer
{
    uint indices[];
} XR_ADV_LightIndexList;

// Matches AdvancedFroxelDecalRecord: the compact cell record leaves the
// capacity budget to the shared index list rather than multiplying it per cell.
struct XRAdvancedFroxelDecalRecord { uint decalOffsetAndCount; uint flags; };
XR_ADV_CLUSTERED_PASS_LAYOUT(13) buffer XRAdvancedFroxelDecalGridBuffer
{
    XRAdvancedFroxelDecalRecord records[];
} XR_ADV_FroxelDecalGrid;
XR_ADV_CLUSTERED_PASS_LAYOUT(14) buffer XRAdvancedDecalIndexListBuffer
{
    uint indices[];
} XR_ADV_DecalIndexList;

#define XR_ADV_FROXEL_OVERFLOW 0xFFFFFFFFu
#define XR_ADV_DECAL_FROXEL_OVERFLOW 1u
#define XR_ADV_DECAL_FROXEL_OFFSET(record) ((record).decalOffsetAndCount & 0xFFFFu)
#define XR_ADV_DECAL_FROXEL_COUNT(record) (((record).decalOffsetAndCount >> 16u) & 0xFFFFu)
XR_ADV_CLUSTERED_PASS_LAYOUT(12) buffer XRAdvancedLightingCountersBuffer
{
    uint nextLightIndex;
    uint overflowCount;
    uint nextDecalIndex;
    uint decalOverflowCount;
} XR_ADV_LightingCounters;

bool XR_ADV_LightAffectsView(XRAdvancedLightRecord light, uint viewIndex)
{
    if ((light.flags & 1u) == 0u) return false;
    if ((light.viewMaskLo | light.viewMaskHi) == 0u) return true;
    return viewIndex < 32u ? (light.viewMaskLo & (1u << viewIndex)) != 0u :
        viewIndex < 64u && (light.viewMaskHi & (1u << (viewIndex - 32u))) != 0u;
}

uint XR_ADV_CalculateDepthSlice(float linearDepth, float nearPlane, float farPlane, uint depthSlices)
{
    if (linearDepth <= nearPlane)
        return 0u;
    if (linearDepth >= farPlane)
        return depthSlices - 1u;

    float ratio = log(linearDepth / nearPlane) / log(farPlane / nearPlane);
    int slice = int(ratio * float(depthSlices));
    return uint(clamp(slice, 0, int(depthSlices) - 1));
}

uint XR_ADV_GetFroxelIndex(
    uvec2 tileCoord,
    uint sliceZ,
    uint viewIndex,
    uvec2 tilesCount,
    uint depthSlices)
{
    uint froxelsPerView = tilesCount.x * tilesCount.y * depthSlices;
    return (viewIndex * froxelsPerView) +
           (sliceZ * tilesCount.x * tilesCount.y) +
           (tileCoord.y * tilesCount.x) +
           tileCoord.x;
}

#endif // XR_ADVANCED_CLUSTERED_LIGHTING_INTERFACE_GLSLINC
