#version 450

layout(push_constant, std430) uniform XRAdvancedVisibilityPreparationPush
{
    uint viewIndex;
    uint payloadBase;
    uint payloadCapacity;
    uint rangeBase;
} XR_ADV_VisibilityPush;

#define XR_ADV_ENABLE_DEPTH_PYRAMID_IMAGES 1

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "../Visibility/VisibilityInterface.glslinc"

void main()
{
    ivec2 destination = ivec2(gl_GlobalInvocationID.xy);
    ivec2 destinationSize = imageSize(XR_ADV_DepthPyramidStorage);
    if (any(greaterThanEqual(destination, destinationSize)))
        return;

    ivec2 source = destination * 2;
    ivec2 sourceMaximum =
        textureSize(XR_ADV_DepthPyramidSampled, 0).xy - ivec2(1);

    ivec2 source0 = clamp(source + ivec2(0, 0), ivec2(0), sourceMaximum);
    ivec2 source1 = clamp(source + ivec2(1, 0), ivec2(0), sourceMaximum);
    ivec2 source2 = clamp(source + ivec2(0, 1), ivec2(0), sourceMaximum);
    ivec2 source3 = clamp(source + ivec2(1, 1), ivec2(0), sourceMaximum);
    float d0 = texelFetch(XR_ADV_DepthPyramidSampled, source0, 0).r;
    float d1 = texelFetch(XR_ADV_DepthPyramidSampled, source1, 0).r;
    float d2 = texelFetch(XR_ADV_DepthPyramidSampled, source2, 0).r;
    float d3 = texelFetch(XR_ADV_DepthPyramidSampled, source3, 0).r;
    bool reversedDepth = XR_ADV_LoadView(
        XR_ADV_VisibilityPush.viewIndex).depthParams.z != 0.0;
    float reduced = reversedDepth
        ? min(min(d0, d1), min(d2, d3))
        : max(max(d0, d1), max(d2, d3));
    imageStore(XR_ADV_DepthPyramidStorage, destination, vec4(reduced));
}
