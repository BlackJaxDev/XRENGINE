#version 450

layout(push_constant, std430) uniform XRAdvancedVisibilityPreparationPush
{
    uint viewIndex;
    uint payloadBase;
    uint payloadCapacity;
    uint rangeBase;
} XR_ADV_VisibilityPush;

#define XR_ADV_VISIBILITY_COUNTER_INDEX XR_ADV_VisibilityPush.viewIndex
// The Vulkan program preamble selects the backend before this canonical
// interface is expanded. Set 1 is owned by the frame-slot visibility runtime.
#include "../Visibility/VisibilityInterface.glslinc"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

const uint FLAG_NEW = 1u << 0u;
const uint FLAG_RESIZED = 1u << 1u;
const uint FLAG_INVALID_HISTORY = 1u << 2u;
const uint FLAG_UNCERTAIN = 1u << 3u;
const uint FLAG_CONSERVATIVE = 1u << 4u;
const uint FLAG_EARLY_VISIBLE = 1u << 5u;
const uint FLAG_DEFERRED = 1u << 6u;
const uint RETEST_AGE_SHIFT = 16u;
const uint RETEST_AGE_MASK = 15u << RETEST_AGE_SHIFT;
const uint RETEST_AGE_LIMIT = 7u;
const uint PRODUCER_CPU_DIRECT_STATIC_INDEXED = 3u;
const uint PRODUCER_CPU_DIRECT_PRE_SKINNED = 4u;

struct XRAdvancedVisibilityCandidate
{
    uvec2 Draw;
    vec4 BoundsSphere;
    vec4 BoundsMin;
    vec4 BoundsMax;
    uvec2 ViewMask;
    uint BvhLeaf;
    uint Flags;
};

struct XRAdvancedVisibilityState
{
    uvec2 Draw;
    uvec2 LastVisibleFrame;
    uvec2 LastTestedFrame;
    uint DepthPyramidGeneration;
    uint Flags;
};

bool sphereInsidePlane(vec3 center, float radius, vec4 plane)
{
    float normalLength = length(plane.xyz);
    return normalLength > 0.0 &&
        dot(plane, vec4(center, 1.0)) >= -radius * normalLength;
}

// Advanced matrices use row-vector convention. Each clip coordinate is the
// dot product with one GLSL matrix column, so the Vulkan 0..w clip planes are
// formed directly from those columns. The sphere test remains conservative at
// the boundary and rejects malformed bounds instead of publishing bad work.
bool sphereInsideFrustum(vec4 sphere)
{
    if (any(isnan(sphere)) || any(isinf(sphere)) || sphere.w < 0.0 ||
        XR_ADV_VisibilityPush.viewIndex >= uint(XR_ADV_Views.records.length()))
    {
        return false;
    }

    mat4 viewProjection = XR_ADV_LoadView(XR_ADV_VisibilityPush.viewIndex).viewProjectionUnjittered;
    vec4 clipX = viewProjection[0];
    vec4 clipY = viewProjection[1];
    vec4 clipZ = viewProjection[2];
    vec4 clipW = viewProjection[3];
    return sphereInsidePlane(sphere.xyz, sphere.w, clipW + clipX) &&
        sphereInsidePlane(sphere.xyz, sphere.w, clipW - clipX) &&
        sphereInsidePlane(sphere.xyz, sphere.w, clipW + clipY) &&
        sphereInsidePlane(sphere.xyz, sphere.w, clipW - clipY) &&
        sphereInsidePlane(sphere.xyz, sphere.w, clipZ) &&
        sphereInsidePlane(sphere.xyz, sphere.w, clipW - clipZ);
}

bool candidateIncludesSelectedView(uvec2 viewMask)
{
    uint viewId = XR_ADV_LoadView(XR_ADV_VisibilityPush.viewIndex).viewId;
    if (viewId < 32u)
        return (viewMask.x & (1u << viewId)) != 0u;
    if (viewId < 64u)
        return (viewMask.y & (1u << (viewId - 32u))) != 0u;
    return false;
}

bool appendEarly(uint candidateIndex)
{
    uint capacity = XR_ADV_VisibilityPush.payloadCapacity;
    uint observed = atomicAdd(XR_ADV_VisibilityCounters.earlyDraws, 0u);
    while (observed < capacity)
    {
        uint prior = atomicCompSwap(
            XR_ADV_VisibilityCounters.earlyDraws,
            observed,
            observed + 1u);
        if (prior == observed)
        {
            XR_ADV_VisibilityVisibleIndices.records[
                XR_ADV_VisibilityPush.payloadBase + observed] = candidateIndex;
            return true;
        }
        observed = prior;
    }

    if (observed >= capacity)
    {
        atomicAdd(XR_ADV_VisibilityCounters.payloadOverflow, 1u);
    }
    return false;
}

bool appendDeferred(uint candidateIndex)
{
    uint capacity = XR_ADV_VisibilityPush.payloadCapacity;
    uint observed = atomicAdd(XR_ADV_VisibilityCounters.deferredCandidates, 0u);
    while (observed < capacity)
    {
        uint prior = atomicCompSwap(
            XR_ADV_VisibilityCounters.deferredCandidates,
            observed,
            observed + 1u);
        if (prior == observed)
        {
            XR_ADV_VisibilityDeferredIndices.records[
                XR_ADV_VisibilityPush.payloadBase + observed] = candidateIndex;
            return true;
        }
        observed = prior;
    }

    if (observed >= capacity)
    {
        atomicAdd(XR_ADV_VisibilityCounters.payloadOverflow, 1u);
    }
    return false;
}

void main()
{
    uint candidateIndex = gl_GlobalInvocationID.x;
    uint candidateCount =
        uint(XR_ADV_VisibilityCandidates.records.length()) / 20u;
    if (candidateIndex >= candidateCount)
        return;

    XRAdvancedVisibilityCandidate candidate;
    candidate.Draw = uvec2(
        XR_ADV_VisibilityCandidates.records[candidateIndex * 20u],
        XR_ADV_VisibilityCandidates.records[candidateIndex * 20u + 1u]);
    candidate.BoundsSphere = uintBitsToFloat(uvec4(
        XR_ADV_VisibilityCandidates.records[candidateIndex * 20u + 4u],
        XR_ADV_VisibilityCandidates.records[candidateIndex * 20u + 5u],
        XR_ADV_VisibilityCandidates.records[candidateIndex * 20u + 6u],
        XR_ADV_VisibilityCandidates.records[candidateIndex * 20u + 7u]));
    candidate.BoundsMin = uintBitsToFloat(uvec4(
        XR_ADV_VisibilityCandidates.records[candidateIndex * 20u + 8u],
        XR_ADV_VisibilityCandidates.records[candidateIndex * 20u + 9u],
        XR_ADV_VisibilityCandidates.records[candidateIndex * 20u + 10u],
        XR_ADV_VisibilityCandidates.records[candidateIndex * 20u + 11u]));
    candidate.BoundsMax = uintBitsToFloat(uvec4(
        XR_ADV_VisibilityCandidates.records[candidateIndex * 20u + 12u],
        XR_ADV_VisibilityCandidates.records[candidateIndex * 20u + 13u],
        XR_ADV_VisibilityCandidates.records[candidateIndex * 20u + 14u],
        XR_ADV_VisibilityCandidates.records[candidateIndex * 20u + 15u]));
    candidate.ViewMask = uvec2(
        XR_ADV_VisibilityCandidates.records[candidateIndex * 20u + 16u],
        XR_ADV_VisibilityCandidates.records[candidateIndex * 20u + 17u]);
    candidate.BvhLeaf = XR_ADV_VisibilityCandidates.records[candidateIndex * 20u + 18u];
    candidate.Flags = XR_ADV_VisibilityCandidates.records[candidateIndex * 20u + 19u];
    if (candidate.Draw.x == 0u)
    {
        atomicAdd(XR_ADV_VisibilityCounters.decodeOutOfBounds, 1u);
        return;
    }

    // History is dense per candidate, not indexed by the stable draw handle.
    // Stable handles may contain tombstone gaps and would let one view's
    // history overlap the next view's segment.
    uint persistentIndex = XR_ADV_VisibilityPush.payloadBase + candidateIndex;
    uint persistentStateCapacity =
        uint(XR_ADV_VisibilityPersistentState.records.length()) / 8u;
    if (persistentIndex >= persistentStateCapacity)
    {
        atomicAdd(XR_ADV_VisibilityCounters.decodeOutOfBounds, 1u);
        return;
    }

    XRAdvancedVisibilityState state;
    uint persistentWord = persistentIndex * 8u;
    state.Draw = uvec2(
        XR_ADV_VisibilityPersistentState.records[persistentWord],
        XR_ADV_VisibilityPersistentState.records[persistentWord + 1u]);
    state.LastVisibleFrame = uvec2(
        XR_ADV_VisibilityPersistentState.records[persistentWord + 2u],
        XR_ADV_VisibilityPersistentState.records[persistentWord + 3u]);
    state.LastTestedFrame = uvec2(
        XR_ADV_VisibilityPersistentState.records[persistentWord + 4u],
        XR_ADV_VisibilityPersistentState.records[persistentWord + 5u]);
    state.DepthPyramidGeneration = XR_ADV_VisibilityPersistentState.records[persistentWord + 6u];
    state.Flags = XR_ADV_VisibilityPersistentState.records[persistentWord + 7u];
    if (!candidateIncludesSelectedView(candidate.ViewMask))
    {
        state.Draw = candidate.Draw;
        state.LastTestedFrame = uvec2(0u);
        state.Flags = 0u;
        XR_ADV_VisibilityPersistentState.records[persistentWord] = state.Draw.x;
        XR_ADV_VisibilityPersistentState.records[persistentWord + 1u] = state.Draw.y;
        XR_ADV_VisibilityPersistentState.records[persistentWord + 4u] = state.LastTestedFrame.x;
        XR_ADV_VisibilityPersistentState.records[persistentWord + 5u] = state.LastTestedFrame.y;
        XR_ADV_VisibilityPersistentState.records[persistentWord + 7u] = state.Flags;
        return;
    }

    bool frustumVisible =
        sphereInsideFrustum(candidate.BoundsSphere);

    bool sameDraw = all(equal(state.Draw, candidate.Draw));
    state.Draw = candidate.Draw;
    state.LastTestedFrame = uvec2(0u);
    bool wasEarlyVisible = sameDraw &&
        (state.Flags & FLAG_EARLY_VISIBLE) != 0u;
    uint retestAge = (state.Flags & RETEST_AGE_MASK) >> RETEST_AGE_SHIFT;
    bool conservativeVisible =
        (candidate.Flags & FLAG_CONSERVATIVE) != 0u;
    bool forceRetest = !conservativeVisible &&
        (!wasEarlyVisible ||
         (candidate.Flags & (FLAG_NEW | FLAG_RESIZED |
             FLAG_INVALID_HISTORY | FLAG_UNCERTAIN)) != 0u ||
         retestAge >= RETEST_AGE_LIMIT);
    uint producer = XR_ADV_VisibilityProducers.records[candidateIndex];
    bool cpuDirect = producer == PRODUCER_CPU_DIRECT_STATIC_INDEXED ||
        producer == PRODUCER_CPU_DIRECT_PRE_SKINNED;
    if (cpuDirect)
        forceRetest = false;
    if (frustumVisible && !forceRetest)
    {
        if (appendEarly(candidateIndex))
        {
            state.LastVisibleFrame = uvec2(0u);
            state.Flags = FLAG_EARLY_VISIBLE |
                (min(retestAge + 1u, RETEST_AGE_LIMIT) << RETEST_AGE_SHIFT);
        }
        else
        {
            state.Flags = 0u;
        }
    }
    else if (frustumVisible)
    {
        state.Flags = appendDeferred(candidateIndex)
            ? FLAG_DEFERRED
            : 0u;
    }
    else
    {
        state.Flags = 0u;
    }

    XR_ADV_VisibilityPersistentState.records[persistentWord] = state.Draw.x;
    XR_ADV_VisibilityPersistentState.records[persistentWord + 1u] = state.Draw.y;
    XR_ADV_VisibilityPersistentState.records[persistentWord + 2u] = state.LastVisibleFrame.x;
    XR_ADV_VisibilityPersistentState.records[persistentWord + 3u] = state.LastVisibleFrame.y;
    XR_ADV_VisibilityPersistentState.records[persistentWord + 4u] = state.LastTestedFrame.x;
    XR_ADV_VisibilityPersistentState.records[persistentWord + 5u] = state.LastTestedFrame.y;
    XR_ADV_VisibilityPersistentState.records[persistentWord + 6u] = state.DepthPyramidGeneration;
    XR_ADV_VisibilityPersistentState.records[persistentWord + 7u] = state.Flags;
}
