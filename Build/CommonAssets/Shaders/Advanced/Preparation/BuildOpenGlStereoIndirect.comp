#version 450

layout(push_constant, std430) uniform XRAdvancedStereoPreparationPush
{
    uint viewCount;
    uint payloadCapacity;
    uint late;
    uint reserved;
} XR_ADV_StereoPush;
#define XR_ADV_VISIBILITY_COUNTER_INDEX 0u
#define XR_ADV_ENABLE_LATE_VISIBILITY_OUTPUTS 1
#include "../Visibility/VisibilityInterface.glslinc"

layout(std430, binding = 75) writeonly buffer StereoArguments { uint words[]; } XR_ADV_StereoArguments;
layout(std430, binding = 76) buffer StereoRangeCounts { uint counts[]; } XR_ADV_StereoRangeCounts;
layout(std430, binding = 77) writeonly buffer StereoViewMasks { uint masks[]; } XR_ADV_StereoViewMasks;
layout(std430, binding = 81) buffer StereoGroupCounts { uint counts[]; } XR_ADV_StereoGroupCounts;
layout(local_size_x = 256) in;

void main()
{
    uint payloadIndex = gl_GlobalInvocationID.x;
    if (payloadIndex >= XR_ADV_StereoPush.payloadCapacity) return;
    uint viewMask = 0u;
    uint requiredFlag = XR_ADV_StereoPush.late != 0u ? 1u << 7u : 1u << 5u;
    // The union is used only for submission. The mask retains each eye's own
    // culling result so broadcasting a draw cannot invent visibility in an eye.
    for (uint view = 0u; view < XR_ADV_StereoPush.viewCount; view++)
    {
        uint stateWord = (view * XR_ADV_StereoPush.payloadCapacity + payloadIndex) * 8u;
        if ((XR_ADV_VisibilityPersistentState.records[stateWord + 7u] & requiredFlag) != 0u)
            viewMask |= 1u << view;
    }
    XR_ADV_StereoViewMasks.masks[payloadIndex] = viewMask;
    if (viewMask == 0u || XR_ADV_VisibilityProducers.records[payloadIndex] != XR_ADV_VIS_PRODUCER_INDIRECT_INDEXED)
        return;
    XRAdvancedVisibilityPayload payload = XR_ADV_VisibilityPayloads.records[payloadIndex];
    uint groupPlusOne = payload.instanceGroupIndexPlusOne;
    uint groupCount = uint(XR_ADV_VisibilityInstanceGroups.records.length());
    if (groupPlusOne == 0u || groupPlusOne > groupCount)
    {
        atomicAdd(XR_ADV_VisibilityCounters.decodeOutOfBounds, 1u);
        return;
    }
    uint groupIndex = groupPlusOne - 1u;
    XRAdvancedIndexedInstanceGroup group = XR_ADV_VisibilityInstanceGroups.records[groupIndex];
    uint range = XR_ADV_VisibilityRangeIndices.records[payloadIndex];
    uint memberCapacity = XR_ADV_StereoPush.late != 0u
        ? uint(XR_ADV_VisibilityLateMeshPayloads.records.length())
        : uint(XR_ADV_VisibilityMeshPayloads.records.length());
    if (group.rangeIndex != range || groupIndex >= uint(XR_ADV_StereoGroupCounts.counts.length()) ||
        group.firstMember > XR_ADV_StereoPush.payloadCapacity ||
        group.memberCapacity > XR_ADV_StereoPush.payloadCapacity - group.firstMember ||
        group.firstMember > memberCapacity ||
        group.memberCapacity > memberCapacity - group.firstMember)
    {
        atomicAdd(XR_ADV_VisibilityCounters.decodeOutOfBounds, 1u);
        return;
    }
    uint member = atomicAdd(XR_ADV_StereoGroupCounts.counts[groupIndex], 0u);
    while (member < group.memberCapacity)
    {
        uint prior = atomicCompSwap(XR_ADV_StereoGroupCounts.counts[groupIndex], member, member + 1u);
        if (prior == member)
            break;
        member = prior;
    }
    if (member >= group.memberCapacity)
    {
        atomicAdd(XR_ADV_VisibilityCounters.payloadOverflow, 1u);
        return;
    }
    if (XR_ADV_StereoPush.late != 0u)
        XR_ADV_VisibilityLateMeshPayloads.records[group.firstMember + member] = payloadIndex;
    else
        XR_ADV_VisibilityMeshPayloads.records[group.firstMember + member] = payloadIndex;
}
