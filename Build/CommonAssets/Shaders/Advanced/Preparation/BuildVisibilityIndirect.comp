#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

const uint PRODUCER_STATIC_MESHLET = 0u;
const uint PRODUCER_SKINNED_MESHLET = 1u;
const uint PRODUCER_INDIRECT_INDEXED = 2u;
const uint PRODUCER_CPU_DIRECT_STATIC_INDEXED = 3u;
const uint PRODUCER_CPU_DIRECT_PRE_SKINNED = 4u;

struct VisibilityPayload
{
    uvec2 Draw;
    uvec2 Geometry;
    uvec2 Material;
    uint VertexOffset;
    uint PreviousVertexOffset;
    uint IndexOffset;
    uint WeightOffset;
    uint PaletteOffset;
    uint MeshletOffset;
    uint MeshletCount;
    uint PrimitiveSection;
    uint InstanceCount;
    uint FirstIndex;
    uint IndexCount;
    uint VertexCount;
    uint RasterStateClass;
    uint Coverage;
    uint CullMode;
    uint PrimitiveTopology;
    uint Flags;
};

struct DrawIndexedIndirect
{
    uint IndexCount;
    uint InstanceCount;
    uint FirstIndex;
    int VertexOffset;
    uint FirstInstance;
};

struct DrawMeshTasksIndirect
{
    uint GroupCountX;
    uint GroupCountY;
    uint GroupCountZ;
};

layout(std430, binding = 0) readonly buffer Payloads
{
    VisibilityPayload PayloadRows[];
};

layout(std430, binding = 1) readonly buffer VisiblePayloadIndices
{
    uint VisibleIndices[];
};

layout(std430, binding = 2) readonly buffer Producers
{
    uint ProducerRows[];
};

layout(std430, binding = 3) writeonly buffer IndexedIndirectArguments
{
    DrawIndexedIndirect IndexedArguments[];
};

layout(std430, binding = 4) buffer RangeCounts
{
    uint Counts[];
};

layout(std430, binding = 5) readonly buffer PayloadRangeIndices
{
    uint RangeIndices[];
};

layout(std430, binding = 6) readonly buffer RangeArgumentOffsets
{
    uint ArgumentOffsets[];
};

layout(std430, binding = 7) buffer VisibilityCounters
{
    uint EarlyCount;
    uint DeferredCount;
    uint LateCount;
    uint RecoveredCount;
    uint ValidPixelCount;
    uint InvalidPixelCount;
    uint PayloadOverflowCount;
    uint MaskedCoverageCount;
    uint DecodeOutOfBoundsCount;
    uint DepthPyramidBuildCount;
    uint UnsupportedDisplacementCount;
    uint ReservedCounters[5];
};

layout(std430, binding = 8) writeonly buffer MeshIndirectArguments
{
    DrawMeshTasksIndirect MeshArguments[];
};

layout(std430, binding = 9) writeonly buffer MeshPayloadIndices
{
    uint MeshPayloadRows[];
};

uniform uint VisibleCapacity;
uniform uint PayloadCount;
uniform uint RangeCount;
uniform uint ArgumentCapacity;
uniform uint UseLateVisibleList;

void main()
{
    uint visibleIndex = gl_GlobalInvocationID.x;
    uint visibleCount = UseLateVisibleList != 0u
        ? LateCount
        : EarlyCount;
    if (visibleIndex >= visibleCount)
        return;
    if (visibleIndex >= VisibleCapacity)
        return;

    uint payloadIndex = VisibleIndices[visibleIndex];
    if (payloadIndex >= PayloadCount)
    {
        atomicAdd(DecodeOutOfBoundsCount, 1u);
        return;
    }

    uint producer = ProducerRows[payloadIndex];
    if (producer == PRODUCER_CPU_DIRECT_STATIC_INDEXED ||
        producer == PRODUCER_CPU_DIRECT_PRE_SKINNED)
    {
        return;
    }

    uint range = RangeIndices[payloadIndex];
    if (range >= RangeCount)
    {
        atomicAdd(DecodeOutOfBoundsCount, 1u);
        return;
    }

    uint rangeLocal = atomicAdd(Counts[range], 1u);
    uint outputIndex =
        ArgumentOffsets[range] + rangeLocal;
    if (outputIndex >= ArgumentCapacity)
    {
        atomicAdd(PayloadOverflowCount, 1u);
        return;
    }

    VisibilityPayload payload = PayloadRows[payloadIndex];
    if (producer == PRODUCER_INDIRECT_INDEXED)
    {
        DrawIndexedIndirect argument;
        argument.IndexCount = payload.IndexCount;
        argument.InstanceCount = max(payload.InstanceCount, 1u);
        argument.FirstIndex = payload.FirstIndex;
        argument.VertexOffset = int(payload.VertexOffset);
        argument.FirstInstance = payloadIndex;
        IndexedArguments[outputIndex] = argument;
        return;
    }

    if (producer == PRODUCER_STATIC_MESHLET ||
        producer == PRODUCER_SKINNED_MESHLET)
    {
        if (payload.MeshletCount == 0u)
        {
            atomicAdd(DecodeOutOfBoundsCount, 1u);
            return;
        }

        DrawMeshTasksIndirect argument;
        argument.GroupCountX = payload.MeshletCount;
        argument.GroupCountY = 1u;
        argument.GroupCountZ = 1u;
        MeshArguments[outputIndex] = argument;
        MeshPayloadRows[outputIndex] = payloadIndex;
        return;
    }

    atomicAdd(DecodeOutOfBoundsCount, 1u);
}
