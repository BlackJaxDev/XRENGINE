#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

const uint PRODUCER_STATIC_MESHLET = 0u;
const uint PRODUCER_SKINNED_MESHLET = 1u;
const uint PRODUCER_TRADITIONAL = 2u;
const uint PRODUCER_CPU_DIAGNOSTIC = 3u;

struct VisibilityPayload
{
    uvec2 Draw;
    uvec2 Geometry;
    uvec2 Material;
    uint VertexOffset;
    uint PreviousVertexOffset;
    uint IndexOffset;
    uint WeightOffset;
    uint PaletteOffset;
    uint MeshletOffset;
    uint MeshletCount;
    uint PrimitiveSection;
    uint InstanceCount;
    uint FirstIndex;
    uint IndexCount;
    uint VertexCount;
    uint RasterStateClass;
    uint Coverage;
    uint CullMode;
    uint PrimitiveTopology;
    uint Flags;
};

struct DrawIndexedIndirect
{
    uint IndexCount;
    uint InstanceCount;
    uint FirstIndex;
    int VertexOffset;
    uint FirstInstance;
};

layout(std430, binding = 0) readonly buffer Payloads
{
    VisibilityPayload PayloadRows[];
};

layout(std430, binding = 1) readonly buffer VisiblePayloadIndices
{
    uint VisibleIndices[];
};

layout(std430, binding = 2) readonly buffer Producers
{
    uint ProducerRows[];
};

layout(std430, binding = 3) writeonly buffer IndirectArguments
{
    DrawIndexedIndirect Arguments[];
};

layout(std430, binding = 4) buffer RangeCounts
{
    uint Counts[];
};

layout(std430, binding = 5) readonly buffer PayloadRangeIndices
{
    uint RangeIndices[];
};

layout(std430, binding = 6) readonly buffer RangeArgumentOffsets
{
    uint ArgumentOffsets[];
};

layout(std430, binding = 7) readonly buffer VisibilityCounters
{
    uint EarlyCount;
    uint DeferredCount;
    uint LateCount;
    uint ReservedCount;
};

uniform uint VisibleCapacity;
uniform uint UseLateVisibleList;

void main()
{
    uint visibleIndex = gl_GlobalInvocationID.x;
    uint visibleCount =
        UseLateVisibleList != 0u ? LateCount : EarlyCount;
    if (visibleIndex >= VisibleCapacity ||
        visibleIndex >= visibleCount)
        return;

    uint payloadIndex = VisibleIndices[visibleIndex];
    VisibilityPayload payload = PayloadRows[payloadIndex];
    uint producer = ProducerRows[payloadIndex];
    uint range = RangeIndices[payloadIndex];
    uint rangeLocal = atomicAdd(Counts[range], 1u);
    uint outputIndex = ArgumentOffsets[range] + rangeLocal;

    DrawIndexedIndirect argument;
    argument.IndexCount = payload.IndexCount;
    argument.InstanceCount = max(payload.InstanceCount, 1u);
    argument.FirstIndex = payload.FirstIndex;
    argument.VertexOffset = int(payload.VertexOffset);
    argument.FirstInstance = payloadIndex;

    // Static and skinned meshlets differ only in vertex source. Both preserve
    // Draw/Geometry/Material identity in the payload consumed by raster.
    if (producer == PRODUCER_STATIC_MESHLET ||
        producer == PRODUCER_SKINNED_MESHLET)
    {
        argument.FirstIndex = payload.MeshletOffset;
        argument.IndexCount = payload.MeshletCount;
    }
    else if (producer == PRODUCER_CPU_DIAGNOSTIC)
    {
        // The explicit diagnostic path consumes the same payload/argument
        // schema; only command production occurs on CPU.
    }
    else if (producer != PRODUCER_TRADITIONAL)
    {
        return;
    }

    Arguments[outputIndex] = argument;
}
