#version 450

layout(push_constant, std430) uniform XRAdvancedVisibilityPreparationPush
{
    uint viewIndex;
    uint payloadBase;
    uint payloadCapacity;
    uint rangeBase;
} XR_ADV_VisibilityPush;

#define XR_ADV_VISIBILITY_COUNTER_INDEX XR_ADV_VisibilityPush.viewIndex
#define XR_ADV_ENABLE_LATE_VISIBILITY_OUTPUTS 1
#define XR_ADV_ENABLE_DEPTH_PYRAMID_IMAGES 1

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

const uint FLAG_LATE_VISIBLE = 1u << 7u;
const uint FLAG_OCCLUDED = 1u << 8u;
const uint FLAG_EARLY_VISIBLE = 1u << 5u;
const uint PRODUCER_STATIC_MESHLET = 0u;
const uint PRODUCER_SKINNED_MESHLET = 1u;
const uint PRODUCER_INDIRECT_INDEXED = 2u;
const uint PRODUCER_CPU_DIRECT_STATIC_INDEXED = 3u;
const uint PRODUCER_CPU_DIRECT_PRE_SKINNED = 4u;

struct VisibilityCandidate
{
    uvec2 Draw;
    vec4 BoundsSphere;
    vec4 BoundsMin;
    vec4 BoundsMax;
    uvec2 ViewMask;
    uint BvhLeaf;
    uint Flags;
};

struct VisibilityState
{
    uvec2 Draw;
    uvec2 LastVisibleFrame;
    uvec2 LastTestedFrame;
    uint DepthPyramidGeneration;
    uint Flags;
};

bool reserveLateOutput(out uint outputIndex);
bool reserveLateRange(uint counterIndex, uint capacity, out uint rangeLocal);
void storeVisibilityState(uint candidateIndex, uvec2 draw, uint flags);

#include "../Visibility/VisibilityInterface.glslinc"

bool currentDepthOccludes(vec4 sphere, XRAdvancedViewRecord view)
{
    // The previous center-sample approximation could falsely classify a
    // partially visible bound as occluded. Keep late recovery conservative
    // until the projected-rectangle/nearest-depth proof is implemented.
    return false;
#if 0
    vec4 clip = XR_ADV_TransformRowVector(vec4(sphere.xyz, 1.0), view.viewProjectionJittered);
    if (clip.w <= 0.0)
        return false;

    vec3 ndc = clip.xyz / clip.w;
    vec2 uv = ndc.xy * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0.0))) ||
        any(greaterThan(uv, vec2(1.0))))
        return false;

    float projectedRadius =
        sphere.w / max(abs(clip.w), 0.00001);
    float diameterPixels =
        projectedRadius *
        float(max(
            textureSize(XR_ADV_DepthPyramidSampled, 0).x,
            textureSize(XR_ADV_DepthPyramidSampled, 0).y));
    float mip = clamp(
        floor(log2(max(diameterPixels, 1.0))),
        0.0,
        float(textureQueryLevels(XR_ADV_DepthPyramidSampled) - 1));
    float currentDepth =
        textureLod(XR_ADV_DepthPyramidSampled, uv, mip).r;
    bool reversedDepth = view.depthParams.z != 0.0;
    float centerDepth = ndc.z;
    float nearestDepth = reversedDepth
        ? centerDepth + projectedRadius
        : centerDepth - projectedRadius;
    return reversedDepth
        ? nearestDepth < currentDepth
        : nearestDepth > currentDepth;
#endif
}

void main()
{
    uint deferredIndex = gl_GlobalInvocationID.x;
    uint boundedDeferredCount = min(
        XR_ADV_VisibilityCounters.deferredCandidates,
        XR_ADV_VisibilityPush.payloadCapacity);
    if (deferredIndex >= boundedDeferredCount)
        return;

    uint candidateIndex =
        XR_ADV_VisibilityDeferredIndices.records[
            XR_ADV_VisibilityPush.payloadBase + deferredIndex];
    if (candidateIndex >= uint(XR_ADV_VisibilityCandidates.records.length()) / 20u)
    {
        atomicAdd(XR_ADV_VisibilityCounters.decodeOutOfBounds, 1u);
        return;
    }

    uint base = candidateIndex * 20u;
    VisibilityCandidate candidate;
    candidate.Draw = uvec2(XR_ADV_VisibilityCandidates.records[base], XR_ADV_VisibilityCandidates.records[base + 1u]);
    candidate.BoundsSphere = uintBitsToFloat(uvec4(XR_ADV_VisibilityCandidates.records[base + 4u], XR_ADV_VisibilityCandidates.records[base + 5u], XR_ADV_VisibilityCandidates.records[base + 6u], XR_ADV_VisibilityCandidates.records[base + 7u]));
    if (candidate.Draw.x == 0u)
    {
        atomicAdd(XR_ADV_VisibilityCounters.decodeOutOfBounds, 1u);
        return;
    }

    uint persistentIndex = XR_ADV_VisibilityPush.payloadBase + candidateIndex;
    if (persistentIndex * 8u + 7u >= uint(XR_ADV_VisibilityPersistentState.records.length()))
    {
        atomicAdd(XR_ADV_VisibilityCounters.decodeOutOfBounds, 1u);
        return;
    }

    XRAdvancedViewRecord view =
        XR_ADV_LoadView(XR_ADV_VisibilityPush.viewIndex);
    if (!currentDepthOccludes(candidate.BoundsSphere, view))
    {
        uint outputIndex;
        if (!reserveLateOutput(outputIndex))
        {
            storeVisibilityState(candidateIndex, candidate.Draw, 0u);
            return;
        }
        XR_ADV_VisibilityLateVisibleIndices.records[
            XR_ADV_VisibilityPush.payloadBase + outputIndex] = candidateIndex;
        atomicAdd(XR_ADV_VisibilityCounters.recoveredCandidates, 1u);

        uint producer = XR_ADV_VisibilityProducers.records[candidateIndex];
        if (producer == PRODUCER_CPU_DIRECT_STATIC_INDEXED ||
            producer == PRODUCER_CPU_DIRECT_PRE_SKINNED)
        {
            storeVisibilityState(candidateIndex, candidate.Draw, FLAG_EARLY_VISIBLE);
            return;
        }
        uint range = XR_ADV_VisibilityRangeIndices.records[candidateIndex];
        uint rangeCount = uint(XR_ADV_VisibilityRangeOffsets.records.length());
        if (range >= rangeCount)
        {
            atomicAdd(XR_ADV_VisibilityCounters.decodeOutOfBounds, 1u);
            storeVisibilityState(candidateIndex, candidate.Draw, 0u);
            return;
        }
        uint capacity = producer == PRODUCER_INDIRECT_INDEXED
            ? XR_ADV_VisibilityPush.payloadCapacity
            : XR_ADV_VisibilityPush.payloadCapacity;
        uint rangeBegin = XR_ADV_VisibilityPush.payloadBase +
            XR_ADV_VisibilityRangeOffsets.records[range];
        uint rangeEnd = range + 1u < rangeCount
            ? XR_ADV_VisibilityPush.payloadBase + XR_ADV_VisibilityRangeOffsets.records[range + 1u]
            : XR_ADV_VisibilityPush.payloadBase + capacity;
        if (rangeBegin > rangeEnd)
        {
            atomicAdd(XR_ADV_VisibilityCounters.payloadOverflow, 1u);
            storeVisibilityState(candidateIndex, candidate.Draw, 0u);
            return;
        }
        uint rangeLocal;
        if (!reserveLateRange(
                XR_ADV_VisibilityPush.rangeBase + range,
                rangeEnd - rangeBegin,
                rangeLocal))
        {
            storeVisibilityState(candidateIndex, candidate.Draw, 0u);
            return;
        }
        uint drawIndex = rangeBegin + rangeLocal;
        XRAdvancedVisibilityPayload payload =
            XR_ADV_VisibilityPayloads.records[candidateIndex];
        if (producer == PRODUCER_INDIRECT_INDEXED)
        {
            uint argumentBase = drawIndex * 5u;
            XR_ADV_VisibilityLateIndexedArguments.records[argumentBase] = payload.indexCount;
            XR_ADV_VisibilityLateIndexedArguments.records[argumentBase + 1u] = max(payload.instanceCount, 1u);
            XR_ADV_VisibilityLateIndexedArguments.records[argumentBase + 2u] = payload.firstIndex;
            XR_ADV_VisibilityLateIndexedArguments.records[argumentBase + 3u] = payload.vertexOffset;
            XR_ADV_VisibilityLateIndexedArguments.records[argumentBase + 4u] = candidateIndex;
        }
        else if (producer == PRODUCER_STATIC_MESHLET ||
                 producer == PRODUCER_SKINNED_MESHLET)
        {
            if (payload.meshletCount == 0u)
            {
                atomicAdd(XR_ADV_VisibilityCounters.decodeOutOfBounds, 1u);
                storeVisibilityState(candidateIndex, candidate.Draw, 0u);
                return;
            }
            uint argumentBase = drawIndex * 3u;
            XR_ADV_VisibilityLateMeshArguments.records[argumentBase] = payload.meshletCount;
            XR_ADV_VisibilityLateMeshArguments.records[argumentBase + 1u] = 1u;
            XR_ADV_VisibilityLateMeshArguments.records[argumentBase + 2u] = 1u;
            XR_ADV_VisibilityLateMeshPayloads.records[drawIndex] = candidateIndex;
        }
        else
        {
            atomicAdd(XR_ADV_VisibilityCounters.decodeOutOfBounds, 1u);
            storeVisibilityState(candidateIndex, candidate.Draw, 0u);
            return;
        }
        storeVisibilityState(candidateIndex, candidate.Draw,
            FLAG_EARLY_VISIBLE | FLAG_LATE_VISIBLE);
    }
    else
    {
        storeVisibilityState(candidateIndex, candidate.Draw, FLAG_OCCLUDED);
    }
}

bool reserveLateOutput(out uint outputIndex)
{
    uint capacity = XR_ADV_VisibilityPush.payloadCapacity;
    uint observed = atomicAdd(XR_ADV_VisibilityCounters.lateDraws, 0u);
    while (observed < capacity)
    {
        uint prior = atomicCompSwap(
            XR_ADV_VisibilityCounters.lateDraws,
            observed,
            observed + 1u);
        if (prior == observed)
        {
            outputIndex = observed;
            return true;
        }
        observed = prior;
    }
    outputIndex = 0u;
    atomicAdd(XR_ADV_VisibilityCounters.payloadOverflow, 1u);
    return false;
}

bool reserveLateRange(uint counterIndex, uint capacity, out uint rangeLocal)
{
    uint observed = atomicAdd(
        XR_ADV_VisibilityLateRangeCounts.records[counterIndex], 0u);
    while (observed < capacity)
    {
        uint prior = atomicCompSwap(
            XR_ADV_VisibilityLateRangeCounts.records[counterIndex],
            observed,
            observed + 1u);
        if (prior == observed)
        {
            rangeLocal = observed;
            return true;
        }
        observed = prior;
    }
    rangeLocal = 0u;
    atomicAdd(XR_ADV_VisibilityCounters.payloadOverflow, 1u);
    return false;
}

void storeVisibilityState(uint candidateIndex, uvec2 draw, uint flags)
{
    uint persistentWord =
        (XR_ADV_VisibilityPush.payloadBase + candidateIndex) * 8u;
    XR_ADV_VisibilityPersistentState.records[persistentWord] = draw.x;
    XR_ADV_VisibilityPersistentState.records[persistentWord + 1u] = draw.y;
    XR_ADV_VisibilityPersistentState.records[persistentWord + 7u] = flags;
}
