#ifndef XR_NATIVE_UBER_LIGHTING_GLSLINC
#define XR_NATIVE_UBER_LIGHTING_GLSLINC
#include "Advanced/Shading/NativeUberSurface.glslinc"

float XR_UBER_LightMap(float nl)
{
    int mode = UBER_I(_LightingMapMode);
    if (mode == 0) return nl * 0.5 + 0.5;
    if (mode == 1) return clamp(nl * 0.5 + 0.5, 0.0, 1.0);
    return mode == 3 ? 1.0 : clamp(nl, 0.0, 1.0);
}

vec3 XR_UBER_LightColor(vec3 color)
{
    int mode = UBER_I(_LightingColorMode);
    float maximum = max(max(color.r, color.g), color.b);
    if (mode == 1) return vec3(XR_UBER_Luminance(color));
    if (mode == 2) return vec3(maximum);
    if (mode == 3) return maximum > 1.0e-6 ? color / maximum : vec3(0.0);
    return color;
}

vec3 XR_UBER_PrimaryLightColor(vec3 color)
{
    return UBER_I(_LightModel) != 0 ? color : XR_UBER_LightColor(color);
}

XrSourceMultilayerInputs XR_UBER_MultilayerInputs(XRUberCoordinates c, vec3 L)
{
    XrSourceMultilayerInputs data;
    data.firstColor = UBER_V(_ShadowColor);
    data.secondColor = UBER_V(_Shadow2ndColor);
    data.thirdColor = UBER_V(_Shadow3rdColor);
    data.borderColor = UBER_V(_ShadowBorderColor);
    data.firstTexture = UBER_SAMPLE(c, _ShadowColorTex, vec4(1.0));
    data.secondTexture = UBER_SAMPLE(c, _Shadow2ndColorTex, vec4(1.0));
    data.thirdTexture = UBER_SAMPLE(c, _Shadow3rdColorTex, vec4(1.0));
    data.blurTexture = UBER_SAMPLE(c, _MultilayerMathBlurMap, vec4(1.0));
    data.options = UBER_V(_MultilayerOptions);
    data.borderShift = UBER_V(_ShadowAOShift);
    data.borderShift2 = UBER_V(_ShadowAOShift2);
    data.borderMask = vec4(1.0);
    data.borderMaskX = vec4(1.0);
    data.borderMaskY = vec4(1.0);
    if (data.options.x > 0.5)
    {
        vec2 uv, dx, dy;
        XR_UBER_CoverageUv(c, UBER_I(_ShadowBorderMaskUV), uv, dx, dy);
        vec4 st = UBER_V(_ShadowBorderMask_ST);
        uv = uv * st.xy + st.zw + UBER_V(_ShadowBorderMaskPan).xy * c.time;
        dx *= st.xy;
        dy *= st.xy;
        vec2 sampleDx = dx, sampleDy = dy;
        uint slot = UBER_T(_ShadowBorderMask);
        if (data.options.w > 0.0)
        {
            float minimumGradient = pow(data.options.w, 4.0);
            dx = max(abs(dx), vec2(minimumGradient));
            dy = max(abs(dy), vec2(minimumGradient));
            slot = UBER_T(_ShadowBorderMaskTrilinear);
        }
        data.borderMask = XR_UBER_Sample(slot, uv, dx, dy, vec4(1.0));
        data.borderMaskX = XR_UBER_Sample(slot, uv + sampleDx,
            dx, dy, vec4(1.0));
        data.borderMaskY = XR_UBER_Sample(slot, uv + sampleDy,
            dx, dy, vec4(1.0));
        data.borderMask.rgb = xrSourceMultilayerRemappedMask(data.borderMask, data);
        data.borderMaskX.rgb = xrSourceMultilayerRemappedMask(data.borderMaskX, data);
        data.borderMaskY.rgb = xrSourceMultilayerRemappedMask(data.borderMaskY, data);
    }
    data.flatSettings = UBER_V(_MultilayerFlat);
    data.flatLight = dot(c.flatNormal, L);
    data.borders = UBER_V(_MultilayerBorders);
    data.blurs = UBER_V(_MultilayerBlurs);
    data.receive = UBER_V(_MultilayerReceive);
    data.mixSettings = UBER_V(_MultilayerMix);
    data.strengthMask = UBER_SAMPLE(c, _ShadowStrengthMask, vec4(1.0)).r;
    return data;
}

float XR_UBER_PrimaryLightMap(XRUberCoordinates c, vec3 N, vec3 L,
    XrSourceShCoefficients sh, vec3 rawPrimary, vec3 selectedDirect, float visibility)
{
    if (UBER_I(_LightModel) == 0) return XR_UBER_LightMap(dot(N, L));
    if (UBER_I(_LightingMode) == 2)
        return xrSourceWrappedMap(N, L, rawPrimary, sh,
            UBER_F(_LightingWrappedWrap), UBER_F(_LightingWrappedNormalization),
            XR_UBER_MaterialAo(c), visibility, UBER_V(_ToonLightSettings).y,
            1.0, UBER_F(_LightingMonochromatic));
    return UBER_I(_LightingMapMode) == 0
        ? xrSourceShLightMap(sh, N, selectedDirect, dot(N, L), visibility,
            UBER_V(_ToonLightSettings).y)
        : xrSourceLightMap(dot(N, L), UBER_I(_LightingMapMode),
            UBER_V(_ToonLightSettings).y, visibility);
}

// Evaluates both the ramped glitter light map (x) and the unramped primary light map (y)
// through one XR_UBER_PrimaryLightMap call site so shader compilers do not inline six
// copies of the primary light-map evaluator per caller.
vec2 XR_UBER_GlitterLightMapPair(XRUberCoordinates c, vec3 N, vec3 Nx, vec3 Ny, vec3 L, float mask,
    XrSourceShCoefficients sh, vec3 rawPrimary, vec3 selectedDirect, float visibility)
{
    int direction = UBER_I(_LightingDirectionMode);
    if (direction == 1) L = N;
    else if (direction == 3) L = vec3(0.0, 1.0, 0.0);
    float nl = dot(N, L);
    bool isMultilayer = UBER_I(_LightModel) != 0 && UBER_I(_LightingMode) == 1;
    bool isRamp = !isMultilayer && UBER_I(_LightingMode) == 0;
    int sampleCount = isMultilayer ? 4 : (isRamp ? 3 : 1);
    float m0 = 0.0, m1 = 0.0, m2 = 0.0, m3 = 0.0;
    for (int sampleIndex = 0; sampleIndex < sampleCount; ++sampleIndex)
    {
        vec3 sampleN = N;
        float sampleVis = visibility;
        if (isMultilayer)
        {
            if (sampleIndex == 1) sampleVis = 1.0;
            else if (sampleIndex == 2) { sampleN = normalize(N + Nx); sampleVis = 1.0; }
            else if (sampleIndex == 3) { sampleN = normalize(N + Ny); sampleVis = 1.0; }
        }
        else if (sampleIndex == 1) sampleN = normalize(N + Nx);
        else if (sampleIndex == 2) sampleN = normalize(N + Ny);
        float value = XR_UBER_PrimaryLightMap(c, sampleN, L, sh, rawPrimary, selectedDirect, sampleVis);
        if (sampleIndex == 0) m0 = value;
        else if (sampleIndex == 1) m1 = value;
        else if (sampleIndex == 2) m2 = value;
        else m3 = value;
    }
    if (isMultilayer)
    {
        float bands = xrSourceMultilayerBands(m1, vec2(m2 - m1, m3 - m1),
            visibility, vec2(0.0), XR_UBER_MultilayerInputs(c, L)).x;
        return vec2(bands, m0);
    }
    float ramp;
    if (isRamp)
    {
        vec2 uv, dx, dy;
        XR_UBER_CoverageUv(c, UBER_I(_ToonRampUV), uv, dx, dy);
        vec4 st = UBER_V(_ToonRamp_ST);
        float offset = UBER_F(_ShadowOffset);
        uv.x = clamp(m0 + offset, 0.0, 1.0);
        dx.x = clamp(m1 + offset, 0.0, 1.0) - uv.x;
        dy.x = clamp(m2 + offset, 0.0, 1.0) - uv.x;
        ramp = XR_UBER_Sample(UBER_T(_ToonRamp), uv * st.xy + st.zw + UBER_V(_ToonRampPan).xy * c.time,
            dx * st.xy, dy * st.xy, vec4(1.0)).r;
    }
    else if (UBER_I(_LightingMode) == 2)
    {
        float wrapped = nl + UBER_F(_LightingWrappedWrap);
        if (UBER_F(_LightingWrappedNormalization) > 0.5) wrapped /= max(1.0 + UBER_F(_LightingWrappedWrap), 1.0e-6);
        ramp = UBER_I(_LightModel) != 0 ? m0 :
            smoothstep(UBER_F(_LightingGradientStart), UBER_F(_LightingGradientEnd), clamp(wrapped, 0.0, 1.0));
    }
    else if (UBER_I(_LightingMode) == 5)
        ramp = UBER_F(_ForceFlatRampedLightmap) > 0.5 ? step(0.5, m0) : 1.0;
    else
        ramp = smoothstep(UBER_F(_ShadowBorder) - UBER_F(_ShadowBlur),
            UBER_F(_ShadowBorder) + UBER_F(_ShadowBlur), m0);
    return vec2(mix(1.0, ramp, clamp(UBER_F(_ShadowStrength) * mask, 0.0, 1.0)), m0);
}

// Glitter uses the red component of the primary ramp before final lighting.
float XR_UBER_GlitterLightMap(XRUberCoordinates c, vec3 N, vec3 Nx, vec3 Ny, vec3 L, float mask,
    XrSourceShCoefficients sh, vec3 rawPrimary, vec3 selectedDirect, float visibility)
{
    return XR_UBER_GlitterLightMapPair(c, N, Nx, Ny, L, mask, sh, rawPrimary, selectedDirect, visibility).x;
}

// Source 10 matcap and glitter light masks multiply the ramped light map by the unramped light map.
float XR_UBER_SourceMaskLightMap(XRUberCoordinates c, vec3 N, vec3 Nx, vec3 Ny, vec3 L, float mask,
    XrSourceShCoefficients sh, vec3 rawPrimary, vec3 selectedDirect, float visibility)
{
    vec2 pair = XR_UBER_GlitterLightMapPair(c, N, Nx, Ny, L, mask, sh, rawPrimary, selectedDirect, visibility);
    return pair.x * pair.y;
}

vec3 XR_UBER_Toon(XRUberCoordinates c, vec3 base, vec3 N, vec3 Nx, vec3 Ny,
    vec3 V, vec3 L, vec3 radiance, vec3 ambient, float visibility, float mask,
    bool primary, vec3 rawPrimary, vec3 rawSelectedDirect,
    XrSourceShCoefficients sh, vec3 worldDiffuseOcclusion)
{
    if (UBER_I(_LightModel) != 0 && UBER_I(_LightingMode) == 1 &&
        (primary || UBER_V(_AdditiveLightColor).z >= 1.5))
    {
        float map = 0.0, mapX = 0.0, mapY = 0.0;
        for (int sampleIndex = 0; sampleIndex < 3; ++sampleIndex)
        {
            vec3 sampleN = sampleIndex == 0 ? N : (sampleIndex == 1 ? normalize(N + Nx) : normalize(N + Ny));
            float value = primary
                ? XR_UBER_PrimaryLightMap(c, sampleN, L, sh, rawPrimary, rawSelectedDirect, 1.0)
                : xrSourceAdditiveLightMap(dot(sampleN, L), UBER_I(_LightingMapMode), 1.0, 0.0);
            if (sampleIndex == 0) map = value;
            else if (sampleIndex == 1) mapX = value;
            else mapY = value;
        }
        XrSourceMultilayerInputs data = XR_UBER_MultilayerInputs(c, L);
        return xrSourceMultilayerDiffuse(base, radiance, ambient, map,
            vec2(mapX - map, mapY - map), visibility, vec2(0.0),
            mask, primary, data);
    }
    if (!primary && UBER_I(_LightModel) != 0)
    {
        float map = xrSourceAdditiveLightMap(dot(N, L), UBER_I(_LightingMapMode),
            visibility, UBER_V(_AdditiveLightColor).w);
        vec2 rampUv, rampDx, rampDy;
        XR_UBER_CoverageUv(c, UBER_I(_ToonRampUV), rampUv, rampDx, rampDy);
        vec4 st = UBER_V(_ToonRamp_ST);
        vec2 uv = vec2(clamp(map + UBER_F(_ShadowOffset), 0.0, 1.0), rampUv.y);
        vec2 dx = vec2(xrSourceAdditiveLightMap(dot(normalize(N + Nx), L),
            UBER_I(_LightingMapMode), visibility,
            UBER_V(_AdditiveLightColor).w) - map, rampDx.y);
        vec2 dy = vec2(xrSourceAdditiveLightMap(dot(normalize(N + Ny), L),
            UBER_I(_LightingMapMode), visibility,
            UBER_V(_AdditiveLightColor).w) - map, rampDy.y);
        vec3 ramp = XR_UBER_Sample(UBER_T(_ToonRamp), uv * st.xy + st.zw +
            UBER_V(_ToonRampPan).xy * c.time, dx * st.xy, dy * st.xy,
            vec4(1.0)).rgb;
        return xrSourceAdditiveDiffuse(base, radiance, ambient, ramp,
            UBER_V(_LightingShadowColor).rgb, dot(N, L), visibility, mask,
            XR_UBER_MaterialAo(c), UBER_F(_ShadowStrength),
            UBER_F(_LightingIgnoreAmbientColor), UBER_I(_LightingMode),
            UBER_V(_AdditiveLightColor), UBER_V(_AdditiveLightGradient));
    }
    if (primary && UBER_I(_LightModel) != 0 &&
        (UBER_I(_LightingMode) == 0 || UBER_I(_LightingMode) == 2 ||
         UBER_I(_LightingMode) == 5))
    {
        if (UBER_I(_LightingMode) == 5)
            return base * radiance * mix(1.0, visibility,
                clamp(UBER_V(_ToonLightSettings).y, 0.0, 1.0));
        if (UBER_I(_LightingMode) == 2)
        {
            float materialAo = XR_UBER_MaterialAo(c);
            float wrapAmount = UBER_F(_LightingWrappedWrap);
            float normalization = UBER_F(_LightingWrappedNormalization);
            float castedShadows = UBER_V(_ToonLightSettings).y;
            float monochromatic = UBER_F(_LightingMonochromatic);
            float map = 0.0, mapX = 0.0, mapY = 0.0;
            for (int sampleIndex = 0; sampleIndex < 3; ++sampleIndex)
            {
                vec3 sampleN = sampleIndex == 0 ? N : (sampleIndex == 1 ? normalize(N + Nx) : normalize(N + Ny));
                float value = xrSourceWrappedMap(sampleN, L, rawPrimary, sh,
                    wrapAmount, normalization, materialAo, visibility,
                    castedShadows, 1.0, monochromatic);
                if (sampleIndex == 0) map = value;
                else if (sampleIndex == 1) mapX = value;
                else mapY = value;
            }
            return xrSourceWrappedDiffuse(base, N, L, rawPrimary, sh,
                UBER_V(_WrappedLightColor).rgb,
                UBER_V(_LightingShadowColor).rgb, wrapAmount, normalization,
                materialAo, worldDiffuseOcclusion, visibility,
                castedShadows, 1.0, monochromatic,
                UBER_F(_ShadowStrength), UBER_F(_LightingIgnoreAmbientColor),
                UBER_F(_LightingGradientStart), UBER_F(_LightingGradientEnd),
                UBER_F(_LightingMinLightBrightness), UBER_F(_LightingCapEnabled),
                UBER_F(_LightingCap), abs(mapX - map) + abs(mapY - map));
        }
        float map = xrSourceLightMap(dot(N, L), UBER_I(_LightingMapMode),
            UBER_V(_ToonLightSettings).y, visibility);
        if (UBER_I(_LightingMapMode) == 0)
            map = xrSourceShLightMap(sh, N, rawSelectedDirect, dot(N, L),
                visibility, UBER_V(_ToonLightSettings).y);
        vec2 rampUv, rampDx, rampDy;
        XR_UBER_CoverageUv(c, UBER_I(_ToonRampUV), rampUv, rampDx, rampDy);
        vec4 st = UBER_V(_ToonRamp_ST);
        vec2 uv = vec2(clamp(map + UBER_F(_ShadowOffset), 0.0, 1.0), rampUv.y);
        float mapX = UBER_I(_LightingMapMode) == 0
            ? xrSourceShLightMap(sh, normalize(N + Nx), rawSelectedDirect,
                dot(normalize(N + Nx), L), visibility,
                UBER_V(_ToonLightSettings).y)
            : xrSourceLightMap(dot(normalize(N + Nx), L),
                UBER_I(_LightingMapMode), UBER_V(_ToonLightSettings).y, visibility);
        float mapY = UBER_I(_LightingMapMode) == 0
            ? xrSourceShLightMap(sh, normalize(N + Ny), rawSelectedDirect,
                dot(normalize(N + Ny), L), visibility,
                UBER_V(_ToonLightSettings).y)
            : xrSourceLightMap(dot(normalize(N + Ny), L),
                UBER_I(_LightingMapMode), UBER_V(_ToonLightSettings).y, visibility);
        vec2 dx = vec2(mapX - uv.x,
            rampDx.y);
        vec2 dy = vec2(mapY - uv.x,
            rampDy.y);
        vec3 ramp = XR_UBER_Sample(UBER_T(_ToonRamp), uv * st.xy + st.zw +
            UBER_V(_ToonRampPan).xy * c.time, dx * st.xy, dy * st.xy, vec4(1.0)).rgb;
        return xrSourceRampDiffuse(base, radiance, ambient, ramp,
            UBER_V(_LightingShadowColor).rgb, UBER_F(_ShadowStrength), mask,
            UBER_F(_LightingIgnoreAmbientColor), XR_UBER_MaterialAo(c));
    }
    int direction = UBER_I(_LightingDirectionMode);
    if (direction == 1) L = N;
    else if (direction == 2) L = V;
    else if (direction == 3) L = vec3(0.0, 1.0, 0.0);
    if (UBER_I(_LightModel) == 0)
        radiance = XR_UBER_LightColor(radiance);
    float nl = dot(N, L), map = XR_UBER_LightMap(nl);
    int mode = UBER_I(_LightingMode);
    vec3 shadowColor = UBER_V(_LightingShadowColor).rgb;
    float strength = UBER_F(_ShadowStrength);
    if (UBER_F(_LightingIgnoreAmbientColor) > 0.0 && mode != 0)
        ambient = mix(ambient, vec3(XR_UBER_Luminance(ambient)), clamp(UBER_F(_LightingIgnoreAmbientColor), 0.0, 1.0));
    if (UBER_F(_LightingIndirectUsesNormals) > 0.0)
        ambient *= mix(0.5, 1.0, N.y * 0.5 + 0.5);
    vec3 color;
    if (mode == 0)
    {
        vec4 st = UBER_V(_ToonRamp_ST);
        vec2 rampUv, rampDx, rampDy;
        XR_UBER_CoverageUv(c, UBER_I(_ToonRampUV), rampUv, rampDx, rampDy);
        vec2 uv = vec2(clamp(map + UBER_F(_ShadowOffset), 0.0, 1.0), rampUv.y);
        vec2 dx = vec2(clamp(XR_UBER_LightMap(dot(normalize(N + Nx), L)) + UBER_F(_ShadowOffset), 0.0, 1.0) - uv.x,
            rampDx.y);
        vec2 dy = vec2(clamp(XR_UBER_LightMap(dot(normalize(N + Ny), L)) + UBER_F(_ShadowOffset), 0.0, 1.0) - uv.x,
            rampDy.y);
        vec3 ramp = XR_UBER_Sample(UBER_T(_ToonRamp), uv * st.xy + st.zw + UBER_V(_ToonRampPan).xy * c.time,
            dx * st.xy, dy * st.xy, vec4(1.0)).rgb;
        vec3 ramped = mix(vec3(1.0), ramp, clamp(strength * mask, 0.0, 1.0));
        vec3 shadow = shadowColor * mix(ambient, base * ramped * radiance, clamp(UBER_F(_LightingIgnoreAmbientColor), 0.0, 1.0));
        color = mix(shadowColor * ambient, mix(shadow, base * radiance, ramped), mix(1.0, visibility, strength));
    }
    else
    {
        float band = 1.0;
        if (mode == 2)
        {
            float wrapped = nl + UBER_F(_LightingWrappedWrap);
            if (UBER_F(_LightingWrappedNormalization) > 0.5) wrapped /= max(1.0 + UBER_F(_LightingWrappedWrap), 1.0e-6);
            band = smoothstep(UBER_F(_LightingGradientStart), UBER_F(_LightingGradientEnd), clamp(wrapped, 0.0, 1.0));
        }
        else if (mode == 5) band = UBER_F(_ForceFlatRampedLightmap) > 0.5 ? step(0.5, map) : 1.0;
        else band = smoothstep(UBER_F(_ShadowBorder) - UBER_F(_ShadowBlur), UBER_F(_ShadowBorder) + UBER_F(_ShadowBlur), map);
        vec3 bandColor = shadowColor;
        if (mode == 4)
        {
            vec4 shadeMap = UBER_SAMPLE(c, _FirstShadeMap, vec4(1.0));
            bandColor = mix(shadowColor, shadeMap.rgb, shadeMap.a);
        }
        vec3 lit = mode == 5 ? radiance * band : mix(radiance * bandColor, radiance, band);
        float engineShadow = clamp(visibility * mask, 0.0, 1.0);
        color = base * lit * mix(1.0, engineShadow, strength) * mix(shadowColor, vec3(1.0), mix(1.0, clamp(band * engineShadow, 0.0, 1.0), strength)) + ambient;
    }
    if (UBER_F(_LightingCapEnabled) > 0.5) color = min(color, base * UBER_F(_LightingCap));
    float luminance = XR_UBER_Luminance(color);
    if (luminance < UBER_F(_LightingMinLightBrightness)) color *= UBER_F(_LightingMinLightBrightness) / max(luminance, 1.0e-6);
    return mix(color, base * XR_UBER_Luminance(color), UBER_F(_LightingMonochromatic));
}

vec3 XR_UBER_Specular(vec3 N, vec3 V, vec3 L, vec3 tangent, vec3 radiance, vec3 tint, float mask)
{
    if (UBER_V(_SecondSpecularSettings).w > 0.5) return vec3(0.0);
    float strength = UBER_I(_PBRPackedMasksEnabled) != 0
        ? mask : UBER_F(_SpecularStrength) * mask * mask;
    if (!XR_UBER_HasFeature(XR_UBER_FEATURE_ADVANCED_SPECULAR) || strength <= 0.0) return vec3(0.0);
    vec3 H = XR_ADV_NormalizeOr(L + V, N);
    float nh = clamp(dot(N, H), 0.0, 1.0), nl = clamp(dot(N, L), 0.0, 1.0);
    float smoothness = clamp(UBER_F(_SpecularSmoothness), 0.0, 1.0);
    float highlight = pow(nh, mix(8.0, 256.0, smoothness));
    if (UBER_I(_SpecularType) == 1)
    {
        float size = mix(0.35, 0.98, smoothness), feather = mix(0.08, 0.005, smoothness);
        highlight = smoothstep(size - feather, size + feather, nh);
    }
    else if (UBER_I(_SpecularType) == 2)
    {
        float th = dot(tangent, H);
        highlight = pow(sqrt(max(0.0, 1.0 - th * th)), mix(8.0, 128.0, smoothness));
    }
    return tint * radiance * highlight * nl * strength * mix(0.5, 2.0, clamp(UBER_F(_StylizedSpecular), 0.0, 1.0));
}

vec3 XR_UBER_ApplyCubemap(XRUberCoordinates c, vec3 N, vec3 V,
    vec3 cameraPosition, float lightMap,
    bool sourceComposition, inout vec3 color, inout vec3 emission)
{
    vec3 direction = reflect(-V, N);
    if (UBER_I(_CubeMapUvMode) == 0) direction = -V;
    else if (UBER_I(_CubeMapUvMode) == 2 || UBER_I(_CubeMapUvMode) == 3) direction = N;
    direction.z *= UBER_F(_CubeMapCoordinateZSign);
    float cubeRoughness = 1.0 - clamp(UBER_F(_CubeMapSmoothness), 0.0, 1.0);
    vec4 cube = XR_UBER_Cube(UBER_T(_CubeMap), direction, cubeRoughness * cubeRoughness * 8.0);
    vec3 environment = cube.rgb * UBER_V(_CubeMapColor).rgb * max(UBER_F(_CubeMapStrength), 0.0);
    float mask = UBER_SAMPLE(c, _CubeMapMask, vec4(1.0))[clamp(UBER_I(_CubeMapMaskChannel), 0, 3)];
    if (sourceComposition && UBER_I(_CubeMapMaskGlobalMask) > 0)
    {
        float globalMask = XR_UBER_GlobalMask(c, UBER_I(_CubeMapMaskGlobalMask),
            uvec4(UBER_T(_GlobalMaskTexture0), UBER_T(_GlobalMaskTexture1),
                UBER_T(_GlobalMaskTexture2), UBER_T(_GlobalMaskTexture3)),
            cameraPosition, N, V);
        mask = XR_UBER_MatcapMaskBlend(mask, globalMask,
            UBER_I(_CubeMapMaskGlobalMaskBlendType));
    }
    mask = mix(mask, 1.0 - mask, clamp(UBER_F(_CubeMapMaskInvert), 0.0, 1.0));
    float lightMask = mix(1.0, clamp(lightMap, 0.0, 1.0), clamp(UBER_F(_CubeMapLightMask), 0.0, 1.0));
    mask = sourceComposition ? min(mask, lightMask) : mask * lightMask;
    float alpha = clamp(mask * cube.a * UBER_F(_CubeMapBlendAmount), 0.0, 1.0);
    if (UBER_I(_CubeMapBlendType) == 1) color *= mix(vec3(1.0), environment, alpha);
    else if (UBER_I(_CubeMapBlendType) == 2) color += environment * alpha;
    else color = mix(color, environment, alpha);
    emission += environment * max(UBER_F(_CubeMapEmissionStrength), 0.0) * mask * cube.a;
    return environment;
}

vec3 XR_UBER_AdvancedPbr(XRUberCoordinates c, vec3 N, vec3 V,
    vec3 cameraPosition, vec3 L, vec3 tangent,
    vec3 bitangent, vec3 lightColor, float lightMap, vec3 specularColor, vec3 color, inout vec3 emission)
{
    if (!XR_UBER_HasFeature(XR_UBER_FEATURE_ADVANCED_PBR)) return color;
    vec3 H = XR_ADV_NormalizeOr(L + V, N);
    float rotation = UBER_F(_AnisotropyRotation) * 6.28318530718;
    vec3 aniso = tangent * cos(rotation) + bitangent * sin(rotation);
    float anisoSpec = pow(clamp(dot(N, XR_ADV_NormalizeOr(H + aniso * UBER_F(_Anisotropy), H)), 0.0, 1.0), mix(8.0, 256.0, clamp(UBER_F(_SpecularSmoothness), 0.0, 1.0)));
    float spec2 = pow(clamp(dot(N, H), 0.0, 1.0), mix(4.0, 512.0, clamp(UBER_F(_Specular2Smoothness), 0.0, 1.0))) * UBER_F(_Specular2Strength);
    color += (UBER_V(_Specular2Color).rgb * spec2 + specularColor * anisoSpec * abs(UBER_F(_Anisotropy))) * lightColor;
    color += pow(clamp(dot(N, H), 0.0, 1.0), mix(16.0, 1024.0, clamp(UBER_F(_ClearCoatSmoothness), 0.0, 1.0))) * clamp(dot(N, L), 0.0, 1.0) * UBER_F(_ClearCoat);
    vec3 environment = vec3(0.0);
    if (UBER_I(_CubeMapToonModel) == 0 && UBER_V(_EnviroRimSettings).x < 0.5)
        environment = XR_UBER_ApplyCubemap(c, N, V, cameraPosition, lightMap,
            false, color, emission);
    vec3 direction = reflect(-V, N);
    if (UBER_I(_CubeMapToonModel) != 0 && UBER_V(_EnviroRimSettings).x < 0.5 &&
        UBER_F(_RimEnviroIntensity) > 0.0)
    {
        if (UBER_I(_CubeMapUvMode) == 0) direction = -V;
        else if (UBER_I(_CubeMapUvMode) == 2 || UBER_I(_CubeMapUvMode) == 3) direction = N;
        direction.z *= UBER_F(_CubeMapCoordinateZSign);
        float cubeRoughness = 1.0 - clamp(UBER_F(_CubeMapSmoothness), 0.0, 1.0);
        environment = XR_UBER_Cube(UBER_T(_CubeMap), direction, cubeRoughness * cubeRoughness * 8.0).rgb *
            UBER_V(_CubeMapColor).rgb * max(UBER_F(_CubeMapStrength), 0.0);
    }
    float rim = pow(1.0 - clamp(dot(N, V), 0.0, 1.0), mix(0.25, 16.0, clamp(UBER_F(_RimEnviroSharpness), 0.0, 1.0)));
    if (UBER_V(_EnviroRimSettings).x < 0.5)
        color += environment * smoothstep(1.0 - UBER_F(_RimEnviroWidth), 1.0, rim) * UBER_F(_RimEnviroIntensity);
    color += UBER_V(_BacklightColor).rgb * clamp(dot(-N, L), 0.0, 1.0) * UBER_SAMPLE(c, _BacklightMask, vec4(1.0)).r * UBER_F(_BacklightStrength);
    return color;
}

vec3 XR_UBER_SourceEnviroRim(XRUberCoordinates c, vec3 N, vec3 V,
    vec3 baseColor, vec3 probeRadiance)
{
    vec4 settings = UBER_V(_EnviroRimSettings);
    if (settings.x < 0.5 || UBER_F(_RimEnviroIntensity) <= 0.0) return vec3(0.0);
    float width = UBER_F(_RimEnviroWidth);
    float edge = clamp(1.0 - smoothstep(min(UBER_F(_RimEnviroSharpness), width),
        width, abs(dot(N, V))), 0.0, 1.0);
    float mask = UBER_SAMPLE(c, _RimEnviroMask, vec4(1.0))[
        clamp(int(settings.w + 0.5), 0, 3)];
    return max((probeRadiance - vec3(settings.z)) * baseColor, vec3(0.0)) *
        edge * mask * UBER_F(_RimEnviroIntensity);
}
#endif
