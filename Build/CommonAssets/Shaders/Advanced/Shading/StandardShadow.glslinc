#ifndef XR_ADVANCED_STANDARD_SHADOW_GLSLINC
#define XR_ADVANCED_STANDARD_SHADOW_GLSLINC

// Values mirror EAdvancedShadowFallbackReason and are also written to the
// shading diagnostic output. Stale tiles retain their rendered projection.
#define XR_ADV_SHADOW_OK 0u
#define XR_ADV_SHADOW_MISSING 1u
#define XR_ADV_SHADOW_STALE_HANDLE 2u
#define XR_ADV_SHADOW_NOT_RESIDENT 3u
#define XR_ADV_SHADOW_UNSUPPORTED 4u
#define XR_ADV_SHADOW_OUTSIDE 5u
#define XR_ADV_SHADOW_STALE_TILE 6u

float XR_ADV_ShadowMomentBound(vec2 moments, float receiver, vec4 parameters)
{
    if (receiver <= moments.x) return 1.0;
    float variance = max(moments.y - moments.x * moments.x, max(parameters.x, 0.0000001));
    float delta = receiver - moments.x;
    float probability = variance / (variance + delta * delta);
    float bleed = clamp(parameters.y, 0.0, 0.999);
    return clamp((probability - bleed) / (1.0 - bleed), 0.0, 1.0);
}

float XR_ADV_CompareShadow(XRAdvancedShadowRecord record, vec4 texel, float receiver)
{
    float depth = clamp(receiver, 0.0, 1.0);
    if (record.encoding == 1u)
        return XR_ADV_ShadowMomentBound(texel.xy, depth, record.momentParameters);
    if (record.encoding == 2u)
        return XR_ADV_ShadowMomentBound(texel.xy,
            exp(clamp(record.momentParameters.z, 0.0, 42.0) * depth), record.momentParameters);
    if (record.encoding == 3u)
    {
        float positive = XR_ADV_ShadowMomentBound(texel.xy,
            exp(clamp(record.momentParameters.z, 0.0, 42.0) * depth), record.momentParameters);
        float negative = XR_ADV_ShadowMomentBound(texel.zw,
            -exp(-clamp(record.momentParameters.w, 0.0, 42.0) * depth), record.momentParameters);
        return min(positive, negative);
    }
    // Point color textures encode radial depth in increasing distance even
    // when their raster depth attachment uses a reversed projection.
    bool reversed = record.type < 2u && (record.flags & 128u) != 0u;
    return reversed ? float(depth >= texel.r) : float(depth <= texel.r);
}

// Grazing receivers are clamped near 84 degrees so the slope term stays finite.
#define XR_ADV_DIRECTIONAL_MAX_SLOPE_TAN 10.0

// Stored shadow depth follows the rasterized triangle, so the receiver slope comes
// from the triangle plane rather than the interpolated or normal-mapped shading
// normal. Plane slope is independent of winding and facing.
vec3 XR_ADV_ShadowReceiverPlaneNormal(XRAdvancedSurface surface, vec3 shadingNormal)
{
    vec3 planeNormal = surface.geometricNormal;
    float lengthSquared = dot(planeNormal, planeNormal);
    return lengthSquared > 1e-12 && !isinf(lengthSquared)
        ? planeNormal * inversesqrt(lengthSquared)
        : shadingNormal;
}

// Directional cascades publish a constant depth floor (x) and normalized depth per
// authored texel of receiver slope (y). Orthographic light space makes the depth
// change across one texel exactly y * tan(theta), the analytic form of the
// derivative-based receiver-plane bias used by raster receivers. The slope uses
// |cos(theta)|: a plane facing away from the light has the same slope as one facing
// it, and treating it as grazing would lift the receiver through thin occluders.
// Other shadow types interpolate their min/max depth bias (x, y) by 1 - N.L.
float XR_ADV_ShadowCompareBias(XRAdvancedShadowRecord record, vec3 N, vec3 planeNormal, vec3 L,
    float footprintTexels)
{
    float constantBias = max(record.depthBiasAndFilter.x, 0.0);
    if (record.type == 0u)
    {
        float planeCos = min(abs(dot(planeNormal, L)), 1.0);
        float tanTheta = sqrt(max(1.0 - planeCos * planeCos, 0.0)) / max(planeCos, 0.0001);
        return constantBias + max(record.depthBiasAndFilter.y, 0.0) * footprintTexels *
            min(tanTheta, XR_ADV_DIRECTIONAL_MAX_SLOPE_TAN);
    }
    float NdotL = clamp(dot(N, L), 0.0, 1.0);
    return mix(constantBias, max(record.depthBiasAndFilter.y, 0.0), 1.0 - NdotL);
}

bool XR_ADV_ShadowAffectsView(XRAdvancedShadowRecord record, XRAdvancedViewRecord view, uint viewIndex)
{
    if (record.type == 0u && (((record.flags & 16u) != 0u) != ((view.flags & 12u) != 0u)))
        return false;
    if ((record.viewMaskLo | record.viewMaskHi) == 0u) return true;
    return viewIndex < 32u ? (record.viewMaskLo & (1u << viewIndex)) != 0u :
        viewIndex < 64u && (record.viewMaskHi & (1u << (viewIndex - 32u))) != 0u;
}

bool XR_ADV_ProjectShadow(XRAdvancedShadowRecord record, vec3 position, out vec3 coordinate)
{
    coordinate = vec3(0.0);
    if (record.type == 3u) return record.renderedLightPositionAndFar.w > 0.0;
    vec4 clip = XR_ADV_TransformRowVector(vec4(position, 1.0), record.worldToShadow);
    if (clip.w <= 0.000001 || any(isnan(clip)) || any(isinf(clip))) return false;
    vec3 ndc = clip.xyz / clip.w;
    coordinate = vec3(ndc.xy * 0.5 + 0.5,
        (record.flags & 32u) != 0u ? ndc.z : ndc.z * 0.5 + 0.5);
    if ((record.flags & 64u) != 0u) coordinate.y = 1.0 - coordinate.y;
    return all(greaterThanEqual(coordinate, vec3(0.0))) && all(lessThanEqual(coordinate, vec3(1.0)));
}

vec4 XR_ADV_FetchShadow(XRAdvancedShadowRecord record, XRAdvancedTextureRecord textureRecord,
    XRAdvancedEncodedTextureReference textureReference, vec2 uv, vec3 direction)
{
    if (textureRecord.dimension == 3u)
        return XR_ADV_SampleTextureCubeLod(textureReference, direction, 0.0);
    if (textureRecord.dimension == 5u)
        return XR_ADV_SampleTexture2DArrayLod(textureReference, vec3(uv, float(record.textureLayer)), 0.0);
    return XR_ADV_SampleTexture2DLod(textureReference, uv, 0.0);
}

// Directional soft-shadow filtering. The record carries the light's filter mode,
// sample counts and radii in tile-local UV, like the forward cascade receivers.
// All modes share one tap loop: the mode only selects the tap pattern, count and
// radius, so the native kernels compile a single filter loop.
#define XR_ADV_MAX_SHADOW_TAPS 32
#define XR_ADV_SHADOW_TAPS_GRID3 0u
#define XR_ADV_SHADOW_TAPS_TENT4 1u
#define XR_ADV_SHADOW_TAPS_POISSON 2u
#define XR_ADV_SHADOW_TAPS_VOGEL 3u

const vec2 XR_ADV_ShadowPoissonDisk[16] = vec2[](
    vec2(-0.94201624, -0.39906216), vec2(0.94558609, -0.76890725),
    vec2(-0.09418410, -0.92938870), vec2(0.34495938, 0.29387760),
    vec2(-0.91588581, 0.45771432), vec2(-0.81544232, -0.87912464),
    vec2(-0.38277543, 0.27676845), vec2(0.97484398, 0.75648379),
    vec2(0.44323325, -0.97511554), vec2(0.53742981, -0.47373420),
    vec2(-0.26496911, -0.41893023), vec2(0.79197514, 0.19090188),
    vec2(-0.24188840, 0.99706507), vec2(-0.81409955, 0.91437590),
    vec2(0.19984126, 0.78641367), vec2(0.14383161, -0.14100790)
);

// The tap rotation and the contact ray jitter use one fixed value. Native shading has
// no stable pixel coordinate, and any hash of the reconstructed receiver position
// changes from frame to frame while the camera moves, which made the filtered
// penumbra boil. A hash of the shadow texel is stable but shows each texel's own
// rotation as square blocks. A fixed rotation keeps the filter locked to the world.
float XR_ADV_ShadowNoise()
{
    return 0.5;
}

vec2 XR_ADV_ShadowTapOffset(uint pattern, int index, int count, float rotation)
{
    if (pattern == XR_ADV_SHADOW_TAPS_GRID3)
        return vec2(float(index % 3 - 1), float(index / 3 - 1));
    if (pattern == XR_ADV_SHADOW_TAPS_TENT4)
        return vec2((index & 1) == 0 ? -0.5 : 0.5, index < 2 ? -0.5 : 0.5);
    if (pattern == XR_ADV_SHADOW_TAPS_POISSON)
        return XR_ADV_ShadowPoissonDisk[index & 15];
    float sampleIndex = float(index) + 0.5;
    float radius = sqrt(sampleIndex / float(max(count, 1)));
    float angle = sampleIndex * 2.39996323 + rotation;
    return vec2(cos(angle), sin(angle)) * radius;
}

float XR_ADV_DirectionalTapDepth(XRAdvancedShadowRecord record, XRAdvancedTextureRecord textureRecord,
    XRAdvancedEncodedTextureReference textureReference, vec2 localUv, vec2 lower, vec2 upper)
{
    vec2 uv = clamp(localUv * record.uvScaleBias.xy + record.uvScaleBias.zw, lower, upper);
    return XR_ADV_FetchShadow(record, textureRecord, textureReference, uv, vec3(0.0)).r;
}

float XR_ADV_DirectionalTapLit(XRAdvancedShadowRecord record, XRAdvancedTextureRecord textureRecord,
    XRAdvancedEncodedTextureReference textureReference, vec2 localUv, vec2 lower, vec2 upper, float receiver)
{
    vec2 uv = clamp(localUv * record.uvScaleBias.xy + record.uvScaleBias.zw, lower, upper);
    return XR_ADV_CompareShadow(record,
        XR_ADV_FetchShadow(record, textureRecord, textureReference, uv, vec3(0.0)), receiver);
}

// Contact-hardening penumbra in tile-local UV, or -1 when no blocker is found.
// The receiver is already biased. Only depth pages hold raw blocker depths.
float XR_ADV_DirectionalPenumbra(XRAdvancedShadowRecord record, XRAdvancedTextureRecord textureRecord,
    XRAdvancedEncodedTextureReference textureReference, vec2 localUv, vec2 lower, vec2 upper,
    float receiver, float localTexel, float rotation)
{
    int samples = clamp(int(record.blockerSamples), 1, XR_ADV_MAX_SHADOW_TAPS);
    float searchRadius = max(record.softShadowParameters.y, localTexel);
    float blockerSum = 0.0;
    int blockerCount = 0;
    for (int i = 0; i < XR_ADV_MAX_SHADOW_TAPS; ++i)
    {
        if (i >= samples) break;
        float depth = XR_ADV_DirectionalTapDepth(record, textureRecord, textureReference,
            localUv + XR_ADV_ShadowTapOffset(XR_ADV_SHADOW_TAPS_VOGEL, i, samples, rotation) * searchRadius,
            lower, upper);
        if (depth < receiver)
        {
            blockerSum += depth;
            ++blockerCount;
        }
    }
    if (blockerCount == 0) return -1.0;
    float blocker = blockerSum / float(blockerCount);
    float penumbra = abs(receiver - blocker) / max(abs(blocker), 0.0001) *
        max(record.contactParameters.x, 0.0);
    float minRadius = max(record.softShadowParameters.z, localTexel);
    return clamp(penumbra, minRadius, max(record.softShadowParameters.w, minRadius));
}

// Mirrors the forward atlas filter selection: Hard uses one tap, a 4-tap tent or a
// 3x3 texel grid by sample count; FixedPoisson uses up to 16 Poisson taps; VogelDisk
// uses its own tap count; ContactHardeningPcss widens a Vogel disk by the blocker
// estimate. Moment pages have no raw blocker depth, so PCSS keeps the fixed radius.
float XR_ADV_SampleDirectionalFiltered(XRAdvancedShadowRecord record, XRAdvancedTextureRecord textureRecord,
    XRAdvancedEncodedTextureReference textureReference, vec2 localUv, vec2 lower, vec2 upper,
    float receiver, float localTexel, float noise)
{
    uint mode = record.softShadowMode;
    int tapCount = clamp(int(record.vogelTapCount), 1, XR_ADV_MAX_SHADOW_TAPS);
    float radius = record.softShadowParameters.x;
    uint pattern = XR_ADV_SHADOW_TAPS_VOGEL;
    float rotation = noise * 6.28318531;
    if (mode != 3u)
    {
        tapCount = clamp(int(record.filterSamples), 1, XR_ADV_MAX_SHADOW_TAPS);
        if (tapCount <= 1)
            return XR_ADV_DirectionalTapLit(record, textureRecord, textureReference, localUv, lower, upper, receiver);
        if (mode == 2u)
        {
            if (record.encoding == 0u)
            {
                radius = XR_ADV_DirectionalPenumbra(record, textureRecord, textureReference,
                    localUv, lower, upper, receiver, localTexel, rotation);
                if (radius < 0.0) return 1.0;
            }
        }
        else if (mode == 1u)
        {
            pattern = XR_ADV_SHADOW_TAPS_POISSON;
            tapCount = min(tapCount, 16);
        }
        else if (tapCount <= 4)
        {
            pattern = XR_ADV_SHADOW_TAPS_TENT4;
            tapCount = 4;
        }
        else
        {
            pattern = XR_ADV_SHADOW_TAPS_GRID3;
            tapCount = 9;
            radius = localTexel;
        }
    }
    radius = max(radius, localTexel);
    float lit = 0.0;
    for (int i = 0; i < XR_ADV_MAX_SHADOW_TAPS; ++i)
    {
        if (i >= tapCount) break;
        lit += XR_ADV_DirectionalTapLit(record, textureRecord, textureReference,
            localUv + XR_ADV_ShadowTapOffset(pattern, i, tapCount, rotation) * radius,
            lower, upper, receiver);
    }
    return lit / float(tapCount);
}

// Short-range contact shadows: march toward the light in the cascade's own depth
// page and darken where a thin occluder lies just above the ray. Mirrors the
// forward shadow-map contact march, including its view-depth sample scaling.
float XR_ADV_DirectionalContactShadow(XRAdvancedShadowRecord record, XRAdvancedTextureRecord textureRecord,
    XRAdvancedEncodedTextureReference textureReference, vec3 position, vec3 N, vec3 L,
    vec2 lower, vec2 upper, float compareBias, float viewDepth, float noise)
{
    float distance = record.contactParameters.y;
    if (record.contactSamples == 0u || distance <= 0.0 || record.encoding > 1u)
        return 1.0;
    float fadeStart = record.contactFadeAndTexel.x;
    float fadeEnd = record.contactFadeAndTexel.y;
    float fade = fadeEnd > fadeStart ? 1.0 - smoothstep(fadeStart, fadeEnd, viewDepth) : 1.0;
    fade *= smoothstep(0.05, 0.35, max(dot(N, L), 0.0));
    if (fade <= 0.0) return 1.0;

    int requested = clamp(int(record.contactSamples), 1, 32);
    float depthScale = clamp((distance * 24.0) / max(viewDepth, distance), 0.35, 1.0);
    int samples = max(1, int(ceil(float(requested) * depthScale)));
    float stepSize = distance / float(samples);
    vec3 origin = position + N * max(max(record.depthBiasAndFilter.z, record.contactParameters.w), compareBias * 2.0);
    float jitter = record.contactFadeAndTexel.z;
    float thicknessScale = record.contactParameters.z;
    float occlusion = 0.0;
    for (int i = 0; i < 32; ++i)
    {
        if (i >= samples) break;
        float travel = (float(i) + 0.5 + (noise - 0.5) * jitter) * stepSize;
        vec3 coordinate;
        if (!XR_ADV_ProjectShadow(record, origin + L * travel, coordinate)) continue;
        float depth = XR_ADV_DirectionalTapDepth(record, textureRecord, textureReference,
            coordinate.xy, lower, upper);
        float blockerDelta = coordinate.z - depth;
        if (blockerDelta <= compareBias) continue;
        float thickness = max(travel * thicknessScale, compareBias * 4.0);
        if (blockerDelta > thickness) continue;
        float depthWeight = 1.0 - smoothstep(compareBias, thickness, blockerDelta);
        occlusion = max(occlusion, depthWeight * (1.0 - travel / distance));
    }
    return 1.0 - occlusion * fade;
}

float XR_ADV_SampleShadowRecord(XRAdvancedShadowRecord record, vec3 position, vec3 N, vec3 planeNormal, vec3 L,
    float viewDepth, out uint reason)
{
    reason = XR_ADV_SHADOW_OK;
    if ((record.flags & 1u) == 0u || (record.lastRenderedFrameLo | record.lastRenderedFrameHi) == 0u)
    {
        reason = XR_ADV_SHADOW_NOT_RESIDENT;
        return 1.0;
    }
    if (record.encoding > 3u || record.type > 3u)
    {
        reason = XR_ADV_SHADOW_UNSUPPORTED;
        return 1.0;
    }
    XRAdvancedTextureRecord textureRecord;
    XRAdvancedEncodedTextureReference textureReference;
    if (!XR_ADV_TryResolveTextureReference(record.textureReference.handle,
        VisibilityTextureLookupSegment, VisibilitySamplerLookupSegment, textureRecord, textureReference))
    {
        reason = XR_ADV_SHADOW_NOT_RESIDENT;
        return 1.0;
    }
    if ((record.type == 3u && textureRecord.dimension != 3u) ||
        (record.type != 3u && textureRecord.dimension != 1u && textureRecord.dimension != 5u) ||
        (textureRecord.dimension == 5u && record.textureLayer >= textureRecord.depthOrLayers) ||
        textureRecord.width == 0u || textureRecord.height == 0u)
    {
        reason = XR_ADV_SHADOW_UNSUPPORTED;
        return 1.0;
    }
    vec3 receiverPosition = position + N * max(record.depthBiasAndFilter.z, 0.0);
    vec3 coordinate;
    if (!XR_ADV_ProjectShadow(record, receiverPosition, coordinate))
    {
        reason = XR_ADV_SHADOW_OUTSIDE;
        return 1.0;
    }
    vec3 radialDirection = receiverPosition - record.renderedLightPositionAndFar.xyz;
    float receiver = coordinate.z;
    if (record.type >= 2u)
    {
        if (record.renderedLightPositionAndFar.w <= 0.0)
        {
            reason = XR_ADV_SHADOW_NOT_RESIDENT;
            return 1.0;
        }
        receiver = length(radialDirection) / record.renderedLightPositionAndFar.w;
    }
    else if (record.encoding != 0u)
    {
        if ((record.flags & 128u) != 0u) receiver = 1.0 - receiver;
        if ((record.flags & 256u) != 0u)
        {
            float nearZ = max(record.depthRangeAndCascade.x, 0.0001);
            float farZ = max(record.depthRangeAndCascade.y, nearZ + 0.0001);
            float linearZ = nearZ * farZ / max(farZ - receiver * (farZ - nearZ), 0.000001);
            receiver = (linearZ - nearZ) / (farZ - nearZ);
        }
    }
    vec2 texelSize = 1.0 / vec2(textureRecord.width, textureRecord.height);
    // Directional cascades filter in tile-local UV with the light's own radius;
    // other types keep the 3x3 kernel with a radius in texels.
    float localTexel = record.contactFadeAndTexel.w > 0.0
        ? record.contactFadeAndTexel.w
        : texelSize.x / max(record.uvScaleBias.x, 0.000001);
    float radius = record.type == 0u
        ? clamp(record.softShadowParameters.x / max(localTexel, 0.0000001), 0.0, 8.0)
        : clamp(record.depthBiasAndFilter.w, 0.0, 8.0);
    // The kernel compares one receiver depth against taps up to sqrt(2) * radius
    // texels away, and the receiver lies up to half a texel from the stored texel center.
    float bias = XR_ADV_ShadowCompareBias(record, N, planeNormal, L, 1.41421356 * (radius + 0.5));
    bool reversed = record.type < 2u && record.encoding == 0u && (record.flags & 128u) != 0u;
    receiver += reversed ? bias : -bias;
    vec2 uv = coordinate.xy * record.uvScaleBias.xy + record.uvScaleBias.zw;
    vec2 lower = record.uvScaleBias.zw + texelSize * 0.5;
    vec2 upper = max(lower, record.uvScaleBias.zw + record.uvScaleBias.xy - texelSize * 0.5);
    float visibility = 0.0;
    if (textureRecord.dimension == 3u)
    {
        vec3 direction = normalize(radialDirection);
        vec3 axis = abs(direction.z) < 0.99 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3 tangent = normalize(cross(axis, direction));
        vec3 bitangent = cross(direction, tangent);
        float angularRadius = 2.0 * radius / float(textureRecord.width);
        for (int y = -1; y <= 1; ++y)
            for (int x = -1; x <= 1; ++x)
                visibility += XR_ADV_CompareShadow(record,
                    XR_ADV_FetchShadow(record, textureRecord, textureReference, vec2(0.0),
                        normalize(direction + angularRadius * (tangent * float(x) + bitangent * float(y)))), receiver);
    }
    else if (record.type == 0u)
    {
        float noise = XR_ADV_ShadowNoise();
        visibility = XR_ADV_SampleDirectionalFiltered(record, textureRecord, textureReference,
            coordinate.xy, lower, upper, receiver, max(localTexel, 0.0000001), noise);
        visibility *= XR_ADV_DirectionalContactShadow(record, textureRecord, textureReference,
            position, N, L, lower, upper, bias, viewDepth, noise);
        if ((record.flags & 4u) != 0u) reason = XR_ADV_SHADOW_STALE_TILE;
        return visibility;
    }
    else
    {
        for (int y = -1; y <= 1; ++y)
            for (int x = -1; x <= 1; ++x)
                visibility += XR_ADV_CompareShadow(record,
                    XR_ADV_FetchShadow(record, textureRecord, textureReference,
                        clamp(uv + vec2(x, y) * texelSize * radius, lower, upper), radialDirection), receiver);
    }
    if ((record.flags & 4u) != 0u) reason = XR_ADV_SHADOW_STALE_TILE;
    return visibility / 9.0;
}

float XR_ADV_EvaluateShadow(XRAdvancedLightRecord light, XRAdvancedSurface surface, vec3 N, vec3 L,
    out uint reason)
{
    reason = XR_ADV_SHADOW_OK;
    if ((light.flags & 2u) == 0u) return 1.0;
    vec3 planeNormal = XR_ADV_ShadowReceiverPlaneNormal(surface, N);
    if (!XR_ADV_IsValidHandle(light.shadowRecord))
    {
        reason = XR_ADV_SHADOW_MISSING;
        return 1.0;
    }
    uint rootIndex = XR_ADV_ResolveHandle(light.shadowRecord, VisibilityShadowLookupSegment.x,
        VisibilityShadowLookupSegment.y, XR_ADV_DIAGNOSTIC_SHADOW);
    if (rootIndex == XR_ADV_INVALID_DENSE_INDEX || rootIndex >= uint(XR_ADV_Shadows.records.length()))
    {
        reason = XR_ADV_SHADOW_STALE_HANDLE;
        return 1.0;
    }
    XRAdvancedShadowRecord root = XR_ADV_Shadows.records[rootIndex];
    if (!XR_ADV_HandleMatches(light.shadowRecord, root.stableShadowId, root.generation) ||
        root.cascadeOffset >= uint(XR_ADV_Shadows.records.length()) || root.cascadeCount == 0u ||
        root.cascadeCount > uint(XR_ADV_Shadows.records.length()) - root.cascadeOffset)
    {
        reason = XR_ADV_SHADOW_STALE_HANDLE;
        return 1.0;
    }
    XRAdvancedViewRecord view = XR_ADV_LoadView(surface.viewIndex);
    float linearDepth = -XR_ADV_TransformRowVector(vec4(surface.worldPosition, 1.0), view.view).z;
    for (uint i = 0u; i < root.cascadeCount; ++i)
    {
        XRAdvancedShadowRecord record = XR_ADV_Shadows.records[root.cascadeOffset + i];
        if (!XR_ADV_ShadowAffectsView(record, view, surface.viewIndex)) continue;
        if ((record.flags & 1u) == 0u || (record.lastRenderedFrameLo | record.lastRenderedFrameHi) == 0u)
        {
            reason = max(reason, XR_ADV_SHADOW_NOT_RESIDENT);
            continue;
        }
        if (record.type == 0u && linearDepth > record.depthRangeAndCascade.z) continue;
        vec3 unusedCoordinate;
        if (!XR_ADV_ProjectShadow(record, surface.worldPosition, unusedCoordinate)) continue;
        float visibility = XR_ADV_SampleShadowRecord(record, surface.worldPosition, N, planeNormal, L, linearDepth, reason);
        if (record.type != 0u) return visibility;
        float blendWidth = max(record.depthRangeAndCascade.w, 0.0);
        if (blendWidth <= 0.0 || linearDepth < record.depthRangeAndCascade.z - blendWidth) return visibility;
        for (uint next = i + 1u; next < root.cascadeCount; ++next)
        {
            XRAdvancedShadowRecord adjacent = XR_ADV_Shadows.records[root.cascadeOffset + next];
            if (adjacent.type != 0u || !XR_ADV_ShadowAffectsView(adjacent, view, surface.viewIndex)) continue;
            if (!XR_ADV_ProjectShadow(adjacent, surface.worldPosition, unusedCoordinate)) continue;
            uint adjacentReason;
            float adjacentVisibility = XR_ADV_SampleShadowRecord(adjacent, surface.worldPosition, N, planeNormal, L, linearDepth, adjacentReason);
            reason = max(reason, adjacentReason);
            return mix(visibility, adjacentVisibility,
                clamp((linearDepth - record.depthRangeAndCascade.z + blendWidth) / blendWidth, 0.0, 1.0));
        }
        return visibility;
    }
    if (reason == XR_ADV_SHADOW_OK) reason = XR_ADV_SHADOW_OUTSIDE;
    return 1.0;
}
#endif