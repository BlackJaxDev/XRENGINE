#version 450
#include "AdvancedShadingInterface.glslinc"
#include "HiddenAreaTiles.glslinc"
#pragma snippet "NormalEncoding"
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
#if defined(XR_ADV_VISIBILITY_ARRAY)
XR_ADV_SHADING_LAYOUT(0) uniform usampler2DArray VisibilityIdentity;
XR_ADV_SHADING_IMAGE(rgba16f, 15) writeonly uniform image2DArray HDRSceneColor;
XR_ADV_SHADING_IMAGE(rg16f, 16) writeonly uniform image2DArray Velocity;
XR_ADV_SHADING_IMAGE(r8, 17) writeonly uniform image2DArray ReactiveMask;
XR_ADV_SHADING_IMAGE(r32ui, 18) writeonly uniform uimage2DArray ShadingDiagnostics;
XR_ADV_SHADING_IMAGE(rgba16f, 51) writeonly uniform image2DArray EmissionColor;
XR_ADV_SHADING_IMAGE(rgba16f, 52) writeonly uniform image2DArray AlbedoOpacity;
XR_ADV_SHADING_IMAGE(rgba16f, 53) writeonly uniform image2DArray Normal;
XR_ADV_SHADING_IMAGE(rgba16f, 54) writeonly uniform image2DArray RMSE;
#define XR_ADV_PIXEL(pixel) ivec3(pixel, u_Push.viewIndex)
#else
XR_ADV_SHADING_LAYOUT(0) uniform usampler2D VisibilityIdentity;
XR_ADV_SHADING_IMAGE(rgba16f, 15) writeonly uniform image2D HDRSceneColor;
XR_ADV_SHADING_IMAGE(rg16f, 16) writeonly uniform image2D Velocity;
XR_ADV_SHADING_IMAGE(r8, 17) writeonly uniform image2D ReactiveMask;
XR_ADV_SHADING_IMAGE(r32ui, 18) writeonly uniform uimage2D ShadingDiagnostics;
XR_ADV_SHADING_IMAGE(rgba16f, 51) writeonly uniform image2D EmissionColor;
XR_ADV_SHADING_IMAGE(rgba16f, 52) writeonly uniform image2D AlbedoOpacity;
XR_ADV_SHADING_IMAGE(rgba16f, 53) writeonly uniform image2D Normal;
XR_ADV_SHADING_IMAGE(rgba16f, 54) writeonly uniform image2D RMSE;
#define XR_ADV_PIXEL(pixel) ivec2(pixel)
#endif
void main()
{
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, u_Push.screenExtent))) return;
    uint drawId = texelFetch(VisibilityIdentity, XR_ADV_PIXEL(pixel), 0).r;
    // The work group is one 16x16 tile, the same tile that classification tests. A hidden-area
    // tile gets no shading, so it is written here as opaque black: alpha 1 keeps the sky pass out,
    // and TSR history, ambient occlusion and bloom read a stable defined value.
    bool hiddenTile = XR_ADV_IsHiddenAreaTile(gl_WorkGroupID.xy);
    bool background = hiddenTile || drawId == 0u || drawId == XR_ADV_VIS_INVALID;
    // Initialize every pixel/sidecar; an invalid non-background material stays
    // visibly diagnostic instead of exposing stale contents from a prior frame.
    vec4 color = hiddenTile ? vec4(0.0, 0.0, 0.0, 1.0)
        : background ? vec4(u_Push.backgroundColor.rgb, 0.0) : vec4(1.0, 0.0, 1.0, 1.0);
    imageStore(HDRSceneColor, XR_ADV_PIXEL(pixel), color);
    // Bit 31 matches XR_ADV_SHADING_DIAGNOSTICS_DISABLED: the diagnostics image is not allocated.
    // A covered pixel starts with the diagnostics of an unresolved material (bit 16, reason
    // 8 = XR_ADV_RECONSTRUCTION_MATERIAL_NOT_RESIDENT in bits 20 and up): this pass is the only
    // writer of such a pixel (see ShadeNativeOpaque.comp), and the shading kernels overwrite
    // every pixel whose material resolves.
    if ((u_Push.flags & (1u << 31u)) == 0u)
        imageStore(ShadingDiagnostics, XR_ADV_PIXEL(pixel), uvec4(background ? 255u << 8u : (1u << 16u) | (8u << 20u)));
    imageStore(Velocity, XR_ADV_PIXEL(pixel), vec4(0.0));
    imageStore(ReactiveMask, XR_ADV_PIXEL(pixel), vec4(background ? 0.0 : 1.0));
    if ((u_Push.flags & 16u) != 0u)
    {
        imageStore(EmissionColor, XR_ADV_PIXEL(pixel), vec4(0.0));
        imageStore(AlbedoOpacity, XR_ADV_PIXEL(pixel), vec4(0.0));
        imageStore(Normal, XR_ADV_PIXEL(pixel), vec4(XRENGINE_EncodeNormal(vec3(0.0, 0.0, 1.0)), 0.0, 1.0));
        imageStore(RMSE, XR_ADV_PIXEL(pixel), vec4(1.0, 0.0, 0.0, 0.0));
    }
}
