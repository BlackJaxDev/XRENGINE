#version 450
#include "Advanced/Classification/ClassificationInterface.glslinc"
#include "Advanced/Lighting/ClusteredLightingInterface.glslinc"
#include "Advanced/Reconstruction/ReconstructSurface.glslinc"
#include "StandardMaterial.glslinc"
#include "StandardPBR.glslinc"
#include "Advanced/Shading/StandardIbl.glslinc"
#include "StandardShadow.glslinc"
#include "AdvancedDecalModifier.glslinc"
#pragma snippet "NormalEncoding"
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#if defined(XR_ADV_VISIBILITY_ARRAY)
XR_ADV_SHADING_LAYOUT(0) uniform usampler2DArray VisibilityIdentity;
XR_ADV_SHADING_LAYOUT(1) uniform usampler2DArray VisibilityMetadata;
XR_ADV_SHADING_LAYOUT(2) uniform sampler2DArray VisibilityDepth;
XR_ADV_SHADING_LAYOUT(50) uniform sampler2DArray AmbientOcclusion;
XR_ADV_SHADING_IMAGE(rgba16f, 15) writeonly uniform image2DArray HDRSceneColor;
XR_ADV_SHADING_IMAGE(rg16f, 16) writeonly uniform image2DArray Velocity;
XR_ADV_SHADING_IMAGE(r8, 17) writeonly uniform image2DArray ReactiveMask;
XR_ADV_SHADING_IMAGE(r32ui, 18) writeonly uniform uimage2DArray ShadingDiagnostics;
XR_ADV_SHADING_IMAGE(rgba16f, 51) writeonly uniform image2DArray EmissionColor;
XR_ADV_SHADING_IMAGE(rgba16f, 52) writeonly uniform image2DArray AlbedoOpacity;
XR_ADV_SHADING_IMAGE(rgba16f, 53) writeonly uniform image2DArray Normal;
XR_ADV_SHADING_IMAGE(rgba16f, 54) writeonly uniform image2DArray RMSE;
#define XR_ADV_PIXEL(pixel, view) ivec3(pixel, view)
#else
XR_ADV_SHADING_LAYOUT(0) uniform usampler2D VisibilityIdentity;
XR_ADV_SHADING_LAYOUT(1) uniform usampler2D VisibilityMetadata;
XR_ADV_SHADING_LAYOUT(2) uniform sampler2D VisibilityDepth;
XR_ADV_SHADING_LAYOUT(50) uniform sampler2D AmbientOcclusion;
XR_ADV_SHADING_IMAGE(rgba16f, 15) writeonly uniform image2D HDRSceneColor;
XR_ADV_SHADING_IMAGE(rg16f, 16) writeonly uniform image2D Velocity;
XR_ADV_SHADING_IMAGE(r8, 17) writeonly uniform image2D ReactiveMask;
XR_ADV_SHADING_IMAGE(r32ui, 18) writeonly uniform uimage2D ShadingDiagnostics;
XR_ADV_SHADING_IMAGE(rgba16f, 51) writeonly uniform image2D EmissionColor;
XR_ADV_SHADING_IMAGE(rgba16f, 52) writeonly uniform image2D AlbedoOpacity;
XR_ADV_SHADING_IMAGE(rgba16f, 53) writeonly uniform image2D Normal;
XR_ADV_SHADING_IMAGE(rgba16f, 54) writeonly uniform image2D RMSE;
#define XR_ADV_PIXEL(pixel, view) ivec2(pixel)
#endif

#include "ShadeNativeOpaqueEvaluator.glslinc"

void main()
{
#if defined(XR_ADV_SHADING_ADDRESS_ROOT_VERSION)
    u_Push = XR_ADV_LoadShadingParameters();
#endif
    bool repair = (u_Push.flags & XR_ADV_SHADING_REPAIR) != 0u;
    bool overflow = XR_ADV_ClassificationCounters.counters.overflowFlags != 0u;
    if (repair != overflow) return;

    uvec2 pixel;
    uint viewIndex = u_Push.viewIndex;
    uint kernelTileFlags = 0u;
    if (repair)
        pixel = gl_GlobalInvocationID.xy;
    else
    {
        if (u_Push.kernelIndex >= XR_ADV_MAX_SHADING_KERNELS) return;
        uint localTile = gl_WorkGroupID.x + gl_WorkGroupID.y * 65535u;
        uint tileCapacity = XR_ADV_TotalTileCount();
        uint membershipCapacity = min(u_Push.maxKernelTiles,
            uint(XR_ADV_KernelTiles.records.length()));
        if (tileCapacity == 0u || u_Push.kernelIndex > membershipCapacity / tileCapacity) return;
        uint rangeBase = u_Push.kernelIndex * tileCapacity;
        uint rangeCapacity = min(tileCapacity, membershipCapacity - rangeBase);
        if (localTile >= min(XR_ADV_KernelCounts.counts[u_Push.kernelIndex], rangeCapacity)) return;
        uint membership = rangeBase + localTile;
        XRAdvancedKernelTile kernelTile = XR_ADV_KernelTiles.records[membership];
        if (kernelTile.shadingKernelId != u_Push.kernelIndex) return;
        kernelTileFlags = kernelTile.flags;
        if (kernelTile.activeTileIndex >= min(
            XR_ADV_ClassificationCounters.counters.activeTileCount,
            uint(XR_ADV_ActiveTiles.records.length()))) return;
        XRAdvancedActiveTile tile = XR_ADV_ActiveTiles.records[kernelTile.activeTileIndex];
        viewIndex = tile.viewIndex;
        // Vulkan binds one frozen 2D image view at a time. A shared compact
        // work list may contain other eyes, which must never touch this layer.
        if (viewIndex != u_Push.viewIndex) return;
        pixel = uvec2(tile.packedTileCoord & 0xFFFFu,
            tile.packedTileCoord >> 16u) * 16u + gl_LocalInvocationID.xy;
    }
    if (any(greaterThanEqual(pixel, u_Push.screenExtent)) || viewIndex >= u_Push.viewCount) return;

    XR_ADV_StoreNeutralMaterialSurfaceInputs(pixel, viewIndex);
    uvec2 identity = texelFetch(VisibilityIdentity, XR_ADV_PIXEL(pixel, viewIndex), 0).rg;
    if (identity.x == 0u || identity.x == XR_ADV_VIS_INVALID) return;

    uint metadata = texelFetch(VisibilityMetadata, XR_ADV_PIXEL(pixel, viewIndex), 0).r;
    uint materialDense, kernelDense;
    bool resolved = XR_ADV_TryResolvePixelMaterial(identity, metadata, materialDense, kernelDense);
    if (!repair && resolved && kernelDense != u_Push.kernelIndex) return;
    if (!repair && resolved)
    {
        bool requiresAnalyticalDerivatives =
            (XR_ADV_LoadShadingKernel(kernelDense).requiredAttributeMask &
                XR_ADV_KERNEL_REQUIRED_ANALYTICAL_DERIVATIVES) != 0u;
        bool hasAnalyticalDerivatives =
            (kernelTileFlags & XR_ADV_KERNEL_TILE_ANALYTICAL_DERIVATIVES) != 0u;
        if (requiresAnalyticalDerivatives != hasAnalyticalDerivatives) return;
    }

    float depth = texelFetch(VisibilityDepth, XR_ADV_PIXEL(pixel, viewIndex), 0).r;
    float ambientOcclusion = texelFetch(AmbientOcclusion, XR_ADV_PIXEL(pixel, viewIndex), 0).r;
    XRAdvancedOpaqueSampleResult result;
    XR_ADV_EvaluateNativeOpaqueSample(
        pixel,
        viewIndex,
        identity,
        metadata,
        depth,
        vec2(pixel) + 0.5,
        ambientOcclusion,
        repair,
        kernelTileFlags,
        true,
        result);
    XR_ADV_StoreOpaqueSampleResult(pixel, viewIndex, result);
}
