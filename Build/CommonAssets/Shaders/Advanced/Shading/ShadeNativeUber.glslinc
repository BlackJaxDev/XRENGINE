            else if (slot == 2)
            {
                texSlot = UBER_T(_Emission2Tex); maskSlot = UBER_T(_Emission2Mask);
                texSt = UBER_V(_Emission2Tex_ST); maskSt = UBER_V(_Emission2Mask_ST);
                slotColor = UBER_V(_EmissionSlotColor2); slotParams = UBER_V(_EmissionSlotParams2);
                slotPan = UBER_V(_EmissionSlotPan2).xy; slotUv = UBER_I(_EmissionSlotUv2);
                maskPan = UBER_V(_Emission2MaskPan).xy; maskUv = UBER_I(_Emission2MaskUV);
                centerOutSpeed = UBER_F(_EmissionSlotCenterOutSpeed2);
                slotModifiers = UBER_V(_EmissionSlotModifiers2); slotSampling = UBER_V(_EmissionSlotSampling2);
            }
            else
            {
                texSlot = UBER_T(_Emission3Tex); maskSlot = UBER_T(_Emission3Mask);
                texSt = UBER_V(_Emission3Tex_ST); maskSt = UBER_V(_Emission3Mask_ST);
                slotColor = UBER_V(_EmissionSlotColor3); slotParams = UBER_V(_EmissionSlotParams3);
                slotPan = UBER_V(_EmissionSlotPan3).xy; slotUv = UBER_I(_EmissionSlotUv3);
                maskPan = UBER_V(_Emission3MaskPan).xy; maskUv = UBER_I(_Emission3MaskUV);
                centerOutSpeed = UBER_F(_EmissionSlotCenterOutSpeed3);
                slotModifiers = UBER_V(_EmissionSlotModifiers3); slotSampling = UBER_V(_EmissionSlotSampling3);
            }
            XR_UBER_EmissionSlot(c, texSlot, maskSlot, texSt, maskSt, slotColor, slotParams,
                slotPan, slotUv, maskPan, maskUv, centerOutSpeed, slotModifiers, slotSampling,
                primaryColor, view.cameraPositionAndNear.xyz, N, Nx, Ny, V, Vx, Vy, base.rgb, emission);
        }
    }
    else if (XR_UBER_HasFeature(XR_UBER_FEATURE_EMISSION))
        emission += UBER_SAMPLE(c, _EmissionMap, vec4(1.0)).rgb * XR_UBER_Theme(UBER_I(_EmissionColorThemeIndex), UBER_V(_EmissionColor).rgb) * max(UBER_F(_EmissionStrength), 0.0);
    vec3 glitter = XR_UBER_Glitter(c, N, V);
    emission += glitter;
    // The post-processing stage adjusts the lit color only. Emission is added after it.
    if (XR_UBER_HasFeature(XR_UBER_FEATURE_SURFACE_EXTENSIONS))
        color = XR_UBER_ApplyPostProcess(color);
    color += emission;
    uint debugView = (u_Push.flags >> 8u) & 255u;
    if (debugView == 3u) color = emission;
    else if (debugView == 5u) color = vec3(shadowVisibility);
    else if (debugView == 6u) color = N * 0.5 + 0.5;
    else if (debugView == 7u) color = vec3(roughness);
    else if (debugView == 8u) color = vec3(metallic);
    else if (debugView == 10u) color = vec3(ao);
    vec3 safeColor = mix(max(color, vec3(0.0)), vec3(0.0), bvec3(isnan(color.x) || isinf(color.x), isnan(color.y) || isinf(color.y), isnan(color.z) || isinf(color.z)));
    vec3 safeEmission = mix(max(emission, vec3(0.0)), vec3(0.0), bvec3(isnan(emission.x) || isinf(emission.x), isnan(emission.y) || isinf(emission.y), isnan(emission.z) || isinf(emission.z)));
    result.radiance = safeColor; result.opacity = base.a;
    result.velocity = surface.motionNdc;
    bool animatedCutout = (surface.flags & XR_ADV_SURFACE_MASKED_EDGE) != 0u &&
        ((XR_UBER_HasFeature(XR_UBER_FEATURE_DISSOLVE) && UBER_F(_DissolveProgress) > 0.0) ||
         (XR_UBER_HasFeature(XR_UBER_FEATURE_ALPHA_MASKS) && UBER_I(_MainAlphaMaskMode) > 0 &&
          dot(UBER_V(_AlphaMaskPan).xy, UBER_V(_AlphaMaskPan).xy) > 0.0));
    result.reactive = ((surface.flags & XR_ADV_SURFACE_REACTIVE) != 0u || animatedCutout) ? 1.0 : 0.0;
    result.diagnostics = shadowReason | (uint(round(clamp(shadowVisibility, 0.0, 1.0) * 255.0)) << 8u);
    result.emittedRadiance = safeEmission; result.albedoOpacity = base; result.normal = N;
    result.rmse = vec4(roughness, metallic, UBER_F(_SpecularStrength), 0.0);
    result.roughness = roughness; result.metallic = metallic; result.hasMaterialSurface = 1u;
}
#endif
