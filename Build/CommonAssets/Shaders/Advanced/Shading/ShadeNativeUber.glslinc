#ifndef XR_SHADE_NATIVE_UBER_GLSLINC
#define XR_SHADE_NATIVE_UBER_GLSLINC
#include "Advanced/Shading/NativeUberLighting.glslinc"

float XR_UBER_SourceStylizedSpecularTerms(XRUberCoordinates c,
    vec3 vertexNormal, vec3 mappedNormal, vec3 mappedNormalDx,
    vec3 mappedNormalDy, vec3 viewDirection, vec3 viewDx, vec3 viewDy,
    vec3 lightDirection, vec3 directColor, float lightMap,
    float attenuation, float visibility, float occlusion, out vec3 highlight)
{
    highlight = vec3(0.0);
    vec4 settings = UBER_V(_StylizedSpecularSettings);
    if (settings.x <= 0.5)
        return 0.0;

    vec4 highSt = UBER_V(_HighColorTex_ST);
    vec4 maskSt = UBER_V(_HighColorMask_ST);
    vec3 highColor = XR_UBER_Sample(UBER_T(_HighColorTex),
        c.uv0 * highSt.xy + highSt.zw, c.uv0Dx * highSt.xy,
        c.uv0Dy * highSt.xy, vec4(1.0)).rgb;
    vec4 sampledMask = XR_UBER_Sample(UBER_T(_HighColorMask),
        c.uv0 * maskSt.xy + maskSt.zw, c.uv0Dx * maskSt.xy,
        c.uv0Dy * maskSt.xy, vec4(1.0));
    vec4 maskSettings = UBER_V(_StylizedSpecularMask);
    float mask = sampledMask[clamp(int(maskSettings.w + 0.5), 0, 3)];

    vec3 halfDirection = normalize(lightDirection + viewDirection);
    vec3 normal = normalize(mix(vertexNormal, mappedNormal, settings.z));
    float area = 0.5 * dot(normal, halfDirection) + 0.5;
    vec3 normalX = normalize(mix(vertexNormal, mappedNormal + mappedNormalDx,
        settings.z));
    vec3 normalY = normalize(mix(vertexNormal, mappedNormal + mappedNormalDy,
        settings.z));
    float areaX = 0.5 * dot(normalX,
        normalize(lightDirection + viewDirection + viewDx)) + 0.5;
    float areaY = 0.5 * dot(normalY,
        normalize(lightDirection + viewDirection + viewDy)) + 0.5;
    float footprint = abs(areaX - area) + abs(areaY - area);
    return xrSourceStylizedSpecularTerms(vertexNormal, mappedNormal,
        viewDirection, lightDirection, directColor, lightMap, attenuation,
        visibility, occlusion, mask, footprint, highColor,
        UBER_V(_StylizedSpecularTint), settings,
        UBER_V(_StylizedSpecularLayers), maskSettings,
        UBER_V(_StylizedSpecularOcclusion), highlight);
}

// Applies the stylized specular of one light. In add mode (1) it returns the term to add
// after lighting. In the other modes it changes baseColor, which the caller then lights
// with the same light, and it returns zero.
vec3 XR_UBER_ApplySourceStylizedSpecular(XRUberCoordinates c,
    vec3 vertexNormal, vec3 mappedNormal, vec3 mappedNormalDx,
    vec3 mappedNormalDy, vec3 viewDirection, vec3 viewDx, vec3 viewDy,
    vec3 lightDirection, vec3 directColor, float lightMap,
    float attenuation, float visibility, float occlusion, inout vec3 baseColor)
{
    vec3 highlight;
    float mask = XR_UBER_SourceStylizedSpecularTerms(c, vertexNormal, mappedNormal,
        mappedNormalDx, mappedNormalDy, viewDirection, viewDx, viewDy,
        lightDirection, directColor, lightMap, attenuation, visibility, occlusion,
        highlight);
    int blendMode = UBER_I(_StylizedSpecularBlend);
    if (blendMode == 1)
        return max(highlight * mask, vec3(0.0));
    baseColor = xrSourceStylizedSpecularBase(baseColor, highlight, mask, blendMode);
    return vec3(0.0);
}

// Loops over the four matcap slots through one XR_UBER_Matcap call site so shader
// compilers do not inline eight copies of matcap evaluation across pre- and post-lighting.
void XR_UBER_ApplyMatcapSlots(
    XRUberCoordinates c,
    vec3 geometric,
    vec3 geometricDx,
    vec3 geometricDy,
    vec3 N,
    vec3 Nx,
    vec3 Ny,
    vec3 tangent,
    vec3 bitangent,
    vec3 V,
    vec3 Vx,
    vec3 Vy,
    vec3 cameraPosition,
    mat3 viewRotation,
    vec3 primaryLightColor,
    float matcapLightMap,
    inout vec3 target,
    inout vec3 emission,
    inout vec3 matcapLightAdd)
{
    uvec4 globalMasks = uvec4(UBER_T(_GlobalMaskTexture0), UBER_T(_GlobalMaskTexture1),
        UBER_T(_GlobalMaskTexture2), UBER_T(_GlobalMaskTexture3));
    uint normalMapSlot = UBER_T(_Matcap1NormalMap);
    vec4 normalMapSt = UBER_V(_Matcap1NormalMap_ST);
    vec2 normalMapPan = UBER_V(_Matcap1NormalMapPan).xy;
    for (int slot = 0; slot < 4; ++slot)
    {
        uint texSlot;
        uint maskSlot;
        int themeIndex;
        vec4 rawColor;
        vec4 params;
        vec4 extra;
        vec4 blend;
        vec4 source;
        vec4 mask;
        vec4 uvBlend;
        vec4 uvControl;
        float rotation;
        vec4 hue;
        vec4 audioBands;
        vec2 audioAlpha;
        vec2 audioEmission;
        vec2 audioIntensity;
        vec4 texSt;
        vec2 texPan;
        vec4 maskSt;
        vec2 maskPan;
        if (slot == 0)
        {
            texSlot = UBER_T(_Matcap0Tex); maskSlot = UBER_T(_Matcap0Mask);
            themeIndex = UBER_I(_MatcapSlotTheme0); rawColor = UBER_V(_MatcapSlotColor0);
            params = UBER_V(_MatcapSlotParams0); extra = UBER_V(_MatcapSlotExtra0);
            blend = UBER_V(_MatcapSlotBlend0); source = UBER_V(_MatcapSlotSource0);
            mask = UBER_V(_MatcapSlotMask0); uvBlend = UBER_V(_MatcapSlotUvBlend0);
            uvControl = UBER_V(_MatcapSlotUvControl0); rotation = UBER_F(_MatcapSlotRotation0);
            hue = UBER_V(_MatcapSlotHue0); audioBands = UBER_V(_MatcapSlotAudioBands0);
            audioAlpha = UBER_V(_MatcapSlotAudioAlpha0).xy;
            audioEmission = UBER_V(_MatcapSlotAudioEmission0).xy;
            audioIntensity = UBER_V(_MatcapSlotAudioIntensity0).xy;
            texSt = UBER_V(_Matcap0Tex_ST); texPan = UBER_V(_Matcap0TexPan).xy;
            maskSt = UBER_V(_Matcap0Mask_ST); maskPan = UBER_V(_Matcap0MaskPan).xy;
        }
        else if (slot == 1)
        {
            texSlot = UBER_T(_Matcap1Tex); maskSlot = UBER_T(_Matcap1Mask);
            themeIndex = UBER_I(_MatcapSlotTheme1); rawColor = UBER_V(_MatcapSlotColor1);
            params = UBER_V(_MatcapSlotParams1); extra = UBER_V(_MatcapSlotExtra1);
            blend = UBER_V(_MatcapSlotBlend1); source = UBER_V(_MatcapSlotSource1);
            mask = UBER_V(_MatcapSlotMask1); uvBlend = UBER_V(_MatcapSlotUvBlend1);
            uvControl = UBER_V(_MatcapSlotUvControl1); rotation = UBER_F(_MatcapSlotRotation1);
            hue = UBER_V(_MatcapSlotHue1); audioBands = UBER_V(_MatcapSlotAudioBands1);
            audioAlpha = UBER_V(_MatcapSlotAudioAlpha1).xy;
            audioEmission = UBER_V(_MatcapSlotAudioEmission1).xy;
            audioIntensity = UBER_V(_MatcapSlotAudioIntensity1).xy;
            texSt = UBER_V(_Matcap1Tex_ST); texPan = UBER_V(_Matcap1TexPan).xy;
            maskSt = UBER_V(_Matcap1Mask_ST); maskPan = UBER_V(_Matcap1MaskPan).xy;
        }
        else if (slot == 2)
        {
            texSlot = UBER_T(_Matcap2Tex); maskSlot = UBER_T(_Matcap2Mask);
            themeIndex = UBER_I(_MatcapSlotTheme2); rawColor = UBER_V(_MatcapSlotColor2);
            params = UBER_V(_MatcapSlotParams2); extra = UBER_V(_MatcapSlotExtra2);
            blend = UBER_V(_MatcapSlotBlend2); source = UBER_V(_MatcapSlotSource2);
            mask = UBER_V(_MatcapSlotMask2); uvBlend = UBER_V(_MatcapSlotUvBlend2);
            uvControl = UBER_V(_MatcapSlotUvControl2); rotation = UBER_F(_MatcapSlotRotation2);
            hue = UBER_V(_MatcapSlotHue2); audioBands = UBER_V(_MatcapSlotAudioBands2);
            audioAlpha = UBER_V(_MatcapSlotAudioAlpha2).xy;
            audioEmission = UBER_V(_MatcapSlotAudioEmission2).xy;
            audioIntensity = UBER_V(_MatcapSlotAudioIntensity2).xy;
            texSt = UBER_V(_Matcap2Tex_ST); texPan = UBER_V(_Matcap2TexPan).xy;
            maskSt = UBER_V(_Matcap2Mask_ST); maskPan = UBER_V(_Matcap2MaskPan).xy;
        }
        else
        {
            texSlot = UBER_T(_Matcap3Tex); maskSlot = UBER_T(_Matcap3Mask);
            themeIndex = UBER_I(_MatcapSlotTheme3); rawColor = UBER_V(_MatcapSlotColor3);
            params = UBER_V(_MatcapSlotParams3); extra = UBER_V(_MatcapSlotExtra3);
            blend = UBER_V(_MatcapSlotBlend3); source = UBER_V(_MatcapSlotSource3);
            mask = UBER_V(_MatcapSlotMask3); uvBlend = UBER_V(_MatcapSlotUvBlend3);
            uvControl = UBER_V(_MatcapSlotUvControl3); rotation = UBER_F(_MatcapSlotRotation3);
            hue = UBER_V(_MatcapSlotHue3); audioBands = UBER_V(_MatcapSlotAudioBands3);
            audioAlpha = UBER_V(_MatcapSlotAudioAlpha3).xy;
            audioEmission = UBER_V(_MatcapSlotAudioEmission3).xy;
            audioIntensity = UBER_V(_MatcapSlotAudioIntensity3).xy;
            texSt = UBER_V(_Matcap3Tex_ST); texPan = UBER_V(_Matcap3TexPan).xy;
            maskSt = UBER_V(_Matcap3Mask_ST); maskPan = UBER_V(_Matcap3MaskPan).xy;
        }
        XR_UBER_Matcap(c, geometric, geometricDx, geometricDy, N, Nx, Ny, tangent, bitangent,
            V, Vx, Vy, cameraPosition, viewRotation, primaryLightColor, matcapLightMap,
            texSlot, maskSlot, normalMapSlot, globalMasks,
            vec4(XR_UBER_Theme(themeIndex, rawColor.rgb), rawColor.a),
            params, extra, blend, source, mask, uvBlend, uvControl, rotation, hue,
            audioBands, audioAlpha, audioEmission, audioIntensity,
            texSt, texPan, maskSt, maskPan, normalMapSt, normalMapPan,
            target, emission, matcapLightAdd);
    }
}

void XR_UBER_Shade(uvec2 pixel, XRAdvancedSurface surface, XRAdvancedViewRecord view,
    XRAdvancedMaterialRecord material, float screenAo, inout XRAdvancedOpaqueSampleResult result)
{
    XR_UBER_Material = material;
    vec2 upscaleDerivativeScale = XR_ADV_UpscaleDerivativeScale(view);
    XRUberCoordinates c;
    c.uv0 = surface.texCoord0; c.uv1 = surface.texCoord1;
    c.uv2 = surface.texCoord2; c.uv3 = surface.texCoord3;
    c.uv0Dx = surface.texCoord0Dx * upscaleDerivativeScale.x; c.uv0Dy = surface.texCoord0Dy * upscaleDerivativeScale.y;
    c.uv1Dx = surface.texCoord1Dx * upscaleDerivativeScale.x; c.uv1Dy = surface.texCoord1Dy * upscaleDerivativeScale.y;
    c.uv2Dx = surface.texCoord2Dx * upscaleDerivativeScale.x; c.uv2Dy = surface.texCoord2Dy * upscaleDerivativeScale.y;
    c.uv3Dx = surface.texCoord3Dx * upscaleDerivativeScale.x; c.uv3Dy = surface.texCoord3Dy * upscaleDerivativeScale.y;
    c.worldPosition = surface.worldPosition; c.localPosition = surface.localPosition;
    c.flatNormal = vec3(0.0);
    if (UBER_I(_LightingMode) == 1 &&
        UBER_I(_LightModel) == 1 &&
        XR_UBER_HasFeature(XR_UBER_FEATURE_ADVANCED_STYLIZED_LIGHTING) &&
        UBER_V(_MultilayerOptions).y > 0.5)
    {
        uint drawDense = XR_ADV_ResolveVisibilityStableIndex(surface.identity.x,
            VisibilityDrawLookupSegment, XR_ADV_DIAGNOSTIC_DRAW);
        if (drawDense == XR_ADV_INVALID_DENSE_INDEX ||
            drawDense >= uint(XR_ADV_Draws.records.length()))
        {
            result.radiance = vec3(1.0, 0.0, 1.0);
            result.opacity = 1.0;
            result.reactive = 1.0;
            result.diagnostics = 1u << 17u;
            return;
        }
        XRAdvancedDrawRecord draw = XR_ADV_LoadDraw(drawDense);
        if (draw.sourceFlatDirectionValid == 0u)
        {
            result.radiance = vec3(1.0, 0.0, 1.0);
            result.opacity = 1.0;
            result.reactive = 1.0;
            result.diagnostics = 1u << 17u;
            return;
        }
        c.flatNormal = XR_ADV_DecodeOct(draw.sourceFlatDirectionOct);
    }
    c.color = surface.color0;
    c.frontFacing = (surface.flags & XR_ADV_SURFACE_BACK_FACING) == 0u;
    c.time = uintBitsToFloat(view.renderTimeBits);
    c.pixel = vec2(pixel) + 0.5;
    vec4 base;
    vec3 emission;
    // Alpha-to-coverage materials already resolved per-sample cutoff acceptance in
    // VisibilityRasterMasked.frag; retain edge samples whose alpha is below _Cutoff.
    bool coverageKept = XR_UBER_EvaluateCoverage(c, base, emission, false);
    if (coverageKept && !XR_UBER_HasAlphaToCoverage())
    {
        int blendMode = UBER_I(_Mode);
        bool alphaClipMode = blendMode == 1 || blendMode == 2 || blendMode == 5 ||
            UBER_F(_AlphaClipAllModes) > 0.5;
        coverageKept = !alphaClipMode || base.a >= UBER_F(_Cutoff);
    }
    if (!coverageKept)
    {
        // Raster coverage must reject the same sample before it writes depth.
        result.diagnostics = 1u << 18u;
        result.reactive = 1.0;
        return;
    }
    base.rgb = XR_UBER_DetailColor(c, base.rgb);
    float backFacing = c.frontFacing ? 1.0 : -1.0;
    float facing = UBER_I(_BackfaceNormalControl) == 0 || UBER_I(_FlipBackfaceNormals) != 0
        ? backFacing : 1.0;
    float frameFacing = UBER_I(_BackfaceNormalControl) != 0 && UBER_I(_FlipBackfaceNormals) != 0
        ? backFacing : 1.0;
    vec3 geometric = surface.shadingNormal * facing;
    XRUberCoordinates cx = c, cy = c;
    cx.uv0 += c.uv0Dx; cx.uv1 += c.uv1Dx;
    cx.uv2 += c.uv2Dx; cx.uv3 += c.uv3Dx;
    cy.uv0 += c.uv0Dy; cy.uv1 += c.uv1Dy;
    cy.uv2 += c.uv2Dy; cy.uv3 += c.uv3Dy;
    cx.worldPosition += surface.worldPositionDx;
    cy.worldPosition += surface.worldPositionDy;
    vec3 geometricX = XR_ADV_NormalizeOr(surface.shadingNormal + surface.shadingNormalDx, surface.shadingNormal);
    vec3 geometricY = XR_ADV_NormalizeOr(surface.shadingNormal + surface.shadingNormalDy, surface.shadingNormal);
    vec3 tangentX = XR_ADV_NormalizeOr(surface.tangent + surface.tangentDx, surface.tangent) * frameFacing;
    vec3 tangentY = XR_ADV_NormalizeOr(surface.tangent + surface.tangentDy, surface.tangent) * frameFacing;
    vec3 bitangentX = XR_ADV_NormalizeOr(cross(geometricX, tangentX), surface.bitangent) * surface.tangentHandedness;
    vec3 bitangentY = XR_ADV_NormalizeOr(cross(geometricY, tangentY), surface.bitangent) * surface.tangentHandedness;
    // Evaluate center and finite-difference normals through one XR_UBER_Normal call site.
    vec3 N = geometric, Nx = vec3(0.0), Ny = vec3(0.0);
    for (int axis = 0; axis < 3; ++axis)
    {
        XRUberCoordinates sampleCoords = axis == 0 ? c : (axis == 1 ? cx : cy);
        vec3 sampleGeo = axis == 0 ? geometric : (axis == 1 ? geometricX * facing : geometricY * facing);
        vec3 sampleTan = axis == 0 ? surface.tangent * frameFacing : (axis == 1 ? tangentX : tangentY);
        vec3 sampleBit = axis == 0 ? surface.bitangent * frameFacing : (axis == 1 ? bitangentX : bitangentY);
        vec3 sampledNormal = XR_UBER_Normal(sampleCoords, sampleGeo, sampleTan, sampleBit);
        if (axis == 0) N = sampledNormal;
        else if (axis == 1) Nx = sampledNormal - N;
        else Ny = sampledNormal - N;
    }
    vec3 toCamera = view.cameraPositionAndNear.xyz - surface.worldPosition;
    vec3 V = XR_ADV_NormalizeOr(toCamera, vec3(0.0, 0.0, 1.0));
    if (XR_UBER_HasFeature(XR_UBER_FEATURE_EXTENDED_EFFECTS) && UBER_I(_ProceduralMode) == 6)
    {
        // The procedural eye is unlit. It replaces the lit result with its own color.
        mat3 eyeTbn = mat3(surface.tangent * frameFacing, surface.bitangent * frameFacing, geometric);
        vec3 tangentView = transpose(eyeTbn) * V;
        float viewLength = length(tangentView);
        vec3 tangentViewNorm = viewLength > 1.0e-5 ? tangentView / viewLength : vec3(0.0, 0.0, 1.0);
        // The engine bitangent points along +V, and the eye math uses the source V direction.
        tangentViewNorm.y = -tangentViewNorm.y;
        vec3 eyeColor = max(xrEvaluateProceduralEye(
            c.uv0,
            UBER_V(_MainTex_ST),
            tangentViewNorm,
            UBER_V(_ProceduralColor).rgb,
            UBER_V(_ProceduralEyeParams0),
            UBER_V(_ProceduralEyeParams1),
            UBER_V(_ProceduralEyeParams2),
            UBER_V(_ProceduralEyeParams3),
            c.time), vec3(0.0));
        result.radiance = eyeColor;
        result.opacity = base.a;
        result.velocity = surface.motionNdc;
        result.reactive = (surface.flags & (XR_ADV_SURFACE_REACTIVE | XR_ADV_SURFACE_MASKED_EDGE)) != 0u ? 1.0 : 0.0;
        result.diagnostics = 0u;
        result.emittedRadiance = eyeColor;
        result.albedoOpacity = vec4(eyeColor, base.a);
        result.normal = N;
        result.rmse = vec4(1.0, 0.0, 0.0, 0.0);
        result.roughness = 1.0;
        result.metallic = 0.0;
        result.hasMaterialSurface = 1u;
        return;
    }
    vec3 Vx = XR_ADV_NormalizeOr(toCamera - surface.worldPositionDx, V) - V;
    vec3 Vy = XR_ADV_NormalizeOr(toCamera - surface.worldPositionDy, V) - V;
    bool stylized = XR_UBER_HasFeature(XR_UBER_FEATURE_STYLIZED_SHADING) && UBER_I(_LightingMode) != 6;
    float shadowMask = XR_UBER_ShadowMask(c);
    vec3 primaryL = vec3(0.0, 1.0, 0.0), primaryColor = vec3(0.0);
    float primaryVisibility = 1.0;
    // The unmodified shadow of the primary directional light. The light loop below visits
    // the same light again with the same direction, so it reuses this value instead of a
    // second soft-shadow filter.
    float primaryShadow = 1.0;
    uint primary = 0xffffffffu;
    uint count = min(u_Push.lightCount, uint(XR_ADV_Lights.records.length()));
    for (uint index = 0u; index < count; ++index)
        if (XR_ADV_Lights.records[index].type == 0u && XR_ADV_LightAffectsView(XR_ADV_Lights.records[index], surface.viewIndex)) { primary = index; break; }
    if (primary != 0xffffffffu)
    {
        XRAdvancedLightRecord light = XR_ADV_LoadLight(primary);
        primaryL = normalize(-light.directionAndOuterCone.xyz);
        primaryColor = light.colorAndIntensity.rgb * light.colorAndIntensity.w;
        uint reason;
        primaryVisibility = XR_ADV_EvaluateShadow(light, surface, geometric, primaryL, vec2(pixel), reason);
        primaryShadow = primaryVisibility;
        shadowReason = max(shadowReason, reason);
        shadowVisibility = min(shadowVisibility, primaryVisibility);
    }
    vec3 rawPrimaryColor = primaryColor;
    vec3 sourceRawAmbient = vec3(0.0);
    vec3 sourceIndirect = vec3(0.0);
    vec3 sourceRawDirect = vec3(0.0);
    bool authoredSh = false;
    XrSourceShCoefficients sourceSh;
    sourceSh.ar = sourceSh.ag = sourceSh.ab = sourceSh.br = sourceSh.bg =
        sourceSh.bb = sourceSh.c = vec4(0.0);
    if (UBER_I(_LightModel) != 0)
    {
        if (xrSourceLuminance(rawPrimaryColor) <= 0.000001)
            primaryVisibility = 1.0;
        sourceRawAmbient = XR_ADV_WorldAmbient(surface.viewIndex);
        authoredSh = XR_ADV_SourceSH(surface.viewIndex, sourceSh.ar, sourceSh.ag,
            sourceSh.ab, sourceSh.br, sourceSh.bg, sourceSh.bb, sourceSh.c);
        if (!authoredSh)
        {
            sourceSh.ar = vec4(0.0, 0.0, 0.0, sourceRawAmbient.r);
            sourceSh.ag = vec4(0.0, 0.0, 0.0, sourceRawAmbient.g);
            sourceSh.ab = vec4(0.0, 0.0, 0.0, sourceRawAmbient.b);
            sourceSh.br = sourceSh.bg = sourceSh.bb = sourceSh.c = vec4(0.0);
        }
        if ((u_Push.flags & 32u) != 0u)
            sourceSh.ar = sourceSh.ag = sourceSh.ab = sourceSh.br = sourceSh.bg =
                sourceSh.bb = sourceSh.c = vec4(0.0);
        xrSourceShLight(sourceSh, rawPrimaryColor, N, primaryL,
            UBER_I(_LightingColorMode), UBER_V(_ToonLightSettings).x,
            UBER_F(_LightingIndirectUsesNormals), primaryL, primaryColor,
            sourceIndirect);
        sourceRawDirect = primaryColor;
        vec4 sourceSettings = UBER_V(_ToonLightSettings);
        primaryColor = max(xrSourceDirectColor(primaryColor,
            UBER_F(_LightingMinLightBrightness), UBER_F(_LightingMonochromatic),
            UBER_F(_LightingCapEnabled), UBER_F(_LightingCap)) * sourceSettings.z +
            vec3(sourceSettings.w), vec3(0.0));
        sourceIndirect = max(xrSourceDirectColor(sourceIndirect,
            UBER_F(_LightingMinLightBrightness), UBER_F(_LightingMonochromatic),
            UBER_F(_LightingCapEnabled), UBER_F(_LightingCap)) * sourceSettings.z +
            vec3(sourceSettings.w), vec3(0.0));
    }
    vec3 matcapLightAdd = vec3(0.0);
    bool hasAniso = XR_UBER_HasFeature(XR_UBER_FEATURE_ADVANCED_PBR) &&
        UBER_V(_AnisotropySettings).x > 0.5;
    bool hasGlitter = XR_UBER_HasFeature(XR_UBER_FEATURE_GLITTER) && UBER_I(_GlitterModel) != 0;
    bool hasSourceMatcapMask = UBER_F(_MatcapToonModel) > 0.5 &&
        (UBER_V(_MatcapSlotParams0).y > 0.0 || UBER_V(_MatcapSlotParams1).y > 0.0 ||
         UBER_V(_MatcapSlotParams2).y > 0.0 || UBER_V(_MatcapSlotParams3).y > 0.0);
    bool hasMode1Matcap = !hasSourceMatcapMask && UBER_I(_LightModel) != 0 && UBER_I(_LightingMode) == 1;
    bool hasCubeLightMask = XR_UBER_HasFeature(XR_UBER_FEATURE_ADVANCED_PBR) &&
        UBER_I(_CubeMapToonModel) != 0 && UBER_F(_CubeMapLightMask) > 0.0;
    bool needPrimaryGlitterPair = hasAniso || hasSourceMatcapMask || hasMode1Matcap ||
        hasCubeLightMask || (hasGlitter && UBER_I(_LightingDirectionMode) != 2);
    vec2 primaryGlitterPair = needPrimaryGlitterPair
        ? XR_UBER_GlitterLightMapPair(c, N, Nx, Ny, primaryL, shadowMask,
            sourceSh, rawPrimaryColor, sourceRawDirect, primaryVisibility)
        : vec2(1.0);
    if (hasAniso)
    {
        float anisoLightMap = primaryGlitterPair.x;
        vec4 anisoMap = vec4(1.0, 1.0, 1.0, 0.0);
        vec2 anisoMapPan = UBER_V(_AnisoColorMapPan).xy * 0.05;
        if (UBER_V(_AnisotropyMapSettings).x > 0.5)
            anisoMap = XR_UBER_CoverageTexture(UBER_T(_AnisoColorMap),
                UBER_I(_AnisoColorMapUV), UBER_V(_AnisoColorMap_ST), anisoMapPan,
                c, vec4(1.0, 1.0, 1.0, 0.0));
        int anisoMaskIndex = int(UBER_V(_AnisotropyMapSettings).y + 0.5);
        int anisoMaskBlend = int(UBER_V(_AnisotropyMapSettings).z);
        uvec4 anisoMaskSlots = uvec4(UBER_T(_GlobalMaskTexture0),
            UBER_T(_GlobalMaskTexture1), UBER_T(_GlobalMaskTexture2),
            UBER_T(_GlobalMaskTexture3));
        float anisoMask = anisoMaskIndex > 0
            ? XR_UBER_GlobalMask(c, anisoMaskIndex, anisoMaskSlots,
                view.cameraPositionAndNear.xyz, N, V)
            : 1.0;
        vec2 anisoResponse = xrSourceAnisoResponses(geometric, N, surface.tangent * frameFacing,
            surface.bitangent * frameFacing, V, primaryL,
            anisoLightMap, UBER_V(_AnisotropySettings), UBER_V(_AnisotropyMix),
            UBER_V(_AnisotropyLayer0), UBER_V(_AnisotropyLayer1),
            UBER_V(_AnisotropyOffsetMapStrength).xy, anisoMap, anisoMask, anisoMaskBlend);
        vec2 anisoFootprint = vec2(0.0);
