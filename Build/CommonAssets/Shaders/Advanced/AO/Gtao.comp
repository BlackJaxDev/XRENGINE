#version 450
#include "Advanced/Shading/AdvancedShadingInterface.glslinc"
#include "Advanced/Reconstruction/ReconstructSurface.glslinc"
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
#if defined(XR_ADV_VISIBILITY_ARRAY)
XR_ADV_SHADING_LAYOUT(2) uniform sampler2DArray VisibilityDepth;
XR_ADV_SHADING_IMAGE(r8, 49) writeonly uniform image2DArray AmbientOcclusionOutput;
#define XR_ADV_AO_PIXEL(p, v) ivec3(p, v)
#else
XR_ADV_SHADING_LAYOUT(2) uniform sampler2D VisibilityDepth;
XR_ADV_SHADING_IMAGE(r8, 49) writeonly uniform image2D AmbientOcclusionOutput;
#define XR_ADV_AO_PIXEL(p, v) ivec2(p)
#endif
const uint XR_ADV_REVERSED_DEPTH = 1u << 1u;
const uint XR_ADV_FRAMEBUFFER_Y_DOWN = 1u << 6u;
const uint XR_ADV_AO_ENABLED = 1u << 2u;
const float XR_ADV_AO_PI = 3.14159265359;
const float XR_ADV_AO_HALF_PI = 1.57079632679;
const float XR_ADV_AO_RADIUS = 2.2;
const float XR_ADV_AO_BIAS = 0.06;
const float XR_ADV_AO_FALLOFF_START_RATIO = 0.4;
const float XR_ADV_AO_THICKNESS_RATIO = 1.0;
const int XR_ADV_AO_SLICE_COUNT = 3;
const int XR_ADV_AO_STEPS_PER_SLICE = 4;

bool XR_ADV_AO_IsFinite(float x) { return !isnan(x) && !isinf(x); }
bool XR_ADV_AO_IsFinite(vec3 x) { return !any(isnan(x)) && !any(isinf(x)); }
bool XR_ADV_AO_IsReversedDepth(XRAdvancedViewRecord v) { return (v.flags & XR_ADV_REVERSED_DEPTH) != 0u || v.depthParams.w != 0.0; }
bool XR_ADV_AO_IsFarDepth(float z, XRAdvancedViewRecord v) { return !XR_ADV_AO_IsFinite(z) || (XR_ADV_AO_IsReversedDepth(v) ? z <= 0.0 : z >= 1.0); }

bool XR_ADV_AO_TryGetViewPosition(ivec2 p, uint viewIndex, XRAdvancedViewRecord v, out vec3 position)
{
    float z = texelFetch(VisibilityDepth, XR_ADV_AO_PIXEL(p, viewIndex), 0).r;
    position = vec3(0.0);
    if (XR_ADV_AO_IsFarDepth(z, v)) return false;
    vec2 pixelCenter = vec2(p) + 0.5;
    if ((v.flags & XR_ADV_FRAMEBUFFER_Y_DOWN) != 0u)
        pixelCenter.y = v.renderSizeAndInverse.y - pixelCenter.y;
    vec3 world = XR_ADV_ReconstructWorldPositionFromDepth(pixelCenter, z, v);
    position = XR_ADV_TransformRowVector(vec4(world, 1.0), v.view).xyz;
    return XR_ADV_AO_IsFinite(world) && XR_ADV_AO_IsFinite(position);
}

bool XR_ADV_AO_TryGetShortestCenterEdge(
    bool hasNegative,
    vec3 negative,
    bool hasPositive,
    vec3 positive,
    vec3 center,
    out vec3 direction)
{
    direction = vec3(0.0);
    float negativeLengthSquared = -1.0;
    float positiveLengthSquared = -1.0;
    vec3 negativeEdge = vec3(0.0);
    vec3 positiveEdge = vec3(0.0);
    if (hasNegative)
    {
        negativeEdge = center - negative;
        negativeLengthSquared = dot(negativeEdge, negativeEdge);
        if (!XR_ADV_AO_IsFinite(negativeEdge) || !XR_ADV_AO_IsFinite(negativeLengthSquared) || negativeLengthSquared <= 1.0e-10)
            negativeLengthSquared = -1.0;
    }
    if (hasPositive)
    {
        positiveEdge = positive - center;
        positiveLengthSquared = dot(positiveEdge, positiveEdge);
        if (!XR_ADV_AO_IsFinite(positiveEdge) || !XR_ADV_AO_IsFinite(positiveLengthSquared) || positiveLengthSquared <= 1.0e-10)
            positiveLengthSquared = -1.0;
    }
    if (negativeLengthSquared < 0.0 && positiveLengthSquared < 0.0)
        return false;
    if (positiveLengthSquared < 0.0 ||
        (negativeLengthSquared >= 0.0 && negativeLengthSquared <= positiveLengthSquared))
        direction = negativeEdge * inversesqrt(negativeLengthSquared);
    else
        direction = positiveEdge * inversesqrt(positiveLengthSquared);
    return XR_ADV_AO_IsFinite(direction);
}

bool XR_ADV_AO_TryGetDepthNormal(
    ivec2 p,
    ivec2 extent,
    uint viewIndex,
    XRAdvancedViewRecord v,
    vec3 center,
    vec3 viewDir,
    out vec3 normal)
{
    vec3 l;
    vec3 r;
    vec3 u;
    vec3 d;
    normal = vec3(0.0, 0.0, 1.0);
    bool hl = XR_ADV_AO_TryGetViewPosition(max(p - ivec2(1, 0), ivec2(0)), viewIndex, v, l);
    bool hr = XR_ADV_AO_TryGetViewPosition(min(p + ivec2(1, 0), extent - 1), viewIndex, v, r);
    bool hu = XR_ADV_AO_TryGetViewPosition(max(p - ivec2(0, 1), ivec2(0)), viewIndex, v, u);
    bool hd = XR_ADV_AO_TryGetViewPosition(min(p + ivec2(0, 1), extent - 1), viewIndex, v, d);
    vec3 xAxis;
    vec3 yAxis;
    if (!XR_ADV_AO_TryGetShortestCenterEdge(hl, l, hr, r, center, xAxis) ||
        !XR_ADV_AO_TryGetShortestCenterEdge(hu, u, hd, d, center, yAxis))
        return false;
    vec3 crossAxis = cross(xAxis, yAxis);
    float crossLengthSquared = dot(crossAxis, crossAxis);
    if (!XR_ADV_AO_IsFinite(crossAxis) || !XR_ADV_AO_IsFinite(crossLengthSquared) || crossLengthSquared <= 1.0e-8)
        return false;
    normal = crossAxis * inversesqrt(crossLengthSquared);
    if (dot(normal, viewDir) < 0.0)
        normal = -normal;
    return XR_ADV_AO_IsFinite(normal);
}

float XR_ADV_AO_FastAcos(float x)
{
    float a = abs(x); float r = (-0.0187293 * a + 0.0742610) * a - 0.2121144;
    r = (r * a + 1.5707288) * sqrt(max(1.0 - a, 0.0));
    return x < 0.0 ? XR_ADV_AO_PI - r : r;
}
float XR_ADV_AO_IntegrateArc(float h, float n)
{
    h = clamp(h, 0.0, XR_ADV_AO_HALF_PI); n = clamp(n, -XR_ADV_AO_HALF_PI, XR_ADV_AO_HALF_PI);
    return 0.25 * (-cos(2.0 * h - n) + cos(n) + 2.0 * h * sin(n));
}
float XR_ADV_AO_Noise(ivec2 p) { return fract(52.9829189 * fract(dot(vec2(p), vec2(0.06711056, 0.00583715)))); }

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy); uint viewIndex = gl_GlobalInvocationID.z;
    if (viewIndex >= u_Push.viewCount || any(greaterThanEqual(uvec2(pixel), u_Push.screenExtent))) return;
    XRAdvancedViewRecord view = XR_ADV_LoadView(viewIndex);
    if ((u_Push.flags & XR_ADV_AO_ENABLED) == 0u) { imageStore(AmbientOcclusionOutput, XR_ADV_AO_PIXEL(pixel, viewIndex), vec4(1.0)); return; }
    ivec2 extent = textureSize(VisibilityDepth, 0).xy;
    vec3 center;
    if (!XR_ADV_AO_TryGetViewPosition(pixel, viewIndex, view, center)) { imageStore(AmbientOcclusionOutput, XR_ADV_AO_PIXEL(pixel, viewIndex), vec4(1.0)); return; }
    float centerDepth = abs(center.z);
    if (!XR_ADV_AO_IsFinite(centerDepth) || centerDepth <= 1.0e-4) { imageStore(AmbientOcclusionOutput, XR_ADV_AO_PIXEL(pixel, viewIndex), vec4(1.0)); return; }
    float centerLengthSquared = dot(center, center);
    if (!XR_ADV_AO_IsFinite(centerLengthSquared) || centerLengthSquared <= 1.0e-10) { imageStore(AmbientOcclusionOutput, XR_ADV_AO_PIXEL(pixel, viewIndex), vec4(1.0)); return; }
    vec3 viewDir = -center * inversesqrt(centerLengthSquared);
    float projectionX = abs(view.projectionUnjittered[0][0]);
    float projectionY = abs(view.projectionUnjittered[1][1]);
    if (!XR_ADV_AO_IsFinite(projectionX) || !XR_ADV_AO_IsFinite(projectionY) || projectionX <= 1.0e-5 || projectionY <= 1.0e-5) { imageStore(AmbientOcclusionOutput, XR_ADV_AO_PIXEL(pixel, viewIndex), vec4(1.0)); return; }
    vec3 normal;
    if (!XR_ADV_AO_TryGetDepthNormal(pixel, extent, viewIndex, view, center, viewDir, normal)) { imageStore(AmbientOcclusionOutput, XR_ADV_AO_PIXEL(pixel, viewIndex), vec4(1.0)); return; }
    float radiusPixels = clamp(XR_ADV_AO_RADIUS * projectionY * 0.5 * float(extent.y) / centerDepth, 1.0, 192.0);
    float invProjX = 1.0 / projectionX;
    float invProjY = 1.0 / projectionY;
    float textureYSign = (view.flags & XR_ADV_FRAMEBUFFER_Y_DOWN) != 0u ? -1.0 : 1.0;
    float visibility = 0.0;
    float baseAngle = (XR_ADV_AO_Noise(pixel) - 0.5) * XR_ADV_AO_PI / float(XR_ADV_AO_SLICE_COUNT);
    float jitter = XR_ADV_AO_Noise(pixel + ivec2(17, 43));
    for (int slice = 0; slice < XR_ADV_AO_SLICE_COUNT; ++slice)
    {
        float angle = baseAngle + XR_ADV_AO_PI * float(slice) / float(XR_ADV_AO_SLICE_COUNT);
        vec2 ray = vec2(cos(angle), sin(angle));
        vec3 tangentSeed = vec3(ray.x * invProjX, ray.y * textureYSign * invProjY, 0.0);
        float tangentSeedLengthSquared = dot(tangentSeed, tangentSeed);
        if (!XR_ADV_AO_IsFinite(tangentSeed) || !XR_ADV_AO_IsFinite(tangentSeedLengthSquared) || tangentSeedLengthSquared <= 1.0e-10) { visibility += 1.0; continue; }
        tangentSeed *= inversesqrt(tangentSeedLengthSquared);
        vec3 tangentProjection = tangentSeed - viewDir * dot(tangentSeed, viewDir);
        float tangentLengthSquared = dot(tangentProjection, tangentProjection);
        if (!XR_ADV_AO_IsFinite(tangentProjection) || !XR_ADV_AO_IsFinite(tangentLengthSquared) || tangentLengthSquared <= 1.0e-10) { visibility += 1.0; continue; }
        vec3 tangent = tangentProjection * inversesqrt(tangentLengthSquared);
        vec3 planeAxis = cross(viewDir, tangent);
        float planeLengthSquared = dot(planeAxis, planeAxis);
        if (!XR_ADV_AO_IsFinite(planeAxis) || !XR_ADV_AO_IsFinite(planeLengthSquared) || planeLengthSquared <= 1.0e-10) { visibility += 1.0; continue; }
        vec3 plane = planeAxis * inversesqrt(planeLengthSquared);
        vec3 projectedNormal = normal - plane * dot(normal, plane);
        float projectedLength = length(projectedNormal);
        if (!XR_ADV_AO_IsFinite(projectedLength) || projectedLength <= 1.0e-5) { visibility += 1.0; continue; }
        projectedNormal /= projectedLength; float gamma = atan(dot(projectedNormal, tangent), dot(projectedNormal, viewDir));
        float forward = XR_ADV_AO_HALF_PI, backward = XR_ADV_AO_HALF_PI;
        for (int step = 0; step < XR_ADV_AO_STEPS_PER_SLICE; ++step)
        {
            ivec2 offset = ivec2(round(ray * radiusPixels * ((float(step) + jitter) / float(XR_ADV_AO_STEPS_PER_SLICE))));
            for (int side = -1; side <= 1; side += 2)
            {
                ivec2 samplePixel = pixel + offset * side;
                if (any(lessThan(samplePixel, ivec2(0))) || any(greaterThanEqual(samplePixel, extent))) continue;
                vec3 samplePosition;
                if (!XR_ADV_AO_TryGetViewPosition(samplePixel, viewIndex, view, samplePosition)) continue;
                vec3 delta = samplePosition - center; float distance = length(delta);
                if (!XR_ADV_AO_IsFinite(distance) || distance <= 1.0e-4 || distance > XR_ADV_AO_RADIUS || max(0.0, -dot(delta, viewDir)) > XR_ADV_AO_RADIUS * XR_ADV_AO_THICKNESS_RATIO) continue;
                vec3 inPlane = delta - plane * dot(delta, plane); float inPlaneLength = length(inPlane);
                if (!XR_ADV_AO_IsFinite(inPlaneLength) || inPlaneLength <= 1.0e-5) continue;
                float horizon = XR_ADV_AO_FastAcos(clamp(dot(inPlane / inPlaneLength, viewDir), 0.0, 1.0));
                horizon = mix(XR_ADV_AO_HALF_PI, horizon, 1.0 - smoothstep(XR_ADV_AO_FALLOFF_START_RATIO * XR_ADV_AO_RADIUS, XR_ADV_AO_RADIUS, distance));
                horizon = clamp(horizon + XR_ADV_AO_BIAS, 0.0, XR_ADV_AO_HALF_PI);
                if (side > 0) forward = min(forward, horizon); else backward = min(backward, horizon);
            }
        }
        visibility += clamp(projectedLength * (XR_ADV_AO_IntegrateArc(forward, gamma) + XR_ADV_AO_IntegrateArc(backward, -gamma)), 0.0, 1.0);
    }
    visibility = clamp(visibility / float(XR_ADV_AO_SLICE_COUNT), 0.0, 1.0);
    vec2 edge = min(vec2(pixel) + 0.5, vec2(extent) - (vec2(pixel) + 0.5));
    visibility = mix(1.0, visibility, smoothstep(0.0, clamp(radiusPixels * 0.08, 2.0, 8.0), min(edge.x, edge.y)));
    imageStore(AmbientOcclusionOutput, XR_ADV_AO_PIXEL(pixel, viewIndex), vec4(visibility));
}
