#ifndef XR_ADVANCED_VISIBILITY_MESHLET_CULLING_GLSLINC
#define XR_ADVANCED_VISIBILITY_MESHLET_CULLING_GLSLINC

// Shared ABI and tests of the meshlet task stage. Include after
// VisibilityInterface.glslinc. Advanced matrices use the row-vector convention
// (position * matrix), so a basis axis of a world matrix is one matrix row and
// one clip coordinate is the dot product with one matrix column.

// XR_ADV_TASK_MESHLETS_PER_GROUP is defined in VisibilityInterface.glslinc,
// because the preparation shaders also use it.

// Task-to-mesh payload: the visibility payload row and the surviving global
// meshlet indices in lane order. 132 bytes.
struct XRAdvancedVisibilityTaskPayload
{
    uint payloadIndex;
    uint meshletIndex[XR_ADV_TASK_MESHLETS_PER_GROUP];
};

#define XR_ADV_MESHLET_CULL_NONE 0u
#define XR_ADV_MESHLET_CULL_FRUSTUM 1u
#define XR_ADV_MESHLET_CULL_CONE 2u
#define XR_ADV_MESHLET_CULL_INVALID 3u
// Late variant: the current-frame depth pyramid proves occlusion.
#define XR_ADV_MESHLET_CULL_OCCLUDED 4u
// Early variant: the meshlet was not visible last frame. The late recheck tests it.
#define XR_ADV_MESHLET_CULL_HISTORY 5u

// A non-uniform scale changes normal directions, so the cone no longer bounds
// them. Scales within this relative tolerance count as uniform.
#define XR_ADV_MESHLET_CONE_UNIFORM_SCALE_TOLERANCE 0.01

bool XR_ADV_MeshletSphereInsidePlane(vec3 center, float radius, vec4 plane)
{
    float normalLength = length(plane.xyz);
    return normalLength > 0.0 &&
        dot(plane, vec4(center, 1.0)) >= -radius * normalLength;
}

// Conservative sphere test against the Vulkan 0..w clip volume, formed from
// the columns of the unjittered view-projection matrix (the same planes as
// EarlyVisibility.comp). Malformed spheres count as visible here: the draw
// already passed its own bounds test, and the mesh stage validates the record.
bool XR_ADV_MeshletSphereInsideFrustum(vec4 sphere, mat4 viewProjection)
{
    if (any(isnan(sphere)) || any(isinf(sphere)) || sphere.w < 0.0)
        return true;
    vec4 clipX = viewProjection[0];
    vec4 clipY = viewProjection[1];
    vec4 clipZ = viewProjection[2];
    vec4 clipW = viewProjection[3];
    return XR_ADV_MeshletSphereInsidePlane(sphere.xyz, sphere.w, clipW + clipX) &&
        XR_ADV_MeshletSphereInsidePlane(sphere.xyz, sphere.w, clipW - clipX) &&
        XR_ADV_MeshletSphereInsidePlane(sphere.xyz, sphere.w, clipW + clipY) &&
        XR_ADV_MeshletSphereInsidePlane(sphere.xyz, sphere.w, clipW - clipY) &&
        XR_ADV_MeshletSphereInsidePlane(sphere.xyz, sphere.w, clipZ) &&
        XR_ADV_MeshletSphereInsidePlane(sphere.xyz, sphere.w, clipW - clipZ);
}

// Per-draw transform facts that every meshlet of the draw shares.
struct XRAdvancedMeshletDrawCullState
{
    mat4 world;
    float maxScale;
    bool coneAllowed;
};

// Builds the per-draw state. The cone test is allowed only for back-face
// culled (single-sided), static, unmirrored, uniformly scaled draws.
XRAdvancedMeshletDrawCullState XR_ADV_MeshletDrawCullState(
    mat4 world,
    uint cullMode,
    uint producer)
{
    XRAdvancedMeshletDrawCullState state;
    state.world = world;
    vec3 axisX = vec3(world[0][0], world[1][0], world[2][0]);
    vec3 axisY = vec3(world[0][1], world[1][1], world[2][1]);
    vec3 axisZ = vec3(world[0][2], world[1][2], world[2][2]);
    float scaleX = length(axisX);
    float scaleY = length(axisY);
    float scaleZ = length(axisZ);
    state.maxScale = max(scaleX, max(scaleY, scaleZ));
    float minScale = min(scaleX, min(scaleY, scaleZ));
    float determinant = dot(axisX, cross(axisY, axisZ));
    bool uniformScale = minScale > 0.0 &&
        (state.maxScale - minScale) <= state.maxScale * XR_ADV_MESHLET_CONE_UNIFORM_SCALE_TOLERANCE;
    state.coneAllowed =
        cullMode != 0u &&
        producer == XR_ADV_VIS_PRODUCER_STATIC_MESHLET &&
        determinant > 0.0 &&
        uniformScale;
    return state;
}

// World-space bounding sphere of one meshlet: the cooked sphere moved by the
// row-vector world matrix and scaled by its largest axis scale.
vec4 XR_ADV_MeshletWorldSphere(
    XRAdvancedVisibilityMeshletDescriptor meshlet,
    XRAdvancedMeshletDrawCullState draw)
{
    vec3 center = (vec4(meshlet.boundsSphere.xyz, 1.0) * draw.world).xyz;
    return vec4(center, meshlet.boundsSphere.w * draw.maxScale);
}

// Classifies one meshlet with the frustum and cone tests. The early and the
// late task variants both call this function with the same inputs, so the late
// recheck reproduces exactly what the early raster drew. Skinned meshlets are
// never culled here: their cooked bounds and cones describe the bind pose, not
// the deformed vertices.
uint XR_ADV_ClassifyVisibilityMeshlet(
    XRAdvancedVisibilityMeshletDescriptor meshlet,
    XRAdvancedMeshletDrawCullState draw,
    uint producer,
    mat4 viewProjection,
    vec3 cameraPosition)
{
    if (producer != XR_ADV_VIS_PRODUCER_STATIC_MESHLET)
        return XR_ADV_MESHLET_CULL_NONE;

    vec4 sphere = XR_ADV_MeshletWorldSphere(meshlet, draw);
    if (!XR_ADV_MeshletSphereInsideFrustum(sphere, viewProjection))
        return XR_ADV_MESHLET_CULL_FRUSTUM;

    // meshoptimizer cone: every triangle faces away from a camera with
    // dot(normalize(apex - camera), axis) >= cutoff. A zero cone has no data.
    bool hasCone = meshlet.packedCone != 0u || dot(meshlet.cone.xyz, meshlet.cone.xyz) != 0.0;
    if (draw.coneAllowed && hasCone && meshlet.cone.w < 1.0)
    {
        vec3 apex = (vec4(meshlet.coneApex.xyz, 1.0) * draw.world).xyz;
        vec3 axis = meshlet.cone.xyz * mat3(draw.world);
        float axisLength = length(axis);
        vec3 toApex = apex - cameraPosition;
        float apexDistance = length(toApex);
        if (axisLength > 0.0 && apexDistance > 0.0 &&
            dot(toApex / apexDistance, axis / axisLength) >= meshlet.cone.w)
        {
            return XR_ADV_MESHLET_CULL_CONE;
        }
    }
    return XR_ADV_MESHLET_CULL_NONE;
}

// The meshlet history of a view is trusted only while the view has temporal
// history. A camera cut, a teleport or a first frame clears that flag, so the
// early task stage then draws every frustum and cone survivor of its draws.
bool XR_ADV_MeshletViewHistoryValid(XRAdvancedViewRecord view)
{
    return (view.flags & XR_ADV_VIEW_TEMPORAL_HISTORY_VALID) != 0u;
}

#if defined(XR_ADV_VISIBILITY_LATE_TASK)
#define XR_ADV_MESHLET_VIEW_FLAG_REVERSED_DEPTH (1u << 1u)
#define XR_ADV_MESHLET_VIEW_FLAG_TEXTURE_Y_DOWN (1u << 6u)

// Hi-Z test of the late task stage against the current-frame depth pyramid of
// the push view (one texel per 64x64 pixels, farthest depth). It is the
// LateVisibility.comp test applied to the axis-aligned box of the meshlet's
// world sphere. Every covered tile must occlude; any doubt returns false
// (visible).
bool XR_ADV_MeshletSphereOccluded(vec4 sphere, XRAdvancedViewRecord view)
{
    if (any(isnan(sphere)) || any(isinf(sphere)) || sphere.w < 0.0)
        return false;
    vec3 boundsMinimum = sphere.xyz - vec3(sphere.w);
    vec3 boundsMaximum = sphere.xyz + vec3(sphere.w);
    vec2 minimumNdc = vec2(3.402823e38);
    vec2 maximumNdc = vec2(-3.402823e38);
    bool reversedDepth = (view.flags & XR_ADV_MESHLET_VIEW_FLAG_REVERSED_DEPTH) != 0u ||
        view.depthParams.w != 0.0;
    float nearestDepth = reversedDepth ? 0.0 : 1.0;
    for (uint corner = 0u; corner < 8u; ++corner)
    {
        vec3 position = vec3(
            (corner & 1u) == 0u ? boundsMinimum.x : boundsMaximum.x,
            (corner & 2u) == 0u ? boundsMinimum.y : boundsMaximum.y,
            (corner & 4u) == 0u ? boundsMinimum.z : boundsMaximum.z);
        vec4 clip = vec4(position, 1.0) * view.viewProjectionJittered;
        if (any(isnan(clip)) || any(isinf(clip)) || clip.w <= 0.00001 ||
            clip.z < 0.0 || clip.z > clip.w)
            return false;
        vec3 ndc = clip.xyz / clip.w;
        minimumNdc = min(minimumNdc, ndc.xy);
        maximumNdc = max(maximumNdc, ndc.xy);
        nearestDepth = reversedDepth ? max(nearestDepth, ndc.z) : min(nearestDepth, ndc.z);
    }

    ivec2 sourceSize = ivec2(max(view.renderSizeAndInverse.xy, vec2(1.0)));
    if (maximumNdc.x < -1.0 || maximumNdc.y < -1.0 ||
        minimumNdc.x > 1.0 || minimumNdc.y > 1.0)
        return false;
    vec2 minimumUv = clamp(minimumNdc * 0.5 + 0.5, vec2(0.0), vec2(1.0));
    vec2 maximumUv = clamp(maximumNdc * 0.5 + 0.5, vec2(0.0), vec2(1.0));
    bool framebufferYDown = (view.flags & XR_ADV_MESHLET_VIEW_FLAG_TEXTURE_Y_DOWN) != 0u;
    float minimumTextureY = framebufferYDown ? 1.0 - maximumUv.y : minimumUv.y;
    float maximumTextureY = framebufferYDown ? 1.0 - minimumUv.y : maximumUv.y;
    float guardPixels = view.foveationCenterAndBias.w == 0.0
        ? 1.0 : exp2(view.foveationCenterAndBias.z);
    vec2 minimumPixel = floor(vec2(minimumUv.x, minimumTextureY) * vec2(sourceSize)) - vec2(guardPixels);
    vec2 maximumPixel = ceil(vec2(maximumUv.x, maximumTextureY) * vec2(sourceSize)) + vec2(guardPixels);
    if (any(isnan(minimumPixel)) || any(isnan(maximumPixel)) || isnan(nearestDepth) ||
        nearestDepth < 0.0 || nearestDepth > 1.0)
        return false;

    const int tileSize = 64;
    const int maxTilesPerAxis = 8;
    ivec2 tileExtent = (sourceSize + ivec2(tileSize - 1)) / tileSize;
    if (XR_ADV_DEPTH_PYRAMID_SIZE() != tileExtent)
        return false;
    ivec2 firstTile = clamp(ivec2(floor(minimumPixel)) / tileSize, ivec2(0), tileExtent - ivec2(1));
    ivec2 lastTile = clamp(ivec2(floor(maximumPixel)) / tileSize, ivec2(0), tileExtent - ivec2(1));
    if (any(greaterThan(lastTile - firstTile + ivec2(1), ivec2(maxTilesPerAxis))))
        return false;
    for (int y = firstTile.y; y <= lastTile.y; ++y)
    for (int x = firstTile.x; x <= lastTile.x; ++x)
    {
        float tileDepth = XR_ADV_LOAD_DEPTH_PYRAMID(ivec2(x, y)).r;
        if (isnan(tileDepth) || isinf(tileDepth) || tileDepth < 0.0 || tileDepth > 1.0)
            return false;
        bool tileOccludes = reversedDepth
            ? nearestDepth < tileDepth - 0.0001
            : nearestDepth > tileDepth + 0.0001;
        if (!tileOccludes)
            return false;
    }
    return true;
}
#endif

#if defined(XR_ADV_CLUSTER_LOD_CUT)
// Cluster level-of-detail cut. Only the task variant compiled with
// XR_ADV_CLUSTER_LOD_CUT has it; every other variant is unchanged.
//
// A cluster hierarchy geometry publishes the meshlets of every level (level 0
// first). Its triangle-word stream holds, after the triangle words, one cluster
// record per meshlet (group, refined group) and then one group record per group
// (sphere center and radius, error, depth, two reserved words). The geometry
// record stores the level-0 count in reservedLayout0 and the word offset of the
// cluster records in reservedLayout1. A geometry without a hierarchy has
// reservedLayout0 == 0 and draws every meshlet.
//
// Render rule: draw a cluster when the projected error of its own group's
// simplified bound is above the threshold (the coarser level is not good
// enough) and the cluster is a level-0 cluster or the projected error of the
// group it was made from is at or below the threshold. Errors and spheres grow
// from child to parent, so the selected clusters cover the mesh once, and the
// locked group borders make the cut crack free.
//
// Skinned draws (XR_ADV_CLUSTER_LOD_CUT_SKINNED): the cooked group spheres are
// bind pose, so they do not bound the posed clusters. Every group of a skinned
// draw instead uses one distance for the whole draw: the distance from the
// nearer eye to the draw's posed bounding spheres (instance record and
// visibility candidate), less the blendshape margin. One distance with errors that grow from
// child to parent keeps the cut consistent, so it stays crack free. The bound is
// per draw, not per cluster, so a large draw refines everywhere as its nearest
// part does.
#define XR_ADV_MESHLET_CULL_LOD 6u
#ifndef XR_ADV_CLUSTER_LOD_PIXEL_THRESHOLD
#define XR_ADV_CLUSTER_LOD_PIXEL_THRESHOLD 1.0
#endif
#define XR_ADV_CLUSTER_RECORD_WORDS 2u
#define XR_ADV_CLUSTER_GROUP_RECORD_WORDS 8u
#define XR_ADV_CLUSTER_VIEW_FLAG_STEREO_LEFT (1u << 2u)
#define XR_ADV_CLUSTER_VIEW_FLAG_STEREO_RIGHT (1u << 3u)

// Facts of the cut that every cluster of one draw shares.
struct XRAdvancedClusterCutState
{
    bool applies;
    uint geometryMeshletFirst;
    uint geometryMeshletCount;
    uint level0Count;
    uint clusterWordBase;
    uint groupWordBase;
    vec3 eye0;
    vec3 eye1;
    float pixelScale;
    float nearDistance;
    // Distance from the eye to the draw bound that every group of a skinned
    // draw uses. Negative: each group uses its own sphere (static draws).
    float sharedDistance;
    // Minimum cluster level of a skinned draw whose deformation job deformed
    // only the vertices of this level and coarser. Groups finer than this level
    // count as refined enough. Zero: no clamp.
    uint clampLevel;
};

// Pixels for one world unit of error at distance 1 for one view: the larger
// projection scale term times half the render height.
float XR_ADV_ClusterCutPixelScale(uint viewIndex)
{
    mat4 projection = XR_ADV_Views.records[viewIndex].projectionUnjittered;
    float scale = max(abs(projection[0][0]), abs(projection[1][1]));
    return scale * XR_ADV_Views.records[viewIndex].renderSizeAndInverse.y * 0.5;
}

// The other eye of a stereo pair: the adjacent view with the opposite stereo
// flag. A view without a partner uses itself. Both eyes then make the same cut
// from both eye positions, so they show the same clusters.
uint XR_ADV_ClusterCutPartnerView(uint viewIndex, uint viewFlags)
{
    uint viewCount = uint(XR_ADV_Views.records.length());
    if ((viewFlags & XR_ADV_CLUSTER_VIEW_FLAG_STEREO_LEFT) != 0u && viewIndex + 1u < viewCount &&
        (XR_ADV_Views.records[viewIndex + 1u].flags & XR_ADV_CLUSTER_VIEW_FLAG_STEREO_RIGHT) != 0u)
        return viewIndex + 1u;
    if ((viewFlags & XR_ADV_CLUSTER_VIEW_FLAG_STEREO_RIGHT) != 0u && viewIndex > 0u &&
        (XR_ADV_Views.records[viewIndex - 1u].flags & XR_ADV_CLUSTER_VIEW_FLAG_STEREO_LEFT) != 0u)
        return viewIndex - 1u;
    return viewIndex;
}

// Builds the cut state of one draw. The cut is active only for a static
// meshlet draw (or, with XR_ADV_CLUSTER_LOD_CUT_SKINNED, a skinned meshlet
// draw) of a hierarchy geometry whose tables fit in the triangle-word table.
// Without it the draw keeps every meshlet of its payload range. A skinned draw
// also needs XR_ADV_ClusterCutUseDrawBound.
XRAdvancedClusterCutState XR_ADV_ClusterCutState(
    XRAdvancedGpuHandle geometryHandle,
    uint producer,
    uint viewIndex,
    XRAdvancedViewRecord view)
{
    XRAdvancedClusterCutState cut;
    cut.applies = false;
    cut.geometryMeshletFirst = 0u;
    cut.geometryMeshletCount = 0u;
    cut.level0Count = 0u;
    cut.clusterWordBase = 0u;
    cut.groupWordBase = 0u;
    cut.eye0 = view.cameraPositionAndNear.xyz;
    cut.eye1 = cut.eye0;
    cut.pixelScale = 0.0;
    cut.nearDistance = max(view.cameraPositionAndNear.w, 1.0e-4);
    cut.sharedDistance = -1.0;
    cut.clampLevel = 0u;
#if defined(XR_ADV_CLUSTER_LOD_CUT_SKINNED)
    if (producer != XR_ADV_VIS_PRODUCER_STATIC_MESHLET &&
        producer != XR_ADV_VIS_PRODUCER_SKINNED_MESHLET)
        return cut;
#else
    if (producer != XR_ADV_VIS_PRODUCER_STATIC_MESHLET)
        return cut;
#endif
    uint geometryDense = XR_ADV_ResolveVisibilityHandle(
        geometryHandle, VisibilityGeometryLookupSegment, XR_ADV_DIAGNOSTIC_MESH);
    if (geometryDense == XR_ADV_INVALID_DENSE_INDEX)
        return cut;
    XRAdvancedGeometryRecord geometry = XR_ADV_LoadGeometry(geometryDense);
    if (geometry.reservedLayout0 == 0u || geometry.reservedLayout0 > geometry.meshletCount)
        return cut;
    uint clusterWordBase = geometry.meshletTriangleWords.elementOffset + geometry.reservedLayout1;
    uint groupWordBase = clusterWordBase + geometry.meshletCount * XR_ADV_CLUSTER_RECORD_WORDS;
    if (clusterWordBase < geometry.meshletTriangleWords.elementOffset ||
        groupWordBase < clusterWordBase ||
        groupWordBase > uint(XR_ADV_VisibilityMeshletTriangleWords.records.length()))
        return cut;

    uint partner = XR_ADV_ClusterCutPartnerView(viewIndex, view.flags);
    cut.applies = true;
    cut.geometryMeshletFirst = geometry.meshletFirst;
    cut.geometryMeshletCount = geometry.meshletCount;
    cut.level0Count = geometry.reservedLayout0;
    cut.clusterWordBase = clusterWordBase;
    cut.groupWordBase = groupWordBase;
    cut.eye1 = XR_ADV_Views.records[partner].cameraPositionAndNear.xyz;
    cut.pixelScale = max(XR_ADV_ClusterCutPixelScale(viewIndex), XR_ADV_ClusterCutPixelScale(partner));
    return cut;
}

#if defined(XR_ADV_CLUSTER_LOD_CUT_SKINNED)
// Distance from the nearer eye to a world bounding sphere, or a negative value
// when the sphere is not usable.
float XR_ADV_ClusterCutSphereDistance(vec4 sphere, XRAdvancedClusterCutState cut)
{
    if (any(isnan(sphere)) || any(isinf(sphere)) || sphere.w < 0.0)
        return -1.0;
    float distanceToBound =
        min(distance(sphere.xyz, cut.eye0), distance(sphere.xyz, cut.eye1)) - sphere.w;
    return isnan(distanceToBound) || isinf(distanceToBound)
        ? -1.0 : max(distanceToBound, 0.0);
}

// Sets the one distance of a skinned draw's cut. Two posed world spheres bound
// the draw: the instance record sphere (the CPU posed bounds that the publisher
// updates when they change) and the visibility candidate sphere (candidate words
// 4 to 7; the candidate index is the payload index), which PatchPhysicsChainBounds
// rewrites for GPU physics chains. The nearer distance of the usable spheres
// wins, less the blendshape margin of candidate word 2 (mesh units, scaled by the
// draw scale). Candidate word 3 is the clamp level of the draw's deformation
// level of detail (see XRAdvancedClusterCutState.clampLevel). The cut then
// applies only when the payload range holds every
// level of the geometry; otherwise the draw keeps its range (level 0). Without a
// usable sphere or margin the distance is the near distance, so every group
// refines and the draw shows level 0.
void XR_ADV_ClusterCutUseDrawBound(
    inout XRAdvancedClusterCutState cut,
    uint payloadIndex,
    XRAdvancedVisibilityPayload payload,
    XRAdvancedMeshletDrawCullState draw)
{
    if (!cut.applies)
        return;
    if (payload.meshletOffset != cut.geometryMeshletFirst ||
        payload.meshletCount != cut.geometryMeshletCount)
    {
        cut.applies = false;
        return;
    }

    cut.sharedDistance = cut.nearDistance;
    float nearest = -1.0;
    uint drawDense = XR_ADV_ResolveVisibilityHandle(
        payload.draw, VisibilityDrawLookupSegment, XR_ADV_DIAGNOSTIC_DRAW);
    if (drawDense != XR_ADV_INVALID_DENSE_INDEX)
    {
        XRAdvancedDrawRecord drawRecord = XR_ADV_LoadDraw(drawDense);
        uint instanceDense = XR_ADV_ResolveVisibilityHandle(
            drawRecord.instance, VisibilityInstanceLookupSegment, XR_ADV_DIAGNOSTIC_INSTANCE);
        if (instanceDense != XR_ADV_INVALID_DENSE_INDEX)
            nearest = XR_ADV_ClusterCutSphereDistance(XR_ADV_LoadInstance(instanceDense).boundsSphere, cut);
    }

    float margin = 0.0;
    uint candidateBase = payloadIndex * 20u;
    if (payloadIndex < uint(XR_ADV_VisibilityCandidates.records.length()) / 20u &&
        XR_ADV_VisibilityCandidates.records[candidateBase] == payload.draw.index &&
        XR_ADV_VisibilityCandidates.records[candidateBase + 1u] == payload.draw.generation)
    {
        margin = uintBitsToFloat(XR_ADV_VisibilityCandidates.records[candidateBase + 2u]);
        // The clamp is set before the distance checks below. A draw whose job
        // deformed only a prefix must not draw finer clusters, even when its
        // distance is unusable.
        cut.clampLevel = XR_ADV_VisibilityCandidates.records[candidateBase + 3u];
        if ((XR_ADV_VisibilityCandidates.records[candidateBase + 19u] & (1u << 10u)) == 0u)
        {
            float candidateDistance = XR_ADV_ClusterCutSphereDistance(uintBitsToFloat(uvec4(
                XR_ADV_VisibilityCandidates.records[candidateBase + 4u],
                XR_ADV_VisibilityCandidates.records[candidateBase + 5u],
                XR_ADV_VisibilityCandidates.records[candidateBase + 6u],
                XR_ADV_VisibilityCandidates.records[candidateBase + 7u])), cut);
            if (candidateDistance >= 0.0 && (nearest < 0.0 || candidateDistance < nearest))
                nearest = candidateDistance;
        }
    }
    if (nearest < 0.0 || isnan(margin) || isinf(margin) || margin < 0.0 || margin >= 3.0e38)
        return;
    cut.sharedDistance = max(nearest - margin * draw.maxScale, cut.nearDistance);
}
#endif

// Projected error in render pixels of one group's simplified bound. The bound
// is in mesh space; the draw's world matrix moves the center, and its largest
// axis scale scales the radius and the error. The nearer eye gives the larger
// error. A camera inside the sphere clamps to the near distance, so the
// cluster refines. An infinite error (the last group) never passes the test.
// A skinned draw uses its shared distance instead of the group sphere.
// A group finer than the clamp level (group record word 5 is its level) with a
// finite error has zero projected error: its clusters are refined enough, so the
// cut draws their coarser clusters. The suffix of levels at or above the clamp
// keeps the original errors, so the cut stays free of cracks.
float XR_ADV_ClusterGroupProjectedError(
    uint group,
    XRAdvancedClusterCutState cut,
    XRAdvancedMeshletDrawCullState draw)
{
    uint word = cut.groupWordBase + group * XR_ADV_CLUSTER_GROUP_RECORD_WORDS;
    if (group >= 0x08000000u || word + 6u > uint(XR_ADV_VisibilityMeshletTriangleWords.records.length()))
        return 3.402823e38;
    vec4 sphere = vec4(
        uintBitsToFloat(XR_ADV_VisibilityMeshletTriangleWords.records[word + 0u]),
        uintBitsToFloat(XR_ADV_VisibilityMeshletTriangleWords.records[word + 1u]),
        uintBitsToFloat(XR_ADV_VisibilityMeshletTriangleWords.records[word + 2u]),
        uintBitsToFloat(XR_ADV_VisibilityMeshletTriangleWords.records[word + 3u]));
    float error = uintBitsToFloat(XR_ADV_VisibilityMeshletTriangleWords.records[word + 4u]);
    if (isnan(error) || isinf(error) || error >= 3.0e38 || any(isnan(sphere)) || any(isinf(sphere)))
        return 3.402823e38;
    if (cut.clampLevel != 0u &&
        XR_ADV_VisibilityMeshletTriangleWords.records[word + 5u] < cut.clampLevel)
        return 0.0;
    if (cut.sharedDistance >= 0.0)
        return error * draw.maxScale * cut.pixelScale / max(cut.sharedDistance, cut.nearDistance);
    vec3 center = (vec4(sphere.xyz, 1.0) * draw.world).xyz;
    float radius = sphere.w * draw.maxScale;
    float distanceToBound = min(distance(center, cut.eye0), distance(center, cut.eye1)) - radius;
    return error * draw.maxScale * cut.pixelScale / max(distanceToBound, cut.nearDistance);
}

// True when the cut selects this meshlet. A meshlet outside the geometry range
// or with an unreadable record is kept only when it is a level-0 meshlet, so a
// bad table never draws two levels at once.
bool XR_ADV_ClusterInCut(
    uint meshletIndex,
    XRAdvancedClusterCutState cut,
    XRAdvancedMeshletDrawCullState draw)
{
    uint cluster = meshletIndex - cut.geometryMeshletFirst;
    uint recordWord = cut.clusterWordBase + cluster * XR_ADV_CLUSTER_RECORD_WORDS;
    if (meshletIndex < cut.geometryMeshletFirst || cluster >= cut.geometryMeshletCount ||
        recordWord + 2u > cut.groupWordBase)
        return cluster < cut.level0Count;
    uint group = XR_ADV_VisibilityMeshletTriangleWords.records[recordWord + 0u];
    int refined = int(XR_ADV_VisibilityMeshletTriangleWords.records[recordWord + 1u]);
    const float threshold = float(XR_ADV_CLUSTER_LOD_PIXEL_THRESHOLD);
    if (XR_ADV_ClusterGroupProjectedError(group, cut, draw) <= threshold)
        return false;
    return refined < 0 ||
        XR_ADV_ClusterGroupProjectedError(uint(refined), cut, draw) <= threshold;
}
#endif

#endif
