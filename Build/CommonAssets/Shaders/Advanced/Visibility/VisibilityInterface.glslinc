#ifndef XR_ADVANCED_VISIBILITY_INTERFACE_GLSLINC
#define XR_ADVANCED_VISIBILITY_INTERFACE_GLSLINC

#ifndef XR_ADV_VISIBILITY_PAYLOAD_VERSION
#error "The advanced visibility payload version must be injected by AdvancedShaderAccessLibrary."
#endif

#include "Advanced/Access/AdvancedAccess.glslinc"

#define XR_ADV_VIS_INVALID 0xFFFFFFFFu
#define XR_ADV_VIS_PRODUCER_STATIC_MESHLET 0u
#define XR_ADV_VIS_PRODUCER_SKINNED_MESHLET 1u
#define XR_ADV_VIS_PRODUCER_INDIRECT_INDEXED 2u
#define XR_ADV_VIS_PRODUCER_CPU_STATIC_INDEXED 3u
#define XR_ADV_VIS_PRODUCER_CPU_PRE_SKINNED 4u

#define XR_ADV_VIS_PRODUCER_MASK 0x7u
#define XR_ADV_VIS_ORIGIN_SHIFT 3u
#define XR_ADV_VIS_MASKED_SHIFT 4u
#define XR_ADV_VIS_FRONT_FACE_SHIFT 5u
#define XR_ADV_VIS_VELOCITY_VALID_SHIFT 6u
#define XR_ADV_VIS_VIEW_SHIFT 8u
#define XR_ADV_VIS_VERSION_SHIFT 16u
#define XR_ADV_VIS_SELECTION_VALID_SHIFT 24u

bool XR_ADV_IsSupportedVisibilityProducer(uint producer)
{
    return producer <=
        XR_ADV_VIS_PRODUCER_CPU_PRE_SKINNED;
}

#ifndef XR_ADV_VISIBILITY_SET
#define XR_ADV_VISIBILITY_SET 1
#endif
#ifndef XR_ADV_BINDING_VISIBILITY_PAYLOADS
#define XR_ADV_BINDING_VISIBILITY_PAYLOADS 24
#endif
#ifndef XR_ADV_BINDING_VISIBILITY_COUNTERS
#define XR_ADV_BINDING_VISIBILITY_COUNTERS 29
#endif

#define XR_ADV_BINDING_VISIBILITY_CANDIDATES 20
#define XR_ADV_BINDING_VISIBILITY_PERSISTENT_STATE 21
#define XR_ADV_BINDING_VISIBILITY_DEFERRED_INDICES 22
#define XR_ADV_BINDING_VISIBILITY_VISIBLE_INDICES 23
#define XR_ADV_BINDING_VISIBILITY_PRODUCERS 25
#define XR_ADV_BINDING_VISIBILITY_RANGE_INDICES 26
#define XR_ADV_BINDING_VISIBILITY_RANGE_OFFSETS 27
#define XR_ADV_BINDING_VISIBILITY_RANGE_COUNTS 28
#define XR_ADV_BINDING_VISIBILITY_INDEXED_ARGUMENTS 30
#define XR_ADV_BINDING_VISIBILITY_MESH_ARGUMENTS 31
#define XR_ADV_BINDING_VISIBILITY_MESH_PAYLOADS 32
#define XR_ADV_BINDING_VISIBILITY_STATIC_VERTICES 33
#define XR_ADV_BINDING_VISIBILITY_CURRENT_VERTICES 34
#define XR_ADV_BINDING_VISIBILITY_PREVIOUS_VERTICES 35
#define XR_ADV_BINDING_VISIBILITY_MESHLET_DESCRIPTORS 36
#define XR_ADV_BINDING_VISIBILITY_MESHLET_VERTEX_INDICES 37
#define XR_ADV_BINDING_VISIBILITY_MESHLET_TRIANGLE_WORDS 38
// Late visibility never overwrites the early producer's GPU-owned streams.
// These three frame-slot ranges retain recovered candidates and their indexed
// indirect expansion until the load-preserving late raster consumes them.
#define XR_ADV_BINDING_VISIBILITY_LATE_VISIBLE_INDICES 39
#define XR_ADV_BINDING_VISIBILITY_LATE_RANGE_COUNTS 40
#define XR_ADV_BINDING_VISIBILITY_LATE_INDEXED_ARGUMENTS 41
#define XR_ADV_BINDING_VISIBILITY_LATE_MESH_ARGUMENTS 44
#define XR_ADV_BINDING_VISIBILITY_LATE_MESH_PAYLOADS 45
// Per-frame depth-pyramid bindings are intentionally runtime-owned. They are
// populated only by the late-stage image closure, never via loose uniforms.
#define XR_ADV_BINDING_VISIBILITY_DEPTH_PYRAMID_SAMPLED 42
#define XR_ADV_BINDING_VISIBILITY_DEPTH_PYRAMID_STORAGE 43

#if defined(XR_ADV_BACKEND_VULKAN)
#define XR_ADV_VIS_TABLE_LAYOUT(bindingIndex) layout(set = XR_ADV_VISIBILITY_SET, binding = bindingIndex, std430, row_major)
#elif defined(XR_ADV_BACKEND_OPENGL)
#define XR_ADV_VIS_TABLE_LAYOUT(bindingIndex) layout(binding = bindingIndex, std430, row_major)
#else
#error "An advanced visibility shader backend must be selected."
#endif

struct XRAdvancedVisibilityPayload
{
    XRAdvancedGpuHandle draw;
    XRAdvancedGpuHandle geometry;
    XRAdvancedGpuHandle material;
    uint vertexOffset;
    uint previousVertexOffset;
    uint indexOffset;
    uint weightOffset;
    uint paletteOffset;
    uint meshletOffset;
    uint meshletCount;
    uint primitiveSection;
    uint instanceCount;
    uint firstIndex;
    uint indexCount;
    uint vertexCount;
    uint rasterStateClass;
    uint coverage;
    uint cullMode;
    uint primitiveTopology;
    uint flags;
};

XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_CANDIDATES)
readonly buffer XRAdvancedVisibilityCandidates { uint records[]; } XR_ADV_VisibilityCandidates;
XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_PERSISTENT_STATE)
buffer XRAdvancedVisibilityPersistentState { uint records[]; } XR_ADV_VisibilityPersistentState;
XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_DEFERRED_INDICES)
buffer XRAdvancedVisibilityDeferredIndices { uint records[]; } XR_ADV_VisibilityDeferredIndices;
XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_VISIBLE_INDICES)
buffer XRAdvancedVisibilityVisibleIndices { uint records[]; } XR_ADV_VisibilityVisibleIndices;

XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_PAYLOADS)
readonly buffer XRAdvancedVisibilityPayloadTable
{
    XRAdvancedVisibilityPayload records[];
} XR_ADV_VisibilityPayloads;

XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_PRODUCERS)
readonly buffer XRAdvancedVisibilityProducers { uint records[]; } XR_ADV_VisibilityProducers;
XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_RANGE_INDICES)
readonly buffer XRAdvancedVisibilityRangeIndices { uint records[]; } XR_ADV_VisibilityRangeIndices;
XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_RANGE_OFFSETS)
readonly buffer XRAdvancedVisibilityRangeOffsets { uint records[]; } XR_ADV_VisibilityRangeOffsets;
XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_RANGE_COUNTS)
buffer XRAdvancedVisibilityRangeCounts { uint records[]; } XR_ADV_VisibilityRangeCounts;

struct XRAdvancedVisibilityCounterRecord
{
    uint earlyDraws;
    uint deferredCandidates;
    uint lateDraws;
    uint recoveredCandidates;
    uint validPixels;
    uint invalidPixels;
    uint payloadOverflow;
    uint maskedCoveragePixels;
    uint decodeOutOfBounds;
    uint depthPyramidBuilds;
    uint unsupportedDisplacement;
    uint reserved[5];
    uvec2 drawLookupSegment;
    uvec2 instanceLookupSegment;
    uvec2 transformLookupSegment;
    uvec2 renderStateLookupSegment;
    uvec2 editorIdentityLookupSegment;
    uvec2 geometryLookupSegment;
    uvec2 materialLookupSegment;
    uvec2 shadingKernelLookupSegment;
    uvec2 textureLookupSegment;
    uvec2 samplerLookupSegment;
};

XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_COUNTERS)
buffer XRAdvancedVisibilityCounterTable
{
    XRAdvancedVisibilityCounterRecord records[];
} XR_ADV_VisibilityCounterTable;

// A producer can select its sealed view segment before including this ABI.
// Legacy single-view shaders intentionally retain index zero.
#ifndef XR_ADV_VISIBILITY_COUNTER_INDEX
#define XR_ADV_VISIBILITY_COUNTER_INDEX 0u
#endif
#define XR_ADV_VisibilityCounters (XR_ADV_VisibilityCounterTable.records[XR_ADV_VISIBILITY_COUNTER_INDEX])

XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_INDEXED_ARGUMENTS)
buffer XRAdvancedVisibilityIndexedArguments { uint records[]; } XR_ADV_VisibilityIndexedArguments;
XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_MESH_ARGUMENTS)
buffer XRAdvancedVisibilityMeshArguments { uint records[]; } XR_ADV_VisibilityMeshArguments;
XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_MESH_PAYLOADS)
buffer XRAdvancedVisibilityMeshPayloads { uint records[]; } XR_ADV_VisibilityMeshPayloads;

// These layouts mirror AdvancedDeformedVertex (64 bytes) and
// AdvancedMeshletDescriptor (80 bytes) exactly. They are declared here rather
// than in the mesh stage so every visibility consumer shares one canonical
// set-1 geometry contract.
struct XRAdvancedVisibilityPackedVertex
{
    vec3 position;
    uint normalOct;
    uint tangentOctAndSign;
    uint texCoord0Half;
    uint texCoord1Half;
    uint color0Rgba8;
    uint color1Rgba8;
    uint custom0;
    uint sourceVertex;
    uint flags;
    uint reserved0;
    uint reserved1;
    uint reserved2;
    uint reserved3;
};

struct XRAdvancedVisibilityMeshletDescriptor
{
    vec4 boundsSphere;
    uint vertexOffset;
    uint triangleByteOffset;
    uint vertexCount;
    uint triangleCount;
    vec4 cone;
    vec4 coneApex;
    uint packedCone;
    uint reserved0;
    uint reserved1;
    uint reserved2;
};

XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_STATIC_VERTICES)
readonly buffer XRAdvancedVisibilityStaticVertexTable
{
    XRAdvancedVisibilityPackedVertex records[];
} XR_ADV_VisibilityStaticVertices;
XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_CURRENT_VERTICES)
readonly buffer XRAdvancedVisibilityCurrentVertexTable
{
    XRAdvancedVisibilityPackedVertex records[];
} XR_ADV_VisibilityCurrentVertices;
XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_PREVIOUS_VERTICES)
readonly buffer XRAdvancedVisibilityPreviousVertexTable
{
    XRAdvancedVisibilityPackedVertex records[];
} XR_ADV_VisibilityPreviousVertices;
XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_MESHLET_DESCRIPTORS)
readonly buffer XRAdvancedVisibilityMeshletTable
{
    XRAdvancedVisibilityMeshletDescriptor records[];
} XR_ADV_VisibilityMeshlets;
XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_MESHLET_VERTEX_INDICES)
readonly buffer XRAdvancedVisibilityMeshletVertexTable
{
    uint records[];
} XR_ADV_VisibilityMeshletVertexIndices;
XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_MESHLET_TRIANGLE_WORDS)
readonly buffer XRAdvancedVisibilityMeshletTriangleTable
{
    uint records[];
} XR_ADV_VisibilityMeshletTriangleWords;

#if defined(XR_ADV_ENABLE_LATE_VISIBILITY_OUTPUTS)
XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_LATE_VISIBLE_INDICES)
buffer XRAdvancedVisibilityLateVisibleIndices { uint records[]; } XR_ADV_VisibilityLateVisibleIndices;
XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_LATE_RANGE_COUNTS)
buffer XRAdvancedVisibilityLateRangeCounts { uint records[]; } XR_ADV_VisibilityLateRangeCounts;
XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_LATE_INDEXED_ARGUMENTS)
buffer XRAdvancedVisibilityLateIndexedArguments { uint records[]; } XR_ADV_VisibilityLateIndexedArguments;
XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_LATE_MESH_ARGUMENTS)
buffer XRAdvancedVisibilityLateMeshArguments { uint records[]; } XR_ADV_VisibilityLateMeshArguments;
XR_ADV_VIS_TABLE_LAYOUT(XR_ADV_BINDING_VISIBILITY_LATE_MESH_PAYLOADS)
buffer XRAdvancedVisibilityLateMeshPayloads { uint records[]; } XR_ADV_VisibilityLateMeshPayloads;
#endif

#if defined(XR_ADV_ENABLE_DEPTH_PYRAMID_IMAGES) && defined(XR_ADV_BACKEND_VULKAN)
layout(set = XR_ADV_VISIBILITY_SET, binding = XR_ADV_BINDING_VISIBILITY_DEPTH_PYRAMID_SAMPLED)
uniform sampler2D XR_ADV_DepthPyramidSampled;
layout(set = XR_ADV_VISIBILITY_SET, binding = XR_ADV_BINDING_VISIBILITY_DEPTH_PYRAMID_STORAGE, r32f)
writeonly uniform image2D XR_ADV_DepthPyramidStorage;
#endif

#define VisibilityDrawLookupSegment XR_ADV_VisibilityCounters.drawLookupSegment
#define VisibilityInstanceLookupSegment XR_ADV_VisibilityCounters.instanceLookupSegment
#define VisibilityTransformLookupSegment XR_ADV_VisibilityCounters.transformLookupSegment
#define VisibilityRenderStateLookupSegment XR_ADV_VisibilityCounters.renderStateLookupSegment
#define VisibilityEditorIdentityLookupSegment XR_ADV_VisibilityCounters.editorIdentityLookupSegment
#define VisibilityGeometryLookupSegment XR_ADV_VisibilityCounters.geometryLookupSegment
#define VisibilityMaterialLookupSegment XR_ADV_VisibilityCounters.materialLookupSegment
#define VisibilityShadingKernelLookupSegment XR_ADV_VisibilityCounters.shadingKernelLookupSegment
#define VisibilityTextureLookupSegment XR_ADV_VisibilityCounters.textureLookupSegment
#define VisibilitySamplerLookupSegment XR_ADV_VisibilityCounters.samplerLookupSegment

uint XR_ADV_ResolveVisibilityHandle(
    XRAdvancedGpuHandle handle,
    uvec2 segment,
    uint diagnosticCategory)
{
    return XR_ADV_ResolveHandle(
        handle,
        segment.x,
        segment.y,
        diagnosticCategory);
}

uint XR_ADV_ResolveVisibilityStableIndex(
    uint stableIndex,
    uvec2 segment,
    uint diagnosticCategory)
{
    if (stableIndex == 0u ||
        stableIndex >= segment.y ||
        segment.x + stableIndex >= uint(XR_ADV_HandleLookups.records.length()))
    {
#ifdef XR_ADV_DIAGNOSTIC_BOUNDS
        XR_ADV_RecordOutOfBounds(diagnosticCategory);
#endif
        return XR_ADV_INVALID_DENSE_INDEX;
    }

    return XR_ADV_HandleLookups.records[segment.x + stableIndex].denseIndex;
}

bool XR_ADV_TryResolveTextureReference(
    XRAdvancedMaterialTextureBinding logicalBinding,
    out XRAdvancedEncodedTextureReference encodedReference)
{
    XRAdvancedTextureReference logicalReference =
        logicalBinding.textureReference;
    encodedReference = XRAdvancedEncodedTextureReference(
        0u,
        0u,
        logicalReference.fallback,
        XR_ADV_RESOURCE_FLAG_FALLBACK);
    if (!XR_ADV_IsValidHandle(logicalReference.handle))
        return false;

    uint textureDense = XR_ADV_ResolveVisibilityHandle(
        logicalReference.handle,
        VisibilityTextureLookupSegment,
        XR_ADV_DIAGNOSTIC_TEXTURE);
    if (textureDense == XR_ADV_INVALID_DENSE_INDEX ||
        textureDense >= uint(XR_ADV_Textures.records.length()))
        return false;

    XRAdvancedTextureRecord textureRecord =
        XR_ADV_LoadTexture(textureDense);
    if (textureRecord.stableTextureId != logicalReference.handle.index ||
        textureRecord.generation != logicalReference.handle.generation ||
        textureRecord.encodedReferenceIndex >=
            uint(XR_ADV_EncodedTextures.records.length()))
    {
        return false;
    }

    XRAdvancedSamplerReference logicalSampler =
        logicalBinding.samplerReference;
    if (!XR_ADV_IsValidHandle(logicalSampler.handle))
        return false;

    uint samplerDense = XR_ADV_ResolveVisibilityHandle(
        logicalSampler.handle,
        VisibilitySamplerLookupSegment,
        XR_ADV_DIAGNOSTIC_TEXTURE);
    uint encodedSamplerIndex = samplerDense + 1u;
    if (samplerDense == XR_ADV_INVALID_DENSE_INDEX ||
        samplerDense >= uint(XR_ADV_Samplers.records.length()) ||
        encodedSamplerIndex == 0u ||
        encodedSamplerIndex >=
            uint(XR_ADV_EncodedSamplers.records.length()))
    {
        return false;
    }

    XRAdvancedSamplerRecord samplerRecord =
        XR_ADV_LoadSampler(samplerDense);
    if (samplerRecord.stableSamplerId !=
            logicalSampler.handle.index ||
        samplerRecord.generation !=
            logicalSampler.handle.generation)
    {
        return false;
    }

    XRAdvancedEncodedSamplerReference encodedSampler =
        XR_ADV_LoadEncodedSampler(encodedSamplerIndex);
    if ((encodedSampler.flags & XR_ADV_RESOURCE_FLAG_RESIDENT) == 0u)
        return false;

    encodedReference =
        XR_ADV_LoadEncodedTexture(textureRecord.encodedReferenceIndex);
    if ((encodedReference.flags & XR_ADV_RESOURCE_FLAG_RESIDENT) == 0u)
        return false;

    encodedReference.payload1 = encodedSampler.payload0;
    return true;
}

uint XR_ADV_EncodeVisibilityPrimitive(
    uint producer,
    uint primitiveBase,
    uint meshletIndex,
    uint localPrimitiveIndex)
{
    if (producer == XR_ADV_VIS_PRODUCER_STATIC_MESHLET ||
        producer == XR_ADV_VIS_PRODUCER_SKINNED_MESHLET)
    {
        if (meshletIndex > 0xFFFFFFu ||
            localPrimitiveIndex > 0xFFu)
            return XR_ADV_VIS_INVALID;

        uint encoded = (meshletIndex << 8u) | localPrimitiveIndex;
        return encoded != XR_ADV_VIS_INVALID
            ? encoded
            : XR_ADV_VIS_INVALID;
    }

    uint encoded = primitiveBase + localPrimitiveIndex;
    return encoded >= primitiveBase
        ? encoded
        : XR_ADV_VIS_INVALID;
}

uint XR_ADV_PackVisibilityMetadata(
    uint producer,
    uint origin,
    bool masked,
    bool frontFace,
    bool velocityValid,
    uint viewIndex,
    bool selectionValid)
{
    return (producer & XR_ADV_VIS_PRODUCER_MASK) |
        ((origin & 1u) << XR_ADV_VIS_ORIGIN_SHIFT) |
        ((masked ? 1u : 0u) << XR_ADV_VIS_MASKED_SHIFT) |
        ((frontFace ? 1u : 0u) << XR_ADV_VIS_FRONT_FACE_SHIFT) |
        ((velocityValid ? 1u : 0u) <<
            XR_ADV_VIS_VELOCITY_VALID_SHIFT) |
        ((viewIndex & 0xFFu) << XR_ADV_VIS_VIEW_SHIFT) |
        (XR_ADV_VISIBILITY_PAYLOAD_VERSION <<
            XR_ADV_VIS_VERSION_SHIFT) |
        ((selectionValid ? 1u : 0u) <<
            XR_ADV_VIS_SELECTION_VALID_SHIFT);
}

#endif
