#version 450

#include "VisibilityInterface.glslinc"

layout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint index = gl_LocalInvocationID.x;
    if (index == 0u)
        XR_ADV_VisibilityCounters.earlyDraws = 0u;
    else if (index == 1u)
        XR_ADV_VisibilityCounters.deferredCandidates = 0u;
    else if (index == 2u)
        XR_ADV_VisibilityCounters.lateDraws = 0u;
    else if (index == 3u)
        XR_ADV_VisibilityCounters.recoveredCandidates = 0u;
    else if (index == 4u)
        XR_ADV_VisibilityCounters.validPixels = 0u;
    else if (index == 5u)
        XR_ADV_VisibilityCounters.invalidPixels = 0u;
    else if (index == 6u)
        XR_ADV_VisibilityCounters.payloadOverflow = 0u;
    else if (index == 7u)
        XR_ADV_VisibilityCounters.maskedCoveragePixels = 0u;
    else if (index == 8u)
        XR_ADV_VisibilityCounters.decodeOutOfBounds = 0u;
    else if (index == 9u)
        XR_ADV_VisibilityCounters.depthPyramidBuilds = 0u;
    else if (index == 10u)
        XR_ADV_VisibilityCounters.unsupportedDisplacement = 0u;
    else
        XR_ADV_VisibilityCounters.reserved[index - 11u] = 0u;
}
