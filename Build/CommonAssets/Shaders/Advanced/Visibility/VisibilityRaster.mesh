#version 460 core
#extension GL_EXT_mesh_shader : require
#extension GL_ARB_shader_draw_parameters : require

#include "VisibilityInterface.glslinc"

layout(local_size_x = 32) in;
layout(triangles, max_vertices = 64, max_primitives = 126) out;

struct XRAdvancedVisibilityMeshletDescriptor
{
    vec4 boundsSphere;
    uint vertexOffset;
    uint triangleByteOffset;
    uint vertexCount;
    uint triangleCount;
    vec4 cone;
    vec4 coneApex;
    uint packedCone;
    uint reserved0;
    uint reserved1;
    uint reserved2;
};

XR_ADV_VIS_TABLE_LAYOUT(30)
readonly buffer XRAdvancedVisibilityMeshPayloadIndexTable
{
    uint payloadIndices[];
} XR_ADV_VisibilityMeshPayloadIndices;

XR_ADV_VIS_TABLE_LAYOUT(31)
readonly buffer XRAdvancedVisibilityMeshletTable
{
    XRAdvancedVisibilityMeshletDescriptor records[];
} XR_ADV_VisibilityMeshlets;

XR_ADV_VIS_TABLE_LAYOUT(32)
readonly buffer XRAdvancedVisibilityMeshletVertexTable
{
    uint vertexIndices[];
} XR_ADV_VisibilityMeshletVertices;

XR_ADV_VIS_TABLE_LAYOUT(33)
readonly buffer XRAdvancedVisibilityMeshletTriangleTable
{
    uint triangleWords[];
} XR_ADV_VisibilityMeshletTriangles;

XR_ADV_VIS_TABLE_LAYOUT(34)
readonly buffer XRAdvancedVisibilityPositionTable
{
    float values[];
} XR_ADV_VisibilityPositions;

XR_ADV_VIS_TABLE_LAYOUT(35)
readonly buffer XRAdvancedVisibilityPreviousPositionTable
{
    float values[];
} XR_ADV_VisibilityPreviousPositions;

XR_ADV_VIS_TABLE_LAYOUT(36)
readonly buffer XRAdvancedVisibilityUvTable
{
    float values[];
} XR_ADV_VisibilityUvs;

layout(location = 0) flat out uint VisibilityDrawIndex[];
layout(location = 1) flat out uint VisibilitySelectionId[];
layout(location = 2) flat out uint VisibilityProducer[];
layout(location = 3) flat out uint VisibilityViewIndex[];
layout(location = 4) flat out uint VisibilityOrigin[];
layout(location = 5) flat out uint VisibilityVelocityValid[];
layout(location = 6) out vec2 VisibilityCoverageUv[];
layout(location = 7) flat out uint VisibilityPrimitiveBase[];
layout(location = 8) flat out uint VisibilityMeshletIndex[];
layout(location = 9) flat out uint VisibilityMaterialDenseIndex[];

uniform mat4 JitteredViewProjection;
uniform mat4 UnjitteredViewProjection;
uniform mat4 PreviousUnjitteredViewProjection;
uniform uint MeshArgumentBase;
uniform uint VisibilityProducerClass;
uniform uint VisibilityView;
uniform uint VisibilityPhaseOrigin;
uniform uint VisibilityVelocityIsValid;

vec3 XR_ADV_LoadVisibilityPosition(uint vertexIndex)
{
    uint base = vertexIndex * 3u;
    return vec3(
        XR_ADV_VisibilityPositions.values[base],
        XR_ADV_VisibilityPositions.values[base + 1u],
        XR_ADV_VisibilityPositions.values[base + 2u]);
}

vec3 XR_ADV_LoadVisibilityPreviousPosition(uint vertexIndex)
{
    uint base = vertexIndex * 3u;
    return vec3(
        XR_ADV_VisibilityPreviousPositions.values[base],
        XR_ADV_VisibilityPreviousPositions.values[base + 1u],
        XR_ADV_VisibilityPreviousPositions.values[base + 2u]);
}

vec2 XR_ADV_LoadVisibilityUv(uint vertexIndex)
{
    uint base = vertexIndex * 2u;
    return vec2(
        XR_ADV_VisibilityUvs.values[base],
        XR_ADV_VisibilityUvs.values[base + 1u]);
}

uint XR_ADV_ReadVisibilityTriangleIndex(uint byteIndex)
{
    uint word =
        XR_ADV_VisibilityMeshletTriangles.triangleWords[
            byteIndex >> 2u];
    return (word >> ((byteIndex & 3u) * 8u)) & 0xFFu;
}

void main()
{
    uint drawArgumentIndex = MeshArgumentBase + uint(gl_DrawID);
    if (drawArgumentIndex >=
        uint(XR_ADV_VisibilityMeshPayloadIndices.payloadIndices.length()))
    {
        SetMeshOutputsEXT(0u, 0u);
        return;
    }

    uint payloadIndex =
        XR_ADV_VisibilityMeshPayloadIndices.payloadIndices[
            drawArgumentIndex];
    if (payloadIndex >= uint(XR_ADV_VisibilityPayloads.records.length()))
    {
        atomicAdd(XR_ADV_VisibilityCounters.decodeOutOfBounds, 1u);
        SetMeshOutputsEXT(0u, 0u);
        return;
    }

    XRAdvancedVisibilityPayload payload =
        XR_ADV_VisibilityPayloads.records[payloadIndex];
    uint meshletIndex =
        payload.meshletOffset + gl_WorkGroupID.x;
    if (gl_WorkGroupID.x >= payload.meshletCount ||
        meshletIndex >=
            uint(XR_ADV_VisibilityMeshlets.records.length()) ||
        meshletIndex > 0xFFFFFFu)
    {
        atomicAdd(XR_ADV_VisibilityCounters.payloadOverflow, 1u);
        SetMeshOutputsEXT(0u, 0u);
        return;
    }

    uint drawDense = XR_ADV_ResolveVisibilityHandle(
        payload.draw,
        VisibilityDrawLookupSegment,
        XR_ADV_DIAGNOSTIC_DRAW);
    uint geometryDense = XR_ADV_ResolveVisibilityHandle(
        payload.geometry,
        VisibilityGeometryLookupSegment,
        XR_ADV_DIAGNOSTIC_MESH);
    uint materialDense = XR_ADV_ResolveVisibilityHandle(
        payload.material,
        VisibilityMaterialLookupSegment,
        XR_ADV_DIAGNOSTIC_MATERIAL);
    if (drawDense == XR_ADV_INVALID_DENSE_INDEX ||
        geometryDense == XR_ADV_INVALID_DENSE_INDEX ||
        materialDense == XR_ADV_INVALID_DENSE_INDEX)
    {
        atomicAdd(XR_ADV_VisibilityCounters.decodeOutOfBounds, 1u);
        SetMeshOutputsEXT(0u, 0u);
        return;
    }

    XRAdvancedDrawRecord draw = XR_ADV_LoadDraw(drawDense);
    XRAdvancedGeometryRecord geometry =
        XR_ADV_LoadGeometry(geometryDense);
    uint transformDense = XR_ADV_ResolveVisibilityHandle(
        draw.currentTransform,
        VisibilityTransformLookupSegment,
        XR_ADV_DIAGNOSTIC_DRAW);
    uint previousTransformDense = XR_ADV_ResolveVisibilityHandle(
        draw.previousTransform,
        VisibilityTransformLookupSegment,
        XR_ADV_DIAGNOSTIC_DRAW);
    uint editorDense = XR_ADV_ResolveVisibilityHandle(
        draw.editorIdentity,
        VisibilityEditorIdentityLookupSegment,
        XR_ADV_DIAGNOSTIC_DRAW);
    if (transformDense == XR_ADV_INVALID_DENSE_INDEX ||
        previousTransformDense == XR_ADV_INVALID_DENSE_INDEX)
    {
        atomicAdd(XR_ADV_VisibilityCounters.decodeOutOfBounds, 1u);
        SetMeshOutputsEXT(0u, 0u);
        return;
    }

    XRAdvancedTransformRecord currentTransform =
        XR_ADV_LoadTransform(transformDense);
    XRAdvancedTransformRecord previousTransform =
        XR_ADV_LoadTransform(previousTransformDense);
    XRAdvancedVisibilityMeshletDescriptor meshlet =
        XR_ADV_VisibilityMeshlets.records[meshletIndex];
    if (meshlet.vertexCount > 64u ||
        meshlet.triangleCount > 126u)
    {
        atomicAdd(XR_ADV_VisibilityCounters.payloadOverflow, 1u);
        SetMeshOutputsEXT(0u, 0u);
        return;
    }

    SetMeshOutputsEXT(meshlet.vertexCount, meshlet.triangleCount);
    uint localInvocation = gl_LocalInvocationID.x;
    if (localInvocation < meshlet.vertexCount)
    {
        uint localVertex =
            XR_ADV_VisibilityMeshletVertices.vertexIndices[
                meshlet.vertexOffset + localInvocation];
        uint currentVertex = payload.vertexOffset + localVertex;
        uint previousVertex =
            payload.previousVertexOffset + localVertex;
        uint uvVertex = geometry.vertexBase + localVertex;
        vec3 position =
            XR_ADV_LoadVisibilityPosition(currentVertex);
        vec3 previousPosition =
            XR_ADV_LoadVisibilityPreviousPosition(previousVertex);
        vec4 worldPosition =
            vec4(position, 1.0) * currentTransform.world;
        vec4 previousWorldPosition =
            vec4(previousPosition, 1.0) * previousTransform.world;
        gl_MeshVerticesEXT[localInvocation].gl_Position =
            worldPosition * JitteredViewProjection;

        vec4 currentClip =
            worldPosition * UnjitteredViewProjection;
        vec4 previousClip =
            previousWorldPosition *
            PreviousUnjitteredViewProjection;
        bool temporalInputsValid =
            !any(isnan(currentClip)) &&
            !any(isinf(currentClip)) &&
            !any(isnan(previousClip)) &&
            !any(isinf(previousClip));

        VisibilityDrawIndex[localInvocation] = payload.draw.index;
        VisibilitySelectionId[localInvocation] =
            editorDense != XR_ADV_INVALID_DENSE_INDEX
                ? XR_ADV_LoadEditorIdentity(editorDense).selectionId
                : XR_ADV_VIS_INVALID;
        VisibilityProducer[localInvocation] =
            VisibilityProducerClass;
        VisibilityViewIndex[localInvocation] = VisibilityView;
        VisibilityOrigin[localInvocation] = VisibilityPhaseOrigin;
        VisibilityVelocityValid[localInvocation] =
            VisibilityVelocityIsValid != 0u &&
            temporalInputsValid
                ? 1u
                : 0u;
        VisibilityCoverageUv[localInvocation] =
            XR_ADV_LoadVisibilityUv(uvVertex);
        VisibilityPrimitiveBase[localInvocation] = 0u;
        VisibilityMeshletIndex[localInvocation] = meshletIndex;
        VisibilityMaterialDenseIndex[localInvocation] =
            materialDense;
    }

    for (uint primitive = localInvocation;
         primitive < meshlet.triangleCount;
         primitive += gl_WorkGroupSize.x)
    {
        uint byteIndex =
            meshlet.triangleByteOffset + primitive * 3u;
        gl_PrimitiveTriangleIndicesEXT[primitive] = uvec3(
            XR_ADV_ReadVisibilityTriangleIndex(byteIndex),
            XR_ADV_ReadVisibilityTriangleIndex(byteIndex + 1u),
            XR_ADV_ReadVisibilityTriangleIndex(byteIndex + 2u));
        gl_MeshPrimitivesEXT[primitive].gl_PrimitiveID =
            int(primitive);
    }
}
