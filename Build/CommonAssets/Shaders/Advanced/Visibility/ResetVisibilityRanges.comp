#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) writeonly buffer VisibilityRangeCounts
{
    uint Counts[];
};

uniform uint RangeCount;

void main()
{
    uint range = gl_GlobalInvocationID.x;
    if (range < RangeCount)
        Counts[range] = 0u;
}
