#version 450

#include "VisibilityInterface.glslinc"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#if defined(XR_ADV_VISIBILITY_ARRAY)
layout(binding = 0) uniform usampler2DArray VisibilityIdentity;
layout(binding = 1) uniform usampler2DArray VisibilityMetadata;
layout(binding = 2) uniform usampler2DArray VisibilitySelection;
layout(binding = 3) uniform sampler2DArray VisibilityDepth;
layout(rgba8, binding = 4) writeonly uniform image2DArray DebugOutput;
#else
layout(binding = 0) uniform usampler2D VisibilityIdentity;
layout(binding = 1) uniform usampler2D VisibilityMetadata;
layout(binding = 2) uniform usampler2D VisibilitySelection;
layout(binding = 3) uniform sampler2D VisibilityDepth;
layout(rgba8, binding = 4) writeonly uniform image2D DebugOutput;
#endif

uniform uint DebugView;

vec3 XR_ADV_VisibilityHashColor(uint value)
{
    value ^= value >> 16u;
    value *= 0x7FEB352Du;
    value ^= value >> 15u;
    value *= 0x846CA68Bu;
    value ^= value >> 16u;
    return vec3(
        float(value & 0xFFu),
        float((value >> 8u) & 0xFFu),
        float((value >> 16u) & 0xFFu)) / 255.0;
}

void main()
{
#if defined(XR_ADV_VISIBILITY_ARRAY)
    ivec3 pixel = ivec3(gl_GlobalInvocationID);
    ivec3 outputSize = imageSize(DebugOutput);
#else
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(DebugOutput);
#endif
    if (any(greaterThanEqual(pixel, outputSize)))
        return;

    uvec2 identity =
        texelFetch(VisibilityIdentity, pixel, 0).rg;
    uint metadata =
        texelFetch(VisibilityMetadata, pixel, 0).r;
    uint selection =
        texelFetch(VisibilitySelection, pixel, 0).r;
    float depth =
        texelFetch(VisibilityDepth, pixel, 0).r;
    uint version = (metadata >> XR_ADV_VIS_VERSION_SHIFT) & 0xFFu;
    bool valid =
        identity.x != 0u &&
        identity.x != XR_ADV_VIS_INVALID &&
        identity.y != XR_ADV_VIS_INVALID &&
        metadata != XR_ADV_VIS_INVALID &&
        version == XR_ADV_VISIBILITY_PAYLOAD_VERSION;

    uint drawDense = valid
        ? XR_ADV_ResolveVisibilityStableIndex(
            identity.x,
            VisibilityDrawLookupSegment,
            XR_ADV_DIAGNOSTIC_DRAW)
        : XR_ADV_INVALID_DENSE_INDEX;
    valid = valid && drawDense != XR_ADV_INVALID_DENSE_INDEX;

    uint materialId = 0u;
    uint shadingKernelId = 0u;
    if (valid)
    {
        XRAdvancedDrawRecord draw = XR_ADV_LoadDraw(drawDense);
        uint materialDense = XR_ADV_ResolveVisibilityHandle(
            draw.material,
            VisibilityMaterialLookupSegment,
            XR_ADV_DIAGNOSTIC_MATERIAL);
        if (materialDense == XR_ADV_INVALID_DENSE_INDEX)
        {
            valid = false;
        }
        else
        {
            XRAdvancedMaterialRecord material =
                XR_ADV_LoadMaterial(materialDense);
            materialId = draw.material.index;
            shadingKernelId = material.shadingKernelId;
            XRAdvancedGpuHandle kernelHandle =
                XRAdvancedGpuHandle(
                    material.shadingKernelId,
                    material.shadingKernelGeneration);
            valid = XR_ADV_ResolveVisibilityHandle(
                    kernelHandle,
                    VisibilityShadingKernelLookupSegment,
                    XR_ADV_DIAGNOSTIC_MATERIAL) !=
                XR_ADV_INVALID_DENSE_INDEX;
        }
    }

    vec3 color = vec3(0.0);
    if (DebugView == 1u)
        color = vec3(vec2(identity), 0.0) /
            vec3(65535.0, 65535.0, 1.0);
    else if (DebugView == 2u)
        color = XR_ADV_VisibilityHashColor(identity.x);
    else if (DebugView == 3u)
        color = XR_ADV_VisibilityHashColor(identity.y);
    else if (DebugView == 4u)
        color = valid
            ? XR_ADV_VisibilityHashColor(materialId)
            : vec3(1.0, 0.0, 1.0);
    else if (DebugView == 5u)
        color = valid
            ? XR_ADV_VisibilityHashColor(shadingKernelId)
            : vec3(1.0, 0.0, 1.0);
    else if (DebugView == 6u)
        color = selection != XR_ADV_VIS_INVALID
            ? XR_ADV_VisibilityHashColor(selection)
            : vec3(0.0);
    else if (DebugView == 7u)
        color = ((metadata >> XR_ADV_VIS_ORIGIN_SHIFT) & 1u) != 0u
            ? vec3(1.0, 0.5, 0.0)
            : vec3(0.0, 0.7, 1.0);
    else if (DebugView == 8u)
        color = valid
            ? vec3(0.0, 0.7, 0.0)
            : vec3(1.0, 0.0, 1.0);
    else if (DebugView == 9u)
        color = vec3(depth);

    imageStore(DebugOutput, pixel, vec4(color, 1.0));
}
