#version 450

#include "VisibilityInterface.glslinc"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#if defined(XR_ADV_VISIBILITY_ARRAY)
layout(rg32ui, binding = 0) writeonly uniform uimage2DArray VisibilityIdentity;
layout(r32ui, binding = 1) writeonly uniform uimage2DArray VisibilityMetadata;
layout(r32ui, binding = 2) writeonly uniform uimage2DArray VisibilitySelection;
#else
layout(rg32ui, binding = 0) writeonly uniform uimage2D VisibilityIdentity;
layout(r32ui, binding = 1) writeonly uniform uimage2D VisibilityMetadata;
layout(r32ui, binding = 2) writeonly uniform uimage2D VisibilitySelection;
#endif

void main()
{
#if defined(XR_ADV_VISIBILITY_ARRAY)
    ivec3 pixel = ivec3(gl_GlobalInvocationID);
    ivec3 size = imageSize(VisibilityIdentity);
#else
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(VisibilityIdentity);
#endif
    if (any(greaterThanEqual(pixel, size)))
        return;

    imageStore(
        VisibilityIdentity,
        pixel,
        uvec4(XR_ADV_VIS_INVALID));
    imageStore(
        VisibilityMetadata,
        pixel,
        uvec4(XR_ADV_VIS_INVALID));
    imageStore(
        VisibilitySelection,
        pixel,
        uvec4(XR_ADV_VIS_INVALID));
}
