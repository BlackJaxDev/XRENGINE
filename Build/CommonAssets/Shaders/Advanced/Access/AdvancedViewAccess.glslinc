#ifndef XR_ADVANCED_VIEW_ACCESS_GLSLINC
#define XR_ADVANCED_VIEW_ACCESS_GLSLINC

#include "AdvancedDiagnostics.glslinc"

const uint XR_ADV_VIEW_FRAMEBUFFER_TEXTURE_Y_DOWN = 1u << 6u;
const uint XR_ADV_VIEW_TEMPORAL_HISTORY_VALID = 1u << 7u;

struct XRAdvancedViewRecord
{
    mat4 view;
    mat4 projectionJittered;
    mat4 projectionUnjittered;
    mat4 viewProjectionJittered;
    mat4 viewProjectionUnjittered;
    mat4 previousView;
    mat4 previousProjectionJittered;
    mat4 previousProjectionUnjittered;
    mat4 previousViewProjectionJittered;
    mat4 previousViewProjectionUnjittered;
    mat4 inverseViewProjectionJittered;
    mat4 inverseViewProjectionUnjittered;
    vec4 cameraPositionAndNear;
    vec4 cameraForwardAndFar;
    vec4 renderSizeAndInverse;
    vec4 outputSizeAndInverse;
    vec4 currentAndPreviousJitter;
    vec4 depthParams;
    uint viewId;
    uint outputLayer;
    uint flags;
    uint historyKeyLo;
    uint historyKeyHi;
    uint viewGeneration;
    uint viewMaskLo;
    uint viewMaskHi;
    vec4 foveationCenterAndBias;
    vec4 foveationRadii;
};

// Analytic reconstruction keeps full-rate visibility. Peripheral sampling only
// widens the texture footprint; it never removes geometry or borrows another eye.
float XR_ADV_FoveationDerivativeScale(XRAdvancedViewRecord viewRecord, vec2 targetUv)
{
    if (viewRecord.foveationCenterAndBias.w == 0.0)
        return 1.0;
    vec2 delta = (targetUv - viewRecord.foveationCenterAndBias.xy) * 2.0;
    float eccentricity = length(delta);
    float guardRadius = viewRecord.foveationRadii.y;
    float outerRadius = viewRecord.foveationRadii.w;
    float peripheral = smoothstep(guardRadius, outerRadius, eccentricity);
    return exp2(peripheral * viewRecord.foveationCenterAndBias.z);
}

XR_ADV_TABLE_LAYOUT(XR_ADV_BINDING_VIEWS) readonly buffer XRAdvancedViewTable
{
    XRAdvancedViewRecord records[];
} XR_ADV_Views;

XRAdvancedViewRecord XR_ADV_LoadView(uint denseIndex)
{
#ifdef XR_ADV_DIAGNOSTIC_BOUNDS
    if (denseIndex >= uint(XR_ADV_Views.records.length()))
    {
        XR_ADV_RecordOutOfBounds(XR_ADV_DIAGNOSTIC_VIEW);
        denseIndex = 0u;
    }
#endif
    // Materialize fields explicitly so storage-layout conversion does not emit
    // OpCopyLogical of the entire matrix-bearing record. SPIR-V 1.6's optimizer
    // can otherwise fold a subsequent field extraction into an invalid ID.
    // Dead fields are still eliminated by the performance optimization pass.
    XRAdvancedViewRecord result;
    result.view = XR_ADV_Views.records[denseIndex].view;
    result.projectionJittered = XR_ADV_Views.records[denseIndex].projectionJittered;
    result.projectionUnjittered = XR_ADV_Views.records[denseIndex].projectionUnjittered;
    result.viewProjectionJittered = XR_ADV_Views.records[denseIndex].viewProjectionJittered;
    result.viewProjectionUnjittered = XR_ADV_Views.records[denseIndex].viewProjectionUnjittered;
    result.previousView = XR_ADV_Views.records[denseIndex].previousView;
    result.previousProjectionJittered = XR_ADV_Views.records[denseIndex].previousProjectionJittered;
    result.previousProjectionUnjittered = XR_ADV_Views.records[denseIndex].previousProjectionUnjittered;
    result.previousViewProjectionJittered = XR_ADV_Views.records[denseIndex].previousViewProjectionJittered;
    result.previousViewProjectionUnjittered = XR_ADV_Views.records[denseIndex].previousViewProjectionUnjittered;
    result.inverseViewProjectionJittered = XR_ADV_Views.records[denseIndex].inverseViewProjectionJittered;
    result.inverseViewProjectionUnjittered = XR_ADV_Views.records[denseIndex].inverseViewProjectionUnjittered;
    result.cameraPositionAndNear = XR_ADV_Views.records[denseIndex].cameraPositionAndNear;
    result.cameraForwardAndFar = XR_ADV_Views.records[denseIndex].cameraForwardAndFar;
    result.renderSizeAndInverse = XR_ADV_Views.records[denseIndex].renderSizeAndInverse;
    result.outputSizeAndInverse = XR_ADV_Views.records[denseIndex].outputSizeAndInverse;
    result.currentAndPreviousJitter = XR_ADV_Views.records[denseIndex].currentAndPreviousJitter;
    result.depthParams = XR_ADV_Views.records[denseIndex].depthParams;
    result.viewId = XR_ADV_Views.records[denseIndex].viewId;
    result.outputLayer = XR_ADV_Views.records[denseIndex].outputLayer;
    result.flags = XR_ADV_Views.records[denseIndex].flags;
    result.historyKeyLo = XR_ADV_Views.records[denseIndex].historyKeyLo;
    result.historyKeyHi = XR_ADV_Views.records[denseIndex].historyKeyHi;
    result.viewGeneration = XR_ADV_Views.records[denseIndex].viewGeneration;
    result.viewMaskLo = XR_ADV_Views.records[denseIndex].viewMaskLo;
    result.viewMaskHi = XR_ADV_Views.records[denseIndex].viewMaskHi;
    result.foveationCenterAndBias = XR_ADV_Views.records[denseIndex].foveationCenterAndBias;
    result.foveationRadii = XR_ADV_Views.records[denseIndex].foveationRadii;
    return result;
}

// Fragment locations and storage images use physical framebuffer coordinates.
// The sealed view flag bridges those coordinates to the clip convention used by
// the matrices without making the shader backend-specific.
vec2 XR_ADV_ClipNdcToFramebufferUv(
    XRAdvancedViewRecord viewRecord,
    vec2 clipNdc)
{
    vec2 framebufferUv = clipNdc * 0.5 + 0.5;
    if ((viewRecord.flags & XR_ADV_VIEW_FRAMEBUFFER_TEXTURE_Y_DOWN) != 0u)
        framebufferUv.y = 1.0 - framebufferUv.y;
    return framebufferUv;
}

vec2 XR_ADV_FramebufferUvToClipNdc(
    XRAdvancedViewRecord viewRecord,
    vec2 framebufferUv)
{
    if ((viewRecord.flags & XR_ADV_VIEW_FRAMEBUFFER_TEXTURE_Y_DOWN) != 0u)
        framebufferUv.y = 1.0 - framebufferUv.y;
    return framebufferUv * 2.0 - 1.0;
}
vec4 XR_ADV_CurrentJitteredClip(
    XRAdvancedViewRecord viewRecord,
    vec3 worldPosition)
{
    return XR_ADV_TransformRowVector(
        vec4(worldPosition, 1.0),
        viewRecord.viewProjectionJittered);
}

vec4 XR_ADV_PreviousJitteredClip(
    XRAdvancedViewRecord viewRecord,
    vec3 previousWorldPosition)
{
    return XR_ADV_TransformRowVector(
        vec4(previousWorldPosition, 1.0),
        viewRecord.previousViewProjectionJittered);
}

#endif
