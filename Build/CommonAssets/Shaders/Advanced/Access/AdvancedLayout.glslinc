#ifndef XR_ADVANCED_LAYOUT_GLSLINC
#define XR_ADVANCED_LAYOUT_GLSLINC

#if defined(XR_ADV_BACKEND_VULKAN)
#define XR_ADV_TABLE_LAYOUT(bindingIndex) layout(set = XR_ADV_GLOBAL_SET, binding = bindingIndex, std430, row_major)
#define XR_ADV_RESOURCE_LAYOUT(bindingIndex) layout(set = XR_ADV_RESOURCE_SET, binding = bindingIndex)
#elif defined(XR_ADV_BACKEND_OPENGL)
#define XR_ADV_TABLE_LAYOUT(bindingIndex) layout(binding = bindingIndex, std430, row_major)
#define XR_ADV_RESOURCE_LAYOUT(bindingIndex) layout(binding = bindingIndex)
#else
#error "An advanced shader backend must be selected."
#endif

#define XR_ADV_MATRIX_STORAGE_ROW_MAJOR 1
#define XR_ADV_VECTOR_CONVENTION_ROW_VECTOR 1

#include "../Generated/AdvancedRecords.glslinc"

bool XR_ADV_IsValidHandle(XRAdvancedGpuHandle handle)
{
    return handle.index != 0u && handle.generation != 0u;
}

bool XR_ADV_HandleMatches(
    XRAdvancedGpuHandle handle,
    uint stableId,
    uint generation)
{
    return handle.index == stableId && handle.generation == generation;
}

vec4 XR_ADV_TransformRowVector(vec4 value, mat4 matrixValue)
{
    return value * matrixValue;
}

vec3 XR_ADV_TransformPositionRowVector(vec3 value, mat4 matrixValue)
{
    return (vec4(value, 1.0) * matrixValue).xyz;
}

vec3 XR_ADV_TransformDirectionRowVector(vec3 value, mat4 matrixValue)
{
    return (vec4(value, 0.0) * matrixValue).xyz;
}

#endif
