#ifndef XR_ADVANCED_LIGHT_ACCESS_GLSLINC
#define XR_ADVANCED_LIGHT_ACCESS_GLSLINC

#include "AdvancedDiagnostics.glslinc"

XR_ADV_TABLE_LAYOUT(XR_ADV_BINDING_LIGHTS) readonly buffer XRAdvancedLightTable
{
    XRAdvancedLightRecord records[];
} XR_ADV_Lights;

XR_ADV_TABLE_LAYOUT(XR_ADV_BINDING_PROBES) readonly buffer XRAdvancedProbeTable
{
    XRAdvancedProbeRecord records[];
} XR_ADV_Probes;

XR_ADV_TABLE_LAYOUT(XR_ADV_BINDING_ENVIRONMENTS) readonly buffer XRAdvancedEnvironmentTable
{
    XRAdvancedEnvironmentRecord records[];
} XR_ADV_Environments;

XR_ADV_TABLE_LAYOUT(XR_ADV_BINDING_DECALS) readonly buffer XRAdvancedDecalTable
{
    XRAdvancedDecalRecord records[];
} XR_ADV_Decals;

XR_ADV_TABLE_LAYOUT(XR_ADV_BINDING_GI_RESOURCES) readonly buffer XRAdvancedGiResourceTable
{
    XRAdvancedGiResourceRecord records[];
} XR_ADV_GiResources;

XRAdvancedLightRecord XR_ADV_LoadLight(uint denseIndex)
{
#ifdef XR_ADV_DIAGNOSTIC_BOUNDS
    if (denseIndex >= uint(XR_ADV_Lights.records.length()))
    {
        XR_ADV_RecordOutOfBounds(XR_ADV_DIAGNOSTIC_LIGHT);
        denseIndex = 0u;
    }
#endif
    return XR_ADV_Lights.records[denseIndex];
}

XRAdvancedProbeRecord XR_ADV_LoadProbe(uint denseIndex)
{
#ifdef XR_ADV_DIAGNOSTIC_BOUNDS
    if (denseIndex >= uint(XR_ADV_Probes.records.length()))
    {
        XR_ADV_RecordOutOfBounds(XR_ADV_DIAGNOSTIC_GLOBAL_RESOURCE);
        denseIndex = 0u;
    }
#endif
    return XR_ADV_Probes.records[denseIndex];
}

XRAdvancedEnvironmentRecord XR_ADV_LoadEnvironment(uint denseIndex)
{
#ifdef XR_ADV_DIAGNOSTIC_BOUNDS
    if (denseIndex >= uint(XR_ADV_Environments.records.length()))
    {
        XR_ADV_RecordOutOfBounds(XR_ADV_DIAGNOSTIC_GLOBAL_RESOURCE);
        denseIndex = 0u;
    }
#endif
    return XR_ADV_Environments.records[denseIndex];
}

XRAdvancedDecalRecord XR_ADV_LoadDecal(uint denseIndex)
{
#ifdef XR_ADV_DIAGNOSTIC_BOUNDS
    if (denseIndex >= uint(XR_ADV_Decals.records.length()))
    {
        XR_ADV_RecordOutOfBounds(XR_ADV_DIAGNOSTIC_GLOBAL_RESOURCE);
        denseIndex = 0u;
    }
#endif
    return XR_ADV_Decals.records[denseIndex];
}

XRAdvancedGiResourceRecord XR_ADV_LoadGiResource(uint denseIndex)
{
#ifdef XR_ADV_DIAGNOSTIC_BOUNDS
    if (denseIndex >= uint(XR_ADV_GiResources.records.length()))
    {
        XR_ADV_RecordOutOfBounds(XR_ADV_DIAGNOSTIC_GLOBAL_RESOURCE);
        denseIndex = 0u;
    }
#endif
    return XR_ADV_GiResources.records[denseIndex];
}

#endif
