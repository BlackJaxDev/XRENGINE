#ifndef XR_ADVANCED_CLASSIFICATION_INTERFACE_GLSLINC
#define XR_ADVANCED_CLASSIFICATION_INTERFACE_GLSLINC

#include "Advanced/Shading/AdvancedShadingInterface.glslinc"

#ifndef XR_ADV_CLASSIFICATION_SET
#define XR_ADV_CLASSIFICATION_SET 1
#endif

#if defined(XR_ADV_BACKEND_VULKAN)
#define XR_ADV_CLASSIFICATION_PASS_LAYOUT(bindingIndex) layout(set = XR_ADV_CLASSIFICATION_SET, binding = bindingIndex)
#define XR_ADV_CLASSIFICATION_IMAGE_LAYOUT(formatName, bindingIndex) layout(formatName, set = XR_ADV_CLASSIFICATION_SET, binding = bindingIndex)
#elif defined(XR_ADV_BACKEND_OPENGL)
#define XR_ADV_CLASSIFICATION_PASS_LAYOUT(bindingIndex) layout(binding = 75 + bindingIndex)
#define XR_ADV_CLASSIFICATION_IMAGE_LAYOUT(formatName, bindingIndex) layout(formatName, binding = 5)
#else
#define XR_ADV_CLASSIFICATION_PASS_LAYOUT(bindingIndex) layout(binding = bindingIndex)
#define XR_ADV_CLASSIFICATION_IMAGE_LAYOUT(formatName, bindingIndex) layout(formatName, binding = bindingIndex)
#endif

struct XRAdvancedActiveTile
{
    uint packedTileCoord;
    uint viewIndex;
    uint activePixelCount;
    uint primaryKernelId;
};

struct XRAdvancedKernelTile
{
    uint activeTileIndex;
    uint shadingKernelId;
    uint pixelCount;
    uint flags;
};

// Keep these values aligned with AdvancedKernelTileRecord. The derivative bit
// carries the immutable dense-kernel requirement through indirect dispatch.
#define XR_ADV_KERNEL_TILE_FULL 1u
#define XR_ADV_KERNEL_TILE_MIXED 2u
#define XR_ADV_KERNEL_TILE_ANALYTICAL_DERIVATIVES 4u
#define XR_ADV_KERNEL_REQUIRED_ANALYTICAL_DERIVATIVES (1u << 11u)

struct XRAdvancedClassificationCounters
{
    uint activeTileCount;
    uint kernelTileCount;
    uint classifiedPixelCount;
    uint backgroundPixelCount;
    uint overflowFlags;
    uint droppedPixelCount;
    uint reserved0;
    uint reserved1;
};

struct XRAdvancedDispatchIndirectCommand
{
    uint workGroupCountX;
    uint workGroupCountY;
    uint workGroupCountZ;
    uint reserved;
};

XR_ADV_CLASSIFICATION_PASS_LAYOUT(4) buffer XRAdvancedActiveTilesBuffer
{
    XRAdvancedActiveTile records[];
} XR_ADV_ActiveTiles;

XR_ADV_CLASSIFICATION_PASS_LAYOUT(5) buffer XRAdvancedKernelTilesBuffer
{
    XRAdvancedKernelTile records[];
} XR_ADV_KernelTiles;

XR_ADV_CLASSIFICATION_PASS_LAYOUT(6) buffer XRAdvancedClassificationCountersBuffer
{
    XRAdvancedClassificationCounters counters;
} XR_ADV_ClassificationCounters;

XR_ADV_CLASSIFICATION_PASS_LAYOUT(7) buffer XRAdvancedDispatchIndirectBuffer
{
    XRAdvancedDispatchIndirectCommand commands[];
} XR_ADV_ClassificationDispatch;

// One initialized compact range per dense kernel. Each range has totalTiles
// capacity: a tile emits at most one membership for a particular kernel.
// counts[0, MAX) hold the membership count of each kernel over the views classified so far.
// Then one block of MAX entries per view holds the count of each kernel after that view
// (BuildClassificationIndirect writes it, clamped to the range capacity). Views classify in
// order with a barrier between them, so the memberships of view v of kernel k are the range
// [end(v - 1), end(v)) of that kernel's list, with end(-1) = 0.
XR_ADV_CLASSIFICATION_PASS_LAYOUT(9) buffer XRAdvancedKernelCountsBuffer
{
    uint counts[];
} XR_ADV_KernelCounts;

// Index of the count of kernel k after view v in XR_ADV_KernelCounts.counts.
#define XR_ADV_KERNEL_VIEW_END_INDEX(view, kernel) (XR_ADV_MAX_SHADING_KERNELS * ((view) + 1u) + (kernel))
// Index of the indirect command of kernel k for view v. The commands of all views come first,
// then the overflow repair command.
#define XR_ADV_KERNEL_DISPATCH_INDEX(view, kernel) (XR_ADV_MAX_SHADING_KERNELS * (view) + (kernel))
#define XR_ADV_OVERFLOW_REPAIR_DISPATCH_INDEX(viewCount) (XR_ADV_MAX_SHADING_KERNELS * max((viewCount), 1u))

#endif // XR_ADVANCED_CLASSIFICATION_INTERFACE_GLSLINC
