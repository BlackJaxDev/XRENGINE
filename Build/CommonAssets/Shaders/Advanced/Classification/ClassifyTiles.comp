#version 450
#include "ClassificationInterface.glslinc"
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
#if defined(XR_ADV_VISIBILITY_ARRAY)
XR_ADV_CLASSIFICATION_PASS_LAYOUT(0) uniform usampler2DArray VisibilityIdentity;
XR_ADV_CLASSIFICATION_PASS_LAYOUT(1) uniform usampler2DArray VisibilityMetadata;
#define XR_ADV_CLASSIFY_COORD(pixel) ivec3(pixel, u_Push.viewIndex)
#else
XR_ADV_CLASSIFICATION_PASS_LAYOUT(0) uniform usampler2D VisibilityIdentity;
XR_ADV_CLASSIFICATION_PASS_LAYOUT(1) uniform usampler2D VisibilityMetadata;
#define XR_ADV_CLASSIFY_COORD(pixel) ivec2(pixel)
#endif
shared uint activePixels;
shared uint backgroundPixels;
shared uint kernelHistogram[128];

void main()
{
    uint localIndex = gl_LocalInvocationIndex;
    if (localIndex == 0u) { activePixels = 0u; backgroundPixels = 0u; }
    if (localIndex < XR_ADV_MAX_SHADING_KERNELS) kernelHistogram[localIndex] = 0u;
    barrier();
    uvec2 pixel = gl_WorkGroupID.xy * 16u + gl_LocalInvocationID.xy;
    if (all(lessThan(pixel, u_Push.screenExtent)))
    {
        uvec2 identity = texelFetch(VisibilityIdentity, XR_ADV_CLASSIFY_COORD(pixel), 0).rg;
        uint metadata = texelFetch(VisibilityMetadata, XR_ADV_CLASSIFY_COORD(pixel), 0).r;
        if (identity.x == 0u || identity.x == XR_ADV_VIS_INVALID)
            atomicAdd(backgroundPixels, 1u);
        else
        {
            uint materialDense, kernelDense;
            if (!XR_ADV_TryResolvePixelMaterial(identity, metadata, materialDense, kernelDense) ||
                ((metadata >> XR_ADV_VIS_VIEW_SHIFT) & 0xFFu) != u_Push.viewIndex)
            {
                atomicOr(XR_ADV_ClassificationCounters.counters.overflowFlags, XR_ADV_CLASSIFICATION_INVALID_IDENTITY);
                atomicAdd(XR_ADV_ClassificationCounters.counters.droppedPixelCount, 1u);
            }
            else if (kernelDense >= XR_ADV_MAX_SHADING_KERNELS)
                atomicOr(XR_ADV_ClassificationCounters.counters.overflowFlags, XR_ADV_CLASSIFICATION_OVERFLOW_KERNELS);
            else
            {
                atomicAdd(activePixels, 1u);
                atomicAdd(kernelHistogram[kernelDense], 1u);
            }
        }
    }
    barrier();
    if (localIndex != 0u) return;
    atomicAdd(XR_ADV_ClassificationCounters.counters.backgroundPixelCount, backgroundPixels);
    atomicAdd(XR_ADV_ClassificationCounters.counters.classifiedPixelCount, activePixels);
    if (activePixels == 0u) return;

    uint tileCapacity = XR_ADV_TotalTileCount();
    uint tileIndex = atomicAdd(XR_ADV_ClassificationCounters.counters.activeTileCount, 1u);
    if (tileIndex >= min(tileCapacity, uint(XR_ADV_ActiveTiles.records.length())))
    {
        atomicOr(XR_ADV_ClassificationCounters.counters.overflowFlags, XR_ADV_CLASSIFICATION_OVERFLOW_TILES);
        return;
    }
    uint primaryKernel = 0u;
    for (uint k = 1u; k < XR_ADV_MAX_SHADING_KERNELS; ++k)
        if (kernelHistogram[k] > kernelHistogram[primaryKernel]) primaryKernel = k;
    XR_ADV_ActiveTiles.records[tileIndex] = XRAdvancedActiveTile(
        gl_WorkGroupID.x | (gl_WorkGroupID.y << 16u), u_Push.viewIndex, activePixels, primaryKernel);
    for (uint k = 0u; k < XR_ADV_MAX_SHADING_KERNELS; ++k)
    {
        if (kernelHistogram[k] == 0u) continue;
        uint rangeIndex = atomicAdd(XR_ADV_KernelCounts.counts[k], 1u);
        uint destination = k * tileCapacity + rangeIndex;
        atomicAdd(XR_ADV_ClassificationCounters.counters.kernelTileCount, 1u);
        if (rangeIndex >= tileCapacity || destination >= min(u_Push.maxKernelTiles, uint(XR_ADV_KernelTiles.records.length())))
        {
            atomicOr(XR_ADV_ClassificationCounters.counters.overflowFlags, XR_ADV_CLASSIFICATION_OVERFLOW_MEMBERSHIPS);
            continue;
        }
        // The dense kernel owns its layout, coverage and derivative contract;
        // material rows remain data and the tile retains its exact view index.
        XR_ADV_KernelTiles.records[destination] = XRAdvancedKernelTile(
            tileIndex, k, kernelHistogram[k], kernelHistogram[k] == activePixels ? 1u : 2u);
    }
}
