#version 450
#include "ClassificationInterface.glslinc"
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

// Per-kernel membership counts of this dispatch, reduced to the kernel tile total.
shared uint kernelTileTotal;

void main()
{
    uint kernel = gl_GlobalInvocationID.x;
    if (gl_LocalInvocationIndex == 0u)
        kernelTileTotal = 0u;
    barrier();

    // The kernel tile total is the sum of the per-kernel membership counts. ClassifyTiles
    // counts each membership only once, in its kernel range, so the tiles do not contend on
    // one global counter. The counts accumulate over the views of the frame, and this pass
    // runs after each view, so the value written after the last view is the frame total.
    bool validKernel = kernel < XR_ADV_MAX_SHADING_KERNELS && kernel < uint(XR_ADV_KernelCounts.counts.length());
    uint membershipCount = validKernel ? XR_ADV_KernelCounts.counts[kernel] : 0u;
    if (membershipCount != 0u)
        atomicAdd(kernelTileTotal, membershipCount);
    barrier();
    if (gl_LocalInvocationIndex == 0u)
    {
        XR_ADV_ClassificationCounters.counters.kernelTileCount = kernelTileTotal;
        // The overflow repair dispatch reads the command after the kernel commands of all views.
        // It launches the full tile grid of one view only when classification overflowed, and no
        // work groups otherwise. Every view is classified before any view is shaded, so the
        // command written after the last view matches the overflow flag that the repair kernel
        // reads, and each view's repair dispatch covers that view's full grid.
        uint repairIndex = XR_ADV_OVERFLOW_REPAIR_DISPATCH_INDEX(u_Push.viewCount);
        if (repairIndex < uint(XR_ADV_ClassificationDispatch.commands.length()))
        {
            bool overflow = XR_ADV_ClassificationCounters.counters.overflowFlags != 0u;
            XR_ADV_ClassificationDispatch.commands[repairIndex] = XRAdvancedDispatchIndirectCommand(
                overflow ? u_Push.tilesCount.x : 0u, overflow ? u_Push.tilesCount.y : 1u, 1u, 0u);
        }
    }

    uint view = u_Push.viewIndex;
    uint commandIndex = XR_ADV_KERNEL_DISPATCH_INDEX(view, kernel);
    uint endIndex = XR_ADV_KERNEL_VIEW_END_INDEX(view, kernel);
    if (!validKernel || commandIndex >= uint(XR_ADV_ClassificationDispatch.commands.length()) ||
        endIndex >= uint(XR_ADV_KernelCounts.counts.length())) return;
    uint capacity = XR_ADV_TotalTileCount();
    bool rangeFits = capacity != 0u && kernel <= u_Push.maxKernelTiles / capacity;
    uint rangeBase = rangeFits ? kernel * capacity : u_Push.maxKernelTiles;
    uint available = rangeFits ? min(capacity, u_Push.maxKernelTiles - rangeBase) : 0u;
    // The memberships of this view follow those of the earlier views in the kernel's list.
    // Store the end of this view's range for the shading kernel and the next view.
    uint viewEnd = min(membershipCount, available);
    uint viewBase = view == 0u ? 0u : min(XR_ADV_KernelCounts.counts[XR_ADV_KERNEL_VIEW_END_INDEX(view - 1u, kernel)], viewEnd);
    XR_ADV_KernelCounts.counts[endIndex] = viewEnd;
    uint count = viewEnd - viewBase;
    // Any producer failure selects the separate GPU-only repair pass, avoiding
    // races between a partial kernel stream and full-screen recovery.
    if (XR_ADV_ClassificationCounters.counters.overflowFlags != 0u) count = 0u;
    XR_ADV_ClassificationDispatch.commands[commandIndex] = XRAdvancedDispatchIndirectCommand(
        min(count, 65535u), count == 0u ? 1u : (count + 65534u) / 65535u, 1u, rangeBase + viewBase);
}
