#version 460

// Emits live world-space 3D Gaussian splats and Uber shading surface records from
// GPU-deformed or static avatar submesh vertex buffers.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct GaussianSplat
{
    vec4 centerOpacity;
    vec4 rotation;
    vec4 scalePad;
    vec4 linearColor;
};

struct GaussianSplatSurface
{
    vec4 uv0Uv1;
    vec4 dUv0LocalXY;
    vec4 worldNormalAndSign;
    vec4 worldTangentPad;
    vec4 localPosPad;
    uvec4 materialAndColor;
};

struct GaussianLiveSurfaceSample
{
    uvec4 triAndSlot;
    vec4 baryAndArea;
    uvec4 meta;
    vec4 uv0Uv1;
    vec4 localPosAndSign;
    vec4 uv0Edges;
};

layout(std430, binding = 0) readonly buffer SamplesBuffer
{
    GaussianLiveSurfaceSample samples[];
};

layout(std430, binding = 1) readonly buffer DeformedPositionsBuffer
{
    uvec4 DeformedPositionsBits[];
};

layout(std430, binding = 2) readonly buffer DeformedNormalsBuffer
{
    vec4 DeformedNormals[];
};

layout(std430, binding = 3) readonly buffer DeformedTangentsBuffer
{
    vec4 DeformedTangents[];
};

layout(std430, binding = 4) readonly buffer StaticPositionsBuffer
{
    float StaticPositions[];
};

layout(std430, binding = 5) readonly buffer StaticNormalsBuffer
{
    float StaticNormals[];
};

layout(std430, binding = 6) readonly buffer StaticTangentsBuffer
{
    float StaticTangents[];
};

layout(std430, binding = 7) readonly buffer InterleavedVertexBuffer
{
    uint InterleavedWords[];
};

layout(std430, binding = 46) writeonly buffer GaussianSplatsOut
{
    GaussianSplat splats[];
};

layout(std430, binding = 60) writeonly buffer GaussianSplatSurfacesOut
{
    GaussianSplatSurface splatSurfaces[];
};

uniform uint uSampleCount;
uniform uint uVertexCount;
uniform uint uSourceMode;
uniform uint uHasNormals;
uniform uint uHasTangents;
uniform uint uStaticTangentStride;
uniform uint uInterleavedStrideBytes;
uniform uint uPositionOffsetBytes;
uniform uint uNormalOffsetBytes;
uniform uint uTangentOffsetBytes;
uniform uint uApplyWorldMatrix;
uniform mat4 uWorldMatrix;
uniform mat4 uNormalMatrix;

vec3 LoadInterleavedVec3(uint byteOffset)
{
    uint word = byteOffset >> 2u;
    return vec3(
        uintBitsToFloat(InterleavedWords[word + 0u]),
        uintBitsToFloat(InterleavedWords[word + 1u]),
        uintBitsToFloat(InterleavedWords[word + 2u]));
}

void LoadVertexAttributes(uint vertexIndex, out vec3 position, out vec3 normal, out vec3 tangent)
{
    uint v = min(vertexIndex, max(uVertexCount, 1u) - 1u);
    if (uSourceMode == 0u)
    {
        position = uintBitsToFloat(DeformedPositionsBits[v].xyz);
        normal = uHasNormals != 0u ? DeformedNormals[v].xyz : vec3(0.0, 1.0, 0.0);
        tangent = uHasTangents != 0u ? DeformedTangents[v].xyz : vec3(1.0, 0.0, 0.0);
    }
    else if (uSourceMode == 1u)
    {
        uint baseByte = v * uInterleavedStrideBytes;
        position = LoadInterleavedVec3(baseByte + uPositionOffsetBytes);
        normal = uHasNormals != 0u ? LoadInterleavedVec3(baseByte + uNormalOffsetBytes) : vec3(0.0, 1.0, 0.0);
        tangent = uHasTangents != 0u ? LoadInterleavedVec3(baseByte + uTangentOffsetBytes) : vec3(1.0, 0.0, 0.0);
    }
    else
    {
        uint base = v * 3u;
        uint tangentBase = v * max(uStaticTangentStride, 3u);
        position = vec3(StaticPositions[base + 0u], StaticPositions[base + 1u], StaticPositions[base + 2u]);
        normal = uHasNormals != 0u
            ? vec3(StaticNormals[base + 0u], StaticNormals[base + 1u], StaticNormals[base + 2u])
            : vec3(0.0, 1.0, 0.0);
        tangent = uHasTangents != 0u
            ? vec3(StaticTangents[tangentBase + 0u], StaticTangents[tangentBase + 1u], StaticTangents[tangentBase + 2u])
            : vec3(1.0, 0.0, 0.0);
    }

    if (uApplyWorldMatrix != 0u)
    {
        position = (uWorldMatrix * vec4(position, 1.0)).xyz;
        normal = mat3(uNormalMatrix) * normal;
        tangent = mat3(uNormalMatrix) * tangent;
    }
}

vec4 MatrixToQuaternion(vec3 col0, vec3 col1, vec3 col2)
{
    float m00 = col0.x; float m10 = col0.y; float m20 = col0.z;
    float m01 = col1.x; float m11 = col1.y; float m21 = col1.z;
    float m02 = col2.x; float m12 = col2.y; float m22 = col2.z;

    float trace = m00 + m11 + m22;
    vec4 q;
    if (trace > 0.0)
    {
        float s = sqrt(trace + 1.0) * 2.0;
        q = vec4((m21 - m12) / s, (m02 - m20) / s, (m10 - m01) / s, 0.25 * s);
    }
    else if (m00 > m11 && m00 > m22)
    {
        float s = sqrt(1.0 + m00 - m11 - m22) * 2.0;
        q = vec4(0.25 * s, (m01 + m10) / s, (m02 + m20) / s, (m21 - m12) / s);
    }
    else if (m11 > m22)
    {
        float s = sqrt(1.0 + m11 - m00 - m22) * 2.0;
        q = vec4((m01 + m10) / s, 0.25 * s, (m12 + m21) / s, (m02 - m20) / s);
    }
    else
    {
        float s = sqrt(1.0 + m22 - m00 - m11) * 2.0;
        q = vec4((m02 + m20) / s, (m12 + m21) / s, 0.25 * s, (m10 - m01) / s);
    }
    return normalize(q);
}

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uSampleCount)
        return;

    GaussianLiveSurfaceSample s = samples[idx];
    vec3 p0, n0, t0;
    vec3 p1, n1, t1;
    vec3 p2, n2, t2;
    LoadVertexAttributes(s.triAndSlot.x, p0, n0, t0);
    LoadVertexAttributes(s.triAndSlot.y, p1, n1, t1);
    LoadVertexAttributes(s.triAndSlot.z, p2, n2, t2);

    float b1 = s.baryAndArea.x;
    float b2 = s.baryAndArea.y;
    float b0 = 1.0 - b1 - b2;

    vec3 center = b0 * p0 + b1 * p1 + b2 * p2;
    vec3 e1 = p1 - p0;
    vec3 e2 = p2 - p0;
    vec3 triCross = cross(e1, e2);
    float liveDoubleArea = length(triCross);
    vec3 faceNormal = liveDoubleArea > 1.0e-10 ? (triCross / liveDoubleArea) : vec3(0.0, 1.0, 0.0);

    vec3 shadingNormal = b0 * n0 + b1 * n1 + b2 * n2;
    shadingNormal = dot(shadingNormal, shadingNormal) > 1.0e-10 ? normalize(shadingNormal) : faceNormal;
    if (dot(faceNormal, shadingNormal) < 0.0)
        faceNormal = -faceNormal;

    vec3 shadingTangent = b0 * t0 + b1 * t1 + b2 * t2;
    shadingTangent -= shadingNormal * dot(shadingTangent, shadingNormal);
    if (dot(shadingTangent, shadingTangent) <= 1.0e-10)
    {
        vec3 helper = abs(shadingNormal.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        shadingTangent = normalize(cross(helper, shadingNormal));
    }
    else
    {
        shadingTangent = normalize(shadingTangent);
    }

    // Orient the 3D Gaussian pancake disc in the live triangle plane so adjacent splats
    // seal flat across every triangle without fuzzy silhouette steps.
    vec3 axisZ = faceNormal;
    vec3 axisX = shadingTangent - axisZ * dot(shadingTangent, axisZ);
    if (dot(axisX, axisX) <= 1.0e-10)
    {
        vec3 e1Norm = dot(e1, e1) > 1.0e-12 ? normalize(e1) : vec3(1.0, 0.0, 0.0);
        axisX = e1Norm - axisZ * dot(e1Norm, axisZ);
        if (dot(axisX, axisX) <= 1.0e-10)
        {
            vec3 helper = abs(axisZ.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
            axisX = cross(helper, axisZ);
        }
    }
    axisX = normalize(axisX);
    vec3 axisY = normalize(cross(axisZ, axisX));

    // Scale rest-pose tangent sigmas by the live triangle stretch ratio so joints and
    // stretched cloth never open pinholes during animation, and cull collapsed or extreme
    // needle-sliver spike triangles so stray bone weights never emit floating splat dots.
    uint outSlot = s.triAndSlot.w;
    vec3 e3 = p2 - p1;
    float maxEdgeSq = max(dot(e1, e1), max(dot(e2, e2), dot(e3, e3)));
    if (liveDoubleArea <= 1.0e-11 || liveDoubleArea < 0.004 * maxEdgeSq)
    {
        GaussianSplat culledSplat;
        culledSplat.centerOpacity = vec4(center, -1.0);
        culledSplat.rotation = vec4(0.0, 0.0, 0.0, 1.0);
        culledSplat.scalePad = vec4(0.0);
        culledSplat.linearColor = vec4(0.0);
        splats[outSlot] = culledSplat;
        return;
    }

    float stretchScale = 1.0;
    if (s.baryAndArea.z > 0.0)
    {
        float rawStretch = sqrt(liveDoubleArea) * s.baryAndArea.z;
        if (rawStretch < 0.05 || rawStretch > 3.0)
        {
            GaussianSplat culledSplat;
            culledSplat.centerOpacity = vec4(center, -1.0);
            culledSplat.rotation = vec4(0.0, 0.0, 0.0, 1.0);
            culledSplat.scalePad = vec4(0.0);
            culledSplat.linearColor = vec4(0.0);
            splats[outSlot] = culledSplat;
            return;
        }

        stretchScale = clamp(rawStretch, 0.15, 2.5);
    }

    float sigmaX = uintBitsToFloat(s.meta.z) * stretchScale;
    float sigmaY = uintBitsToFloat(s.meta.w) * stretchScale;
    float sigmaZ = max(0.10 * min(sigmaX, sigmaY), 1.0e-5);

    // Solve exact affine UV0 gradients along axisX and axisY on the deformed triangle.
    vec2 dUvAxisX = vec2(0.0);
    vec2 dUvAxisY = vec2(0.0);
    float g11 = dot(e1, e1);
    float g12 = dot(e1, e2);
    float g22 = dot(e2, e2);
    float metricDet = g11 * g22 - g12 * g12;
    if (metricDet > 1.0e-16)
    {
        float invDet = 1.0 / metricDet;
        float e1x = dot(e1, axisX);
        float e2x = dot(e2, axisX);
        float du1 = (g22 * e1x - g12 * e2x) * invDet;
        float du2 = (g11 * e2x - g12 * e1x) * invDet;
        dUvAxisX = s.uv0Edges.xy * du1 + s.uv0Edges.zw * du2;

        float e1y = dot(e1, axisY);
        float e2y = dot(e2, axisY);
        float dv1 = (g22 * e1y - g12 * e2y) * invDet;
        float dv2 = (g11 * e2y - g12 * e1y) * invDet;
        dUvAxisY = s.uv0Edges.xy * dv1 + s.uv0Edges.zw * dv2;
    }

    GaussianSplat outSplat;
    outSplat.centerOpacity = vec4(center, s.baryAndArea.w);
    outSplat.rotation = MatrixToQuaternion(axisX, axisY, axisZ);
    outSplat.scalePad = vec4(sigmaX, sigmaY, sigmaZ, 0.0);
    outSplat.linearColor = vec4(1.0);
    splats[outSlot] = outSplat;

    GaussianSplatSurface outSurface;
    outSurface.uv0Uv1 = s.uv0Uv1;
    outSurface.dUv0LocalXY = vec4(dUvAxisX, dUvAxisY);
    outSurface.worldNormalAndSign = vec4(shadingNormal, s.localPosAndSign.w);
    outSurface.worldTangentPad = vec4(shadingTangent, 0.0);
    outSurface.localPosPad = vec4(s.localPosAndSign.xyz, 0.0);
    outSurface.materialAndColor = uvec4(s.meta.x, s.meta.y, 0u, 0u);
    splatSurfaces[outSlot] = outSurface;
}
