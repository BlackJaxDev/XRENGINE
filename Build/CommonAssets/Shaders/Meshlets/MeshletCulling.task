#version 460 core
#extension GL_NV_mesh_shader : require

layout(local_size_x = 1) in;

const uint XRE_INVALID_PASS = 0xFFFFFFFFu;
const uint MESHLET_TASK_PREVIOUS_LOD_FLAG = 0x80000000u;
const uint MESHLET_TASK_MESHLET_INDEX_MASK = 0x7FFFFFFFu;
const uint MESH_DATA_ATLAS_TIER_MASK = 0x3u;

const uint MESHLET_PASS_DEPTH_PREPASS = 1u << 0u;
const uint MESHLET_PASS_SHADOW_DEPTH = 1u << 1u;
const uint MESHLET_PASS_OPAQUE = 1u << 2u;
const uint MESHLET_PASS_MASKED = 1u << 3u;
const uint MESHLET_PASS_TRANSPARENT = 1u << 4u;
const uint MESHLET_PASS_VELOCITY = 1u << 5u;
const uint MESHLET_PASS_STEREO = 1u << 6u;

struct DrawMetadata
{
    uint DrawID;
    uint MeshID;
    uint SubmeshID;
    uint MaterialID;
    uint TransformID;
    uint SkinID;
    uint RenderPassMask;
    uint LayerMask;
    uint Flags;
    uint LodPolicy;
    uint StateClassID;
    uint InstanceCount;
    uint RenderPass;
    uint RenderIdentityID;
    uint LogicalMeshID;
    uint BoundsID;
};

struct MeshDataEntry
{
    uint IndexCount;
    uint FirstIndex;
    uint FirstVertex;
    uint Flags;
};

struct GpuMeshletTaskRecord
{
    uint MeshletIndex;
    uint DrawID;
    uint TransformID;
    uint MaterialID;
};

struct GpuMeshletDescriptor
{
    vec4 BoundsSphere;
    uint VertexOffset;
    uint TriangleByteOffset;
    uint VertexCount;
    uint TriangleCount;
    vec4 Cone;
    vec4 ConeApex;
    uint PackedCone;
    uint Reserved0;
    uint Reserved1;
    uint Reserved2;
};

layout(std430, binding = 3) readonly buffer MeshDataBuffer { MeshDataEntry MeshData[]; };
layout(std430, binding = 5) readonly buffer MeshletDescriptorBuffer { GpuMeshletDescriptor Meshlets[]; };
layout(std430, binding = 9) readonly buffer VisibleMeshletTaskBuffer { GpuMeshletTaskRecord meshletTasks[]; };
layout(std430, binding = 10) readonly buffer VisibleMeshletTaskCountBuffer { uint MeshletTaskCount; };
layout(std430, binding = 24) readonly buffer MeshletExpansionOverflowBuffer { uint MeshletExpansionOverflow; };
layout(std430, binding = 12) readonly buffer DrawMetadataBuffer { DrawMetadata Draws[]; };
layout(std430, binding = 19) readonly buffer TransformBuffer { mat4 WorldMatrices[]; };
layout(std430, binding = 21) buffer MeshletStatsBuffer
{
    uint StatsInputCount;
    uint StatsCulledCount;
    uint StatsDrawCount;
    uint StatsRejectedFrustum;
    uint StatsRejectedDistance;
    uint StatsBvhBuildCount;
    uint StatsBvhRefitCount;
    uint StatsBvhCullCount;
    uint StatsBvhRayCount;
    uint StatsBvhBuildTimeLo;
    uint StatsBvhBuildTimeHi;
    uint StatsBvhRefitTimeLo;
    uint StatsBvhRefitTimeHi;
    uint StatsBvhCullTimeLo;
    uint StatsBvhCullTimeHi;
    uint StatsBvhRayTimeLo;
    uint StatsBvhRayTimeHi;
    uint StatsTriangleCount;
    uint MeshletTaskRecordsEmitted;
    uint MeshletTaskRecordsFrustumCulled;
    uint MeshletTaskRecordsConeCulled;
    uint MeshletTaskRecordsHiZCulled;
};

// Interface block form is required when the task/mesh program is linked as a
// combined (non-separable) program. Field layout must stay in lock-step with
// the matching MeshletRender.mesh / MeshletRenderSkinned.mesh shaders.
taskNV out TaskPayload
{
    GpuMeshletTaskRecord Record;
    uint MeshletIndex;
    uint IsPreviousLod;
    uint TaskPassFlags;
    uint Reserved;
} OUT;

layout(binding = 0) uniform sampler2D HiZDepth; // XRENGINE_FREQUENCY(View)

uniform vec4 FrustumPlanes[6];
uniform mat4 ViewProjectionMatrix;
uniform mat4 HiZViewProjectionMatrix;
uniform vec3 CameraPosition;
uniform vec2 HiZSize;
uniform float HiZMipCount;
uniform float HiZDepthBias;
uniform uint HiZUsesReversedZ;
uniform uint HiZValid;
uniform int ClipDepthRange;
uniform int FramebufferTextureYDirection;
uniform uint EnableHiZOcclusion;
uniform uint EnableFrustumCulling;
uniform uint EnableConeCulling;
uniform uint EnableMaskedConeCulling;
uniform uint EnableTransparentConeCulling;
uniform uint EnableVelocityConeCulling;
uniform uint EnableStereoHiZ;
uniform uint ActiveViewCount;
uniform uint CurrentRenderPass;
uniform uint RequiredRenderPassMask;
uniform uint RequiredLayerMask;
uniform uint AllowedStateClassMask;
uniform uint PassFlags;
uniform uint StatsEnabled;
uniform uint ActiveAtlasTier;

const int HIZ_MAX_SAMPLE_TEXELS = 8;
const int HIZ_MAX_MIP_SEARCH = 32;

uint SafeBit(uint value)
{
    return value < 32u ? (1u << value) : 0u;
}

bool AcceptsRenderPass(in DrawMetadata draw)
{
    if (CurrentRenderPass == XRE_INVALID_PASS)
        return true;

    if (draw.RenderPass == CurrentRenderPass)
        return true;

    uint passBit = SafeBit(CurrentRenderPass);
    return passBit != 0u && (draw.RenderPassMask & passBit) != 0u;
}

bool AcceptsPassControls(in DrawMetadata draw)
{
    if (!AcceptsRenderPass(draw))
        return false;

    if (RequiredRenderPassMask != 0u && (draw.RenderPassMask & RequiredRenderPassMask) == 0u)
        return false;

    if (RequiredLayerMask != 0u && (draw.LayerMask & RequiredLayerMask) == 0u)
        return false;

    uint stateClassBit = SafeBit(draw.StateClassID);
    if (AllowedStateClassMask != 0u && (AllowedStateClassMask & stateClassBit) == 0u)
        return false;

    return true;
}

vec4 TransformSphere(in GpuMeshletDescriptor meshlet, uint transformID)
{
    mat4 world = WorldMatrices[transformID];
    vec3 center = (world * vec4(meshlet.BoundsSphere.xyz, 1.0)).xyz;
    float scale = max(max(length(world[0].xyz), length(world[1].xyz)), length(world[2].xyz));
    return vec4(center, meshlet.BoundsSphere.w * scale);
}

bool FrustumCulled(vec4 sphere)
{
    if (EnableFrustumCulling == 0u)
        return false;

    for (int i = 0; i < 6; ++i)
    {
        vec4 p = FrustumPlanes[i];
        float dist = dot(p.xyz, sphere.xyz) + p.w;
        if (dist < -sphere.w)
            return true;
    }

    return false;
}

bool ConeCullAllowedForPass()
{
    if (EnableConeCulling == 0u)
        return false;

    if ((PassFlags & MESHLET_PASS_TRANSPARENT) != 0u && EnableTransparentConeCulling == 0u)
        return false;

    if ((PassFlags & MESHLET_PASS_MASKED) != 0u && EnableMaskedConeCulling == 0u)
        return false;

    if ((PassFlags & MESHLET_PASS_VELOCITY) != 0u && EnableVelocityConeCulling == 0u)
        return false;

    return true;
}

bool ConeBackfaceCulled(in GpuMeshletDescriptor meshlet, uint transformID)
{
    if (!ConeCullAllowedForPass())
        return false;

    if (meshlet.PackedCone == 0u && dot(meshlet.Cone.xyz, meshlet.Cone.xyz) == 0.0)
        return false;

    mat4 world = WorldMatrices[transformID];
    vec3 worldAxis = normalize(mat3(world) * meshlet.Cone.xyz);
    vec3 worldApex = (world * vec4(meshlet.ConeApex.xyz, 1.0)).xyz;
    vec3 viewDirection = normalize(worldApex - CameraPosition);
    return dot(viewDirection, worldAxis) >= meshlet.Cone.w;
}

bool IsFiniteFloat(float value)
{
    return !isnan(value) && !isinf(value);
}

bool TryProjectConservativeSphereBounds(
    in vec4 sphere,
    out vec2 uvMin,
    out vec2 uvMax,
    out float nearestDepth)
{
    uvMin = vec2(1.0);
    uvMax = vec2(0.0);
    nearestDepth = HiZUsesReversedZ != 0u ? 0.0 : 1.0;

    if (!IsFiniteFloat(sphere.w) || sphere.w < 0.0 ||
        any(isnan(sphere.xyz)) || any(isinf(sphere.xyz)))
    {
        return false;
    }

    vec3 boundsMin = sphere.xyz - vec3(sphere.w);
    vec3 boundsMax = sphere.xyz + vec3(sphere.w);
    vec3 corners[8] = vec3[8](
        vec3(boundsMin.x, boundsMin.y, boundsMin.z),
        vec3(boundsMax.x, boundsMin.y, boundsMin.z),
        vec3(boundsMin.x, boundsMax.y, boundsMin.z),
        vec3(boundsMax.x, boundsMax.y, boundsMin.z),
        vec3(boundsMin.x, boundsMin.y, boundsMax.z),
        vec3(boundsMax.x, boundsMin.y, boundsMax.z),
        vec3(boundsMin.x, boundsMax.y, boundsMax.z),
        vec3(boundsMax.x, boundsMax.y, boundsMax.z));

    for (int i = 0; i < 8; ++i)
    {
        vec4 clip = HiZViewProjectionMatrix * vec4(corners[i], 1.0);
        if (any(isnan(clip)) || any(isinf(clip)) || clip.w <= 0.000001)
            return false;

        vec3 ndc = clip.xyz / clip.w;
        if (any(isnan(ndc)) || any(isinf(ndc)))
            return false;

        vec2 uv = ndc.xy * 0.5 + 0.5;
        if (FramebufferTextureYDirection == 1)
            uv.y = 1.0 - uv.y;

        // A clipped footprint cannot be proven occluded by this single-view
        // pyramid. Keeping it visible also covers near-plane crossings.
        if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))))
            return false;

        float depth = ClipDepthRange == 0
            ? ndc.z
            : ndc.z * 0.5 + 0.5;
        if (!IsFiniteFloat(depth) || depth < 0.0 || depth > 1.0)
            return false;

        uvMin = min(uvMin, uv);
        uvMax = max(uvMax, uv);
        nearestDepth = HiZUsesReversedZ != 0u
            ? max(nearestDepth, depth)
            : min(nearestDepth, depth);
    }

    return true;
}

bool TrySelectHiZFootprint(
    in vec2 uvMin,
    in vec2 uvMax,
    out int selectedMip,
    out ivec2 texelMin,
    out ivec2 texelMax)
{
    selectedMip = 0;
    texelMin = ivec2(0);
    texelMax = ivec2(0);

    int textureMipCount = textureQueryLevels(HiZDepth);
    int declaredMipCount = int(floor(HiZMipCount + 0.5));
    if (textureMipCount <= 0 || declaredMipCount <= 0 || declaredMipCount > textureMipCount)
        return false;

    ivec2 baseSize = textureSize(HiZDepth, 0);
    ivec2 declaredSize = ivec2(floor(HiZSize + vec2(0.5)));
    if (any(lessThanEqual(baseSize, ivec2(0))) || any(notEqual(baseSize, declaredSize)))
        return false;

    int maxMip = declaredMipCount - 1;
    vec2 footprintPixels = max((uvMax - uvMin) * vec2(baseSize), vec2(1.0));
    float maxFootprintDimension = max(footprintPixels.x, footprintPixels.y);
    float targetDimension = max(
        maxFootprintDimension / float(HIZ_MAX_SAMPLE_TEXELS - 1),
        1.0);
    int candidateMip = int(clamp(ceil(log2(targetDimension)), 0.0, float(maxMip)));

    for (int attempt = 0; attempt < HIZ_MAX_MIP_SEARCH; ++attempt)
    {
        if (candidateMip > maxMip)
            return false;

        ivec2 mipSize = textureSize(HiZDepth, candidateMip);
        if (any(lessThanEqual(mipSize, ivec2(0))))
            return false;

        ivec2 candidateMin = ivec2(floor(uvMin * vec2(mipSize)));
        ivec2 candidateMax = ivec2(floor(uvMax * vec2(mipSize)));
        candidateMin = clamp(candidateMin, ivec2(0), mipSize - ivec2(1));
        candidateMax = clamp(candidateMax, ivec2(0), mipSize - ivec2(1));
        ivec2 span = candidateMax - candidateMin + ivec2(1);
        if (span.x <= HIZ_MAX_SAMPLE_TEXELS && span.y <= HIZ_MAX_SAMPLE_TEXELS)
        {
            selectedMip = candidateMip;
            texelMin = candidateMin;
            texelMax = candidateMax;
            return true;
        }

        ++candidateMip;
    }

    return false;
}

bool TrySampleHiZFootprint(
    int mip,
    in ivec2 texelMin,
    in ivec2 texelMax,
    out float hiZDepth)
{
    hiZDepth = HiZUsesReversedZ != 0u ? 1.0 : 0.0;
    ivec2 span = texelMax - texelMin + ivec2(1);
    for (int y = 0; y < HIZ_MAX_SAMPLE_TEXELS; ++y)
    {
        if (y >= span.y)
            break;

        for (int x = 0; x < HIZ_MAX_SAMPLE_TEXELS; ++x)
        {
            if (x >= span.x)
                break;

            float sampleDepth = texelFetch(HiZDepth, texelMin + ivec2(x, y), mip).r;
            if (!IsFiniteFloat(sampleDepth) || sampleDepth < 0.0 || sampleDepth > 1.0)
                return false;

            hiZDepth = HiZUsesReversedZ != 0u
                ? min(hiZDepth, sampleDepth)
                : max(hiZDepth, sampleDepth);
        }
    }

    return true;
}

bool HiZOccluded(vec4 sphere)
{
    if (EnableHiZOcclusion == 0u || HiZValid == 0u)
        return false;

    bool stereoActive = ActiveViewCount > 1u || (PassFlags & MESHLET_PASS_STEREO) != 0u;
    if (stereoActive && EnableStereoHiZ == 0u)
        return false;

    if (!IsFiniteFloat(HiZDepthBias) || HiZDepthBias < 0.0)
        return false;

    vec2 uvMin;
    vec2 uvMax;
    float nearestDepth;
    if (!TryProjectConservativeSphereBounds(sphere, uvMin, uvMax, nearestDepth))
        return false;

    int mip;
    ivec2 texelMin;
    ivec2 texelMax;
    if (!TrySelectHiZFootprint(uvMin, uvMax, mip, texelMin, texelMax))
        return false;

    float hiZDepth;
    if (!TrySampleHiZFootprint(mip, texelMin, texelMax, hiZDepth))
        return false;

    return HiZUsesReversedZ != 0u
        ? nearestDepth + HiZDepthBias < hiZDepth
        : nearestDepth - HiZDepthBias > hiZDepth;
}

void main()
{
    uint taskIndex = gl_WorkGroupID.x;
    bool visible = false;
    GpuMeshletTaskRecord record = GpuMeshletTaskRecord(0u, 0u, 0u, 0u);
    uint meshletIndex = 0u;
    uint isPreviousLod = 0u;

    // An expansion overflow routes the full pass through material scatter.  Do
    // not emit a partial task stream alongside that conservative fallback.
    if (MeshletExpansionOverflow == 0u &&
        taskIndex < MeshletTaskCount && taskIndex < uint(meshletTasks.length()))
    {
        record = meshletTasks[taskIndex];
        meshletIndex = record.MeshletIndex & MESHLET_TASK_MESHLET_INDEX_MASK;
        isPreviousLod = (record.MeshletIndex & MESHLET_TASK_PREVIOUS_LOD_FLAG) != 0u ? 1u : 0u;
        if (meshletIndex < uint(Meshlets.length()) &&
            record.DrawID < uint(Draws.length()) &&
            record.MaterialID < uint(MeshData.length()) &&
            (MeshData[record.MaterialID].Flags & MESH_DATA_ATLAS_TIER_MASK) == ActiveAtlasTier)
        {
            if (StatsEnabled != 0u)
                atomicAdd(MeshletTaskRecordsEmitted, 1u);

            DrawMetadata draw = Draws[record.DrawID];
            GpuMeshletDescriptor meshlet = Meshlets[meshletIndex];

            if (AcceptsPassControls(draw))
            {
                uint transformID = record.TransformID != 0u ? record.TransformID : draw.TransformID;
                if (transformID < uint(WorldMatrices.length()))
                {
                    vec4 worldSphere = TransformSphere(meshlet, transformID);
                    bool frustumCulled = FrustumCulled(worldSphere);
                    bool coneCulled = !frustumCulled && ConeBackfaceCulled(meshlet, transformID);
                    bool hiZCulled = !frustumCulled && !coneCulled && HiZOccluded(worldSphere);
                    visible = !frustumCulled && !coneCulled && !hiZCulled;

                    if (StatsEnabled != 0u)
                    {
                        if (frustumCulled)
                            atomicAdd(MeshletTaskRecordsFrustumCulled, 1u);
                        else if (coneCulled)
                            atomicAdd(MeshletTaskRecordsConeCulled, 1u);
                        else if (hiZCulled)
                            atomicAdd(MeshletTaskRecordsHiZCulled, 1u);
                    }
                }
            }
        }
    }

    OUT.Record = record;
    OUT.MeshletIndex = meshletIndex;
    OUT.IsPreviousLod = isPreviousLod;
    OUT.TaskPassFlags = PassFlags;
    OUT.Reserved = 0u;
    gl_TaskCountNV = visible ? 1u : 0u;
}
