#version 460 core
#extension GL_EXT_mesh_shader : require

// GL_EXT_mesh_shader (VK_EXT_mesh_shader / GL_EXT_mesh_shader) variant of
// MeshletRenderSkinned.mesh. Semantics are identical to the NV sibling; only the
// dialect-specific intrinsics differ:
//   - taskPayloadSharedEXT for the task payload binding.
//   - SetMeshOutputsEXT(vertexCount, primitiveCount) declares output counts.
//   - gl_MeshVerticesEXT[] for per-vertex outputs.
//   - gl_PrimitiveTriangleIndicesEXT[] for triangle index emission (one uvec3 per primitive).

layout(local_size_x = 32) in;
// Keep the portable cooked profile below the minimum device limit required by
// the runtime capability gate (64 vertices / 124 primitives).
layout(triangles, max_vertices = 64, max_primitives = 124) out;

const uint GROUP_SIZE = 32u;
const uint MESHLET_TASK_MESHLET_INDEX_MASK = 0x7FFFFFFFu;

struct DrawMetadata
{
    uint DrawID;
    uint MeshID;
    uint SubmeshID;
    uint MaterialID;
    uint TransformID;
    uint SkinID;
    uint RenderPassMask;
    uint LayerMask;
    uint Flags;
    uint LodPolicy;
    uint StateClassID;
    uint InstanceCount;
    uint RenderPass;
    uint RenderIdentityID;
    uint LogicalMeshID;
    uint BoundsID;
};

struct MeshDataEntry
{
    uint IndexCount;
    uint FirstIndex;
    uint FirstVertex;
    uint Flags;
};

struct GpuMeshletTaskRecord
{
    uint MeshletIndex;
    uint DrawID;
    uint TransformID;
    uint MaterialID;
};

struct GpuMeshletDescriptor
{
    vec4 BoundsSphere;
    uint VertexOffset;
    uint TriangleByteOffset;
    uint VertexCount;
    uint TriangleCount;
    vec4 Cone;
    vec4 ConeApex;
    uint PackedCone;
    uint Reserved0;
    uint Reserved1;
    uint Reserved2;
};

struct VertexSkin
{
    uvec4 Indices;
    vec4 Weights;
};

struct TaskPayload
{
    GpuMeshletTaskRecord Record;
    uint MeshletIndex;
    uint IsPreviousLod;
    uint TaskPassFlags;
    uint Reserved;
};

taskPayloadSharedEXT TaskPayload IN;

layout(std430, binding = 3) readonly buffer MeshDataBuffer { MeshDataEntry MeshData[]; };
layout(std430, binding = 5) readonly buffer MeshletDescriptorBuffer { GpuMeshletDescriptor Meshlets[]; };
layout(std430, binding = 6) readonly buffer MeshletVertexIndexBuffer { uint MeshletVertexIndices[]; };
layout(std430, binding = 7) readonly buffer MeshletTriangleIndexBuffer { uint MeshletTriangleWords[]; };
layout(std430, binding = 12) readonly buffer DrawMetadataBuffer { DrawMetadata Draws[]; };
layout(std430, binding = 13) readonly buffer AtlasPositionBuffer { float AtlasPositions[]; };
layout(std430, binding = 14) readonly buffer AtlasNormalBuffer { float AtlasNormals[]; };
layout(std430, binding = 15) readonly buffer AtlasTangentBuffer { float AtlasTangents[]; };
layout(std430, binding = 18) readonly buffer AtlasUV0Buffer { float AtlasUV0[]; };
layout(std430, binding = 19) readonly buffer TransformBuffer { mat4 WorldMatrices[]; };
layout(std430, binding = 20) readonly buffer PrevTransformBuffer { mat4 PreviousWorldMatrices[]; };
layout(std430, binding = 21) readonly buffer MeshletSkinningBuffer { VertexSkin VertexSkinning[]; };
layout(std430, binding = 22) readonly buffer SkinningPaletteBuffer { mat4 SkinningPalette[]; };
layout(std430, binding = 23) readonly buffer SkinningMetaBuffer { uvec4 SkinningMeta[]; };

layout(location = 0) out vec3 FragPos[];
layout(location = 1) out vec3 FragNorm[];
layout(location = 2) out vec3 FragTan[];
layout(location = 3) out vec3 FragBinorm[];
layout(location = 4) out vec2 FragUV0[];
layout(location = 12) out vec4 FragColor0[];
layout(location = 20) out vec3 FragPosLocal[];
layout(location = 21) flat out uint FragTransformId[];
layout(location = 27) flat out uint FragRenderIdentityId[];
layout(location = 22) out float FragViewIndex[];
layout(location = 23) flat out uint XreFragLodTransitionRole[];
layout(location = 24) flat out uint XRE_FragMaterialId[];
layout(location = 25) out vec3 PrevFragPos[];
layout(location = 26) flat out uint XRE_FragStateClassId[];

uniform mat4 ViewProjectionMatrix;
uniform mat4 PreviousViewProjectionMatrix;
uniform uint ActiveViewIndex;
uniform uint EnableSkinning;
uniform uint EnableMeshletDebugDisplay;

vec3 LoadPosition(uint vertexIndex)
{
    uint base = vertexIndex * 3u;
    return vec3(AtlasPositions[base + 0u], AtlasPositions[base + 1u], AtlasPositions[base + 2u]);
}

vec3 LoadNormal(uint vertexIndex)
{
    uint base = vertexIndex * 3u;
    return vec3(AtlasNormals[base + 0u], AtlasNormals[base + 1u], AtlasNormals[base + 2u]);
}

vec4 LoadTangent(uint vertexIndex)
{
    uint base = vertexIndex * 4u;
    return vec4(AtlasTangents[base + 0u], AtlasTangents[base + 1u], AtlasTangents[base + 2u], AtlasTangents[base + 3u]);
}

vec2 LoadUV0(uint vertexIndex)
{
    uint base = vertexIndex * 2u;
    return vec2(AtlasUV0[base + 0u], AtlasUV0[base + 1u]);
}

uint ReadTriIndex(uint byteIndex)
{
    uint word = MeshletTriangleWords[byteIndex >> 2u];
    uint shift = (byteIndex & 3u) * 8u;
    return (word >> shift) & 0xFFu;
}

uint ResolveSkinBase(uint skinID)
{
    if (skinID < uint(SkinningMeta.length()))
        return SkinningMeta[skinID].x;

    return skinID;
}

uint XRE_HashUint(uint value)
{
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return value;
}

vec3 XRE_HsvToRgb(vec3 hsv)
{
    vec3 p = abs(fract(hsv.xxx + vec3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
    return hsv.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), hsv.y);
}

vec4 XRE_MeshletDebugColor(uint meshletIndex)
{
    uint hash = XRE_HashUint(meshletIndex + 1u);
    float hue = fract(float(hash & 0x00FFFFFFu) * (1.0 / 16777216.0));
    return vec4(XRE_HsvToRgb(vec3(hue, 0.82, 1.0)), 1.0);
}

vec3 SafeNormalize(vec3 value, vec3 fallbackValue)
{
    float lengthSquared = dot(value, value);
    return lengthSquared > 1.0e-12 && !isnan(lengthSquared) && !isinf(lengthSquared)
        ? value * inversesqrt(lengthSquared)
        : fallbackValue;
}

void ApplySkinning(
    uint atlasVertexIndex,
    uint skinBase,
    inout vec3 localPosition,
    inout vec3 localNormal,
    inout vec3 localTangent)
{
    if (EnableSkinning == 0u || atlasVertexIndex >= uint(VertexSkinning.length()))
        return;

    VertexSkin skin = VertexSkinning[atlasVertexIndex];
    mat4 b0 = SkinningPalette[skinBase + skin.Indices.x];
    mat4 b1 = SkinningPalette[skinBase + skin.Indices.y];
    mat4 b2 = SkinningPalette[skinBase + skin.Indices.z];
    mat4 b3 = SkinningPalette[skinBase + skin.Indices.w];

    vec4 skinnedPosition =
        (b0 * vec4(localPosition, 1.0)) * skin.Weights.x +
        (b1 * vec4(localPosition, 1.0)) * skin.Weights.y +
        (b2 * vec4(localPosition, 1.0)) * skin.Weights.z +
        (b3 * vec4(localPosition, 1.0)) * skin.Weights.w;

    mat3 skinnedLinear =
        mat3(b0) * skin.Weights.x +
        mat3(b1) * skin.Weights.y +
        mat3(b2) * skin.Weights.z +
        mat3(b3) * skin.Weights.w;

    localPosition = skinnedPosition.xyz;
    localNormal = normalize(skinnedLinear * localNormal);
    localTangent = normalize(skinnedLinear * localTangent);
}

void EmitVertex(uint tid, uint atlasVertexIndex, in DrawMetadata draw, mat4 world, mat4 previousWorld, vec4 meshletDebugColor)
{
    vec3 localPosition = LoadPosition(atlasVertexIndex);
    vec3 localNormal = LoadNormal(atlasVertexIndex);
    vec4 localTangent = LoadTangent(atlasVertexIndex);
    vec2 uv0 = LoadUV0(atlasVertexIndex);

    vec3 skinnedTangent = localTangent.xyz;
    ApplySkinning(atlasVertexIndex, ResolveSkinBase(draw.SkinID), localPosition, localNormal, skinnedTangent);
    localTangent.xyz = skinnedTangent;

    mat3 normalMatrix = mat3(world);
    vec3 worldNormal = SafeNormalize(normalMatrix * localNormal, vec3(0.0, 0.0, 1.0));
    vec3 worldTangent = SafeNormalize(normalMatrix * localTangent.xyz, vec3(1.0, 0.0, 0.0));
    vec3 worldBitangent = SafeNormalize(cross(worldNormal, worldTangent) * localTangent.w, vec3(0.0, 1.0, 0.0));
    vec4 worldPosition = world * vec4(localPosition, 1.0);
    vec4 previousWorldPosition = previousWorld * vec4(localPosition, 1.0);

    gl_MeshVerticesEXT[tid].gl_Position = ViewProjectionMatrix * worldPosition;
    FragPos[tid] = worldPosition.xyz;
    FragNorm[tid] = worldNormal;
    FragTan[tid] = worldTangent;
    FragBinorm[tid] = worldBitangent;
    FragUV0[tid] = uv0;
    FragColor0[tid] = meshletDebugColor;
    FragPosLocal[tid] = localPosition;
    FragTransformId[tid] = draw.DrawID;
    FragRenderIdentityId[tid] = draw.RenderIdentityID;
    FragViewIndex[tid] = float(ActiveViewIndex);
    XreFragLodTransitionRole[tid] = IN.IsPreviousLod;
    XRE_FragMaterialId[tid] = draw.MaterialID;
    PrevFragPos[tid] = previousWorldPosition.xyz;
    XRE_FragStateClassId[tid] = draw.StateClassID;
}

void main()
{
    uint meshletIndex = IN.MeshletIndex & MESHLET_TASK_MESHLET_INDEX_MASK;
    if (meshletIndex >= uint(Meshlets.length()) || IN.Record.DrawID >= uint(Draws.length()))
    {
        SetMeshOutputsEXT(0u, 0u);
        return;
    }

    GpuMeshletDescriptor meshlet = Meshlets[meshletIndex];
    DrawMetadata draw = Draws[IN.Record.DrawID];
    uint selectedMeshID = IN.Record.MaterialID;
    if (selectedMeshID >= uint(MeshData.length()))
    {
        SetMeshOutputsEXT(0u, 0u);
        return;
    }

    MeshDataEntry meshData = MeshData[selectedMeshID];
    uint transformID = IN.Record.TransformID != 0u ? IN.Record.TransformID : draw.TransformID;
    mat4 world = WorldMatrices[transformID];
    mat4 previousWorld = PreviousWorldMatrices[transformID];

    SetMeshOutputsEXT(meshlet.VertexCount, meshlet.TriangleCount);
    vec4 meshletDebugColor = EnableMeshletDebugDisplay != 0u
        ? XRE_MeshletDebugColor(meshletIndex)
        : vec4(1.0);

    uint tid = gl_LocalInvocationID.x;
    for (uint vertex = tid; vertex < meshlet.VertexCount; vertex += GROUP_SIZE)
    {
        uint localVertexIndex = MeshletVertexIndices[meshlet.VertexOffset + vertex];
        uint atlasVertexIndex = meshData.FirstVertex + localVertexIndex;
        EmitVertex(vertex, atlasVertexIndex, draw, world, previousWorld, meshletDebugColor);
    }

    for (uint tri = tid; tri < meshlet.TriangleCount; tri += GROUP_SIZE)
    {
        uint baseByte = meshlet.TriangleByteOffset + tri * 3u;
        gl_PrimitiveTriangleIndicesEXT[tri] = uvec3(
            ReadTriIndex(baseByte + 0u),
            ReadTriIndex(baseByte + 1u),
            ReadTriIndex(baseByte + 2u));
    }
}
