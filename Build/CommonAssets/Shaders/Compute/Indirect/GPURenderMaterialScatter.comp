#version 460 core

layout(local_size_x = 64) in;

const uint KEY_UINTS = 4u;
const uint DRAW_UINTS = 5u;
const uint MATERIAL_TIER_COUNT = 3u;
const uint INVALID_MATERIAL_SLOT = 0xFFFFFFFFu;
const uint MESH_DATA_ATLAS_TIER_MASK = 0x3u;
const uint LOD_TRANSITION_UINTS = 4u;
const uint LOD_TRANSITION_ACTIVE = 1u;
const uint PREVIOUS_LOD_DRAW_FLAG = 0x40000000u;
const uint COMMAND_INDEX_MASK = 0x3FFFFFFFu;
const uint STATS_DRAW_COUNT = 2u;
const uint STATS_TRIANGLE_COUNT = 17u;
const uint STATS_MATERIAL_SCATTER_INPUT = 22u;
const uint STATS_MATERIAL_SCATTER_REJECTED_DRAW_ID = 23u;
const uint STATS_MATERIAL_SCATTER_REJECTED_MATERIAL = 24u;
const uint STATS_MATERIAL_SCATTER_REJECTED_MESH = 25u;
const uint STATS_MATERIAL_SCATTER_REJECTED_ATLAS = 26u;
const uint STATS_MATERIAL_SCATTER_REJECTED_BUCKET = 27u;
const uint STATS_MATERIAL_SCATTER_EMITTED = 28u;
const uint STATS_MATERIAL_SCATTER_REJECTED_BOUNDS = 29u;
const uint STATS_MATERIAL_SCATTER_MAX_DRAW_ID = 30u;
const uint STATS_MATERIAL_SCATTER_METADATA_LENGTH = 31u;
const uint STATS_MATERIAL_SCATTER_CULLED_COUNT = 32u;
const uint STATS_MATERIAL_SCATTER_KEY_COUNT = 33u;
const uint METADATA_UINTS = 4u;
const uint DOMAIN_EXACT = 3u;

struct DrawMetadata
{
    uint DrawID;
    uint MeshID;
    uint SubmeshID;
    uint MaterialID;
    uint TransformID;
    uint SkinID;
    uint RenderPassMask;
    uint LayerMask;
    uint Flags;
    uint LodPolicy;
    uint StateClassID;
    uint InstanceCount;
    uint RenderPass;
    uint ShaderProgramID;
    uint LogicalMeshID;
    uint BoundsID;
};

layout(std430, binding = 0) readonly buffer DrawMetadataBuffer { DrawMetadata Draws[]; };
layout(std430, binding = 1) readonly buffer MeshDataBuffer { uint meshData[]; };
layout(std430, binding = 2) readonly buffer CulledCountBuffer
{
    uint CulledCount;
    uint CulledInstanceCount;
    uint CulledOverflow;
};
layout(std430, binding = 3) readonly buffer SortKeysBuffer { uint sortKeys[]; };
layout(std430, binding = 4) readonly buffer MaterialSlotLookupBuffer { uint materialSlots[]; };
layout(std430, binding = 5) buffer IndirectDrawBuffer { uint indirectDraws[]; };
layout(std430, binding = 6) buffer DrawCountBuffer { uint drawCounts[]; };
layout(std430, binding = 7) buffer OverflowFlagBuffer { uint overflowFlag; };
layout(std430, binding = 8) readonly buffer LODTransitionBuffer { uint lodTransitions[]; };
layout(std430, binding = 9) buffer StatsBuffer { uint stats[]; };
layout(std430, binding = 10) readonly buffer TransparencyMetadataBuffer { uint transparencyMetadata[]; };

uniform int CurrentRenderPass;
uniform int MaxMaterialSlotLookup;
uniform int MaxBucketCount;
uniform int MaxIndirectDrawsPerBucket;
uniform uvec3 AtlasIndexCounts;
uniform uvec3 AtlasVertexCounts;
uniform uint StatsEnabled;
uniform uint RejectExactTransparentMultiview;
uniform uint CompactMaterialTableOutput;

shared uint compactScan[MATERIAL_TIER_COUNT][64];
shared uint compactBase[MATERIAL_TIER_COUNT];
shared uint compactAccepted[MATERIAL_TIER_COUNT];
shared uint compactDrawStats[64];
shared uint compactTriangleStats[64];

struct DrawCandidate
{
    uint Valid;
    uint BucketIndex;
    uint Tier;
    uint IndexCount;
    uint InstanceCount;
    uint FirstIndex;
    uint BaseVertex;
    uint BaseInstance;
};

uvec4 LoadKey(uint index)
{
    uint base = index * KEY_UINTS;
    return uvec4(
        sortKeys[base + 0u],
        sortKeys[base + 1u],
        sortKeys[base + 2u],
        sortKeys[base + 3u]);
}

bool StoreDrawCommand(uint bucketIndex, uint drawIndexInBucket, uint count, uint instanceCount, uint firstIndex, uint baseVertex, uint baseInstance)
{
    uint globalDrawIndex = bucketIndex * uint(MaxIndirectDrawsPerBucket) + drawIndexInBucket;
    uint base = globalDrawIndex * DRAW_UINTS;
    if (base + 4u >= uint(indirectDraws.length()))
    {
        atomicOr(overflowFlag, 1u);
        return false;
    }

    indirectDraws[base + 0u] = count;
    indirectDraws[base + 1u] = instanceCount;
    indirectDraws[base + 2u] = firstIndex;
    indirectDraws[base + 3u] = baseVertex;
    indirectDraws[base + 4u] = baseInstance;
    return true;
}

bool TryReserveBucketDraw(uint bucketIndex, out uint drawIndexInBucket)
{
    drawIndexInBucket = 0u;
    uint capacity = uint(max(MaxIndirectDrawsPerBucket, 0));
    if (capacity == 0u)
    {
        atomicOr(overflowFlag, 1u);
        return false;
    }

    while (true)
    {
        uint current = drawCounts[bucketIndex];
        if (current >= capacity)
        {
            atomicOr(overflowFlag, 1u);
            return false;
        }

        uint observed = atomicCompSwap(drawCounts[bucketIndex], current, current + 1u);
        if (observed == current)
        {
            drawIndexInBucket = current;
            return true;
        }
    }
}

void RecordStat(uint index, uint value)
{
    if (StatsEnabled != 0u && index < uint(stats.length()))
        atomicAdd(stats[index], value);
}

DrawCandidate BuildDrawCandidate(
    uint meshID,
    uint materialID,
    uint instanceCount,
    uint commandIndex,
    bool previousLod)
{
    DrawCandidate candidate;
    candidate.Valid = 0u;
    candidate.BucketIndex = 0u;
    candidate.Tier = 0u;
    candidate.IndexCount = 0u;
    candidate.InstanceCount = instanceCount;
    candidate.FirstIndex = 0u;
    candidate.BaseVertex = 0u;
    candidate.BaseInstance = 0u;

    if (instanceCount == 0u)
    {
        RecordStat(STATS_MATERIAL_SCATTER_REJECTED_MESH, 1u);
        return candidate;
    }

    if (materialID >= uint(MaxMaterialSlotLookup) || materialID >= uint(materialSlots.length()))
    {
        RecordStat(STATS_MATERIAL_SCATTER_REJECTED_MATERIAL, 1u);
        return candidate;
    }

    uint slotIndex = materialSlots[materialID];
    if (slotIndex == INVALID_MATERIAL_SLOT)
    {
        RecordStat(STATS_MATERIAL_SCATTER_REJECTED_MATERIAL, 1u);
        return candidate;
    }

    uint meshBase = meshID * 4u;
    if (meshBase + 3u >= uint(meshData.length()))
    {
        RecordStat(STATS_MATERIAL_SCATTER_REJECTED_MESH, 1u);
        return candidate;
    }

    uint indexCount = meshData[meshBase + 0u];
    if (indexCount == 0u)
    {
        RecordStat(STATS_MATERIAL_SCATTER_REJECTED_MESH, 1u);
        return candidate;
    }

    uint tierFlags = meshData[meshBase + 3u];
    uint tier = tierFlags & MESH_DATA_ATLAS_TIER_MASK;
    if (tier >= MATERIAL_TIER_COUNT)
        tier = 0u;

    uint firstIndex = meshData[meshBase + 1u];
    uint baseVertex = meshData[meshBase + 2u];
    uint atlasIndexCount = AtlasIndexCounts[tier];
    uint atlasVertexCount = AtlasVertexCounts[tier];
    if (atlasIndexCount == 0u ||
        atlasVertexCount == 0u ||
        firstIndex >= atlasIndexCount ||
        indexCount > atlasIndexCount - firstIndex ||
        baseVertex >= atlasVertexCount)
    {
        atomicOr(overflowFlag, 1u);
        RecordStat(STATS_MATERIAL_SCATTER_REJECTED_ATLAS, 1u);
        return candidate;
    }

    uint bucketIndex = CompactMaterialTableOutput != 0u
        ? tier
        : slotIndex * MATERIAL_TIER_COUNT + tier;
    if (bucketIndex >= uint(MaxBucketCount) || bucketIndex >= uint(drawCounts.length()))
    {
        RecordStat(STATS_MATERIAL_SCATTER_REJECTED_BUCKET, 1u);
        return candidate;
    }

    candidate.Valid = 1u;
    candidate.BucketIndex = bucketIndex;
    candidate.Tier = tier;
    candidate.IndexCount = indexCount;
    candidate.FirstIndex = firstIndex;
    candidate.BaseVertex = baseVertex;
    candidate.BaseInstance = commandIndex & COMMAND_INDEX_MASK;
    if (previousLod)
        candidate.BaseInstance |= PREVIOUS_LOD_DRAW_FLAG;
    return candidate;
}

void EmitDiagnosticCandidate(DrawCandidate candidate)
{
    if (candidate.Valid == 0u)
        return;

    uint drawIndexInBucket;
    if (!TryReserveBucketDraw(candidate.BucketIndex, drawIndexInBucket))
    {
        RecordStat(STATS_MATERIAL_SCATTER_REJECTED_BUCKET, 1u);
        return;
    }

    if (StoreDrawCommand(
        candidate.BucketIndex,
        drawIndexInBucket,
        candidate.IndexCount,
        candidate.InstanceCount,
        candidate.FirstIndex,
        candidate.BaseVertex,
        candidate.BaseInstance))
    {
        RecordStat(STATS_DRAW_COUNT, 1u);
        RecordStat(
            STATS_TRIANGLE_COUNT,
            (candidate.IndexCount / 3u) * candidate.InstanceCount);
        RecordStat(STATS_MATERIAL_SCATTER_EMITTED, 1u);
    }
    else
        RecordStat(STATS_MATERIAL_SCATTER_REJECTED_BUCKET, 1u);
}

uint ReserveClampedGroupSpan(uint tier, uint requested)
{
    uint capacity = uint(max(MaxIndirectDrawsPerBucket, 0));
    while (true)
    {
        uint current = drawCounts[tier];
        uint clampedCurrent = min(current, capacity);
        uint available = capacity - clampedCurrent;
        uint accepted = min(requested, available);
        uint desired = clampedCurrent + accepted;
        uint observed = atomicCompSwap(drawCounts[tier], current, desired);
        if (observed != current)
            continue;

        compactAccepted[tier] = accepted;
        if (accepted != requested)
            atomicOr(overflowFlag, 1u);
        return clampedCurrent;
    }
}

void EmitCompactCandidate(DrawCandidate candidate)
{
    uint lane = gl_LocalInvocationID.x;
    for (uint tier = 0u; tier < MATERIAL_TIER_COUNT; ++tier)
    {
        compactScan[tier][lane] =
            candidate.Valid != 0u && candidate.Tier == tier ? 1u : 0u;
    }
    barrier();

    for (uint offset = 1u; offset < 64u; offset <<= 1u)
    {
        uvec3 preceding = uvec3(0u);
        if (lane >= offset)
        {
            preceding.x = compactScan[0][lane - offset];
            preceding.y = compactScan[1][lane - offset];
            preceding.z = compactScan[2][lane - offset];
        }
        barrier();
        if (lane >= offset)
        {
            compactScan[0][lane] += preceding.x;
            compactScan[1][lane] += preceding.y;
            compactScan[2][lane] += preceding.z;
        }
        barrier();
    }

    if (lane < MATERIAL_TIER_COUNT)
    {
        uint requested = compactScan[lane][63];
        compactBase[lane] = ReserveClampedGroupSpan(lane, requested);
    }
    barrier();

    bool stored = false;
    if (candidate.Valid != 0u)
    {
        uint localIndex = compactScan[candidate.Tier][lane] - 1u;
        if (localIndex < compactAccepted[candidate.Tier])
        {
            stored = StoreDrawCommand(
                candidate.Tier,
                compactBase[candidate.Tier] + localIndex,
                candidate.IndexCount,
                candidate.InstanceCount,
                candidate.FirstIndex,
                candidate.BaseVertex,
                candidate.BaseInstance);
        }
        else
        {
            atomicOr(overflowFlag, 1u);
        }
    }

    compactDrawStats[lane] = stored ? 1u : 0u;
    compactTriangleStats[lane] = stored
        ? (candidate.IndexCount / 3u) * candidate.InstanceCount
        : 0u;
    barrier();
    for (uint offset = 32u; offset > 0u; offset >>= 1u)
    {
        if (lane < offset)
        {
            compactDrawStats[lane] += compactDrawStats[lane + offset];
            compactTriangleStats[lane] += compactTriangleStats[lane + offset];
        }
        barrier();
    }

    if (lane == 0u && StatsEnabled != 0u)
    {
        RecordStat(STATS_DRAW_COUNT, compactDrawStats[0]);
        RecordStat(STATS_TRIANGLE_COUNT, compactTriangleStats[0]);
        RecordStat(STATS_MATERIAL_SCATTER_EMITTED, compactDrawStats[0]);
    }
    barrier();
}

void main()
{
    uint sortedIndex = gl_GlobalInvocationID.x;
    uint availableKeyCount = uint(sortKeys.length()) / KEY_UINTS;
    RecordStat(STATS_MATERIAL_SCATTER_INPUT, 1u);
    if (sortedIndex == 0u && StatsEnabled != 0u)
    {
        stats[STATS_MATERIAL_SCATTER_METADATA_LENGTH] = uint(Draws.length());
        stats[STATS_MATERIAL_SCATTER_CULLED_COUNT] = CulledCount;
        stats[STATS_MATERIAL_SCATTER_KEY_COUNT] = availableKeyCount;
    }
    bool inputValid =
        sortedIndex < CulledCount &&
        sortedIndex < availableKeyCount;
    if (!inputValid)
        RecordStat(STATS_MATERIAL_SCATTER_REJECTED_BOUNDS, 1u);

    uint drawID = 0u;
    DrawMetadata meta;
    meta.InstanceCount = 0u;
    if (inputValid)
    {
        uvec4 key = LoadKey(sortedIndex);
        drawID = key.w;
        if (StatsEnabled != 0u)
            atomicMax(stats[STATS_MATERIAL_SCATTER_MAX_DRAW_ID], drawID);
        inputValid = drawID < Draws.length();
        if (!inputValid)
            RecordStat(STATS_MATERIAL_SCATTER_REJECTED_DRAW_ID, 1u);
    }

    if (inputValid && RejectExactTransparentMultiview != 0u)
    {
        uint metadataBase = drawID * METADATA_UINTS;
        inputValid = metadataBase + METADATA_UINTS <=
            uint(transparencyMetadata.length());
        if (inputValid)
        {
            uint domain =
                (transparencyMetadata[metadataBase] >> 16u) & 0xFFFFu;
            inputValid = domain != DOMAIN_EXACT;
        }
    }

    if (inputValid)
    {
        meta = Draws[drawID];
        inputValid =
            meta.InstanceCount != 0u &&
            (CurrentRenderPass < 0 ||
             meta.RenderPass == uint(CurrentRenderPass) ||
             meta.RenderPass == 0xFFFFFFFFu);
    }

    uint transitionBase = drawID * LOD_TRANSITION_UINTS;
    bool transitionActive = false;
    uint previousMeshID = 0u;
    if (inputValid && transitionBase + 3u < uint(lodTransitions.length()))
    {
        previousMeshID = lodTransitions[transitionBase + 0u];
        uint transitionFlags = lodTransitions[transitionBase + 2u];
        float transitionProgress = clamp(uintBitsToFloat(lodTransitions[transitionBase + 3u]), 0.0, 1.0);
        transitionActive = (transitionFlags & LOD_TRANSITION_ACTIVE) != 0u && previousMeshID != 0u && transitionProgress < 1.0;
    }

    DrawCandidate previousCandidate = transitionActive
        ? BuildDrawCandidate(
            previousMeshID,
            meta.MaterialID,
            meta.InstanceCount,
            drawID,
            true)
        : BuildDrawCandidate(0u, 0u, 0u, 0u, false);
    DrawCandidate currentCandidate = inputValid
        ? BuildDrawCandidate(
            meta.MeshID,
            meta.MaterialID,
            meta.InstanceCount,
            drawID,
            false)
        : BuildDrawCandidate(0u, 0u, 0u, 0u, false);

    if (CompactMaterialTableOutput != 0u)
    {
        EmitCompactCandidate(previousCandidate);
        EmitCompactCandidate(currentCandidate);
    }
    else
    {
        EmitDiagnosticCandidate(previousCandidate);
        EmitDiagnosticCandidate(currentCandidate);
    }
}
