#version 460 core

// Filters a culled command buffer against a Hi-Z depth pyramid.
// Stage order intent: frustum/BVH cull -> (optional) Hi-Z occlusion refine -> indirect build.

layout(local_size_x = 256) in;

// Compact visible draw-ID ping-pong. Scene-native metadata/bounds remain the
// source of truth; no 80-byte command copies cross this stage.
layout(std430, binding = 0) buffer InputDrawIdsBuffer { uint inDrawIds[]; };
layout(std430, binding = 1) buffer OutputDrawIdsBuffer { uint outDrawIds[]; };

// Input counters (from frustum/BVH cull stage)
layout(std430, binding = 2) buffer InCountBuffer
{
    uint InCount;
    uint InInstanceCount;
    uint InOverflow;
};

// Output counters (final visible set used for indirect build)
layout(std430, binding = 3) buffer OutCountBuffer
{
    uint OutCount;
    uint OutInstanceCount;
    uint OutOverflow;
};

layout(std430, binding = 4) buffer OverflowFlagBuffer { uint OcclusionOverflowFlag; };

struct BoundsGpu
{
    vec4 BoundingSphere;
    vec4 AabbMin;
    vec4 AabbMax;
    uint BoundsVersion;
    uint Padding0;
    uint Padding1;
    uint Padding2;
};

layout(std430, binding = 5) readonly buffer BoundsBuffer { BoundsGpu Bounds[]; };
struct DrawMetadata
{
    uint DrawID; uint MeshID; uint SubmeshID; uint MaterialID;
    uint TransformID; uint SkinID; uint RenderPassMask; uint LayerMask;
    uint Flags; uint LodPolicy; uint StateClassID; uint InstanceCount;
    uint RenderPass; uint RenderIdentityID; uint LogicalMeshID; uint BoundsID;
};
layout(std430, binding = 10) readonly buffer DrawMetadataBuffer { DrawMetadata Draws[]; };
// Two uints per DrawID: { RenderIdentityID + 1, visible }.
layout(std430, binding = 6) buffer VisibilityHistoryBuffer { uint VisibilityHistory[]; };

struct GPUViewDescriptor
{
    uint ViewId;
    uint ParentViewId;
    uint Flags;
    uint RenderPassMaskLo;
    uint RenderPassMaskHi;
    uint OutputLayer;
    uint ViewRectX;
    uint ViewRectY;
    uint ViewRectW;
    uint ViewRectH;
    uint VisibleOffset;
    uint VisibleCapacity;
    vec4 FoveationA;
    vec4 FoveationB;
};

struct GPUViewConstants
{
    mat4 View;
    mat4 Projection;
    mat4 ViewProjection;
    mat4 PrevViewProjection;
    vec4 CameraPositionAndNear;
    vec4 CameraForwardAndFar;
};

layout(std430, binding = 11) readonly buffer ViewDescriptorBuffer { GPUViewDescriptor ViewDescriptors[]; };
layout(std430, binding = 12) readonly buffer ViewConstantsBuffer { GPUViewConstants ViewConstants[]; };
layout(std430, binding = 13) readonly buffer CommandViewMaskBuffer { uvec2 CommandViewMasks[]; };
layout(std430, binding = 14) buffer PerViewVisibleIndicesBuffer { uint PerViewVisibleIndices[]; };
layout(std430, binding = 15) buffer PerViewDrawCountBuffer { uint PerViewDrawCounts[]; };

// Optional stats buffer (shared layout)
layout(std430, binding = 8) buffer StatsBuffer {
    uint StatsInputCount;        // 0
    uint StatsCulledCount;       // 1
    uint StatsDrawCount;         // 2
    uint StatsRejectedFrustum;   // 3
    uint StatsRejectedDistance;  // 4
    uint StatsBvhBuildCount;     // 5
    uint StatsBvhRefitCount;     // 6
    uint StatsBvhCullCount;      // 7
    uint StatsBvhRayCount;       // 8
    uint StatsBvhBuildTimeLo;    // 9
    uint StatsBvhBuildTimeHi;    // 10
    uint StatsBvhRefitTimeLo;    // 11
    uint StatsBvhRefitTimeHi;    // 12
    uint StatsBvhCullTimeLo;     // 13
    uint StatsBvhCullTimeHi;     // 14
    uint StatsBvhRayTimeLo;      // 15
    uint StatsBvhRayTimeHi;      // 16
    uint StatsTriangleCount;     // 17
};

layout(binding = 0) uniform sampler2D HiZDepth;

uniform mat4 ViewProj;
uniform int HiZMaxMip;
// Nonzero only for the fixed 64-pixel tile path. UVs address the unpadded
// source extent, not the rounded-up tile image (important at NPOT edges).
uniform ivec2 CoarseSourceSize;
uniform uint IsReversedDepth; // 1 if camera uses reversed Z
uniform int MaxOutputCommands;
uniform int TwoPassPhase; // 0 = legacy refine, 2 = late two-pass visibility update
uniform int ActiveViewCount;
uniform int CurrentRenderPass;
uniform uint ForcePhaseOneVisible;
uniform int ClipDepthRange;
uniform int FramebufferTextureYDirection;

const int HIZ_TARGET_TEXEL_SPAN = 6;
const int HIZ_MAX_SAMPLE_TEXELS = 8;
const float HIZ_DEPTH_EPSILON = 0.0001;

#define FLAG_TRANSPARENT (1u << 0u)

vec2 ClipToFramebufferUv(vec2 ndc)
{
    vec2 uv = ndc * 0.5 + 0.5;
    if (FramebufferTextureYDirection == 1)
        uv.y = 1.0 - uv.y;
    return uv;
}

float ClipToFramebufferDepth(float ndcDepth)
{
    return ClipDepthRange == 0
        ? ndcDepth
        : ndcDepth * 0.5 + 0.5;
}

bool LoadPreviousVisibility(uint drawId, uint renderIdentityId, out uint recordBase)
{
    recordBase = drawId * 2u;
    if (recordBase + 1u >= uint(VisibilityHistory.length()))
        return true;

    uint identityKey = renderIdentityId + 1u;
    if (identityKey == 0u || VisibilityHistory[recordBase] != identityKey)
        return true;

    return VisibilityHistory[recordBase + 1u] != 0u;
}

void StoreCurrentVisibility(uint recordBase, uint renderIdentityId, bool visible)
{
    if (recordBase + 1u >= uint(VisibilityHistory.length()))
        return;

    uint identityKey = renderIdentityId + 1u;
    if (identityKey == 0u)
        return;

    VisibilityHistory[recordBase] = identityKey;
    VisibilityHistory[recordBase + 1u] = visible ? 1u : 0u;
}

bool ViewMaskContains(uvec2 mask, uint viewId)
{
    if (viewId < 32u)
        return (mask.x & (1u << viewId)) != 0u;

    uint hi = viewId - 32u;
    return hi < 32u && (mask.y & (1u << hi)) != 0u;
}

bool ViewPassMatches(uint viewId)
{
    if (viewId >= uint(ActiveViewCount) || viewId >= ViewDescriptors.length())
        return false;

    GPUViewDescriptor descriptor = ViewDescriptors[viewId];
    if (CurrentRenderPass < 0)
        return true;

    if (CurrentRenderPass < 32)
        return (descriptor.RenderPassMaskLo & (1u << uint(CurrentRenderPass))) != 0u;

    uint hi = uint(CurrentRenderPass - 32);
    return hi >= 32u || (descriptor.RenderPassMaskHi & (1u << hi)) != 0u;
}

void AppendPerView(uint sourceCommandIndex, uint outputCommandIndex, vec3 commandCenter, uint commandFlags)
{
    if (ActiveViewCount <= 0 || sourceCommandIndex >= CommandViewMasks.length())
        return;

    uvec2 mask = CommandViewMasks[sourceCommandIndex];
    uint maxViews = min(uint(ActiveViewCount), min(64u, uint(PerViewDrawCounts.length())));
    for (uint viewId = 0u; viewId < maxViews; ++viewId)
    {
        if (!ViewMaskContains(mask, viewId) || !ViewPassMatches(viewId))
            continue;

        GPUViewDescriptor descriptor = ViewDescriptors[viewId];
        bool foveated = (descriptor.Flags & (1u << 3u)) != 0u;
        if (foveated)
        {
            vec3 cameraPosition = ViewConstants[viewId].CameraPositionAndNear.xyz;
            vec3 toCenter = commandCenter - cameraPosition;
            float distanceSq = dot(toCenter, toCenter);
            float fullResNearDistance = descriptor.FoveationB.w;
            if (fullResNearDistance > 0.0 && distanceSq <= fullResNearDistance * fullResNearDistance)
                continue;
            if ((commandFlags & FLAG_TRANSPARENT) != 0u)
                continue;
        }

        uint local = atomicAdd(PerViewDrawCounts[viewId], 1u);
        if (local < descriptor.VisibleCapacity)
        {
            uint destination = descriptor.VisibleOffset + local;
            if (destination < PerViewVisibleIndices.length())
                PerViewVisibleIndices[destination] = outputCommandIndex;
        }
    }
}


float CombineHiZDepth(float a, float b)
{
    if (IsReversedDepth != 0u)
        return min(a, b);

    return max(a, b);
}

float InitialHiZDepth()
{
    return IsReversedDepth != 0u ? 1.0 : 0.0;
}

bool IsDefinitelyBehindHiZ(float nearestDepth, float hizDepth)
{
    // Bounds projection and fixed-function rasterization do not produce bit-
    // identical depth for a surface that contributed to the pyramid. Require
    // separation beyond that precision envelope before rejecting the draw.
    if (IsReversedDepth != 0u)
        return nearestDepth < hizDepth - HIZ_DEPTH_EPSILON;

    return nearestDepth > hizDepth + HIZ_DEPTH_EPSILON;
}

int SelectHiZMip(vec2 uvMin, vec2 uvMax)
{
    if (all(greaterThan(CoarseSourceSize, ivec2(0))))
        return 0;
    ivec2 baseSize = textureSize(HiZDepth, 0);
    vec2 sizePx = max((uvMax - uvMin) * vec2(baseSize), vec2(1.0));
    float maxDim = max(sizePx.x, sizePx.y);
    float targetDim = max(maxDim / float(HIZ_TARGET_TEXEL_SPAN), 1.0);
    return int(clamp(floor(log2(targetDim)), 0.0, float(HiZMaxMip)));
}

bool TrySampleHiZConservative(vec2 uvMin, vec2 uvMax, int mip, out float result)
{
    ivec2 mipSize = textureSize(HiZDepth, mip);
    ivec2 tMin = ivec2(clamp(floor(uvMin * vec2(mipSize)), vec2(0.0), vec2(mipSize - 1)));
    ivec2 tMax = ivec2(clamp(floor(uvMax * vec2(mipSize)), vec2(0.0), vec2(mipSize - 1)));
    if (all(greaterThan(CoarseSourceSize, ivec2(0))))
    {
        if (any(notEqual(mipSize, (CoarseSourceSize + ivec2(63)) / 64)))
            return false;
        // Include a pixel of rasterization uncertainty and every intersected
        // tile. Scaling directly by mipSize would skip tiles at partial edges.
        vec2 firstPixel = floor(uvMin * vec2(CoarseSourceSize)) - vec2(1.0);
        vec2 lastPixel = ceil(uvMax * vec2(CoarseSourceSize)) + vec2(1.0);
        tMin = clamp(ivec2(floor(firstPixel / 64.0)), ivec2(0), mipSize - 1);
        tMax = clamp(ivec2(floor(lastPixel / 64.0)), ivec2(0), mipSize - 1);
    }
    ivec2 span = tMax - tMin + ivec2(1);

    if (span.x > HIZ_MAX_SAMPLE_TEXELS || span.y > HIZ_MAX_SAMPLE_TEXELS)
    {
        // The bounded coarse-tile path must inspect every intersecting tile.
        // A larger footprint is simply not proven occluded.
        result = InitialHiZDepth();
        return false;
    }

    result = InitialHiZDepth();
    for (int y = 0; y < HIZ_MAX_SAMPLE_TEXELS; ++y)
    {
        if (y >= span.y)
            break;

        for (int x = 0; x < HIZ_MAX_SAMPLE_TEXELS; ++x)
        {
            if (x >= span.x)
                break;

            float depth = texelFetch(HiZDepth, tMin + ivec2(x, y), mip).r;
            // A malformed tile cannot establish occlusion. This also keeps a
            // partially initialized diagnostic image conservative.
            if (isnan(depth) || isinf(depth) || depth < 0.0 || depth > 1.0)
                return false;
            result = CombineHiZDepth(result, depth);
        }
    }

    return true;
}

bool HiZOccludedAabb(vec3 aabbMin, vec3 aabbMax)
{
    vec3 corners[8] = vec3[8](
        vec3(aabbMin.x, aabbMin.y, aabbMin.z),
        vec3(aabbMax.x, aabbMin.y, aabbMin.z),
        vec3(aabbMin.x, aabbMax.y, aabbMin.z),
        vec3(aabbMax.x, aabbMax.y, aabbMin.z),
        vec3(aabbMin.x, aabbMin.y, aabbMax.z),
        vec3(aabbMax.x, aabbMin.y, aabbMax.z),
        vec3(aabbMin.x, aabbMax.y, aabbMax.z),
        vec3(aabbMax.x, aabbMax.y, aabbMax.z)
    );

    vec2 uvMin = vec2(1.0);
    vec2 uvMax = vec2(0.0);
    float nearestDepth = (IsReversedDepth != 0u) ? 0.0 : 1.0;

    for (int i = 0; i < 8; ++i)
    {
        vec4 clip = ViewProj * vec4(corners[i], 1.0);
        if (any(isnan(clip)) || any(isinf(clip)) || clip.w <= 0.0)
            return false;

        vec3 ndc = clip.xyz / clip.w;
        vec2 uv = ClipToFramebufferUv(ndc.xy);
        uvMin = min(uvMin, uv);
        uvMax = max(uvMax, uv);

        float depth = ClipToFramebufferDepth(ndc.z);
        if (depth < 0.0 || depth > 1.0)
            return false;

        if (IsReversedDepth != 0u)
            nearestDepth = max(nearestDepth, depth);
        else
            nearestDepth = min(nearestDepth, depth);
    }

    if (uvMax.x < 0.0 || uvMax.y < 0.0 || uvMin.x > 1.0 || uvMin.y > 1.0)
        return false;

    vec2 clampedUvMin = clamp(uvMin, vec2(0.0), vec2(1.0));
    vec2 clampedUvMax = clamp(uvMax, vec2(0.0), vec2(1.0));

    int mip = SelectHiZMip(clampedUvMin, clampedUvMax);
    float hiz;
    if (!TrySampleHiZConservative(clampedUvMin, clampedUvMax, mip, hiz))
        return false;
    return IsDefinitelyBehindHiZ(nearestDepth, hiz);
}

bool TryLoadAabb(uint boundsId, out vec3 aabbMin, out vec3 aabbMax)
{
    if (boundsId >= uint(Bounds.length()))
    {
        aabbMin = vec3(0.0);
        aabbMax = vec3(0.0);
        return false;
    }

    BoundsGpu bounds = Bounds[boundsId];
    aabbMin = bounds.AabbMin.xyz;
    aabbMax = bounds.AabbMax.xyz;
    return all(lessThanEqual(aabbMin, aabbMax));
}

bool HiZOccludedAabbRefine(vec3 worldCenter, float radius)
{
    return HiZOccludedAabb(worldCenter - vec3(radius), worldCenter + vec3(radius));
}

// Conservative Hi-Z test using a projected sphere.
// Returns true if the sphere is definitely occluded; false otherwise.
bool HiZOccluded(vec3 worldCenter, float radius)
{
    vec4 clip = ViewProj * vec4(worldCenter, 1.0);
    if (clip.w <= 0.0)
        return false;

    vec3 ndc = clip.xyz / clip.w;

    // Convert to UV in [0,1]
    vec2 uvCenter = ClipToFramebufferUv(ndc.xy);

    // Conservative screen radius approximation.
    float rNdc = radius / max(clip.w, 1e-6);
    vec2 uvRadius = vec2(rNdc * 0.5);

    vec2 uvMin = uvCenter - uvRadius;
    vec2 uvMax = uvCenter + uvRadius;

    // If bounds are fully outside the screen, keep visible; otherwise clamp to
    // the visible viewport region before sampling the pyramid.
    if (uvMax.x < 0.0 || uvMax.y < 0.0 || uvMin.x > 1.0 || uvMin.y > 1.0)
        return false;

    vec2 clampedUvMin = clamp(uvMin, vec2(0.0), vec2(1.0));
    vec2 clampedUvMax = clamp(uvMax, vec2(0.0), vec2(1.0));

    // Select mip level based on projected footprint.
    int mip = SelectHiZMip(clampedUvMin, clampedUvMax);
    float hiz;
    if (!TrySampleHiZConservative(clampedUvMin, clampedUvMax, mip, hiz))
        return false;

    // Convert NDC z to depth-buffer space.
    float depth = ClipToFramebufferDepth(ndc.z);

    // Approximate depth extent of the sphere and use the nearest point for a conservative test.
    float depthDelta = rNdc * 0.5;
    float nearestDepth = (IsReversedDepth != 0u) ? (depth + depthDelta) : (depth - depthDelta);

    // If depth is outside [0,1], keep visible (uncertain).
    if (nearestDepth < 0.0 || nearestDepth > 1.0)
        return false;

    // Occlusion test depends on depth mode.
    bool sphereOccluded = IsDefinitelyBehindHiZ(nearestDepth, hiz);
    if (!sphereOccluded)
        return false;

    // Borderline values are refined using an AABB pass to reduce false positives.
    float delta = abs(nearestDepth - hiz);
    if (delta < 0.02)
        return HiZOccludedAabbRefine(worldCenter, radius);

    return true;
}

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    uint inputCount = InCount;

    if (idx >= inputCount)
        return;

    if (idx >= uint(inDrawIds.length()))
        return;

    uint drawId = inDrawIds[idx];
    if (drawId >= uint(Draws.length()))
        return;
    DrawMetadata draw = Draws[drawId];
    if (draw.InstanceCount == 0u)
        return;
    uint renderIdentityId = draw.RenderIdentityID;
    uint visibilityRecordBase = 0u;
    bool previouslyVisible = true;
    if (TwoPassPhase == 2)
    {
        // Always resolve this draw's history address, including on camera cuts.
        // Short-circuiting the load leaves every invocation writing record zero.
        previouslyVisible = LoadPreviousVisibility(drawId, renderIdentityId, visibilityRecordBase);
        previouslyVisible = ForcePhaseOneVisible != 0u || previouslyVisible;
    }

    BoundsGpu bounds = draw.BoundsID < uint(Bounds.length()) ? Bounds[draw.BoundsID] : BoundsGpu(vec4(0.0), vec4(0.0), vec4(0.0), 0u, 0u, 0u, 0u);
    vec3 center = bounds.BoundingSphere.xyz;
    float radius = bounds.BoundingSphere.w;

    vec3 aabbMin;
    vec3 aabbMax;
    bool occluded = TryLoadAabb(draw.BoundsID, aabbMin, aabbMax)
        ? HiZOccludedAabb(aabbMin, aabbMax)
        : false;

    if (TwoPassPhase == 2)
        StoreCurrentVisibility(visibilityRecordBase, renderIdentityId, !occluded);

    if (occluded)
        return;

    // A command emitted in phase one is already present in the frame. Phase two
    // still tested it to update next frame's visibility, but must not draw it twice.
    if (TwoPassPhase == 2 && previouslyVisible)
        return;

    uint outIndex = atomicAdd(OutCount, 1u);
    uint outputCapacity = min(uint(max(MaxOutputCommands, 0)), uint(outDrawIds.length()));
    if (outIndex >= outputCapacity)
    {
        // Bound the count as well as the write; the next GPU stage consumes it.
        atomicMin(OutCount, outputCapacity);
        atomicAdd(OcclusionOverflowFlag, 1u);
        atomicOr(OutOverflow, 1u);
        return;
    }

    outDrawIds[outIndex] = drawId;
    AppendPerView(drawId, outIndex, center, draw.Flags);
    atomicAdd(OutInstanceCount, draw.InstanceCount);
}
