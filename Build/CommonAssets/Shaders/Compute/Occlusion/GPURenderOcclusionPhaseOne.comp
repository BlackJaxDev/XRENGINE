#version 460 core

// Early phase of two-pass occlusion culling. Commands that were visible after
// the prior frame's late Hi-Z test are compacted and rendered as occluders.
// Identity mismatches are treated as visible so new/recycled commands cannot
// disappear before they have contributed depth once.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer InputCommandsBuffer { uint inCommands[]; };
layout(std430, binding = 1) writeonly buffer OutputCommandsBuffer { uint outCommands[]; };

layout(std430, binding = 2) readonly buffer InCountBuffer
{
    uint InCount;
    uint InInstanceCount;
    uint InOverflow;
};

layout(std430, binding = 3) buffer OutCountBuffer
{
    uint OutCount;
    uint OutInstanceCount;
    uint OutOverflow;
};

layout(std430, binding = 4) buffer OverflowFlagBuffer { uint OcclusionOverflowFlag; };

// Two uints per DrawID: { RenderIdentityID + 1, visible }.
layout(std430, binding = 6) readonly buffer VisibilityHistoryBuffer { uint VisibilityHistory[]; };

struct DrawMetadata
{
    uint DrawID; uint MeshID; uint SubmeshID; uint MaterialID;
    uint TransformID; uint SkinID; uint RenderPassMask; uint LayerMask;
    uint Flags; uint LodPolicy; uint StateClassID; uint InstanceCount;
    uint RenderPass; uint RenderIdentityID; uint LogicalMeshID; uint BoundsID;
};
layout(std430, binding = 5) readonly buffer DrawMetadataBuffer { DrawMetadata Draws[]; };
layout(std430, binding = 7) readonly buffer BoundsBuffer { vec4 boundsData[]; };

struct GPUViewDescriptor
{
    uint ViewId;
    uint ParentViewId;
    uint Flags;
    uint RenderPassMaskLo;
    uint RenderPassMaskHi;
    uint OutputLayer;
    uint ViewRectX;
    uint ViewRectY;
    uint ViewRectW;
    uint ViewRectH;
    uint VisibleOffset;
    uint VisibleCapacity;
    vec4 FoveationA;
    vec4 FoveationB;
};

struct GPUViewConstants
{
    mat4 View;
    mat4 Projection;
    mat4 ViewProjection;
    mat4 PrevViewProjection;
    vec4 CameraPositionAndNear;
    vec4 CameraForwardAndFar;
};

layout(std430, binding = 11) readonly buffer ViewDescriptorBuffer { GPUViewDescriptor ViewDescriptors[]; };
layout(std430, binding = 12) readonly buffer ViewConstantsBuffer { GPUViewConstants ViewConstants[]; };
layout(std430, binding = 13) readonly buffer CommandViewMaskBuffer { uvec2 CommandViewMasks[]; };
layout(std430, binding = 14) buffer PerViewVisibleIndicesBuffer { uint PerViewVisibleIndices[]; };
layout(std430, binding = 15) buffer PerViewDrawCountBuffer { uint PerViewDrawCounts[]; };

uniform int MaxOutputCommands;
uniform int ActiveViewCount;
uniform int CurrentRenderPass;
uniform uint ForceVisible;

#define FLAG_TRANSPARENT (1u << 0u)

bool WasPreviouslyVisible(uint drawId, uint renderIdentityId)
{
    uint recordBase = drawId * 2u;
    if (recordBase + 1u >= uint(VisibilityHistory.length()))
        return true;

    uint identityKey = renderIdentityId + 1u;
    if (identityKey == 0u || VisibilityHistory[recordBase] != identityKey)
        return true;

    return VisibilityHistory[recordBase + 1u] != 0u;
}

bool ViewMaskContains(uvec2 mask, uint viewId)
{
    if (viewId < 32u)
        return (mask.x & (1u << viewId)) != 0u;

    uint hi = viewId - 32u;
    return hi < 32u && (mask.y & (1u << hi)) != 0u;
}

bool ViewPassMatches(uint viewId)
{
    if (viewId >= uint(ActiveViewCount) || viewId >= ViewDescriptors.length())
        return false;

    GPUViewDescriptor descriptor = ViewDescriptors[viewId];
    if (CurrentRenderPass < 0)
        return true;

    if (CurrentRenderPass < 32)
        return (descriptor.RenderPassMaskLo & (1u << uint(CurrentRenderPass))) != 0u;

    uint hi = uint(CurrentRenderPass - 32);
    return hi >= 32u || (descriptor.RenderPassMaskHi & (1u << hi)) != 0u;
}

void AppendPerView(uint sourceCommandIndex, uint outputCommandIndex, vec3 commandCenter, uint commandFlags)
{
    if (ActiveViewCount <= 0 || sourceCommandIndex >= CommandViewMasks.length())
        return;

    uvec2 mask = CommandViewMasks[sourceCommandIndex];
    uint maxViews = min(uint(ActiveViewCount), min(64u, uint(PerViewDrawCounts.length())));
    for (uint viewId = 0u; viewId < maxViews; ++viewId)
    {
        if (!ViewMaskContains(mask, viewId) || !ViewPassMatches(viewId))
            continue;

        GPUViewDescriptor descriptor = ViewDescriptors[viewId];
        bool foveated = (descriptor.Flags & (1u << 3u)) != 0u;
        if (foveated)
        {
            vec3 cameraPosition = ViewConstants[viewId].CameraPositionAndNear.xyz;
            vec3 toCenter = commandCenter - cameraPosition;
            float distanceSq = dot(toCenter, toCenter);
            float fullResNearDistance = descriptor.FoveationB.w;
            if (fullResNearDistance > 0.0 && distanceSq <= fullResNearDistance * fullResNearDistance)
                continue;
            if ((commandFlags & FLAG_TRANSPARENT) != 0u)
                continue;
        }

        uint local = atomicAdd(PerViewDrawCounts[viewId], 1u);
        if (local < descriptor.VisibleCapacity)
        {
            uint destination = descriptor.VisibleOffset + local;
            if (destination < PerViewVisibleIndices.length())
                PerViewVisibleIndices[destination] = outputCommandIndex;
        }
    }
}

void main()
{
    uint candidateIndex = gl_GlobalInvocationID.x;
    if (candidateIndex >= InCount)
        return;

    if (candidateIndex >= uint(inCommands.length()))
        return;

    uint drawId = inCommands[candidateIndex];
    if (drawId >= uint(Draws.length()))
        return;
    DrawMetadata draw = Draws[drawId];
    uint instanceCount = draw.InstanceCount;
    if (instanceCount == 0u)
        return;

    // Camera/scene discontinuities invalidate the prior frame's visibility.
    // Seed the new view with every candidate so stale depth cannot lock work
    // out of both phases indefinitely.
    if (ForceVisible == 0u && !WasPreviouslyVisible(drawId, draw.RenderIdentityID))
        return;

    uint outputIndex = atomicAdd(OutCount, 1u);
    if (outputIndex >= uint(MaxOutputCommands))
    {
        atomicAdd(OcclusionOverflowFlag, 1u);
        OutOverflow = 1u;
        return;
    }

    outCommands[outputIndex] = drawId;

    uint boundsBase = draw.BoundsID * 4u;
    vec3 center = boundsBase < uint(boundsData.length()) ? boundsData[boundsBase].xyz : vec3(0.0);
    AppendPerView(drawId, outputIndex, center, draw.Flags);
    atomicAdd(OutInstanceCount, instanceCount);
}
