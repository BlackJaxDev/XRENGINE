#version 450

#include "Compute/PhysicsChain/PhysicsChainBonePose.glslinc"
#include "Compute/PhysicsChain/PhysicsChainAffineInput.glslinc"

layout(local_size_x = 64) in;

#include "Advanced/Generated/GPUSceneRecords.glslinc"

struct ParticleState
{
    vec3 Position;
    float _pad0;
    vec3 PrevPosition;
    float _pad1;
    int IsColliding;
    // The turn of the segment that ends at this particle. A zero quaternion means no turn.
    float SegmentTurnX;
    float SegmentTurnY;
    float SegmentTurnZ;
    vec3 PreviousPhysicsPosition;
    float SegmentTurnW;
};

layout(std430, binding = 0) readonly buffer ParticlesBuffer
{
    ParticleState Particles[];
};

layout(std430, binding = 1) readonly buffer TransformMatricesBuffer
{
    PhysicsChainAffineInput TransformMatrices[];
};

layout(std430, binding = 2) readonly buffer BoneMappingBuffer
{
    BoneMappingData BoneMappings[];
};

layout(std430, binding = 3) buffer SkinPaletteBuffer
{
    vec4 SkinPaletteRows[];
};

layout(row_major, std430, binding = 4) readonly buffer BoneInvBindMatricesBuffer
{
    mat4 BoneInvBindMatrices[];
};

uniform int particleBaseOffset;
uniform int mappingCount;

const int ROTATE_WITH_CHILD = 1;

void writeSkinPalette(uint paletteIndex, mat4 skinMatrix)
{
    uint rowBase = paletteIndex * 3u;
    SkinPaletteRows[rowBase + 0u] = skinMatrix[0];
    SkinPaletteRows[rowBase + 1u] = skinMatrix[1];
    SkinPaletteRows[rowBase + 2u] = skinMatrix[2];
}

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= uint(mappingCount))
        return;

    BoneMappingData mapping = BoneMappings[index];
    int particleIndex = particleBaseOffset + mapping.ParticleIndex;
    if (particleIndex < 0 || particleIndex >= Particles.length())
        return;

    vec3 particlePosition = Particles[particleIndex].Position;
    mat4 baseWorld = decodePhysicsChainAffineInput(TransformMatrices[particleIndex]);
    int childParticleIndex = particleBaseOffset + mapping.ChildParticleIndex;
    bool hasChild = (mapping.Flags & ROTATE_WITH_CHILD) != 0 && mapping.ChildParticleIndex >= 0
        && childParticleIndex >= 0 && childParticleIndex < Particles.length();
    vec3 childPosition = hasChild ? Particles[childParticleIndex].Position : particlePosition;

    // Particles keep their solved positions between solver steps, and the root follows its
    // animated transform. The offset moves the whole chain with the root and changes no solver state.
    int rootParticleIndex = particleBaseOffset + mapping.RootParticleIndex;
    if (rootParticleIndex >= 0 && rootParticleIndex < Particles.length())
    {
        vec3 presentationOffset = physicsChainAffineTranslation(TransformMatrices[rootParticleIndex])
            - Particles[rootParticleIndex].Position;
        particlePosition += presentationOffset;
        childPosition += presentationOffset;
    }

    // A bone inherits the simulated turn of its parents before it aims at its child, as a
    // transform hierarchy does. A branching or last bone keeps only the inherited turn.
    vec4 inheritedTurn = vec4(Particles[particleIndex].SegmentTurnX, Particles[particleIndex].SegmentTurnY,
        Particles[particleIndex].SegmentTurnZ, Particles[particleIndex].SegmentTurnW);
    if (dot(inheritedTurn, inheritedTurn) > 0.5)
        baseWorld = mat4(chainQuaternionToMatrix(inheritedTurn)) * baseWorld;

    // The decoded matrix uses GLSL's column-vector form of the C# row-vector
    // matrix. Transpose it before composition with the row-major inverse bind.
    mat4 boneWorldColumn = composeChainBoneWorld(baseWorld, particlePosition,
        childPosition, mapping.RestLocalDirection, hasChild);
    mat4 boneWorldRow = transpose(boneWorldColumn);
    mat4 skinMatrix = BoneInvBindMatrices[mapping.BoneMatrixIndex] * boneWorldRow;
    writeSkinPalette(uint(mapping.BoneMatrixIndex), skinMatrix);
}
