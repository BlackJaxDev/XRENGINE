#ifndef XRE_PHYSICS_CHAIN_BONE_POSE
#define XRE_PHYSICS_CHAIN_BONE_POSE

#include "Compute/PhysicsChain/PhysicsChainConstraints.glslinc"

mat3 chainQuaternionToMatrix(vec4 q)
{
    float xx = q.x * q.x;
    float yy = q.y * q.y;
    float zz = q.z * q.z;
    float xy = q.x * q.y;
    float xz = q.x * q.z;
    float yz = q.y * q.z;
    float wx = q.w * q.x;
    float wy = q.w * q.y;
    float wz = q.w * q.z;
    return mat3(
        1.0 - 2.0 * (yy + zz), 2.0 * (xy + wz), 2.0 * (xz - wy),
        2.0 * (xy - wz), 1.0 - 2.0 * (xx + zz), 2.0 * (yz + wx),
        2.0 * (xz + wy), 2.0 * (yz - wx), 1.0 - 2.0 * (xx + yy));
}

vec4 chainRotationBetweenVectors(vec3 start, vec3 destination)
{
    vec3 a = normalizeChainDirection(start);
    vec3 b = normalizeChainDirection(destination);
    float cosTheta = clamp(dot(a, b), -1.0, 1.0);
    if (cosTheta >= 0.99999)
        return vec4(0.0, 0.0, 0.0, 1.0);
    if (cosTheta <= -0.99999)
    {
        vec3 axis = normalize(abs(a.x) < 0.1 ? cross(a, vec3(1.0, 0.0, 0.0)) : cross(a, vec3(0.0, 1.0, 0.0)));
        return vec4(axis, 0.0);
    }
    vec3 axis = cross(a, b);
    float s = sqrt((1.0 + cosTheta) * 2.0);
    float inverseS = 1.0 / s;
    return normalize(vec4(axis * inverseS, s * 0.5));
}

// The result uses column vectors. Its fourth column is the solved world position.
mat4 composeChainBoneWorld(mat4 restWorld, vec3 position, vec3 childPosition,
    vec3 restLocalDirection, bool rotateWithChild)
{
    mat3 basis = mat3(restWorld);
    if (rotateWithChild)
    {
        vec3 restDirection = basis * restLocalDirection;
        vec3 currentDirection = childPosition - position;
        if (dot(restDirection, restDirection) > 1e-10 && dot(currentDirection, currentDirection) > 1e-10)
            basis = chainQuaternionToMatrix(chainRotationBetweenVectors(restDirection, currentDirection)) * basis;
    }
    return mat4(vec4(basis[0], 0.0), vec4(basis[1], 0.0), vec4(basis[2], 0.0), vec4(position, 1.0));
}

#endif
