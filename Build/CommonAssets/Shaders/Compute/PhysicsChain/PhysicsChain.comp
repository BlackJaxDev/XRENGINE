#version 450

#include "Compute/PhysicsChain/PhysicsChainWorkgroups.glslinc"
#include "Compute/PhysicsChain/PhysicsChainConstraints.glslinc"
#include "Compute/PhysicsChain/PhysicsChainAffineInput.glslinc"

layout(local_size_x = PHYSICS_CHAIN_SHORT_LINEAR_GROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

#include "Compute/PhysicsChain/PhysicsChainSolverData.glslinc"

// --- Buffers ---

layout(std430, binding = 0) buffer ParticlesBuffer 
{
    ParticleState Particles[];
};

layout(std430, binding = 1) readonly buffer ParticleStaticBuffer
{
    ParticleStatic ParticleStatics[];
};

layout(std430, binding = 3) buffer TransformMatricesBuffer 
{
    PhysicsChainAffineInput TransformMatrices[];
};

layout(std430, binding = 4) buffer CollidersBuffer
{
    ColliderData Colliders[];
};

layout(std430, binding = 5) readonly buffer PerTreeParamsBuffer
{
    PerTreeParams TreeParams[];
};

layout(std430, binding = 6) readonly buffer ActiveTreeIdBuffer
{
    uint ActiveTreeIds[];
};

layout(std430, binding = 7) readonly buffer ActiveWorkCounterBuffer
{
    uint ActiveWorkCounters[];
};

// --- Uniforms ---

uniform int ApplyObjectMove;
uniform int ParticleCount;
uniform int TreeCount;
uniform int UseActiveTreeIds;
uniform uint ActiveTreeIdBase;
uniform uint ActiveTreeIdCapacity;
uniform uint ActiveTreeBucket;

#include "Compute/PhysicsChain/PhysicsChainSolverStep.glslinc"

// --- Main Physics Update ---

void main()
{
    uint dispatchIndex = gl_GlobalInvocationID.x;
    if (ParticleCount <= 0 || TreeCount <= 0)
        return;
    if (UseActiveTreeIds != 0 && dispatchIndex >= min(ActiveWorkCounters[ActiveTreeBucket], ActiveTreeIdCapacity))
        return;

    uint treeId = UseActiveTreeIds != 0 ? ActiveTreeIds[ActiveTreeIdBase + dispatchIndex] : dispatchIndex;
    if (treeId >= uint(TreeCount))
        return;
    PerTreeParams tp = TreeParams[treeId];
    int particleStart = tp.ParticleOffset;
    int particleEnd = particleStart + tp.TreeParticleCount;
    if (particleStart < 0 || tp.TreeParticleCount <= 0 || particleEnd > ParticleCount)
        return;

    if (tp.LoopCount <= 0)
    {
        if ((tp.SolverFlags & CHAIN_HOLD_BETWEEN_STEPS) != 0)
            return;

        for (int pid = particleStart; pid < particleEnd; ++pid)
        {
            ParticleStatic particleStatic = ParticleStatics[pid];
            ParticleState p = Particles[pid];
            int parentIndex = particleStatic.ParentIndex;

            if (parentIndex < particleStart || parentIndex >= pid)
            {
                p.PrevPosition = p.Position;
                p.Position = physicsChainAffineTranslation(TransformMatrices[pid]);
            }
            else
            {
                resetChainParticle(p, particleStatic, tp);
            }

            Particles[pid] = p;
        }
        return;
    }

    vec3 force = computeChainIntegrationForce(tp);

    int iterationCount = clamp(tp.LoopCount, 1, 3);
    for (int iteration = 0; iteration < iterationCount; ++iteration)
    {
        vec3 objectMove = (ApplyObjectMove != 0 && iteration == 0) ? tp.ObjectMove : vec3(0.0);

        // One invocation owns one complete tree. Particle construction
        // guarantees parents precede children, so every parent write is
        // visible before a child reads it without cross-invocation ordering.
        for (int pid = particleStart; pid < particleEnd; ++pid)
        {
            ParticleStatic particleStatic = ParticleStatics[pid];
            ParticleState p = Particles[pid];
            p.PreviousPhysicsPosition = p.Position;

            int parentIndex = particleStatic.ParentIndex;
            if (parentIndex >= particleStart && parentIndex < pid)
            {
                stepChainParticle(p, particleStatic, particleStart, tp, force, objectMove, iteration == 0);
            }
            else
            {
                p.PrevPosition = p.Position;
                p.Position = physicsChainAffineTranslation(TransformMatrices[pid]);
                writeSegmentTurn(p, vec4(0.0, 0.0, 0.0, 1.0));
            }

            Particles[pid] = p;
        }
    }
}
