#version 450

// Copies one renderer's deformed world-space vertices into its range of the mesh atlas.
// The GPU indirect vertex shader reads only the atlas, so this makes deformed meshes visible to it.
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer SourcePositionsBuffer { vec4 SourcePositions[]; };
layout(std430, binding = 1) readonly buffer SourceNormalsBuffer { vec4 SourceNormals[]; };
layout(std430, binding = 2) readonly buffer SourceTangentsBuffer { vec4 SourceTangents[]; };
layout(std430, binding = 3) writeonly buffer AtlasPositionsBuffer { float AtlasPositions[]; };
layout(std430, binding = 4) writeonly buffer AtlasNormalsBuffer { float AtlasNormals[]; };
layout(std430, binding = 5) writeonly buffer AtlasTangentsBuffer { vec4 AtlasTangents[]; };

uniform uint firstVertex;
uniform uint vertexCount;
uniform int hasNormals;
uniform int hasTangents;

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= vertexCount)
        return;

    uint atlasVertex = firstVertex + index;
    uint word = atlasVertex * 3u;
    vec3 position = SourcePositions[index].xyz;
    AtlasPositions[word] = position.x;
    AtlasPositions[word + 1u] = position.y;
    AtlasPositions[word + 2u] = position.z;

    if (hasNormals != 0)
    {
        vec3 normal = SourceNormals[index].xyz;
        AtlasNormals[word] = normal.x;
        AtlasNormals[word + 1u] = normal.y;
        AtlasNormals[word + 2u] = normal.z;
    }

    if (hasTangents != 0)
        AtlasTangents[atlasVertex] = SourceTangents[index];
}
