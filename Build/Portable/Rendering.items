<Project>
  <PropertyGroup>
    <XREnginePortableRuntimeSupported>true</XREnginePortableRuntimeSupported>
  </PropertyGroup>
  <!-- Compile the existing backend-neutral contracts under the rendering assembly
       identity; desktop builds continue to compile the full source tree. -->
  <ItemGroup>
    <Compile Remove="**/*.cs" />
    <Compile Include="Runtime/RuntimeGraphicsApiKind.cs" />
    <Compile Include="Runtime/RendererModules/RendererBackendId.cs" />
    <Compile Include="Runtime/RendererModules/RenderExecutionMode.cs" />
    <Compile Include="Runtime/RendererModules/RendererBackendCapabilities.cs" />
    <Compile Include="Runtime/RendererModules/IRendererPresentationTarget.cs" />
    <Compile Include="Runtime/RendererModules/RenderTargetOutputProperties.cs" />
    <Compile Include="Runtime/RendererModules/RenderFrameOutputCapabilities.cs" />
    <Compile Include="Runtime/Browser/RuntimeSurfaceState.cs" />
    <Compile Include="Runtime/Browser/RuntimeInputState.cs" />
    <Compile Include="Runtime/Browser/IRuntimeSurfaceHost.cs" />
    <Compile Include="Runtime/Browser/BrowserCanvasRenderTarget.cs" />
    <Compile Include="Runtime/Browser/BrowserResourceHandle.cs" />
    <Compile Include="Runtime/Browser/BrowserFramePacket.cs" />
    <Compile Include="Runtime/Browser/BrowserFramePacketState.cs" />
    <Compile Include="Rendering/Shaders/Compilation/ShaderCompileTarget.cs" />
    <Compile Include="Rendering/Shaders/Compilation/ShaderArtifact.cs" />
    <Compile Include="Rendering/Shaders/Compilation/ShaderCompileResult.cs" />
    <Compile Include="Rendering/Shaders/Compilation/ShaderCompileDependency.cs" />
    <Compile Include="Rendering/Shaders/Compilation/ShaderCompileDiagnostic.cs" />
  </ItemGroup>
</Project>
