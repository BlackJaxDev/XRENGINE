    <Compile Include="Runtime/RendererModules/RendererBackendModuleIdentity.cs" />
    <Compile Include="Runtime/RendererModules/RendererBackendRegistration.cs" />
    <Compile Include="Runtime/RendererModules/RendererBackendRegistrationBehavior.cs" />
    <Compile Include="Runtime/RendererModules/RendererBackendRegistrationLease.cs" />
    <Compile Include="Runtime/RendererModules/RendererBackendReloadLimitations.cs" />
    <Compile Include="Runtime/RendererModules/RendererHostContext.cs" />
    <Compile Include="Runtime/RendererModules/RendererModuleUnloadContext.cs" />
    <Compile Include="Runtime/RendererModules/IRendererBackendCatalog.cs" />
    <Compile Include="Runtime/RendererModules/IRendererBackendFactory.cs" />
    <Compile Include="Runtime/RendererModules/IRendererBackendLifecycle.cs" />
    <Compile Include="Runtime/RendererModules/IRendererBackendModule.cs" />
    <Compile Include="Runtime/RendererModules/IRendererDesktopWindowServices.cs" />
    <Compile Include="Runtime/RendererModules/UnconfiguredRendererBackendCatalog.cs" />
    <Compile Include="Runtime/Interfaces/IRuntimeRendererHost.cs" />
    <Compile Include="Runtime/RendererModules/IRendererPresentationTarget.cs" />
    <Compile Include="Runtime/RendererModules/RenderTargetOutputProperties.cs" />
    <Compile Include="Runtime/RendererModules/RenderFrameOutputCapabilities.cs" />
    <Compile Include="Runtime/RendererModules/RenderFrameOutputDescription.cs" />
    <Compile Include="Runtime/Browser/BrowserRenderPassDescription.cs" />
    <Compile Include="Runtime/Browser/RuntimeSurfaceState.cs" />
    <Compile Include="Runtime/Browser/RuntimeInputState.cs" />
    <Compile Include="Runtime/Browser/IRuntimeSurfaceHost.cs" />
    <Compile Include="Runtime/Browser/BrowserCanvasRenderTarget.cs" />
    <Compile Include="Runtime/Browser/BrowserResourceHandle.cs" />
    <Compile Include="Runtime/Browser/BrowserFramePacket.cs" />
    <Compile Include="Runtime/Browser/BrowserFramePacketState.cs" />
    <Compile Include="Runtime/Browser/BrowserUploadBatch.cs" />
