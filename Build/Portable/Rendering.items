    <Compile Include="Runtime/Browser/BrowserArenaCapacityException.cs" />
    <Compile Include="Runtime/Browser/IBrowserRendererHost.cs" />
    <Compile Include="Runtime/Browser/IBrowserResourceCapability.cs" />
    <Compile Include="Runtime/Browser/IBrowserFrameSubmissionCapability.cs" />
    <Compile Include="Runtime/Browser/IBrowserUploadCapability.cs" />
    <Compile Include="Runtime/Browser/IBrowserTextureCopyCapability.cs" />
    <Compile Include="Runtime/Browser/IBrowserPresentationCapability.cs" />
    <Compile Include="Runtime/Browser/IBrowserCompletionCapability.cs" />
    <Compile Include="Runtime/Browser/BrowserTextureCopyDescription.cs" />
    <Compile Include="Runtime/Browser/BrowserRendererState.cs" />
    <Compile Include="Runtime/Browser/Assets/BrowserMeshData.cs" />
    <Compile Include="Runtime/Browser/Assets/BrowserTextureData.cs" />
    <Compile Include="Runtime/Browser/Assets/BrowserMaterialData.cs" />
    <Compile Include="Runtime/Browser/Assets/BrowserCameraSnapshot.cs" />
