<Project>
  <!-- Public factories from this managed closure belong to the shared host.
       Desktop generation reads the same types only to resolve inheritance. -->
  <ItemGroup Condition="'$(DesignTimeBuild)' != 'true'">
    <XREngineFactoryRegistrationInput Include="$(MSBuildThisFileDirectory)../../XREngine.Extensions/**/*.cs" Exclude="$(MSBuildThisFileDirectory)../../XREngine.Extensions/bin/**;$(MSBuildThisFileDirectory)../../XREngine.Extensions/obj/**;$(MSBuildThisFileDirectory)../../XREngine.Extensions/**/*.g.cs" RegistrationAssembly="XREngine.Extensions" EmitRegistration="$(XREngineEmitPortableFactoryRegistrations)" />
    <XREngineFactoryRegistrationInput Include="$(MSBuildThisFileDirectory)../../XREngine.Data/**/*.cs" Exclude="$(MSBuildThisFileDirectory)../../XREngine.Data/bin/**;$(MSBuildThisFileDirectory)../../XREngine.Data/obj/**;$(MSBuildThisFileDirectory)../../XREngine.Data/**/*.g.cs" RegistrationAssembly="XREngine.Data" EmitRegistration="$(XREngineEmitPortableFactoryRegistrations)" />
    <XREngineFactoryRegistrationInput Include="$(MSBuildThisFileDirectory)../../XREngine.Animation/**/*.cs" Exclude="$(MSBuildThisFileDirectory)../../XREngine.Animation/bin/**;$(MSBuildThisFileDirectory)../../XREngine.Animation/obj/**;$(MSBuildThisFileDirectory)../../XREngine.Animation/**/*.g.cs" RegistrationAssembly="XREngine.Animation" EmitRegistration="$(XREngineEmitPortableFactoryRegistrations)" />
    <XREngineFactoryRegistrationInput Include="$(MSBuildThisFileDirectory)../../XREngine.Audio/**/*.cs" Exclude="$(MSBuildThisFileDirectory)../../XREngine.Audio/bin/**;$(MSBuildThisFileDirectory)../../XREngine.Audio/obj/**;$(MSBuildThisFileDirectory)../../XREngine.Audio/**/*.g.cs" RegistrationAssembly="XREngine.Audio" EmitRegistration="$(XREngineEmitPortableFactoryRegistrations)" />
    <XREngineFactoryRegistrationInput Include="$(MSBuildThisFileDirectory)../../XREngine.Input/**/*.cs" Exclude="$(MSBuildThisFileDirectory)../../XREngine.Input/bin/**;$(MSBuildThisFileDirectory)../../XREngine.Input/obj/**;$(MSBuildThisFileDirectory)../../XREngine.Input/**/*.g.cs" RegistrationAssembly="XREngine.Input" EmitRegistration="$(XREngineEmitPortableFactoryRegistrations)" />
    <XREngineFactoryRegistrationInput Include="$(MSBuildThisFileDirectory)../../XREngine.Runtime.Core/**/*.cs" Exclude="$(MSBuildThisFileDirectory)../../XREngine.Runtime.Core/bin/**;$(MSBuildThisFileDirectory)../../XREngine.Runtime.Core/obj/**;$(MSBuildThisFileDirectory)../../XREngine.Runtime.Core/**/*.g.cs" RegistrationAssembly="XREngine.Runtime.Core" EmitRegistration="$(XREngineEmitPortableFactoryRegistrations)" />
    <XREngineFactoryRegistrationInput Include="$(MSBuildThisFileDirectory)../../XREngine.Runtime.Rendering/**/*.cs" Exclude="$(MSBuildThisFileDirectory)../../XREngine.Runtime.Rendering/bin/**;$(MSBuildThisFileDirectory)../../XREngine.Runtime.Rendering/obj/**;$(MSBuildThisFileDirectory)../../XREngine.Runtime.Rendering/**/*.g.cs" RegistrationAssembly="XREngine.Runtime.Rendering" EmitRegistration="$(XREngineEmitPortableFactoryRegistrations)" />
    <XREngineFactoryRegistrationInput Include="$(MSBuildThisFileDirectory)../../XREngine.Runtime.AnimationIntegration/**/*.cs" Exclude="$(MSBuildThisFileDirectory)../../XREngine.Runtime.AnimationIntegration/bin/**;$(MSBuildThisFileDirectory)../../XREngine.Runtime.AnimationIntegration/obj/**;$(MSBuildThisFileDirectory)../../XREngine.Runtime.AnimationIntegration/**/*.g.cs" RegistrationAssembly="XREngine.Runtime.AnimationIntegration" EmitRegistration="$(XREngineEmitPortableFactoryRegistrations)" />
    <XREngineFactoryRegistrationInput Include="$(MSBuildThisFileDirectory)../../XREngine.Runtime.AudioIntegration/**/*.cs" Exclude="$(MSBuildThisFileDirectory)../../XREngine.Runtime.AudioIntegration/bin/**;$(MSBuildThisFileDirectory)../../XREngine.Runtime.AudioIntegration/obj/**;$(MSBuildThisFileDirectory)../../XREngine.Runtime.AudioIntegration/**/*.g.cs" RegistrationAssembly="XREngine.Runtime.AudioIntegration" EmitRegistration="$(XREngineEmitPortableFactoryRegistrations)" />
    <XREngineFactoryRegistrationInput Include="$(MSBuildThisFileDirectory)../../XREngine.Runtime.InputIntegration/**/*.cs" Exclude="$(MSBuildThisFileDirectory)../../XREngine.Runtime.InputIntegration/bin/**;$(MSBuildThisFileDirectory)../../XREngine.Runtime.InputIntegration/obj/**;$(MSBuildThisFileDirectory)../../XREngine.Runtime.InputIntegration/**/*.g.cs" RegistrationAssembly="XREngine.Runtime.InputIntegration" EmitRegistration="$(XREngineEmitPortableFactoryRegistrations)" />
    <XREngineFactoryRegistrationInput Include="$(MSBuildThisFileDirectory)../../XREngine.Runtime.Host/**/*.cs" Exclude="$(MSBuildThisFileDirectory)../../XREngine.Runtime.Host/bin/**;$(MSBuildThisFileDirectory)../../XREngine.Runtime.Host/obj/**;$(MSBuildThisFileDirectory)../../XREngine.Runtime.Host/**/*.g.cs" RegistrationAssembly="XREngine.Runtime.Host" EmitRegistration="$(XREngineEmitPortableFactoryRegistrations)" />
    <XREngineFactoryRegistrationInput Remove="**/bin/**;**/obj/**;**/*.g.cs" />
  </ItemGroup>
</Project>
