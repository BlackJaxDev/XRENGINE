    </_BrowserPublisherFile>
    <_BrowserPublisherFile Include="$(BrowserPublisherSourceRoot)LEGAL/README.md">
      <TargetPath>LEGAL/%(Filename)%(Extension)</TargetPath>
    </_BrowserPublisherFile>
    <_BrowserPublisherFile Include="$(BrowserPublisherSourceRoot)LEGAL/COMMERCIAL.md;$(BrowserPublisherSourceRoot)LEGAL/CONTRIBUTING.md">
      <TargetPath>LEGAL/%(Filename)%(Extension)</TargetPath>
    </_BrowserPublisherFile>
    <_BrowserPublisherFile Include="$(BrowserPublisherSourceRoot)Build/Portable/**/*.cs;$(BrowserPublisherSourceRoot)Build/Portable/**/*.props;$(BrowserPublisherSourceRoot)Build/Portable/**/*.targets;$(BrowserPublisherSourceRoot)Build/Portable/**/*.tsv">
      <TargetPath>Build/Portable/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </_BrowserPublisherFile>
    <_BrowserPublisherFile Include="$(BrowserPublisherSourceRoot)Build/Registration/**/*.targets;$(BrowserPublisherSourceRoot)Build/Registration/**/*.txt">
      <TargetPath>Build/Registration/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </_BrowserPublisherFile>
    <_BrowserPublisherFile Include="$(BrowserPublisherSourceRoot)Tools/Generate-AotFactoryRegistrations.ps1">
      <TargetPath>Tools/%(Filename)%(Extension)</TargetPath>
    </_BrowserPublisherFile>
    <_BrowserPublisherFile Include="$(BrowserPublisherSourceRoot)Tools/Dependencies/JoltBrowser.lock.json">
      <TargetPath>Tools/Dependencies/%(Filename)%(Extension)</TargetPath>
    </_BrowserPublisherFile>
    <_BrowserPublisherFile Include="$(BrowserPublisherSourceRoot)Tools/Dependencies/JoltBrowser/JoltBrowserNative.targets">
      <TargetPath>Tools/Dependencies/JoltBrowser/%(Filename)%(Extension)</TargetPath>
    </_BrowserPublisherFile>
    <_BrowserPublisherFile Include="$(BrowserPublisherSourceRoot)Tools/Dependencies/JoltBrowser/Managed/JoltPhysicsSharp.Browser.csproj">
      <TargetPath>Tools/Dependencies/JoltBrowser/Managed/%(Filename)%(Extension)</TargetPath>
    </_BrowserPublisherFile>
    <_BrowserPublisherFile Include="$(JoltBrowserManagedSourceDirectory)/src/**/*.cs">
      <TargetPath>Build/Dependencies/JoltBrowser/managed/staged/src/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </_BrowserPublisherFile>
    <_BrowserPublisherFile Include="$(JoltBrowserManagedSourceDirectory)/managed-source-files.props;$(JoltBrowserManagedSourceDirectory)/managed-source-pin.json;$(JoltBrowserManagedSourceDirectory)/LICENSE">
      <TargetPath>Build/Dependencies/JoltBrowser/managed/staged/%(Filename)%(Extension)</TargetPath>
    </_BrowserPublisherFile>
    <_BrowserPublisherFile Include="$(JoltBrowserArchiveDirectory)/libJolt.a;$(JoltBrowserArchiveDirectory)/libjoltc.a;$(JoltBrowserArchiveDirectory)/native-build-pin.json;$(JoltBrowserArchiveDirectory)/Jolt-LICENSE.txt;$(JoltBrowserArchiveDirectory)/joltc-LICENSE.txt">
      <TargetPath>Build/Dependencies/JoltBrowser/native/archives/%(Filename)%(Extension)</TargetPath>
    </_BrowserPublisherFile>
    <_BrowserPublisherFile Remove="$(BrowserPublisherSourceRoot)XREngine.Browser/Properties/launchSettings.json" />
  </ItemGroup>

  <Target Name="PublishBrowserPublisherPayload" AfterTargets="Publish" Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <_BrowserPublisherStage>$(PublishDir).BrowserPublishing-stage-$([System.Guid]::NewGuid().ToString('N'))</_BrowserPublisherStage>
      <_BrowserPublisherPowerShell Condition="'$(OS)' == 'Windows_NT'">powershell -NoProfile -ExecutionPolicy Bypass</_BrowserPublisherPowerShell>
      <_BrowserPublisherPowerShell Condition="'$(OS)' != 'Windows_NT'">pwsh -NoProfile</_BrowserPublisherPowerShell>
    </PropertyGroup>
    <Error Condition="'$(PublishDir)' == ''" Text="BrowserPublisher.PublishDirectoryMissing: Editor publish output is required." />
    <Error Condition="!Exists('$(JoltBrowserManagedSourceDirectory)/managed-source-files.props') or !Exists('$(JoltBrowserManagedSourceDirectory)/managed-source-pin.json') or !Exists('$(JoltBrowserManagedSourceDirectory)/LICENSE')"
           Text="BrowserPublisher.ManagedSourceMissing: prepare the reviewed Jolt browser managed source and pass JoltBrowserManagedSourceDirectory when publishing the Editor." />
    <Error Condition="!Exists('$(JoltBrowserArchiveDirectory)/libJolt.a') or !Exists('$(JoltBrowserArchiveDirectory)/libjoltc.a') or !Exists('$(JoltBrowserArchiveDirectory)/native-build-pin.json') or !Exists('$(JoltBrowserArchiveDirectory)/Jolt-LICENSE.txt') or !Exists('$(JoltBrowserArchiveDirectory)/joltc-LICENSE.txt')"
           Text="BrowserPublisher.NativeArchiveMissing: prepare the pinned Jolt browser archives and pass JoltBrowserArchiveDirectory when publishing the Editor." />
    <Error Condition="!Exists('$(BrowserPublisherSourceRoot)XREngine.Browser/XREngine.Browser.csproj') or !Exists('$(BrowserPublisherSourceRoot)Build/Portable/PortableProjects.tsv') or !Exists('$(BrowserPublisherSourceRoot)Tools/Generate-AotFactoryRegistrations.ps1')"
           Text="BrowserPublisher.SourceMissing: the portable browser project and build policy sources are required." />
    <Error Condition="'@(_BrowserPublisherFile)' == ''" Text="BrowserPublisher.PayloadEmpty: no browser publisher inputs were selected." />
    <GetFileHash Files="$(BrowserPublisherSourceRoot)Tools/Dependencies/JoltBrowser.lock.json" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_BrowserPublisherExpectedNativePin" />
    </GetFileHash>
    <GetFileHash Files="$(JoltBrowserArchiveDirectory)/native-build-pin.json" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_BrowserPublisherNativePin" />
    </GetFileHash>
    <Error Condition="'@(_BrowserPublisherExpectedNativePin->'%(FileHash)')' != '@(_BrowserPublisherNativePin->'%(FileHash)')'"
           Text="BrowserPublisher.NativePinMismatch: prepared Jolt archives do not match the reviewed browser source pin." />
    <Copy SourceFiles="@(_BrowserPublisherFile)"
          DestinationFiles="@(_BrowserPublisherFile->'$(_BrowserPublisherStage)/%(TargetPath)')"
          SkipUnchangedFiles="true" />
    <Exec Command="$(_BrowserPublisherPowerShell) -File &quot;$(MSBuildThisFileDirectory)Complete-BrowserPublisherPayload.ps1&quot; -StageDirectory &quot;$(_BrowserPublisherStage)&quot; -DestinationDirectory &quot;$(PublishDir)BrowserPublishing&quot;" />
    <OnError ExecuteTargets="CleanFailedBrowserPublisherStage" />
  </Target>

  <Target Name="CleanFailedBrowserPublisherStage">
    <RemoveDir Directories="$(_BrowserPublisherStage)" Condition="'$(_BrowserPublisherStage)' != '' and Exists('$(_BrowserPublisherStage)')" />
  </Target>
</Project>
