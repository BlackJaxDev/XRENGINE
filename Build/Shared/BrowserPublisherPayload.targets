<Project>
  <PropertyGroup>
    <BrowserPublisherSourceRoot>$(MSBuildThisFileDirectory)../../</BrowserPublisherSourceRoot>
    <JoltBrowserManagedSourceDirectory Condition="'$(JoltBrowserManagedSourceDirectory)' == ''">$(BrowserPublisherSourceRoot)Build/Dependencies/JoltBrowser/managed/staged</JoltBrowserManagedSourceDirectory>
    <JoltBrowserArchiveDirectory Condition="'$(JoltBrowserArchiveDirectory)' == ''">$(BrowserPublisherSourceRoot)Build/Dependencies/JoltBrowser/native/archives</JoltBrowserArchiveDirectory>
  </PropertyGroup>

  <!-- Copy an allowlisted, source-only browser build graph beside the published Editor.
       The browser build retains the same projects, guards, generated registrations,
       WebGPU assets, and reviewed Jolt supply as the checkout build. -->
  <ItemGroup>
    <_BrowserPublisherFile Include="$(BrowserPublisherSourceRoot)XREngine.Extensions/**/*.cs;$(BrowserPublisherSourceRoot)XREngine.Extensions/**/*.csproj;$(BrowserPublisherSourceRoot)XREngine.Extensions/**/*.props;$(BrowserPublisherSourceRoot)XREngine.Extensions/**/*.targets;$(BrowserPublisherSourceRoot)XREngine.Extensions/**/*.json;$(BrowserPublisherSourceRoot)XREngine.Extensions/**/*.js;$(BrowserPublisherSourceRoot)XREngine.Extensions/**/*.html;$(BrowserPublisherSourceRoot)XREngine.Extensions/**/*.css;$(BrowserPublisherSourceRoot)XREngine.Extensions/**/*.wgsl;$(BrowserPublisherSourceRoot)XREngine.Extensions/**/*.slang;$(BrowserPublisherSourceRoot)XREngine.Extensions/**/*.md" Exclude="$(BrowserPublisherSourceRoot)XREngine.Extensions/bin/**/*;$(BrowserPublisherSourceRoot)XREngine.Extensions/obj/**/*;$(BrowserPublisherSourceRoot)XREngine.Extensions/**/bin/**/*;$(BrowserPublisherSourceRoot)XREngine.Extensions/**/obj/**/*;$(BrowserPublisherSourceRoot)XREngine.Extensions/**/appsettings*.json;$(BrowserPublisherSourceRoot)XREngine.Extensions/**/secrets*.json;$(BrowserPublisherSourceRoot)XREngine.Extensions/**/*credentials*.json">
