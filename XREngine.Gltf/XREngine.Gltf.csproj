<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
    <FastGltfBridgeProject>$(MSBuildProjectDirectory)\..\Build\Native\FastGltfBridge\FastGltfBridge.vcxproj</FastGltfBridgeProject>
    <FastGltfBridgeNativeDll>$(MSBuildProjectDirectory)\runtimes\win-x64\native\FastGltfBridge.Native.dll</FastGltfBridgeNativeDll>
    <FastGltfBridgeBuildStateFile>$(BaseIntermediateOutputPath)fastgltf-active-native-configuration.txt</FastGltfBridgeBuildStateFile>
    <FastGltfBridgeBuildStampFile>$(BaseIntermediateOutputPath)fastgltf-native-build.stamp</FastGltfBridgeBuildStampFile>
  </PropertyGroup>

  <ItemGroup>
    <FastGltfBridgeBuildInput Include="$(MSBuildProjectFullPath);$(FastGltfBridgeProject);$(MSBuildProjectDirectory)\..\Build\Native\FastGltfBridge\**\*.cpp;$(MSBuildProjectDirectory)\..\Build\Native\FastGltfBridge\**\*.h;$(MSBuildProjectDirectory)\..\Build\Native\FastGltfBridge\**\*.hpp" />
  </ItemGroup>

  <ItemGroup>
    <None Include="runtimes\win-x64\native\FastGltfBridge.Native.dll" Condition="Exists('runtimes\win-x64\native\FastGltfBridge.Native.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="runtimes\win-x64\native\FastGltfBridge.Native.pdb" Condition="Exists('runtimes\win-x64\native\FastGltfBridge.Native.pdb')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="PrepareFastGltfBridgeBuildState"
          BeforeTargets="BuildFastGltfBridge"
          Condition="'$(XREngineUseExistingNativeBridges)' != 'true' and '$(OS)' == 'Windows_NT' and Exists('$(FastGltfBridgeProject)')">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(FastGltfBridgeBuildStateFile)'))" />
    <PropertyGroup>
      <FastGltfBridgeCurrentBuildState>$(Configuration)|x64</FastGltfBridgeCurrentBuildState>
    </PropertyGroup>
    <WriteLinesToFile File="$(FastGltfBridgeBuildStateFile)" Lines="$(FastGltfBridgeCurrentBuildState)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="BuildFastGltfBridge"
          BeforeTargets="PrepareForBuild"
          Inputs="@(FastGltfBridgeBuildInput);$(FastGltfBridgeBuildStateFile)"
          Outputs="$(FastGltfBridgeNativeDll);$(FastGltfBridgeBuildStampFile)"
          Condition="'$(XREngineUseExistingNativeBridges)' != 'true' and '$(OS)' == 'Windows_NT' and Exists('$(FastGltfBridgeProject)')">
    <PropertyGroup>
      <VsWhereExe>$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe</VsWhereExe>
    </PropertyGroup>

    <!-- MSBuild alone does not include C++ targets; include standalone Build Tools installations. -->
    <Exec Condition="Exists('$(VsWhereExe)')" Command="&quot;$(VsWhereExe)&quot; -latest -products * -requires Microsoft.Component.MSBuild Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -find &quot;MSBuild\Current\Bin\MSBuild.exe&quot;" ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="FastGltfBridgeMsBuildPath" />
    </Exec>

    <Message Condition="'$(FastGltfBridgeMsBuildPath)' == '' and Exists('$(FastGltfBridgeNativeDll)')" Importance="high" Text="Skipping FastGltfBridge native rebuild because Visual Studio MSBuild with C++ tools was not found; using existing $(FastGltfBridgeNativeDll)." />
    <Error Condition="'$(FastGltfBridgeMsBuildPath)' == '' and !Exists('$(FastGltfBridgeNativeDll)')" Text="Could not locate Visual Studio MSBuild with C++ tools required to build FastGltfBridge.vcxproj, and $(FastGltfBridgeNativeDll) is missing. Install Visual Studio or Build Tools with Desktop development with C++ and the MSVC v143 x64/x86 build tools." />

    <Exec Condition="'$(FastGltfBridgeMsBuildPath)' != ''" Command="&quot;$(FastGltfBridgeMsBuildPath)&quot; &quot;$(FastGltfBridgeProject)&quot; /m /nologo /p:Configuration=$(Configuration);Platform=x64" />
    <WriteLinesToFile File="$(FastGltfBridgeBuildStampFile)" Lines="$(FastGltfBridgeCurrentBuildState)" Overwrite="true" />
  </Target>

  <Target Name="ValidateExistingFastGltfBridge"
          BeforeTargets="PrepareForBuild"
          Condition="'$(XREngineUseExistingNativeBridges)' == 'true' and !Exists('$(FastGltfBridgeNativeDll)')">
    <Error Text="Isolated editor builds reuse the repository-managed FastGltfBridge native binary, but $(FastGltfBridgeNativeDll) is missing. Build the native bridge once before starting an isolated editor session." />
  </Target>

</Project>
