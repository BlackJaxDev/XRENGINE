<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    <XREngineRendererBackends>None</XREngineRendererBackends>
    <XREngineIncludeSharedExecutableDependencies>false</XREngineIncludeSharedExecutableDependencies>
    <HeadlessBootstrapAssetsFile>$(MSBuildThisFileDirectory)..\XREngine.Runtime.Bootstrap\obj\renderer-None\project.assets.json</HeadlessBootstrapAssetsFile>
    <HeadlessBootstrapBuildTargets Condition="Exists('$(HeadlessBootstrapAssetsFile)')">Build</HeadlessBootstrapBuildTargets>
    <HeadlessBootstrapBuildTargets Condition="!Exists('$(HeadlessBootstrapAssetsFile)')">Restore;Build</HeadlessBootstrapBuildTargets>
    <XREngineHeadlessExcludedPublishPattern>(?i)(openvr_api\.dll|actionmanifest\.json|bindings_.*\.json|ovrlipsync\.dll|naudio\.sdl2\.dll|(?:lib)?sdl2(?:-2\.0)?\.(dll|so|dylib|a)|glfw3\.dll|libglfw(?:\.so\.3|\.3\.dylib)|vulkanmemoryallocator.*\.(dll|so|dylib)|soft_oal\.dll|libopenal\.(so|dylib)|av(codec|device|filter|format|util)-[0-9]+\.dll|postproc-[0-9]+\.dll|swresample-[0-9]+\.dll|swscale-[0-9]+\.dll|libmp3lame\.(32|64)\.dll|cimgui\.(dll|so|dylib)|raylib\.(dll|so|dylib)|ultralight(core)?\.(dll|so|dylib)|appcore\.(dll|so|dylib)|webcore\.(dll|so|dylib)|dstorage(core)?\.dll|openal-soft)</XREngineHeadlessExcludedPublishPattern>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.NoAffinitize" Value="true" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Steamworks.NET" Version="2024.8.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XREngine.Data\XREngine.Data.csproj" />
    <ProjectReference Include="..\XREngine.Extensions\XREngine.Extensions.csproj" />
    <ProjectReference Include="..\XREngine.Fbx\XREngine.Fbx.csproj" />
    <!-- NuGet's recursive restore drops custom ProjectReference properties. Restore
         the headless variant on first use so its isolated assets file exists. -->
    <ProjectReference
      Include="..\XREngine.Runtime.Bootstrap\XREngine.Runtime.Bootstrap.csproj"
      AdditionalProperties="XREngineRendererBackends=None"
      Targets="$(HeadlessBootstrapBuildTargets)" />
    <ProjectReference Include="..\XREngine.Runtime.Core\XREngine.Runtime.Core.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.ModelAssetPipeline\XREngine.Runtime.ModelAssetPipeline.csproj" />
  </ItemGroup>

  <Target Name="RemoveHeadlessLocalDevicePublishCargo" AfterTargets="ComputeFilesToPublish" BeforeTargets="CopyFilesToPublishDirectory">
    <ItemGroup>
      <_HeadlessLocalDevicePublishCargo
        Include="@(ResolvedFileToPublish)"
        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '$(XREngineHeadlessExcludedPublishPattern)'))" />
      <ResolvedFileToPublish Remove="@(_HeadlessLocalDevicePublishCargo)" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'openvr_api.dll'" />
    </ItemGroup>
  </Target>

</Project>
