<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
    <DefineConstants Condition="'$(RuntimeIdentifier)' == 'browser-wasm' or '$(XREngineJoltBrowser)' == 'true'">$(DefineConstants);XRE_JOLT_BROWSER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XREngine.UnitTests" />
    <PackageReference Include="JoltPhysicsSharp" Version="2.22.0" Condition="'$(RuntimeIdentifier)' != 'browser-wasm' and '$(XREngineJoltBrowser)' != 'true'" />
    <ProjectReference Include="../Tools/Dependencies/JoltBrowser/Managed/JoltPhysicsSharp.Browser.csproj" Condition="'$(RuntimeIdentifier)' == 'browser-wasm' or '$(XREngineJoltBrowser)' == 'true'" />
    <ProjectReference Include="../XREngine.Runtime.Core/XREngine.Runtime.Core.csproj" />
  </ItemGroup>
</Project>
