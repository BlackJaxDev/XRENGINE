<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
    <XREngineFactoryRegistrationMode>Portable</XREngineFactoryRegistrationMode>
    <GeneratedAotFactoryRegistrations>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', '$(Configuration)', '$(TargetFramework)', 'Generated', 'AotFactoryRegistrations.g.cs'))</GeneratedAotFactoryRegistrations>
    <XREngineFactoryRegistrationOutput>$(GeneratedAotFactoryRegistrations)</XREngineFactoryRegistrationOutput>
    <XREngineFactoryRegistrationStamp>$(GeneratedAotFactoryRegistrations).stamp</XREngineFactoryRegistrationStamp>
    <XREngineEmitPortableFactoryRegistrations>true</XREngineEmitPortableFactoryRegistrations>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../XREngine.Extensions/XREngine.Extensions.csproj" />
    <ProjectReference Include="../XREngine.Data/XREngine.Data.csproj" />
    <ProjectReference Include="../XREngine.Animation/XREngine.Animation.csproj" />
    <ProjectReference Include="../XREngine.Audio/XREngine.Audio.csproj" />
    <ProjectReference Include="../XREngine.Input/XREngine.Input.csproj" />
    <ProjectReference Include="../XREngine.Runtime.Core/XREngine.Runtime.Core.csproj" />
    <ProjectReference Include="../XREngine.Runtime.Rendering/XREngine.Runtime.Rendering.csproj" />
    <ProjectReference Include="../XREngine.Runtime.AnimationIntegration/XREngine.Runtime.AnimationIntegration.csproj" />
    <ProjectReference Include="../XREngine.Runtime.AudioIntegration/XREngine.Runtime.AudioIntegration.csproj" />
    <ProjectReference Include="../XREngine.Runtime.InputIntegration/XREngine.Runtime.InputIntegration.csproj" />
    <InternalsVisibleTo Include="XREngine.Runtime.Bootstrap" />
    <InternalsVisibleTo Include="XREngine.Editor" />
    <InternalsVisibleTo Include="XREngine.UnitTests" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <Import Project="../Build/Portable/PortableFactorySources.props" />
  <Import Project="../Build/Registration/FactoryRegistrations.targets" />
</Project>
