<Project>
  <PropertyGroup>
    <JoltBrowserManagedSourceDirectory Condition="'$(JoltBrowserManagedSourceDirectory)' == ''">$(MSBuildThisFileDirectory)Build/Dependencies/JoltBrowser/managed/staged</JoltBrowserManagedSourceDirectory>
    <JoltBrowserArchiveDirectory Condition="'$(JoltBrowserArchiveDirectory)' == ''">$(MSBuildThisFileDirectory)Build/Dependencies/JoltBrowser/native/archives</JoltBrowserArchiveDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'XREngine.Browser'">
    <XREngineIncludeSharedExecutableDependencies>false</XREngineIncludeSharedExecutableDependencies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'XREngine.Extensions' or '$(MSBuildProjectName)' == 'XREngine.Data' or '$(MSBuildProjectName)' == 'XREngine.Audio' or '$(MSBuildProjectName)' == 'XREngine.Animation' or '$(MSBuildProjectName)' == 'XREngine.Input' or '$(MSBuildProjectName)' == 'XREngine.Modeling' or '$(MSBuildProjectName)' == 'XREngine.Runtime.Core' or '$(MSBuildProjectName)' == 'XREngine.Runtime.Rendering' or '$(MSBuildProjectName)' == 'XREngine.Runtime.AudioIntegration' or '$(MSBuildProjectName)' == 'XREngine.Runtime.AnimationIntegration' or '$(MSBuildProjectName)' == 'XREngine.Runtime.InputIntegration' or '$(MSBuildProjectName)' == 'XREngine.Runtime.ModelingIntegration' or '$(MSBuildProjectName)' == 'XREngine.Runtime.Rendering.WebGPU' or '$(MSBuildProjectName)' == 'XREngine.Runtime.Platform.Browser' or '$(MSBuildProjectName)' == 'XREngine.Runtime.Host' or '$(MSBuildProjectName)' == 'XREngine.Browser' or '$(MSBuildProjectName)' == 'XREngine.Audio.WebAudio' or '$(MSBuildProjectName)' == 'XREngine.Runtime.Net.WebSockets' or ('$(MSBuildProjectName)' == 'XREngine.Runtime.Physics.Jolt' and ('$(RuntimeIdentifier)' == 'browser-wasm' or '$(XREngineJoltBrowser)' == 'true'))">
    <XREnginePortableProject>true</XREnginePortableProject>
  </PropertyGroup>

  <!-- The browser lane qualifies the untrimmed interpreter. Without this, the SDK defaults
       browser-wasm builds to trimmed publishing, which the portability guard rejects until
       trimming has its own metadata and serializer review. -->
  <PropertyGroup Condition="'$(XREnginePortableProject)' == 'true' and '$(RuntimeIdentifier)' == 'browser-wasm'">
    <PublishTrimmed Condition="'$(PublishTrimmed)' == ''">false</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WpfTemporaryProjectAdditionalProperties>$(WpfTemporaryProjectAdditionalProperties);AllowUnsafeBlocks=true</WpfTemporaryProjectAdditionalProperties>
    <AdditionalCscArguments>$(AdditionalCscArguments) /unsafe</AdditionalCscArguments>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <Nullable>disable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/Build/Temp/**;**/Build/TempValidation/**;**/Build/_AgentValidation/**;**/obj/**;**/bin/**</DefaultItemExcludes>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.1.0-dev</PackageVersion>
    <Authors Condition="'$(Authors)' == ''">BlackJax</Authors>
    <Company Condition="'$(Company)' == ''">BlackJax LLC</Company>
    <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">https://blackjaxvr.com</PackageProjectUrl>
    <RepositoryType Condition="'$(RepositoryType)' == ''">git</RepositoryType>
    <PackageTags Condition="'$(PackageTags)' == ''">xre xr vr game-engine blackjaxvr source-available</PackageTags>
    <PackageLicenseFile Condition="'$(PackageLicenseFile)' == '' and '$(PackageLicenseExpression)' == ''">LICENSE.md</PackageLicenseFile>
    <PackageRequireLicenseAcceptance Condition="'$(PackageRequireLicenseAcceptance)' == ''">true</PackageRequireLicenseAcceptance>
    <PackageReadmeFile Condition="'$(PackageReadmeFile)' == '' and Exists('$(MSBuildThisFileDirectory)README.md')">README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'XREngine.Runtime.Bootstrap'">
    <XREngineRendererBackends Condition="'$(XREngineRendererBackends)' == ''">All</XREngineRendererBackends>
    <XREngineRendererBackendVariant>renderer-$(XREngineRendererBackends)</XREngineRendererBackendVariant>
    <BaseOutputPath Condition="'$(UseArtifactsOutput)' != 'true' and '$(ArtifactsPath)' == ''">bin\$(XREngineRendererBackendVariant)\</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(UseArtifactsOutput)' != 'true' and '$(ArtifactsPath)' == ''">obj\$(XREngineRendererBackendVariant)\</BaseIntermediateOutputPath>
    <ArtifactsProjectName>$(MSBuildProjectName).$(XREngineRendererBackendVariant)</ArtifactsProjectName>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AdditionalCscArguments>$(AdditionalCscArguments) /unsafe</AdditionalCscArguments>
  </PropertyGroup>

  <!-- OpenVR.NET generates a large C# binding surface with XML documentation
       enabled. Keep the dependency source-built without flooding every engine
       build with missing-comment warnings owned by the third-party submodule. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'OpenVR.NET'">
    <NoWarn>$(NoWarn);CS1574;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE.md" Pack="true" PackagePath="\" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)LICENSE.md')" />
    <None Include="$(MSBuildThisFileDirectory)LEGAL\README.md" Pack="true" PackagePath="LEGAL\" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)LEGAL\README.md')" />
    <None Include="$(MSBuildThisFileDirectory)LEGAL\COMMERCIAL.md" Pack="true" PackagePath="LEGAL\" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)LEGAL\COMMERCIAL.md')" />
    <None Include="$(MSBuildThisFileDirectory)LEGAL\CONTRIBUTING.md" Pack="true" PackagePath="LEGAL\" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)LEGAL\CONTRIBUTING.md')" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)README.md')" />
  </ItemGroup>
</Project>
