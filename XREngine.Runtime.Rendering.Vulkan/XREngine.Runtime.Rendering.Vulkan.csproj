<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
    <VmaBridgeProject>$(MSBuildProjectDirectory)\..\Build\Native\VulkanMemoryAllocatorBridge\VulkanMemoryAllocatorBridge.vcxproj</VmaBridgeProject>
    <VmaBridgePackagedDll>$(MSBuildProjectDirectory)\runtimes\win-x64\native\VulkanMemoryAllocatorBridge.Native.dll</VmaBridgePackagedDll>
    <VmaBridgeNativeConfiguration Condition="'$(VmaBridgeNativeConfiguration)' == ''">$([System.Text.RegularExpressions.Regex]::Replace('$(Configuration)', '^.*(Debug|Release)$', '$1'))</VmaBridgeNativeConfiguration>
    <VmaBridgeGeneratedDir>$(MSBuildProjectDirectory)\..\Build\_AgentValidation\00000000-000000-shared\tools\bin\VulkanMemoryAllocatorBridge\$(VmaBridgeNativeConfiguration)\</VmaBridgeGeneratedDir>
    <VmaBridgeNativeDll Condition="'$(XREngineUseExistingNativeBridges)' != 'true'">$(VmaBridgeGeneratedDir)VulkanMemoryAllocatorBridge.Native.dll</VmaBridgeNativeDll>
    <VmaBridgeNativeDll Condition="'$(XREngineUseExistingNativeBridges)' == 'true'">$(VmaBridgePackagedDll)</VmaBridgeNativeDll>
    <VmaBridgeBuildStateFile>$(BaseIntermediateOutputPath)vma-$(VmaBridgeNativeConfiguration)-active-native-configuration.txt</VmaBridgeBuildStateFile>
    <VmaBridgeBuildStampFile>$(BaseIntermediateOutputPath)vma-$(VmaBridgeNativeConfiguration)-native-build.stamp</VmaBridgeBuildStampFile>
    <NvidiaSdkWinX64Dir Condition="'$(NvidiaSdkWinX64Dir)' == ''">$(MSBuildProjectDirectory)\..\ThirdParty\NVIDIA\SDK\win-x64\</NvidiaSdkWinX64Dir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <VmaBridgeBuildInput Include="$(MSBuildProjectFullPath);$(VmaBridgeProject);$(MSBuildProjectDirectory)\..\Build\Native\VulkanMemoryAllocatorBridge\**\*.cpp;$(MSBuildProjectDirectory)\..\Build\Native\VulkanMemoryAllocatorBridge\**\*.h;$(MSBuildProjectDirectory)\..\Build\Native\VulkanMemoryAllocatorBridge\**\*.hpp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="Silk.NET.Core" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Core.Win32Extras" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenXR" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenXR.Extensions.KHR" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Shaderc" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.AMD" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.ARM" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.FB" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.HUAWEI" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.INTEL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.NV" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.NVX" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.QNX" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.VALVE" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Loader.Native" Version="2025.9.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XREngine.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="runtimes\win-x64\native\xr_shaderc.dll;runtimes\win-x64\native\xr_shaderc.license.txt">
      <TargetPath>%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XREngine.Runtime.Rendering\XREngine.Runtime.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(XREngineUseExistingNativeBridges)' != 'true'">
    <None Include="$(VmaBridgeNativeDll)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>VulkanMemoryAllocatorBridge.Native.dll</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(XREngineUseExistingNativeBridges)' == 'true'">
    <None Include="$(VmaBridgePackagedDll)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>VulkanMemoryAllocatorBridge.Native.dll</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="Exists('$(NvidiaSdkWinX64Dir)')">
    <NvidiaSdkNative Include="$(NvidiaSdkWinX64Dir)nvngx_*.dll" />
    <NvidiaSdkNative Include="$(NvidiaSdkWinX64Dir)sl.*.dll" />
    <NvidiaSdkNative Include="$(NvidiaSdkWinX64Dir)NvLowLatencyVk.dll" Condition="Exists('$(NvidiaSdkWinX64Dir)NvLowLatencyVk.dll')" />
    <NvidiaSdkNative Include="$(NvidiaSdkWinX64Dir)*.license.txt" />
  </ItemGroup>

  <Target Name="CopyNvidiaSdkNative" AfterTargets="Build" Condition="'@(NvidiaSdkNative)' != ''">
    <Copy SourceFiles="@(NvidiaSdkNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyNvidiaSdkNativePublish" AfterTargets="Publish" Condition="'@(NvidiaSdkNative)' != '' and '$(PublishDir)' != ''">
    <Copy SourceFiles="@(NvidiaSdkNative)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Register symbols after native preparation so clean builds include newly generated PDBs.
       Packaged bridges do not require symbols; normal content propagation handles consumers and publish. -->
  <Target Name="IncludeVulkanMemoryAllocatorBridgeSymbols" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildVulkanMemoryAllocatorBridge" Condition="'$(XREngineUseExistingNativeBridges)' != 'true'">
    <ItemGroup>
      <None Include="$(VmaBridgeGeneratedDir)VulkanMemoryAllocatorBridge.Native.pdb" Condition="Exists('$(VmaBridgeGeneratedDir)VulkanMemoryAllocatorBridge.Native.pdb')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <TargetPath>VulkanMemoryAllocatorBridge.Native.pdb</TargetPath>
      </None>
    </ItemGroup>
  </Target>

  <Target Name="PrepareVulkanMemoryAllocatorBridgeBuildState" BeforeTargets="BuildVulkanMemoryAllocatorBridge" Condition="'$(XREngineUseExistingNativeBridges)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(NoBuild)' != 'true' and '$(OS)' == 'Windows_NT' and Exists('$(VmaBridgeProject)')">
    <Error Condition="'$(VmaBridgeNativeConfiguration)' != 'Debug' and '$(VmaBridgeNativeConfiguration)' != 'Release'" Text="VulkanMemoryAllocatorBridge native configuration must be Debug or Release. Managed configuration '$(Configuration)' did not map to either; set VmaBridgeNativeConfiguration explicitly if needed." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(VmaBridgeBuildStateFile)'))" />
    <PropertyGroup>
      <VmaBridgeCurrentBuildState>$(VmaBridgeNativeConfiguration)|x64|$(VULKAN_SDK)</VmaBridgeCurrentBuildState>
    </PropertyGroup>
    <WriteLinesToFile File="$(VmaBridgeBuildStateFile)" Lines="$(VmaBridgeCurrentBuildState)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="BuildVulkanMemoryAllocatorBridge" BeforeTargets="PrepareForBuild" Inputs="@(VmaBridgeBuildInput);$(VmaBridgeBuildStateFile)" Outputs="$(VmaBridgeNativeDll);$(VmaBridgeBuildStampFile)" Condition="'$(XREngineUseExistingNativeBridges)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(NoBuild)' != 'true' and '$(OS)' == 'Windows_NT' and Exists('$(VmaBridgeProject)')">
    <PropertyGroup>
      <VsWhereExe>$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe</VsWhereExe>
    </PropertyGroup>

    <!-- MSBuild alone does not include C++ targets; include standalone Build Tools installations. -->
    <Exec Condition="Exists('$(VsWhereExe)')" Command="&quot;$(VsWhereExe)&quot; -latest -products * -requires Microsoft.Component.MSBuild Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -find &quot;MSBuild\Current\Bin\MSBuild.exe&quot;" ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="VmaBridgeMsBuildPath" />
    </Exec>

    <MakeDir Directories="$(VmaBridgeGeneratedDir)" />
    <Copy Condition="('$(VmaBridgeMsBuildPath)' == '' or '$(VULKAN_SDK)' == '') and Exists('$(VmaBridgePackagedDll)')" SourceFiles="$(VmaBridgePackagedDll)" DestinationFiles="$(VmaBridgeNativeDll)" SkipUnchangedFiles="true" />
    <!-- Symbols from an earlier native build do not describe the packaged DLL. -->
    <Delete Condition="('$(VmaBridgeMsBuildPath)' == '' or '$(VULKAN_SDK)' == '') and Exists('$(VmaBridgePackagedDll)')" Files="$(VmaBridgeGeneratedDir)VulkanMemoryAllocatorBridge.Native.pdb" />
    <Error Condition="'$(VmaBridgeMsBuildPath)' == '' and !Exists('$(VmaBridgeNativeDll)')" Text="Could not locate Visual Studio MSBuild with C++ tools required to build VulkanMemoryAllocatorBridge.vcxproj, and no packaged bridge is available. Install Visual Studio or Build Tools with Desktop development with C++ and the MSVC v143 x64/x86 build tools." />
    <Error Condition="'$(VmaBridgeMsBuildPath)' != '' and '$(VULKAN_SDK)' == '' and !Exists('$(VmaBridgeNativeDll)')" Text="VULKAN_SDK must be set to build VulkanMemoryAllocatorBridge.vcxproj, and no packaged bridge is available." />

    <Exec Condition="'$(VmaBridgeMsBuildPath)' != '' and '$(VULKAN_SDK)' != ''" Command="&quot;$(VmaBridgeMsBuildPath)&quot; &quot;$(VmaBridgeProject)&quot; /m /nologo &quot;/p:Configuration=$(VmaBridgeNativeConfiguration);Platform=x64&quot;" />
    <WriteLinesToFile File="$(VmaBridgeBuildStampFile)" Lines="$(VmaBridgeCurrentBuildState)" Overwrite="true" />
  </Target>

  <Target Name="ValidateExistingVulkanMemoryAllocatorBridge" BeforeTargets="PrepareForBuild" Condition="'$(XREngineUseExistingNativeBridges)' == 'true' and !Exists('$(VmaBridgeNativeDll)')">
    <Error Text="Isolated editor builds reuse the repository-managed VulkanMemoryAllocatorBridge native binary, but $(VmaBridgeNativeDll) is missing. Build the native bridge once before starting an isolated editor session." />
  </Target>

</Project>
