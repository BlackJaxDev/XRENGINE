{
  "$schema": "../../../../.vscode/schemas/render-profile-recipe.schema.json",
  "schema_version": 1,
  "name": "control-presentationless",
  "component": "PresentationlessFrame",
  "execution_mode": "presentationless",
  "backend": "vulkan",
  "adapter": "default",
  "fixture": "synthetic-clear",
  "width": 1280,
  "height": 720,
  "render_scale": 1.0,
  "color_format": "Rgba8",
  "depth_format": "DepthComponent32f",
  "sample_count": 1,
  "frame_slots": 3,
  "warmup_frames": 120,
  "stability_frames": 60,
  "capture_frames": 240,
  "repetitions": 3,
  "timeout_seconds": 120,
  "instrumentation": "aggregate_cpu, coarse_gpu",
  "validation_mode": "counters_and_hash",
  "label_policy": "stable_fixture_labels",
  "hardware_counter_policy": "disabled",
  "cpu_sampling_policy": "aggregate_only",
  "scene": {
    "scene_identity": "synthetic:no-world",
    "camera_identity": "synthetic:fixed-camera",
    "light_identities": [],
    "animation_identity": "frozen",
    "fixed_time_step_seconds": 0.016666666666666666,
    "random_seed": 5788229,
    "mesh_strategy": "direct",
    "render_features": [],
    "stereo_mode": "mono",
    "output_identities": ["color0"]
  },
  "mutation": { "policy": "stable_reuse" },
  "worker_counts": [1],
  "expected": { "draws": 0, "submissions": 1, "command_buffers": 1, "barriers": 2 },
  "budgets": { "max_capture_thread_allocated_bytes": 0, "require_output_hash": true }
}
