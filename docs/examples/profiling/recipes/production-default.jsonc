{
  "$schema": "../../../../.vscode/schemas/render-profile-recipe.schema.json",
  "schema_version": 1,
  "name": "production-default-diagnostic",
  "component": "ProductionFullFrame",
  "execution_mode": "presentationless",
  "backend": "vulkan",
  "fixture": "production-default-static",
  "width": 640,
  "height": 360,
  "color_format": "Rgba8",
  "depth_format": "DepthComponent32f",
  "sample_count": 1,
  "frame_slots": 3,
  "warmup_frames": 60,
  "stability_frames": 10,
  "capture_frames": 30,
  "repetitions": 1,
  "timeout_seconds": 180,
  "instrumentation": "aggregate_cpu, coarse_gpu",
  "profile_mode": "diagnostics",
  "validation_mode": "counters_hash_and_image",
  "enable_validation": true,
  "enable_synchronization_validation": true,
  "label_policy": "disabled",
  "hardware_counter_policy": "disabled",
  "cpu_sampling_policy": "aggregate_only",
  "scene": {
    "scene_identity": "renderbench:production-moderate-static",
    "camera_identity": "renderbench:production-fixed-camera",
    "light_identities": [],
    "animation_identity": "frozen",
    "random_seed": 5788229,
    "mesh_strategy": "multi_draw_indirect",
    "render_features": ["default-render-pipeline:raw-albedo:gpu-indirect-zero-readback"],
    "stereo_mode": "mono",
    "output_identities": ["production-color"]
  },
  "mutation": { "policy": "stable_reuse" },
  "worker_counts": [1],
  "expected": { "submissions": 1, "command_buffers": 1 },
  "budgets": {
    "max_capture_thread_allocated_bytes": 67108864,
    "max_worker_allocated_bytes": null,
    "require_output_hash": true
  }
}
