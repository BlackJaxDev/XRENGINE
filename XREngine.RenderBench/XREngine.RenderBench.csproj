<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <BaseOutputPath Condition="'$(UseArtifactsOutput)' != 'true'">$(MSBuildThisFileDirectory)..\Build\RenderBench\$(Configuration)\$(Platform)\</BaseOutputPath>
    <RenderBenchRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</RenderBenchRepositoryRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpFont.Dependencies" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XREngine.Runtime.Automation\XREngine.Runtime.Automation.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.Bootstrap\XREngine.Runtime.Bootstrap.csproj" />
    <ProjectReference Include="..\XREngine.Runtime.Rendering.Vulkan\XREngine.Runtime.Rendering.Vulkan.csproj" />
  </ItemGroup>

  <Target Name="RejectRepositoryRootOutput" BeforeTargets="PrepareForBuild">
    <Error
      Condition="'$(TargetDir)' == '$(RenderBenchRepositoryRoot)'"
      Text="XREngine.RenderBench output cannot target the repository root. Use the project default or an output directory under Build/." />
  </Target>
</Project>
